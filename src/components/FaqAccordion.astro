---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="space-y-0">
  {items.map((item) => (
    <div class="faq-item">
      <div class="faq-question">
        <span>{item.question}</span>
        <div class="faq-icon">
          <i class="fa-solid fa-plus"></i>
        </div>
      </div>
      <div class="faq-answer">
        <p>{item.answer}</p>
      </div>
    </div>
  ))}
</div>
