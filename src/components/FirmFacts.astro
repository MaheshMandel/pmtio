---
// FE-34: firm-specific, dated facts block for /prop-firm-faq/<firm>/. Data lives in
// config/propfirm-facts.json (read from each firm's own pages; null = not confirmed and is
// never rendered). Labels are translated; the free-text values are the firm's own figures and
// notes and stay in English on every locale.
import propfirmFacts from '../../config/propfirm-facts.json';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  slug: string;
  name: string;
  locale: Locale;
}
const { slug, name, locale } = Astro.props as Props;
const t = useTranslations(locale);
const facts = (propfirmFacts.firms as Record<string, any>)[slug];
const verified: string = propfirmFacts.meta.verified_on;
const date = new Date(verified + 'T00:00:00Z').toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

type Row = { label: string; value: string };
const rows: Row[] = [];
let cannot: string | null = null;

if (facts && facts.status === 'operating') {
  const typeKey = facts.max_loss?.type ? (`propfirm_faq_detail.ff_type_${facts.max_loss.type}` as Parameters<typeof t>[0]) : null;
  const autoKey = `propfirm_faq_detail.ff_auto_${facts.automation_policy}` as Parameters<typeof t>[0];
  const copyKey = `propfirm_faq_detail.ff_copy_${facts.copy_trading_policy}` as Parameters<typeof t>[0];
  const programs = (facts.programs ?? []).map((p: any) => {
    const bits = [
      p.account_sizes,
      p.profit_target && `${t('propfirm_faq_detail.ff_prog_target')} ${p.profit_target}`,
      p.profit_split && `${t('propfirm_faq_detail.ff_prog_split')} ${p.profit_split}`,
      p.fee && `${t('propfirm_faq_detail.ff_prog_fee')} ${p.fee}`,
    ].filter(Boolean);
    return bits.length ? `${p.name}: ${bits.join(', ')}` : p.name;
  });

  const add = (label: string, value: string | null | undefined) => {
    if (value) rows.push({ label, value });
  };
  add(t('propfirm_faq_detail.ff_row_platforms'), (facts.platforms ?? []).join(', '));
  add(t('propfirm_faq_detail.ff_row_programs'), programs.join(' · '));
  add(t('propfirm_faq_detail.ff_row_daily'), facts.daily_loss);
  add(
    t('propfirm_faq_detail.ff_row_max'),
    facts.max_loss?.value ? `${facts.max_loss.value}${typeKey ? ` (${t(typeKey)})` : ''}` : null,
  );
  add(t('propfirm_faq_detail.ff_row_consistency'), facts.consistency_rule);
  add(t('propfirm_faq_detail.ff_row_days'), facts.min_trading_days);
  if (facts.automation_policy && facts.automation_policy !== 'unclear') {
    add(t('propfirm_faq_detail.ff_row_automation'), `${t(autoKey)}${facts.automation_note ? `. ${facts.automation_note}` : ''}`);
  }
  if (facts.copy_trading_policy && facts.copy_trading_policy !== 'unclear') {
    add(t('propfirm_faq_detail.ff_row_copy'), `${t(copyKey)}${facts.copy_trading_note ? `. ${facts.copy_trading_note}` : ''}`);
  }
  const route = facts.pmt_route && !/^none$/i.test(facts.pmt_route) ? facts.pmt_route : null;
  add(t('propfirm_faq_detail.ff_row_route'), route ?? t('propfirm_faq_detail.ff_route_none'));

  if (facts.pmt_cannot_note) cannot = facts.pmt_cannot_note;
  else if (!route) cannot = t('propfirm_faq_detail.ff_cannot_default', { name });
}
---
{facts && (
  <section id="key-facts" class="bg-[#001a33] py-12 px-4 border-y border-white/5" aria-labelledby="key-facts-heading">
    <div class="max-w-4xl mx-auto">
      <h2 id="key-facts-heading" class="text-2xl md:text-3xl font-bold text-white mb-4">{t('propfirm_faq_detail.ff_heading', { name })}</h2>

      {facts.status === 'closed' && (
        <p class="text-gray-300 leading-relaxed">
          {t('propfirm_faq_detail.ff_closed', { name })}{facts.status_note ? ` ${facts.status_note}` : ''}
        </p>
      )}
      {facts.status !== 'operating' && facts.status !== 'closed' && (
        <p class="text-gray-300 leading-relaxed">{t('propfirm_faq_detail.ff_none', { name })}</p>
      )}

      {rows.length > 0 && (
        <div class="overflow-x-auto rounded-xl border border-[#2B77EE]/40">
          <table class="w-full text-left text-sm sm:text-base">
            <tbody>
              {rows.map((r) => (
                <tr class="border-t border-white/10 first:border-t-0">
                  <th scope="row" class="px-4 py-3 font-medium text-gray-300 w-1/3 align-top">{r.label}</th>
                  <td class="px-4 py-3 text-white">{r.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {cannot && (
        <div class="mt-6 bg-amber-500/10 border border-amber-500/30 rounded-xl p-5">
          <h3 class="text-white font-bold mb-2">{t('propfirm_faq_detail.ff_cannot_heading', { name })}</h3>
          <p class="text-gray-300 text-sm leading-relaxed">{cannot}</p>
        </div>
      )}

      {rows.length > 0 && (
        <p class="mt-4 text-sm text-gray-400">
          {t('propfirm_faq_detail.ff_checked', { name, date })}
          {facts.basis === 'excerpt' && <> {t('propfirm_faq_detail.ff_basis_excerpt')}</>}
        </p>
      )}

      {facts.sources?.length > 0 && (
        <p class="mt-2 text-xs text-gray-500">
          {t('propfirm_faq_detail.ff_sources')}:{' '}
          {facts.sources.map((u: string, i: number) => (
            <>
              {i > 0 && ' · '}
              <a href={u} rel="nofollow noopener" class="underline hover:text-gray-300">{new URL(u).hostname.replace(/^www\./, '')}</a>
            </>
          ))}
        </p>
      )}
    </div>
  </section>
)}
