---
import { localizedPath, useTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/config";
import brokerList from "../../active-broker-list.json";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = localizedPath(locale);

const brokers = Object.entries(brokerList as Record<string, { name: string; url: string; target?: string }>).map(
  ([key, val]) => ({
    key,
    name: val.name,
    href: val.url.startsWith("http")
      ? val.url
      : localizedPath(locale, val.url.replace(/^\.\//, "")),
    target: val.target ?? "_self",
  })
);
---

<header id="nav-bar" class="navbar-header fixed top-0 left-0 right-0 z-[60] w-full flex flex-col">
  <div id="navbar-inner" class="bg-[#003366] w-full flex flex-row justify-between items-center lg:px-8 px-3 border-b border-white/10 transition-shadow duration-300 [font-family:'Inter',system-ui,sans-serif]">

    <!-- Logo -->
    <a href={home} class="flex items-center gap-2.5 py-3">
      <img
              width="28"
              height="28" src="/logo.png" alt="PickMyTrade" class="w-7 h-7 aspect-square object-contain" loading="eager" decoding="async" />
      <span class="font-bold hidden sm:inline text-white text-[15px] tracking-tight">PickMyTrade</span>
    </a>

    <nav class="flex items-center gap-0.5">

      <!-- Desktop links -->
      <a href={localizedPath(locale, "about")} class="relative hidden lg:inline-flex items-center px-3.5 py-5 text-[13.5px] font-semibold text-white/80 hover:text-white transition-colors duration-200 group">
        {t('nav.about')}
        <span class="absolute bottom-3 left-3.5 right-3.5 h-[2px] bg-white rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-250 origin-left opacity-60"></span>
      </a>
      <a href={`${home}#howitworks`} class="relative hidden lg:inline-flex items-center px-3.5 py-5 text-[13.5px] font-semibold text-white/80 hover:text-white transition-colors duration-200 group">
        {t('nav.how_it_works')}
        <span class="absolute bottom-3 left-3.5 right-3.5 h-[2px] bg-white rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-250 origin-left opacity-60"></span>
      </a>
      <a href={localizedPath(locale, "page/affiliate-program")} class="relative hidden lg:inline-flex items-center px-3.5 py-5 text-[13.5px] font-semibold text-white/80 hover:text-white transition-colors duration-200 group">
        {t('nav.affiliate')}
        <span class="absolute bottom-3 left-3.5 right-3.5 h-[2px] bg-white rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-250 origin-left opacity-60"></span>
      </a>
      <a href={`${home}#pricing-cards-container`} class="relative hidden lg:inline-flex items-center px-3.5 py-5 text-[13.5px] font-semibold text-white/80 hover:text-white transition-colors duration-200 group">
        {t('nav.pricing')}
        <span class="absolute bottom-3 left-3.5 right-3.5 h-[2px] bg-white rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-250 origin-left opacity-60"></span>
      </a>
      <a href="https://docs.pickmytrade.io/docs/" class="relative hidden lg:inline-flex items-center px-3.5 py-5 text-[13.5px] font-semibold text-white/80 hover:text-white transition-colors duration-200 group">
        {t('nav.docs')}
        <span class="absolute bottom-3 left-3.5 right-3.5 h-[2px] bg-white rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-250 origin-left opacity-60"></span>
      </a>
      <a href="https://blog.pickmytrade.io" target="_blank" rel="noopener" class="relative hidden lg:inline-flex items-center px-3.5 py-5 text-[13.5px] font-semibold text-white/80 hover:text-white transition-colors duration-200 group">
        {t('nav.blog')}
        <span class="absolute bottom-3 left-3.5 right-3.5 h-[2px] bg-white rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-250 origin-left opacity-60"></span>
      </a>

      <!-- Brokers dropdown (desktop) -->
      <div class="relative group hidden lg:block">
        <button class="relative inline-flex items-center gap-1 px-3.5 py-5 text-[13.5px] font-medium text-white/80 hover:text-white transition-colors duration-200 focus:outline-none group/btn">
          <span class="font-semibold">{t('nav.brokers')}</span>
          <svg class="w-3.5 h-3.5 mt-0.5 transition-transform duration-200 group-hover/btn:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
          <span class="absolute bottom-3 left-3.5 right-3.5 h-[2px] bg-white rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-250 origin-left opacity-60"></span>
        </button>
        <div class="absolute left-0 top-full pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-1 group-hover:translate-y-0 z-50">
          <div class="w-44 bg-white rounded-xl shadow-xl shadow-black/20 border border-gray-100 overflow-hidden py-1.5">
            {brokers.map((b) => (
              <a
                href={b.href}
                target={b.target}
                rel={b.target === "_blank" ? "noopener noreferrer" : undefined}
                class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:text-[#003366] hover:bg-[#003366]/[0.06] transition-colors duration-150 font-medium"
              >
                {b.name}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Resources dropdown (desktop) -->
      <div class="relative group hidden lg:block">
        <button class="relative inline-flex items-center gap-1 px-3.5 py-5 text-[13.5px] font-medium text-white/80 hover:text-white transition-colors duration-200 focus:outline-none group/btn">
          <span class="font-semibold">{t('nav.resources')}</span>
          <svg class="w-3.5 h-3.5 mt-0.5 transition-transform duration-200 group-hover/btn:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
          <span class="absolute bottom-3 left-3.5 right-3.5 h-[2px] bg-white rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-250 origin-left opacity-60"></span>
        </button>
        <div class="absolute left-0 top-full pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-1 group-hover:translate-y-0 z-50">
          <div class="w-52 bg-white rounded-xl shadow-xl shadow-black/20 border border-gray-100 overflow-hidden py-1.5">
            <a href={localizedPath(locale, "trade-copier")} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:text-[#003366] hover:bg-[#003366]/[0.06] transition-colors duration-150 font-medium">{t('nav.trade_copier')}</a>
            <div class="border-t border-gray-100 my-1.5"></div>
            <div class="px-4 py-2 text-xs font-bold text-gray-400 uppercase tracking-wider">{t('nav.asset_classes')}</div>
            <a href={localizedPath(locale, "assets/futures")} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:text-[#003366] hover:bg-[#003366]/[0.06] transition-colors duration-150 font-medium">{t('nav.futures')}</a>
            <a href={localizedPath(locale, "assets/stocks")} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:text-[#003366] hover:bg-[#003366]/[0.06] transition-colors duration-150 font-medium">{t('nav.stocks')}</a>
            <a href={localizedPath(locale, "assets/options")} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:text-[#003366] hover:bg-[#003366]/[0.06] transition-colors duration-150 font-medium">{t('nav.options')}</a>
            <a href={localizedPath(locale, "assets/forex")} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:text-[#003366] hover:bg-[#003366]/[0.06] transition-colors duration-150 font-medium">{t('nav.forex')}</a>
            <div class="border-t border-gray-100 my-1.5"></div>
            <div class="px-4 py-2 text-xs font-bold text-gray-400 uppercase tracking-wider">{t('nav.use_cases')}</div>
            <a href={localizedPath(locale, "use-cases/systematic-traders")} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:text-[#003366] hover:bg-[#003366]/[0.06] transition-colors duration-150 font-medium">{t('nav.systematic_traders')}</a>
            <a href={localizedPath(locale, "use-cases/prop-firm-traders")} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:text-[#003366] hover:bg-[#003366]/[0.06] transition-colors duration-150 font-medium">{t('nav.prop_firm_traders')}</a>
            <a href={localizedPath(locale, "use-cases/day-traders")} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:text-[#003366] hover:bg-[#003366]/[0.06] transition-colors duration-150 font-medium">{t('nav.day_traders')}</a>
            <div class="border-t border-gray-100 my-1.5"></div>
            <div class="px-4 py-2 text-xs font-bold text-gray-400 uppercase tracking-wider">{t('nav.compare')}</div>
            <a href={localizedPath(locale, "compare")} class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:text-[#003366] hover:bg-[#003366]/[0.06] transition-colors duration-150 font-medium">{t('nav.see_all_comparisons')}</a>
          </div>
        </div>
      </div>

      <!-- Divider -->
      <div class="hidden lg:block w-px h-5 bg-white/20 mx-2.5"></div>

      <!-- Sign Up -->
      <a href="https://app.pickmytrade.io/?register=true"
        class="hidden lg:inline-flex items-center px-4 py-2 rounded-lg text-[13.5px] font-semibold text-white bg-[#0F3EC3] border border-[#2B77EE] hover:bg-[#0d35a8] transition-all duration-200 active:scale-95">
        {t('nav.signup')}
      </a>

      <!-- Login -->
      <a href="https://app.pickmytrade.io"
        class="hidden lg:inline-flex items-center px-4 py-2 rounded-lg text-[13.5px] font-semibold text-[#0F3EC3] bg-white border border-[#2B77EE] hover:bg-gray-50 transition-all duration-200 ml-1.5 active:scale-95">
        {t('nav.login')}
      </a>

      <!-- Hamburger (mobile) -->
      <button id="mobile-menu-btn" aria-label={t('nav.menu')} aria-expanded="false" aria-controls="mobile-menu"
        class="lg:hidden flex flex-col justify-center items-center w-10 h-10 gap-[5px] rounded-lg hover:bg-white/10 transition-colors focus:outline-none ml-1">
        <span id="ham-bar-1" class="block w-5 h-[1.5px] bg-white transition-all duration-300 origin-center"></span>
        <span id="ham-bar-2" class="block w-5 h-[1.5px] bg-white transition-all duration-300"></span>
        <span id="ham-bar-3" class="block w-5 h-[1.5px] bg-white transition-all duration-300 origin-center"></span>
      </button>
    </nav>
  </div>

  <!-- Mobile menu overlay -->
  <div id="mobile-menu" role="dialog" aria-modal="true" aria-label={t('nav.nav_menu')}
    class="fixed inset-0 z-[55] lg:hidden pointer-events-none">
    <div id="mobile-menu-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>
    <div id="mobile-menu-panel"
      class="absolute top-0 left-0 h-full w-[min(300px,85vw)] bg-[#001e40] flex flex-col shadow-2xl border-r border-white/10 -translate-x-full transition-transform duration-300 ease-in-out [font-family:'Inter',system-ui,sans-serif]">

      <!-- Panel header -->
      <div class="flex items-center justify-between px-5 py-4 border-b border-white/10 bg-[#003366]">
        <a href={home} class="flex items-center gap-2.5">
          <img
              width="28"
              height="28" src="/logo.png" alt="PickMyTrade" class="w-7 h-7 aspect-square object-contain" />
          <span class="font-bold text-white text-sm tracking-tight">PickMyTrade</span>
        </a>
        <button id="mobile-menu-close" aria-label={t('nav.close_menu')}
          class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-300 hover:text-white hover:bg-white/10 transition-colors focus:outline-none">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-0.5">
        <a href={localizedPath(locale, "about")}
          class="mob-nav-link flex items-center gap-3 px-3.5 py-3 rounded-xl text-gray-200 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm font-medium group">
          <span class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/15 transition-colors">
            <svg class="w-3.5 h-3.5 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </span>
          {t('nav.about')}
        </a>
        <a href={`${home}#howitworks`}
          class="mob-nav-link flex items-center gap-3 px-3.5 py-3 rounded-xl text-gray-200 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm font-medium group">
          <span class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/15 transition-colors">
            <svg class="w-3.5 h-3.5 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </span>
          {t('nav.how_it_works')}
        </a>
        <a href={localizedPath(locale, "page/affiliate-program")}
          class="mob-nav-link flex items-center gap-3 px-3.5 py-3 rounded-xl text-gray-200 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm font-medium group">
          <span class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/15 transition-colors">
            <svg class="w-3.5 h-3.5 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/>
            </svg>
          </span>
          {t('nav.affiliate')}
        </a>
        <a href={`${home}#pricing`}
          class="mob-nav-link flex items-center gap-3 px-3.5 py-3 rounded-xl text-gray-200 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm font-medium group">
          <span class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/15 transition-colors">
            <svg class="w-3.5 h-3.5 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </span>
          {t('nav.pricing')}
        </a>
        <a href="https://docs.pickmytrade.io/docs/"
          class="flex items-center gap-3 px-3.5 py-3 rounded-xl text-gray-200 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm font-medium group">
          <span class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/15 transition-colors">
            <svg class="w-3.5 h-3.5 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </span>
          {t('nav.docs')}
        </a>
        <a href="https://blog.pickmytrade.io" target="_blank" rel="noopener"
          class="flex items-center gap-3 px-3.5 py-3 rounded-xl text-gray-200 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm font-medium group">
          <span class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/15 transition-colors">
            <svg class="w-3.5 h-3.5 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
            </svg>
          </span>
          {t('nav.blog')}
        </a>

        <!-- Brokers accordion -->
        <div>
          <button id="mob-brokers-toggle"
            class="w-full flex items-center justify-between gap-3 px-3.5 py-3 rounded-xl text-gray-200 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm font-medium focus:outline-none group">
            <span class="flex items-center gap-3">
              <span class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/15 transition-colors">
                <svg class="w-3.5 h-3.5 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
                </svg>
              </span>
              {t('nav.brokers')}
            </span>
            <svg id="mob-brokers-chevron" class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div id="mob-broker-list" class="hidden pl-[52px] pr-3 pb-1 space-y-0.5 mt-0.5">
            {brokers.map((b) => (
              <a
                href={b.href}
                target={b.target}
                rel={b.target === "_blank" ? "noopener noreferrer" : undefined}
                class="mob-nav-link flex items-center gap-2 px-3 py-2.5 rounded-lg text-gray-300 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm"
              >
                <span class="w-1 h-1 rounded-full bg-blue-300/60 shrink-0"></span>
                {b.name}
              </a>
            ))}
          </div>
        </div>

        <!-- Resources accordion -->
        <div>
          <button id="mob-resources-toggle"
            class="w-full flex items-center justify-between gap-3 px-3.5 py-3 rounded-xl text-gray-200 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm font-medium focus:outline-none group">
            <span class="flex items-center gap-3">
              <span class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/15 transition-colors">
                <svg class="w-3.5 h-3.5 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
              </span>
              {t('nav.resources')}
            </span>
            <svg id="mob-resources-chevron" class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div id="mob-resources-list" class="hidden pl-[52px] pr-3 pb-1 space-y-0.5 mt-0.5">
            <a href={localizedPath(locale, "trade-copier")} class="mob-nav-link flex items-center gap-2 px-3 py-2.5 rounded-lg text-gray-300 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm">
              <span class="w-1 h-1 rounded-full bg-blue-300/60 shrink-0"></span>{t('nav.trade_copier')}
            </a>
            <p class="px-3 pt-2 pb-1 text-[11px] font-semibold text-gray-500 uppercase tracking-widest">{t('nav.asset_classes')}</p>
            <a href={localizedPath(locale, "assets/futures")} class="mob-nav-link flex items-center gap-2 px-3 py-2.5 rounded-lg text-gray-300 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm">
              <span class="w-1 h-1 rounded-full bg-blue-300/60 shrink-0"></span>{t('nav.futures')}
            </a>
            <a href={localizedPath(locale, "assets/stocks")} class="mob-nav-link flex items-center gap-2 px-3 py-2.5 rounded-lg text-gray-300 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm">
              <span class="w-1 h-1 rounded-full bg-blue-300/60 shrink-0"></span>{t('nav.stocks')}
            </a>
            <a href={localizedPath(locale, "assets/options")} class="mob-nav-link flex items-center gap-2 px-3 py-2.5 rounded-lg text-gray-300 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm">
              <span class="w-1 h-1 rounded-full bg-blue-300/60 shrink-0"></span>{t('nav.options')}
            </a>
            <a href={localizedPath(locale, "assets/forex")} class="mob-nav-link flex items-center gap-2 px-3 py-2.5 rounded-lg text-gray-300 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm">
              <span class="w-1 h-1 rounded-full bg-blue-300/60 shrink-0"></span>{t('nav.forex')}
            </a>
            <p class="px-3 pt-2 pb-1 text-[11px] font-semibold text-gray-500 uppercase tracking-widest">{t('nav.use_cases')}</p>
