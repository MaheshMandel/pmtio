              <span class="w-1 h-1 rounded-full bg-blue-300/60 shrink-0"></span>{t('nav.prop_firm_traders')}
            </a>
            <a href={localizedPath(locale, "use-cases/day-traders")} class="mob-nav-link flex items-center gap-2 px-3 py-2.5 rounded-lg text-gray-300 hover:text-white hover:bg-white/10 transition-all duration-150 text-sm">
              <span class="w-1 h-1 rounded-full bg-blue-300/60 shrink-0"></span>{t('nav.day_traders')}
