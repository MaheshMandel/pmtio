---
import type { TwsUi } from "../data/twsHelpUi";
import { TWS_DISCLAIMER_URLS } from "../data/twsHelp";

interface Props {
  ui: Pick<TwsUi, "disclaimerHeading" | "financialHeading" | "financial" | "informationHeading" | "information" | "disclaimerLinks">;
  urls?: string[];
}
const { ui, urls = TWS_DISCLAIMER_URLS } = Astro.props as Props;
---

<section id="disclaimers" aria-labelledby="disclaimer-heading" class="bg-[#001a33] border border-white/10 rounded-xl p-6 sm:p-8">
  <h2 id="disclaimer-heading" class="text-xl font-bold text-white mb-4">{ui.disclaimerHeading}</h2>
  <h3 class="text-white font-semibold mb-1">{ui.financialHeading}</h3>
  <p class="text-gray-400 text-sm leading-relaxed mb-4">{ui.financial}</p>
  <h3 class="text-white font-semibold mb-1">{ui.informationHeading}</h3>
  <p class="text-gray-400 text-sm leading-relaxed mb-4">{ui.information}</p>
  {urls.length > 0 && <p class="text-sm text-gray-400">
    {urls.map((href, i) => (
      <>
        {i > 0 && " · "}
        <a href={href} class="text-[#2B77EE] hover:underline" rel="noopener">{ui.disclaimerLinks[i]}</a>
      </>
    ))}
  </p>}
</section>
