---
import BaseLayout from "../layouts/BaseLayout.astro";
import { DEFAULT_LOCALE } from "../i18n/config";
import { localizedPath, useTranslations } from "../i18n/utils";

const locale = DEFAULT_LOCALE;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={t('not_found.meta_title')}
  description={t('not_found.meta_description')}
  robots="noindex"
>
  <div class="min-h-screen bg-[#080c14] flex items-center justify-center px-4">
    <div class="text-center max-w-lg">
      <p class="text-8xl font-bold text-blue-500 mb-4">{t('not_found.code')}</p>
      <h1 class="text-3xl font-bold text-white mb-4">{t('not_found.title')}</h1>
      <p class="text-gray-400 mb-8">{t('not_found.subtitle')}</p>
      <a
        href={localizedPath(locale)}
        class="inline-block px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors"
      >
        {t('not_found.cta_home')}
      </a>
    </div>
  </div>
</BaseLayout>
