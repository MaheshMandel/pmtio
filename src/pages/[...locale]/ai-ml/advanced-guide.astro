  <style>
    /* =====================================================================
       Advanced Guide — "Reference Console" layout system
       Docs-style two-pane shell: a fixed sticky left index rail + a right
       content pane. Flat, crisp surfaces — hairline-bordered cards/tables
       with colored top-accent bars, monospace section pills and code chips,
       information-dense spacing. Brand navy / blue(#2B77EE) / purple(#7c3aed)
       / orange(#e93d00). Mono = JetBrains Mono.
       ===================================================================== */

    /* global.css sets `html, body { overflow-x: hidden }`, which makes the root
       a scroll container and breaks `position: sticky` for the index rail.
       `overflow-x: clip` still prevents horizontal scroll but does NOT create a
       scroll container, so sticky works. Scoped to this page via :global(). */
    :global(html), :global(body) { overflow-x: clip; }

    /* ---- Two-pane shell: [ index rail | content pane ] ---- */
    .adv-shell {
      display: grid;
      grid-template-columns: 244px minmax(0, 1fr);
      gap: 3.25rem;
      align-items: start;
    }
    @media (max-width: 1023px) {
      .adv-shell { grid-template-columns: 1fr; gap: 0; }
    }

    /* Sticky reference index rail — the grid ITEM is sticky (align-self:start
       keeps it content-height at the top of the tall grid row so it has room
       to travel); the inner div is just the scroll container for a long index. */
    .adv-rail { position: sticky; top: 6rem; align-self: start; }
    .adv-rail-inner {
      max-height: calc(100vh - 7.5rem);
      overflow-y: auto;
      padding: 1.25rem 1rem 1.5rem 0.25rem;
      border-right: 1px solid rgba(59,130,246,0.12);
      scrollbar-width: thin; scrollbar-color: rgba(59,130,246,0.4) transparent;
    }
    .adv-rail-label {
      display: flex; align-items: center; gap: 0.55rem;
      font-size: 0.62rem; font-weight: 700; letter-spacing: 0.2em;
      text-transform: uppercase; color: #6b7f98; margin: 0 0 1rem;
    }
    .adv-rail-dot { width: 6px; height: 6px; border-radius: 999px; background: #2B77EE; box-shadow: 0 0 8px #2B77EE; flex: 0 0 auto; }
    @media (max-width: 1023px) {
      .adv-rail { position: static; top: auto; }
      .adv-rail-inner {
        max-height: none; overflow: visible;
        border-right: none; border: 1px solid rgba(59,130,246,0.12);
        border-radius: 0.9rem; background: #06101c;
        margin: 0 0 2.5rem; padding: 1.1rem 1.25rem 1.35rem;
      }
    }

    /* Cross-link banner — flat hairline card with blue top accent */
    .adv-crosslink {
      display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;
      background: #06101c; border: 1px solid rgba(59,130,246,0.12);
      border-top: 2px solid #2B77EE; border-radius: 0.7rem;
      padding: 1rem 1.25rem; margin: 0 0 2.25rem; color: #889bb4;
      transition: border-color 0.3s ease;
    }
    .adv-crosslink:hover { border-color: rgba(59,130,246,0.35); }
    .adv-crosslink-icon {
      width: 2.1rem; height: 2.1rem; flex: none; border-radius: 0.5rem;
      background: rgba(43,119,238,0.1); border: 1px solid rgba(43,119,238,0.2);
      display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
    }
    .adv-crosslink-cta { color: #60a5fa; font-weight: 600; text-decoration: none; }
    .adv-crosslink-cta:hover { text-decoration: underline; }

    /* ---- Section = breakout grid: [full | content(measure) | full] ---- */
    .adv-section {
      position: relative;
      display: grid;
      grid-template-columns:
        [full-start] minmax(0, 1fr)
        [content-start] min(100%, 76ch) [content-end]
        minmax(0, 1fr) [full-end];
      padding: 3.75rem 0 0.75rem;
      margin: 0;
      scroll-margin-top: 5.5rem;
      border-top: 1px solid rgba(59, 130, 246, 0.12);
    }
    .adv-section:first-of-type { border-top: none; padding-top: 2rem; }
    /* every direct child rides the centered measure by default … */
    .adv-section > * { grid-column: content; }
    /* … except media, which breaks out to the full container width */
    .adv-section > .adv-tablewrap,
    .adv-section > .prompt-box,
    .adv-section > .card-grid,
    .adv-section > .nlp-featured,
    .adv-section > figure { grid-column: full; }

    /* Disclaimer section: no divider, no top padding jump */
