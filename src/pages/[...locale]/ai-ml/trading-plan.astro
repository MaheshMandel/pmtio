---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import ReadingMotion from '../../../components/ReadingMotion.astro';
import { getLocalePaths, localizedPath, useTranslations } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const pageUrl = 'https://pickmytrade.io/ai-ml/trading-plan/';

// ---------------------------------------------------------------------------
// TODO(pre-launch): finalize these three items before this page goes live.
//   1. CANONICAL — <BaseLayout> auto-emits the locale-prefixed canonical from
//      astro.config `site`: https://pickmytrade.io/<locale>/ai-ml/trading-plan.
//      `pageUrl` above (used in the JSON-LD) omits the /<locale> prefix — confirm
//      the intended public canonical and align both. To pin a fixed canonical,
//      pass an explicit `canonical="..."` prop to <BaseLayout> below.
//   2. OG IMAGE — `OG_IMAGE` below is still the generic /logo.png fallback.
//      Replace with a page-specific 1200x630 social card before launch
//      (suggested path: /og/ai-ml-trading-plan.png).
//   3. FOOTER LINK — Footer.astro links this page via `footer.link_ai_trading_plan`.
//      Keep that key translated in every locale (en ✓, de ✓).
// ---------------------------------------------------------------------------
const OG_IMAGE = '/logo.png'; // TODO(pre-launch): swap for /og/ai-ml-trading-plan.png (1200x630)

const schema1 = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "AI Trading for Beginners: The Complete Machine-Learning Trading Plan, Executed with PickMyTrade",
  "description": "A plain-English, step-by-step guide for US-based beginners: build an AI/ML trading system using meta-labeling, regime detection, and volatility-based position sizing, with Claude Fable (Anthropic's AI model) writing the code and PickMyTrade automating execution at your broker.",
  "author": { "@type": "Organization", "name": "PickMyTrade", "url": "https://pickmytrade.io/" },
  "publisher": {
    "@type": "Organization",
    "name": "PickMyTrade",
    "logo": { "@type": "ImageObject", "url": "https://pickmytrade.io/logo.png" }
  },
  "datePublished": "2026-07-03",
  "dateModified": "2026-07-03",
  "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
  "image": "https://pickmytrade.io/logo.png",
  "about": ["AI trading", "machine learning trading", "automated trading", "algorithmic trading for beginners", "PickMyTrade", "TradingView webhook automation"]
};

const schema2 = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://pickmytrade.io/" },
    { "@type": "ListItem", "position": 2, "name": "AI Trading for Beginners with PickMyTrade", "item": pageUrl }
  ]
};

const schema3 = {
                  "@context": "https://schema.org",
                  "@type": "TechArticle",
                  "headline": "How to Build an AI/ML Trading System and Automate It with PickMyTrade",
                  "name": "How to Build an AI/ML Trading System and Automate It with PickMyTrade",
                  "description": "An eight-step educational plan for building a machine-learning-assisted trading system: pick a market and timeframe, gather clean data, engineer features, label history with the triple-barrier method, train a LightGBM trade filter, validate honestly, paper trade, then automate execution through TradingView alerts and PickMyTrade.",
                  "timeRequired": "P90D",
                  "articleSection": [
                    "Pick your market and timeframe — Start with daily or swing trading (holding trades for days to weeks) on highly liquid US instruments: SPY or QQQ ETFs, or Micro E-mini futures (MES, MNQ). Micro futures require only small margin deposits and are not subject to the Pattern Day Trader $25,000 rule that applies to frequent stock day-trading in margin accounts.",
                    "Get clean historical data — Download 10 or more years of daily price history. Free sources like yfinance are fine for learning; survivorship-bias-free vendors like Norgate Data are the professional upgrade once you expand beyond a single index product.",
                    "Build simple features — Compute a small set of inputs the model will learn from: recent returns at several horizons, realized volatility, ATR, and one or two trend measures. Simple, decorrelated features generalize better than piles of indicators.",
                    "Label your history with the triple-barrier method — For each historical trade signal, ask which happened first: the profit target, the stop-loss, or a time limit. Set the target and stop as multiples of recent volatility (ATR) so they adapt to market conditions. These win/loss labels become the model's answer key.",
                    "Train a LightGBM trade filter (meta-labeling) — Train a LightGBM classifier to predict the probability that each new signal from your base strategy will hit its target before its stop. The AI does not invent trades; it grades the trades your strategy proposes, and only high-confidence trades get taken.",
                    "Validate honestly — Test the model only on data it has never seen, using walk-forward and purged cross-validation, and subtract realistic commissions and slippage. Re-run the test at double your cost estimate; a robust system should still make sense.",
                    "Paper trade the full pipeline — Run the whole system on live market data with simulated money for one to three months. Confirm real-time signals, fills, and behavior match what the backtest predicted before any real dollars are involved.",
                    "Go live small with TradingView alerts and PickMyTrade — Connect your strategy's TradingView alerts to PickMyTrade via webhook. PickMyTrade routes each signal to your connected broker account with take-profit and stop-loss brackets attached, executing the plan automatically and without emotion. Start with the smallest position size available."
                  ],
                  "proficiencyLevel": "Beginner",
                  "author": {
                    "@id": "https://pickmytrade.io/#organization"
                  },
                  "publisher": {
                    "@id": "https://pickmytrade.io/#organization"
                  }
                };

const faqKeys = Array.from({ length: 13 }, (_, i) => i + 1);
const schema4 = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqKeys.map((n) => ({
    "@type": "Question",
    "name": t(`ai_ml_trading_plan.faq_q${n}` as any),
    "acceptedAnswer": { "@type": "Answer", "text": t(`ai_ml_trading_plan.faq_a${n}` as any) }
  }))
};

const faqItems = faqKeys.map((n) => ({
  question: t(`ai_ml_trading_plan.faq_q${n}` as any),
  answer: t(`ai_ml_trading_plan.faq_a${n}` as any),
}));

const tocKeys = Array.from({ length: 12 }, (_, i) => i + 1);
const tocAnchors = [
  'what-is-ai-trading', 'professional-goal', 'architecture', 'build-plan', 'claude-fable',
  'build-vs-buy', 'pickmytrade', 'toolbox', 'mistakes', 'glossary', 'faq', 'full-disclaimer',
];
const tocIcons = [
  'fa-lightbulb', 'fa-bullseye', 'fa-diagram-project', 'fa-list-check', 'fa-robot',
  'fa-scale-balanced', 'fa-bolt', 'fa-toolbox', 'fa-triangle-exclamation', 'fa-book', 'fa-circle-question', 'fa-shield-halved',
];

const archBlocks = [1, 2, 3, 4, 5].map((n) => ({
  tag: t(`ai_ml_trading_plan.arch_block${n}_tag` as any),
  title: t(`ai_ml_trading_plan.arch_block${n}_title` as any),
  desc: t(`ai_ml_trading_plan.arch_block${n}_desc` as any),
}));
const archIcons = ['fa-chart-line', 'fa-brain', 'fa-cloud-bolt', 'fa-scale-balanced', 'fa-bolt'];

const steps = Array.from({ length: 8 }, (_, i) => i + 1).map((n) => ({
  title: t(`ai_ml_trading_plan.step${n}_title` as any),
  desc: t(`ai_ml_trading_plan.step${n}_desc` as any),
}));

const prompts = [1, 2, 3, 4, 5, 6].map((n) => ({
  label: t(`ai_ml_trading_plan.prompt${n}_label` as any),
  text: t(`ai_ml_trading_plan.prompt${n}_text` as any),
}));

const bvbCards = [1, 2, 3, 4].map((n) => ({
  title: t(`ai_ml_trading_plan.bvb_card${n}_title` as any),
  desc: t(`ai_ml_trading_plan.bvb_card${n}_desc` as any),
}));

const tools = [
  { name: 'LightGBM', key: 'lightgbm' }, { name: 'scikit-learn', key: 'sklearn' },
  { name: 'pandas', key: 'pandas' }, { name: 'mlfinpy', key: 'mlfinpy' },
  { name: 'skfolio', key: 'skfolio' }, { name: 'hmmlearn', key: 'hmmlearn' },
  { name: 'vectorbt', key: 'vectorbt' }, { name: 'NautilusTrader', key: 'nautilus' },
  { name: 'MLflow', key: 'mlflow' }, { name: 'FinBERT', key: 'finbert' },
  { name: 'Chronos / TimesFM', key: 'chronos' }, { name: 'yfinance', key: 'yfinance' },
  { name: 'Norgate Data', key: 'norgate' },
].map((tool) => ({
  name: tool.name,
  cat: t(`ai_ml_trading_plan.tool_${tool.key}_cat` as any),
  desc: t(`ai_ml_trading_plan.tool_${tool.key}_desc` as any),
}));

const mistakes = [1, 2, 3, 4, 5, 6].map((n) => ({
  title: t(`ai_ml_trading_plan.mistake${n}_title` as any),
  desc: t(`ai_ml_trading_plan.mistake${n}_desc` as any),
}));

const glossary = Array.from({ length: 22 }, (_, i) => i + 1).map((n) => ({
  term: t(`ai_ml_trading_plan.g${n}_term` as any),
  def: t(`ai_ml_trading_plan.g${n}_def` as any),
}));

const discParas = [1, 2, 3, 4, 5, 6].map((n) => ({
  strong: t(`ai_ml_trading_plan.disc_p${n}_strong` as any),
  text: t(`ai_ml_trading_plan.disc_p${n}_text` as any),
}));

const pmtFlow = [1, 2, 3, 4].map((n) => ({
  strong: t(`ai_ml_trading_plan.pmt_flow_step${n}_strong` as any),
  text: t(`ai_ml_trading_plan.pmt_flow_step${n}_text` as any),
}));
const pmtSupports = [1, 2, 3, 4, 5].map((n) => ({
  label: t(`ai_ml_trading_plan.pmt_supports_li${n}_label` as any),
  text: t(`ai_ml_trading_plan.pmt_supports_li${n}_text` as any),
}));
const pmtWhy = [1, 2, 3].map((n) => ({
  label: t(`ai_ml_trading_plan.pmt_why_li${n}_label` as any),
  text: t(`ai_ml_trading_plan.pmt_why_li${n}_text` as any),
}));
const fableLis = [1, 2, 3, 4, 5].map((n) => ({
  label: t(`ai_ml_trading_plan.fable_li${n}_label` as any),
  text: t(`ai_ml_trading_plan.fable_li${n}_text` as any),
}));
const whatisTerms = [1, 2, 3].map((n) => ({
  label: t(`ai_ml_trading_plan.whatis_term${n}_label` as any),
  text: t(`ai_ml_trading_plan.whatis_term${n}_text` as any),
}));
const goalScores = [1, 2].map((n) => ({
  label: t(`ai_ml_trading_plan.goal_score${n}_label` as any),
  text: t(`ai_ml_trading_plan.goal_score${n}_text` as any),
}));
---
<BaseLayout
  locale={locale}
  title={t('ai_ml_trading_plan.page_title')}
  description={t('ai_ml_trading_plan.page_description')}
  keywords={t('ai_ml_trading_plan.page_keywords')}
  ogImage={OG_IMAGE}
  structuredData={[schema1, schema2, schema3, schema4]}
>
  <ReadingMotion />
  <!-- Top disclaimer banner -->
  <div class="bg-[#001429] pt-20 text-center px-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-b border-blue-500/20 pb-3">
      <p class="text-xs sm:text-sm text-gray-400">
        <strong class="text-white">{t('ai_ml_trading_plan.top_banner_strong')}</strong>
        {t('ai_ml_trading_plan.top_banner_text')}
      </p>
    </div>
  </div>

  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="bg-[#001429] pt-3 pb-3 sm:pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center flex-wrap gap-2 text-xs sm:text-sm text-gray-400" itemscope
        itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={localizedPath(locale, '')} class="hover:text-[#2B77EE] transition" itemprop="item">
            <span itemprop="name">{t('ai_ml_trading_plan.breadcrumb_home')}</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="text-gray-600">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="text-white font-semibold" itemprop="name">{t('ai_ml_trading_plan.breadcrumb_current')}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative pt-16 pb-24 overflow-hidden bg-[#001429]">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-gradient-to-br from-blue-600/10 via-transparent to-orange-600/10"></div>
      <div class="absolute top-0 left-[12%] w-96 h-96 bg-orange-500/10 rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute bottom-0 right-[8%] w-96 h-96 bg-blue-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
      <div class="absolute inset-0 opacity-[0.02]" style="background-image: linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px); background-size: 50px 50px;"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl" data-aos="fade-up">
        <span class="inline-block bg-zinc-800 border border-blue-500/40 rounded-full px-5 py-2 mb-6 text-xs sm:text-sm font-bold tracking-wide uppercase text-zinc-300 electrolize-regular">
          {t('ai_ml_trading_plan.hero_eyebrow')}
        </span>
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold leading-tight tracking-tight mb-6">
          <span class="text-white">{t('ai_ml_trading_plan.hero_title_1')} </span>
          <span class="text-[#2B77EE]">{t('ai_ml_trading_plan.hero_title_grad')}</span>
          <span class="text-white">, {t('ai_ml_trading_plan.hero_title_2')}</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl">
          {t('ai_ml_trading_plan.hero_subhead')}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 mb-8">
          <a href="https://app.pickmytrade.io/?register=true" class="px-8 py-4 text-lg rounded-xl shadow-lg transition hover:shadow-[0_0_20px_4px_rgba(51,102,255,0.4)] hover:scale-105 electrolize-regular bg-[#0F3EC3] text-white text-center inline-flex items-center justify-center gap-2">
            {t('ai_ml_trading_plan.cta_trial')}
            <i class="fa-solid fa-arrow-right"></i>
          </a>
          <a href="https://docs.pickmytrade.io/docs/" class="px-8 py-4 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-lg transition-all duration-300 electrolize-regular text-white text-center">
            {t('ai_ml_trading_plan.cta_docs')}
          </a>
        </div>

        <div class="flex flex-wrap gap-3 sm:gap-4 mb-10 text-sm">
          <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-check-circle text-green-400" aria-hidden="true"></i>
            <span class="text-gray-300 electrolize-regular">{t('ai_ml_trading_plan.hero_badge_trial')}</span>
          </div>
          <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-credit-card text-blue-400" aria-hidden="true"></i>
            <span class="text-gray-300 electrolize-regular">{t('ai_ml_trading_plan.hero_badge_nocard')}</span>
          </div>
          <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-infinity text-purple-400" aria-hidden="true"></i>
            <span class="text-gray-300 electrolize-regular">{t('ai_ml_trading_plan.hero_badge_unlimited')}</span>
          </div>
          <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-bolt text-yellow-400" aria-hidden="true"></i>
            <span class="text-gray-300 electrolize-regular">{t('ai_ml_trading_plan.hero_badge_instant')}</span>
          </div>
        </div>
      </div>

      <aside class="bg-gradient-to-br from-gray-800/60 to-gray-900/60 backdrop-blur-sm border border-gray-700/50 border-l-4 border-l-orange-500 rounded-2xl p-6 sm:p-8 max-w-4xl" aria-label="Quick answer" data-aos="fade-up" data-aos-delay="100">
        <h2 class="text-sm font-bold uppercase tracking-wider text-blue-400 mb-3 flex items-center gap-2"><i class="fa-solid fa-bolt"></i>{t('ai_ml_trading_plan.hero_answer_title')}</h2>
        <p class="text-gray-300 mb-3 leading-relaxed">{t('ai_ml_trading_plan.hero_answer_p1')}</p>
        <p class="text-gray-300 leading-relaxed">{t('ai_ml_trading_plan.hero_answer_p2')}</p>
      </aside>
    </div>
  </section>

  <!-- TOC -->
  <section class="py-16 bg-gradient-to-b from-[#001429] to-[#00182f]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10" data-aos="fade-up">
        <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold border border-blue-500/30 electrolize-regular mb-4">{t('ai_ml_trading_plan.toc_title')}</span>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3" data-aos="fade-up">
        {tocKeys.map((n, i) => (
          <a href={`#${tocAnchors[i]}`} class="group flex items-center gap-3 bg-gradient-to-br from-gray-800/50 to-gray-900/50 border border-gray-700/50 hover:border-blue-500/50 rounded-xl px-4 py-3 transition-all duration-300 hover:-translate-y-1">
            <span class="w-9 h-9 flex-shrink-0 rounded-lg bg-gradient-to-br from-blue-500/20 to-blue-600/20 flex items-center justify-center text-blue-400 group-hover:scale-110 transition-transform">
              <i class={`fa-solid ${tocIcons[i]}`}></i>
            </span>
            <span class="text-sm text-gray-300 group-hover:text-blue-400 transition-colors">{t(`ai_ml_trading_plan.toc_${n}` as any)}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- What is AI/ML trading -->
  <section id="what-is-ai-trading" class="relative py-20 scroll-mt-28 bg-[#001429] overflow-hidden">
    <div class="absolute top-1/3 -left-20 w-96 h-96 bg-blue-500/5 rounded-full blur-3xl"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto mb-12" data-aos="fade-up">
        <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold border border-blue-500/30 electrolize-regular mb-4">01</span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white tracking-tight mb-5">{t('ai_ml_trading_plan.whatis_title')}</h2>
        <p class="text-lg text-gray-300 leading-relaxed">{t('ai_ml_trading_plan.whatis_lede')}</p>
      </div>

      <div class="max-w-3xl mx-auto space-y-4 mb-10" data-aos="fade-up">
        <p class="text-gray-300 leading-relaxed">{t('ai_ml_trading_plan.whatis_p1')}</p>
        <p class="text-gray-300 leading-relaxed">{t('ai_ml_trading_plan.whatis_p2')}</p>
        <p class="text-gray-300 leading-relaxed">{t('ai_ml_trading_plan.whatis_terms_intro')}</p>
      </div>

      <div class="grid md:grid-cols-3 gap-5 mb-10">
        {whatisTerms.map((term) => (
          <article class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 border border-gray-700/50 hover:border-blue-500/50 rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1" data-aos="zoom-in">
            <div class="w-12 h-12 mb-4 bg-gradient-to-br from-blue-500/20 to-blue-600/20 rounded-xl flex items-center justify-center text-blue-400 group-hover:scale-110 transition-transform"><i class="fa-solid fa-angle-right"></i></div>
            <h3 class="font-bold text-white mb-2">{term.label}</h3>
            <p class="text-sm text-gray-300 leading-relaxed">{term.text}</p>
          </article>
        ))}
      </div>

      <div class="max-w-4xl mx-auto bg-blue-500/10 border border-blue-500/30 rounded-2xl p-6 sm:p-7 flex gap-4" data-aos="fade-up">
        <div class="w-11 h-11 flex-shrink-0 rounded-xl bg-blue-500/20 flex items-center justify-center text-blue-400"><i class="fa-solid fa-circle-info text-lg"></i></div>
        <div>
          <span class="block font-bold text-blue-400 mb-1">{t('ai_ml_trading_plan.whatis_callout_title')}</span>
          <p class="text-gray-300">{t('ai_ml_trading_plan.whatis_callout_p')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Professional goal -->
  <section id="professional-goal" class="py-20 scroll-mt-28 bg-gradient-to-b from-[#00182f] to-[#001429]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12" data-aos="fade-up">
        <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold border border-blue-500/30 electrolize-regular mb-4">02</span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white tracking-tight mb-5">{t('ai_ml_trading_plan.goal_title')}</h2>
        <p class="text-lg text-gray-300 leading-relaxed">{t('ai_ml_trading_plan.goal_lede')}</p>
      </div>

      <div class="max-w-3xl mx-auto mb-8" data-aos="fade-up">
        <p class="text-gray-300 leading-relaxed">{t('ai_ml_trading_plan.goal_p1')}</p>
      </div>

      <figure class="max-w-5xl mx-auto mb-10" data-aos="zoom-in">
        <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 border border-gray-700/50 rounded-2xl p-4 sm:p-6 overflow-x-auto">
          <svg viewBox="0 0 720 320" role="img" aria-label={t('ai_ml_trading_plan.goal_fig_alt')} class="w-full h-auto">
            <g stroke="rgba(255,255,255,0.08)" stroke-width="1">
              <line x1="52" y1="60" x2="700" y2="60"/>
              <line x1="52" y1="120" x2="700" y2="120"/>
              <line x1="52" y1="180" x2="700" y2="180"/>
              <line x1="52" y1="240" x2="700" y2="240"/>
            </g>
            <line x1="52" y1="20" x2="52" y2="272" stroke="rgba(255,255,255,0.25)" stroke-width="1.5"/>
            <line x1="52" y1="272" x2="700" y2="272" stroke="rgba(255,255,255,0.25)" stroke-width="1.5"/>
