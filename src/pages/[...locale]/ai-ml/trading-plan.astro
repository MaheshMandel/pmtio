          <ul class="space-y-3">
            {pmtWhy.map((li) => (
              <li class="flex items-start gap-2 text-gray-300"><i class="fa-solid fa-check text-blue-400 mt-1.5"></i><span><strong class="text-white">{li.label}</strong> {li.text}</span></li>
            ))}
          </ul>
        </div>
      </div>

      <div class="max-w-4xl mx-auto bg-blue-500/10 border border-blue-500/30 rounded-2xl p-6 sm:p-7 flex gap-4" data-aos="fade-up">
        <div class="w-11 h-11 flex-shrink-0 rounded-xl bg-blue-500/20 flex items-center justify-center text-blue-400"><i class="fa-solid fa-circle-info text-lg"></i></div>
        <div>
          <span class="block font-bold text-blue-400 mb-1">{t('ai_ml_trading_plan.pmt_callout_title')}</span>
          <p class="text-gray-300">{t('ai_ml_trading_plan.pmt_callout_p')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Toolbox -->
  <section id="toolbox" class="py-20 scroll-mt-28 bg-[#001429]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12" data-aos="fade-up">
        <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold border border-blue-500/30 electrolize-regular mb-4">08</span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white tracking-tight mb-5">{t('ai_ml_trading_plan.toolbox_title')}</h2>
        <p class="text-lg text-gray-300 leading-relaxed">{t('ai_ml_trading_plan.toolbox_lede')}</p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-gray-700/50 bg-gradient-to-br from-gray-800/50 to-gray-900/50" data-aos="fade-up">
        <table class="w-full min-w-[640px] text-sm border-collapse">
          <thead>
            <tr class="bg-blue-500/10 text-blue-300">
              <th class="text-left font-semibold px-5 py-3.5 whitespace-nowrap">{t('ai_ml_trading_plan.toolbox_th_tool')}</th>
              <th class="text-left font-semibold px-5 py-3.5 whitespace-nowrap">{t('ai_ml_trading_plan.toolbox_th_category')}</th>
              <th class="text-left font-semibold px-5 py-3.5">{t('ai_ml_trading_plan.toolbox_th_desc')}</th>
            </tr>
          </thead>
          <tbody>
            {tools.map((tool) => (
              <tr class="border-t border-gray-700/50 hover:bg-white/[0.02] transition-colors">
                <td class="px-5 py-3.5 font-semibold text-white whitespace-nowrap">{tool.name}</td>
                <td class="px-5 py-3.5 text-gray-400 whitespace-nowrap">{tool.cat}</td>
                <td class="px-5 py-3.5 text-gray-300">{tool.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Mistakes -->
  <section id="mistakes" class="py-20 scroll-mt-28 bg-gradient-to-b from-[#001429] to-[#00182f]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12" data-aos="fade-up">
        <span class="inline-block px-4 py-2 bg-orange-600/20 text-orange-400 rounded-full text-sm font-semibold border border-orange-500/30 electrolize-regular mb-4">09</span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white tracking-tight mb-5">{t('ai_ml_trading_plan.mistakes_title')}</h2>
        <p class="text-lg text-gray-300 leading-relaxed">{t('ai_ml_trading_plan.mistakes_lede')}</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {mistakes.map((mistake) => (
          <article class="group bg-gradient-to-br from-gray-800/50 to-gray-900/50 border border-gray-700/50 border-l-4 border-l-orange-500 rounded-2xl p-6 hover:border-orange-500/50 transition-all duration-300 hover:-translate-y-1" data-aos="fade-up">
            <div class="w-11 h-11 mb-3 rounded-xl bg-orange-500/15 flex items-center justify-center text-orange-400"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <h3 class="text-base font-bold text-orange-400 mb-2">{mistake.title}</h3>
            <p class="text-sm text-gray-300 leading-relaxed">{mistake.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Glossary -->
  <section id="glossary" class="py-20 scroll-mt-28 bg-[#001429]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12" data-aos="fade-up">
        <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold border border-blue-500/30 electrolize-regular mb-4">10</span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white tracking-tight">{t('ai_ml_trading_plan.glossary_title')}</h2>
      </div>
      <dl class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {glossary.map((item) => (
          <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 border border-gray-700/50 hover:border-blue-500/40 rounded-xl p-5 transition-colors" data-aos="fade-up">
            <dt class="font-bold text-blue-400 mb-1">{item.term}</dt>
            <dd class="text-sm text-gray-300 leading-relaxed">{item.def}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-20 scroll-mt-28 bg-gradient-to-b from-[#001429] to-[#00182f]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12" data-aos="fade-up">
        <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold border border-blue-500/30 electrolize-regular mb-4">11</span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white tracking-tight">{t('ai_ml_trading_plan.faq_title')}</h2>
      </div>
      <div data-aos="fade-up">
        <FaqAccordion items={faqItems} />
      </div>
    </div>
  </section>

  <!-- Full disclaimer + go deeper -->
  <section id="full-disclaimer" class="py-16 scroll-mt-28 bg-[#001429]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 border border-gray-700/50 border-t-4 border-t-gray-500 rounded-2xl p-6 sm:p-8 mb-8" data-aos="fade-up">
        <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2"><i class="fa-solid fa-shield-halved text-gray-400"></i>{t('ai_ml_trading_plan.disclaimer_title')}</h2>
        {discParas.map((para) => (
          <p class="text-sm text-gray-400 leading-relaxed mb-3"><strong class="text-gray-200">{para.strong}</strong> {para.text}</p>
        ))}
      </div>

      <div class="bg-blue-500/10 border border-blue-500/30 rounded-2xl p-6 sm:p-7 flex gap-4" data-aos="fade-up">
        <div class="w-11 h-11 flex-shrink-0 rounded-xl bg-blue-500/20 flex items-center justify-center text-blue-400"><i class="fa-solid fa-arrow-trend-up text-lg"></i></div>
        <div>
          <span class="block font-bold text-blue-400 mb-1">{t('ai_ml_trading_plan.deeper_title')}</span>
          <p class="text-gray-300">
            {t('ai_ml_trading_plan.deeper_text')}
            <a href={localizedPath(locale, 'ai-ml/advanced-guide')} class="text-blue-400 hover:underline font-semibold">{t('ai_ml_trading_plan.deeper_link')}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-20 bg-gradient-to-b from-[#00182f] to-[#002040]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-aos="fade-up">
      <div class="relative bg-gradient-to-br from-blue-600/20 to-purple-600/20 border-2 border-blue-500/40 rounded-3xl p-10 sm:p-14 overflow-hidden">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-72 h-72 bg-blue-500/10 rounded-full blur-3xl"></div>
        <div class="relative z-10">
          <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">{t('ai_ml_trading_plan.cta_title')}</h2>
          <p class="text-lg text-gray-300 mb-8 max-w-2xl mx-auto">{t('ai_ml_trading_plan.cta_subtitle')}</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a href="https://app.pickmytrade.io/?register=true" class="px-10 py-4 text-lg rounded-xl shadow-lg transition hover:shadow-[0_0_20px_4px_rgba(51,102,255,0.4)] hover:scale-105 electrolize-regular bg-[#0F3EC3] text-white inline-flex items-center gap-2">{t('ai_ml_trading_plan.cta_trial')}<i class="fa-solid fa-arrow-right"></i></a>
            <a href="https://docs.pickmytrade.io/docs/" class="px-10 py-4 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-lg transition-all duration-300 electrolize-regular text-white">{t('ai_ml_trading_plan.cta_docs')}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.copy-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var pre = btn.closest('.rounded-xl') ? btn.closest('.rounded-xl').querySelector('pre') : null;
          if (!pre) return;
          var text = pre.innerText;
          var original = btn.textContent;
          function done() { btn.textContent = 'Copied!'; setTimeout(function () { btn.textContent = original; }, 1600); }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done).catch(function () {});
          }
        });
      });
    });
  </script>
</BaseLayout>
