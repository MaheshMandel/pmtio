] as const;

export function getStaticPaths() {
  const BROKER_SLUGS = [
    'ctrader-faq', 'ib-faq', 'ironbeam-faq',
    'matchtrader-faq', 'projectx-faq', 'rithmic-faq', 'tradelocker-faq',
    'tradestation-faq', 'tradier-faq',
  ];
  return getLocalePaths().flatMap(({ params, props }) =>
    BROKER_SLUGS.map((slug) => ({
      params: { locale: params.locale, slug },
      props: { locale: props.locale, slug },
    }))
  );
}

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const faq = brokerFaqs.find((f) => f.slug === slug)!;
const t = useTranslations(locale);
// Per-broker translatable copy lives under broker_faq_detail.brokers.<slug>.*
const bk = (field: string) => t(`broker_faq_detail.brokers.${faq.slug}.${field}` as TranslationKey);

const pageUrl = absoluteLocalizedPath(locale, `broker-faq/${faq.slug}`);

// Build FAQPage schema from the exact Q&A rendered for this broker.
// Sections render in this fixed order; `propfirm` only when present in this broker's TOC.
const FAQ_SECTIONS = ['automation', 'account', 'fees', 'features', 'funding', 'security', 'propfirm', 'troubleshooting', 'comparisons'];
const hasPropfirm = faq.tocSections.some((s) => s.id === 'propfirm');
const bfd = enDict.broker_faq_detail as unknown as Record<string, string>;
const qCount = (id: string) => { let n = 0; while (bfd[`${id}_q${n + 1}`] !== undefined) n++; return n; };

// Derive the table of contents from the sections this page actually renders,
// rather than a hand-maintained per-broker list. That list had drifted: the
// TradingView entry linked to #pinescript, #alerts and #brokers (no such
// sections exist — three dead anchors) while omitting the funding and security
// sections that do render, and every broker's hand-written `count` overstated
// the real number of answers (e.g. "21 answers" on a section holding 10).
const tocSections = FAQ_SECTIONS
  .filter((id) => id !== 'propfirm' || hasPropfirm)
  .map((id) => ({ id, count: String(qCount(id)) }));

// Real number of answers on a related broker's page. The hardcoded values these
// replace ("68", "70", "72", "300") were several times the number of Q&As the
// template actually renders.
function relatedAnswerCount(slug: string): number {
  const related = brokerFaqs.find((f) => f.slug === slug);
  const withPropfirm = related?.tocSections.some((s) => s.id === 'propfirm') ?? false;
  return FAQ_SECTIONS
    .filter((id) => id !== 'propfirm' || withPropfirm)
    .reduce((total, id) => total + qCount(id), 0);
}

// The schema builder must pass the SAME interpolation params as the visible
// render, or a template token ships un-resolved into machine-readable JSON-LD.
// `tagline` is used by features_a3 and was previously omitted here, which left a
// literal "{tagline}" in the Answer text.
const faqParams = { name: faq.name, tagline: bk('tagline') };

// comparisons_a5 is rendered visibly as three fragments wrapped around an inline
// link (_pre / _link / _post). There is no flat `comparisons_a5` key, so asking
// for one made t() fall through to returning the key itself — publishing the
// literal string "broker_faq_detail.comparisons_a5" as a FAQ answer.
const answerText = (id: string, n: number): string => {
  if (id === 'comparisons' && n === 5) {
    return [
      t('broker_faq_detail.comparisons_a5_pre', faqParams),
      t('broker_faq_detail.comparisons_a5_link', faqParams),
      t('broker_faq_detail.comparisons_a5_post', faqParams),
    ].join(' ').replace(/\s+/g, ' ').replace(/\s+([.,])/g, '$1').trim();
  }
  return t(`broker_faq_detail.${id}_a${n}` as TranslationKey, faqParams);
};

const faqEntities = FAQ_SECTIONS.filter((id) => id !== 'propfirm' || hasPropfirm).flatMap((id) =>
  Array.from({ length: qCount(id) }, (_, i) => ({
    '@type': 'Question',
    name: t(`broker_faq_detail.${id}_q${i + 1}` as TranslationKey, faqParams),
    acceptedAnswer: {
      '@type': 'Answer',
      text: answerText(id, i + 1),
    },
  })),
);

// Fail the build rather than publish a broken placeholder again: no Q&A may
// contain an unresolved {token} or a leaked i18n key path.
for (const entity of faqEntities) {
  for (const field of [entity.name, entity.acceptedAnswer.text]) {
    if (/\{[a-zA-Z_]\w*\}/.test(field) || /\bbroker_faq_detail\.[a-z_]/.test(field)) {
      throw new Error(
        `[broker-faq/${faq.slug}] unresolved placeholder in FAQ schema: ${JSON.stringify(field)}`,
      );
    }
  }
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  url: pageUrl,
  inLanguage: LOCALE_BCP47[locale],
  name: bk('meta_title'),
  mainEntity: faqEntities,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('broker_faq_hub.breadcrumb_home'), item: absoluteLocalizedPath(locale) },
    { '@type': 'ListItem', position: 2, name: t('broker_faq_hub.breadcrumb_current'), item: absoluteLocalizedPath(locale, 'broker-faq') },
    { '@type': 'ListItem', position: 3, name: faq.name, item: pageUrl },
  ],
};

const structuredData = [faqSchema, breadcrumbSchema];
