            <span class="ml-auto bg-[#D4EBFE] text-[#082072] text-sm font-bold px-3 py-1 rounded-full">{tocSections.find(s => s.id === 'automation')?.count ?? ''} {t('broker_faq_detail.section_answers_suffix')}</span>
          </div>
