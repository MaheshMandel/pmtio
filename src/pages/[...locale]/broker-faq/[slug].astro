            {t('broker_faq_detail.hero_cta_browse')} <i class="fa-solid fa-chevron-down ml-2"></i>
          </a>
        </div>
      </div>
    </section>

    <!-- Search Bar -->
    <section id="search-section" class="bg-[#001a33] py-10 px-4 border-y border-white/5">
