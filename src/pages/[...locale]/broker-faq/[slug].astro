<style>
  body { font-family: ui-sans-serif, system-ui, sans-serif; background:#001429; color:#fff; }
  .electrolize { font-family: 'Electrolize', sans-serif; }
  details[open] .fa-chevron-down { transform: rotate(180deg); }
  .fa-chevron-down { transition: transform .2s ease; }
  .badge-pill { background:#D4EBFE; color:#082072; font-weight:700; }
  .cta-btn { background:linear-gradient(90deg,#0F3EC3,#2B77EE); transition: box-shadow .3s; }
  .cta-btn:hover { box-shadow: 0 0 30px 5px rgba(43,119,238,0.5); }
  html { scroll-behavior: smooth; scroll-padding-top: 90px; }
</style>
  </Fragment>

<main id="main-content" role="main">
