---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalePaths, localizedPath, absoluteLocalizedPath, useTranslations } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';

export const getStaticPaths = getLocalePaths;
const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const canonical = absoluteLocalizedPath(locale, 'broker-faq');

// Built from the actual set of broker-faq pages. The previous inline JSON-LD
// hardcoded English URLs (so /de, /es, /fr and /it pointed at the English
// children) and declared numberOfItems: 12 while listing 10.
const FAQ_PAGES = [
  { slug: 'rithmic-faq', name: 'Rithmic FAQ' },
  { slug: 'ib-faq', name: 'Interactive Brokers FAQ' },
  { slug: 'ironbeam-faq', name: 'Ironbeam FAQ' },
  { slug: 'tradestation-faq', name: 'TradeStation FAQ' },
  { slug: 'tradelocker-faq', name: 'TradeLocker FAQ' },
  { slug: 'projectx-faq', name: 'ProjectX FAQ' },
  { slug: 'ctrader-faq', name: 'cTrader FAQ' },
  { slug: 'matchtrader-faq', name: 'Match-Trader FAQ' },
  { slug: 'tradier-faq', name: 'Tradier FAQ' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('broker_faq_hub.breadcrumb_home'), item: absoluteLocalizedPath(locale) },
    { '@type': 'ListItem', position: 2, name: t('broker_faq_hub.breadcrumb_current'), item: canonical },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Broker & Platform FAQ Pages',
  description: 'Per-broker FAQ pages covering TradingView automation, API access, account setup, fees, and execution.',
  numberOfItems: FAQ_PAGES.length,
  itemListOrder: 'https://schema.org/ItemListUnordered',
  itemListElement: FAQ_PAGES.map((page, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: page.name,
    url: absoluteLocalizedPath(locale, `broker-faq/${page.slug}`),
  })),
};
---

<BaseLayout
  locale={locale}
  title={t('broker_faq_hub.meta_title')}
  description={t('broker_faq_hub.meta_description')}
  canonical={canonical}
  keywords=""
  structuredData={[itemListSchema, breadcrumbSchema]}
>
  <Fragment slot="head">
<style>
  body { font-family: ui-sans-serif, system-ui, sans-serif; background:#001429; color:#fff; }
  .electrolize { font-family: 'Electrolize', sans-serif; }
</style>
  </Fragment>

<main id="main-content" role="main">

    <!-- Hero -->
    <section class="bg-gradient-to-b from-[#001429] via-[#001f3f] to-[#002040] pt-28 pb-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <nav aria-label="Breadcrumb" class="flex justify-center mb-6">
          <ol class="flex items-center space-x-2 text-sm text-gray-400">
            <li><a href={localizedPath(locale)} class="hover:text-[#2B77EE] transition-colors">{t('broker_faq_hub.breadcrumb_home')}</a></li>
            <li><i class="fa-solid fa-chevron-right text-xs text-gray-600"></i></li>
            <li class="text-[#2B77EE]">{t('broker_faq_hub.breadcrumb_current')}</li>
          </ol>
        </nav>
        <h1 class="text-3xl md:text-5xl font-bold mb-6 leading-tight">
          {t('broker_faq_hub.hero_title_pre')} <span class="bg-gradient-to-r from-[#2B77EE] to-blue-400 bg-clip-text text-transparent">{t('broker_faq_hub.hero_title_highlight')}</span>{t('broker_faq_hub.hero_title_post')}
        </h1>
        <p class="text-gray-400 text-lg md:text-xl max-w-3xl mx-auto mb-8">
          {t('broker_faq_hub.hero_subtitle')}
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="https://app.pickmytrade.io/?register=true" class="px-8 py-3 bg-[#2B77EE] hover:bg-blue-600 text-white font-semibold rounded-xl transition-all duration-300 shadow-lg shadow-blue-500/25">
            {t('broker_faq_hub.cta_start_trial')} <i class="fa-solid fa-arrow-right ml-2"></i>
          </a>
          <a href="#browse" class="px-8 py-3 border border-white/20 hover:border-[#2B77EE]/50 text-white font-semibold rounded-xl transition-all duration-300 hover:bg-white/5">
            {t('broker_faq_hub.hero_browse_brokers')} <i class="fa-solid fa-chevron-down ml-2"></i>
          </a>
        </div>
      </div>
    </section>

    <!-- Browse Brokers -->
    <section id="browse" class="bg-[#001429] py-16 px-4">
      <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <span class="inline-block px-4 py-1.5 rounded-full bg-[#2B77EE]/10 border border-[#2B77EE]/30 text-[#2B77EE] text-xs font-semibold uppercase tracking-wider mb-4">
          <i class="fa-solid fa-arrow-down mr-1.5" aria-hidden="true"></i> {t('broker_faq_hub.browse_badge')}
        </span>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">{t('broker_faq_hub.browse_title')}</h2>
        <p class="text-gray-400 max-w-2xl mx-auto">{t('broker_faq_hub.browse_subtitle')}</p>
      </div>
      <div class="mb-12">
        <h2 class="text-2xl md:text-3xl font-bold mb-6 pb-3 border-b-2 border-[#2B77EE] flex items-center gap-3">
          <i class="fa-solid fa-chart-simple text-[#2B77EE]" aria-hidden="true"></i>{t('broker_faq_hub.cat_charting_title')}
          <span class="ml-auto text-xs text-gray-500 font-normal">{t('broker_faq_hub.cat_charting_count')}</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {/* Points at the TradingView FAQ spoke, not a broker-faq page. TradingView
            is the signal source, not a destination broker, so the per-broker FAQ
            template did not apply to it (see the retired broker-faq/tradingview-faq). */}
        <a href={localizedPath(locale, 'faq/tradingview-webhooks')} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-chart-area" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate">TradingView</h3>
                <span class="text-gray-500 text-xs flex-shrink-0">22 Qs</span>
              </div>
              <p class="text-gray-400 text-sm mb-3">{t('broker_faq_hub.card_tradingview_desc')}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t('broker_faq_hub.card_read_faq')} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>
        </div>
      </div>

      <div class="mb-12">
        <h2 class="text-2xl md:text-3xl font-bold mb-6 pb-3 border-b-2 border-[#2B77EE] flex items-center gap-3">
          <i class="fa-solid fa-chart-line text-[#2B77EE]" aria-hidden="true"></i>{t('broker_faq_hub.cat_futures_title')}
          <span class="ml-auto text-xs text-gray-500 font-normal">{t('broker_faq_hub.cat_futures_count')}</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href={localizedPath(locale, 'broker-faq/projectx-faq')} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-square-poll-vertical" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate">ProjectX</h3>
                <span class="text-gray-500 text-xs flex-shrink-0">72 Qs</span>
              </div>
              <p class="text-gray-400 text-sm mb-3">{t('broker_faq_hub.card_projectx_desc')}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t('broker_faq_hub.card_read_faq')} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>
        <a href={localizedPath(locale, 'broker-faq/rithmic-faq')} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-chart-line" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate">Rithmic</h3>
                <span class="text-gray-500 text-xs flex-shrink-0">70 Qs</span>
              </div>
              <p class="text-gray-400 text-sm mb-3">{t('broker_faq_hub.card_rithmic_desc')}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t('broker_faq_hub.card_read_faq')} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>
        <a href={localizedPath(locale, 'broker-faq/tradestation-faq')} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-building-columns" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate">TradeStation</h3>
                <span class="text-gray-500 text-xs flex-shrink-0">68 Qs</span>
              </div>
              <p class="text-gray-400 text-sm mb-3">{t('broker_faq_hub.card_tradestation_desc')}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t('broker_faq_hub.card_read_faq')} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>
        <a href={localizedPath(locale, 'broker-faq/ib-faq')} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-globe" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate">Interactive Brokers</h3>
                <span class="text-gray-500 text-xs flex-shrink-0">160+ Qs</span>
              </div>
              <p class="text-gray-400 text-sm mb-3">{t('broker_faq_hub.card_ib_desc')}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t('broker_faq_hub.card_read_faq')} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>
        <a href="https://pickmytrade.trade/broker-faq/tradovate-faq/" target="_blank" rel="noopener noreferrer" class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-bolt" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate">Tradovate</h3>
                <i class="fa-solid fa-arrow-up-right-from-square text-gray-500 text-xs flex-shrink-0" aria-hidden="true" title="External link"></i>
              </div>
              <p class="text-gray-400 text-sm mb-3">{t('broker_faq_hub.card_tradovate_desc')}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t('broker_faq_hub.card_read_faq')} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>
        <a href={localizedPath(locale, 'broker-faq/ironbeam-faq')} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-chart-line" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate">Ironbeam</h3>
                <span class="text-gray-500 text-xs flex-shrink-0">54 Qs</span>
              </div>
              <p class="text-gray-400 text-sm mb-3">{t('broker_faq_hub.card_ironbeam_desc')}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t('broker_faq_hub.card_read_faq')} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>
        </div>
      </div>
      <div class="mb-12">
        <h2 class="text-2xl md:text-3xl font-bold mb-6 pb-3 border-b-2 border-[#2B77EE] flex items-center gap-3">
          <i class="fa-solid fa-layer-group text-[#2B77EE]" aria-hidden="true"></i>{t('broker_faq_hub.cat_multiasset_title')}
          <span class="ml-auto text-xs text-gray-500 font-normal">{t('broker_faq_hub.cat_multiasset_count')}</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href={localizedPath(locale, 'broker-faq/ctrader-faq')} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-arrow-trend-up" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate">cTrader</h3>
                <span class="text-gray-500 text-xs flex-shrink-0">70 Qs</span>
              </div>
              <p class="text-gray-400 text-sm mb-3">{t('broker_faq_hub.card_ctrader_desc')}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t('broker_faq_hub.card_read_faq')} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>
        <a href={localizedPath(locale, 'broker-faq/matchtrader-faq')} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-shuffle" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate">MatchTrader</h3>
                <span class="text-gray-500 text-xs flex-shrink-0">70 Qs</span>
              </div>
              <p class="text-gray-400 text-sm mb-3">{t('broker_faq_hub.card_matchtrader_desc')}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t('broker_faq_hub.card_read_faq')} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>
        <a href={localizedPath(locale, 'broker-faq/tradelocker-faq')} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-lock" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate">TradeLocker</h3>
                <span class="text-gray-500 text-xs flex-shrink-0">72 Qs</span>
              </div>
              <p class="text-gray-400 text-sm mb-3">{t('broker_faq_hub.card_tradelocker_desc')}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t('broker_faq_hub.card_read_faq')} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>
        <a href={localizedPath(locale, 'broker-faq/tradier-faq')} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
              <i class="fa-solid fa-dollar-sign" aria-hidden="true"></i>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate">Tradier</h3>
                <span class="text-gray-500 text-xs flex-shrink-0">68 Qs</span>
              </div>
              <p class="text-gray-400 text-sm mb-3">{t('broker_faq_hub.card_tradier_desc')}</p>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t('broker_faq_hub.card_read_faq')} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
            </div>
          </div>
        </a>
        <div class="flex flex-wrap justify-center gap-3 mt-8">
          <a href={localizedPath(locale, 'broker/tradingview-to-ctrader')} class="px-4 py-2 rounded-full bg-[#122B75]/40 border border-[#2B77EE]/40 text-sm text-gray-200 hover:text-white hover:border-[#2B77EE] transition">cTrader</a>
          <a href={localizedPath(locale, 'broker/tradingview-to-ironbeam')} class="px-4 py-2 rounded-full bg-[#122B75]/40 border border-[#2B77EE]/40 text-sm text-gray-200 hover:text-white hover:border-[#2B77EE] transition">Ironbeam</a>
        </div>
        </div>
      </div>
      </div>
    </section>
  </main>

<section class="bg-gradient-to-br from-[#0F3EC3] to-[#2B77EE] py-16 px-4">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-white electrolize mb-4">{t('broker_faq_hub.cta_title')}</h2>
    <p class="text-white/90 mb-8">{t('broker_faq_hub.cta_subtitle')}</p>
    <a href="https://pickmytrade.io/signup" class="bg-white text-[#0F3EC3] px-10 py-4 rounded-xl font-bold electrolize hover:shadow-[0_0_30px_5px_rgba(255,255,255,0.4)] transition-all">{t('broker_faq_hub.cta_start_trial')}</a>
  </div>
</section>

<section class="bg-[#000a15] py-10 px-4 border-t border-white/10">
  <div class="max-w-4xl mx-auto text-sm text-white/60 leading-relaxed space-y-3">
    <h2 class="text-lg font-bold text-white/80 electrolize mb-2">{t('broker_faq_hub.disclaimer_title')}</h2>
    <p>{t('broker_faq_hub.disclaimer_text')}</p>
  </div>
</section>
</BaseLayout>
