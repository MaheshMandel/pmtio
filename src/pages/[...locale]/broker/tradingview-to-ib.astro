---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalePaths, localizedPath, useTranslations, absoluteLocalizedPath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';
import AnswerBlock from '../../../components/AnswerBlock.astro';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);


const schema1 = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "image": "https://pickmytrade.io/assets/logo.png",
    "name": "PickMyTrade - TradingView to Interactive Brokers Automation",
    "alternateName": "IBKR Algo Trading Platform",
    "description": "Automated trading system for Interactive Brokers (IBKR) connecting TradingView alerts to IBKR brokerage accounts and TWS platform. Full support for IBKR API automation, interactive brokers algorithmic trading, IBKR paper trading, and live trading. Works with IBKR trading platform for stocks, options, futures, and forex across global markets.",
    "url": absoluteLocalizedPath(locale, 'broker/tradingview-to-ib'),
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web-based, Windows, Mac, Linux",
    "keywords": "automated trading system interactive brokers, interactive brokers auto trading, ibkr algo trading, ibkr api, ibkr api python, interactive brokers api, ibkr trading platform, ibkr paper trading, ibkr brokerage account",
    "offers": {
      "@type": "Offer",
      "price": "50.00",
      "priceCurrency": "USD",
      "priceValidUntil": "2026-12-31",
      "availability": "https://schema.org/InStock",
      "description": "7-day free trial, no credit card required"
    },
    "publisher": {
      "@type": "Organization",
      "name": "PickMyTrade",
      "url": "https://pickmytrade.io",
      "logo": {
        "@type": "ImageObject",
        "url": "https://pickmytrade.io/assets/logo.png"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "support@pickmytrade.com",
        "contactType": "Customer Support",
        "availableLanguage": "English"
      },
    "sameAs": [
      "https://x.com/pickmytrade",
      "https://discord.gg/FkJ7g7498S",
      "https://www.instagram.com/pickmytrade",
      "https://www.youtube.com/@PickMyTrade",
      "https://www.linkedin.com/company/pickmytrade",
      "https://sourceforge.net/software/product/PickMyTrade/",
      "https://www.trustpilot.com/review/pickmytrade.trade",
      "https://blog.pickmytrade.io",
      "https://docs.pickmytrade.io"
    ]
  },
    "featureList": [
      "TradingView Alert Integration",
      "Interactive Brokers TWS Integration",
      "IBKR API Connectivity",
      "Automated Order Execution for IBKR",
      "IBKR Algo Trading Support",
      "Interactive Brokers API Python Integration",
      "IBKR Paper Trading and Live Trading",
      "Stocks Options Futures Forex on IBKR Platform",
      "Multi IBKR Account Management",
      "Interactive Brokers Auto Trading System",
      "Risk Management Tools",
      "Stop Loss & Take Profit Automation",
      "No Coding Required - Alternative to IBKR API Python"
    ]
  };
const schema2 = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1","h2",".faq-question",".faq-answer","summary","details > div","details > p"] },
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can you automate TradingView alerts to Interactive Brokers?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. PickMyTrade connects TradingView to Interactive Brokers, so when your TradingView alert fires, PickMyTrade places the matching order on your IBKR account through TWS or IB Gateway. There is no coding involved. You paste a PickMyTrade webhook URL and alert message into a TradingView alert, and PickMyTrade handles execution on IBKR for stocks, options and futures." }
      },
      {
        "@type": "Question",
        "name": "How do I connect TradingView to Interactive Brokers without coding?",
        "acceptedAnswer": { "@type": "Answer", "text": "Install and log in to TWS or IB Gateway, turn on API access in the settings, then connect that account inside PickMyTrade. Generate your webhook URL and alert message in PickMyTrade and paste them into a TradingView alert. When the alert triggers, PickMyTrade routes the order to IBKR. You never touch the IB API directly and you do not write any code." }
      },
      {
        "@type": "Question",
        "name": "What can I trade on IBKR through PickMyTrade (stocks, options, futures)?",
        "acceptedAnswer": { "@type": "Answer", "text": "You can trade the main IBKR asset classes: stocks and ETFs, options, and futures, across the exchanges your IBKR account is permitted to access. Because Interactive Brokers is a global multi-asset broker, this covers far more than futures alone, which is the main reason traders pick IBKR for automation. It works on both paper and live accounts." }
      },
      {
        "@type": "Question",
        "name": "Does PickMyTrade store my Interactive Brokers login or API credentials?",
        "acceptedAnswer": { "@type": "Answer", "text": "No. PickMyTrade connects through the Interactive Brokers API using TWS or IB Gateway, which you log in to yourself. Your IBKR username and password stay with Interactive Brokers, and you authorize the API connection inside your own TWS or Gateway. PickMyTrade sends orders over that authorized connection rather than storing your broker login." }
      },
      {
        "@type": "Question",
        "name": "How fast are orders executed and is this suitable for scalping?",
        "acceptedAnswer": { "@type": "Answer", "text": "PickMyTrade processes your order in under 200ms on our side. Total time from chart to fill also depends on TradingView's webhook delivery, the round trip to IBKR through TWS or IB Gateway, and IBKR's own routing. This suits swing and intraday strategies well. It is not designed for sub-minute high-frequency scalping where microseconds decide the outcome." }
      },
      {
        "@type": "Question",
        "name": "Can I run multiple IBKR accounts from one TradingView strategy?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. PickMyTrade can route a single TradingView alert to one or more Interactive Brokers accounts, so you can mirror the same strategy across several accounts. You map each alert to the account or accounts you want it to trade. See the PickMyTrade guide on connecting multiple IBKR accounts for the exact steps." }
      }
    ]
  };
const schema3 = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://pickmytrade.io"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "TradingView to Interactive Brokers Automation",
        "item": absoluteLocalizedPath(locale, 'broker/tradingview-to-ib')
      }
    ]
  };
const schema4 = {
                  "@context": "https://schema.org",
                  "@type": "TechArticle",
                  "headline": "How to Connect TradingView to Interactive Brokers in 3 Steps",
                  "name": "How to Connect TradingView to Interactive Brokers in 3 Steps",
                  "description": "Set up automated trading by connecting TradingView alerts to your Interactive Brokers (IBKR) account through PickMyTrade and TWS. No coding required.",
                  "image": "https://pickmytrade.io/public/ib-automation.png",
                  "timeRequired": "PT10M",
                  "dependencies": "TradingView account; Interactive Brokers (IBKR) account; Trader Workstation (TWS); PickMyTrade account",
                  "articleSection": [
                    "Configure Your IBKR Account — Download and install TWS from the Interactive Brokers website, then launch and log in with your IBKR credentials. Launch PickMyTrade and click the IB Connection button in the navbar to establish the connection. Add your account by entering your IB Connection Name and selecting a single or multiple account setup, then verify your settings including Token, Connection Name, Account Name, Risk %, and Quantity Multiplier.",
                    "Set Up TradingView Webhook Alerts — Generate your unique webhook URL in PickMyTrade, copy the alert message code for your strategy, and paste it into your TradingView alert settings. Works with both Pine Script indicators and strategies.",
                    "Start Automated Trading — When your TradingView alert fires, PickMyTrade processes your order in under 200ms on our side and places it on Interactive Brokers, along with any automated stop loss and take profit orders. Monitor trades in real time through your TWS dashboard."
                  ],
                  "proficiencyLevel": "Beginner",
                  "author": {
                    "@id": "https://pickmytrade.io/#organization"
                  },
                  "publisher": {
                    "@id": "https://pickmytrade.io/#organization"
                  }
                };
---
<BaseLayout
  locale={locale}
  title={t('broker_ib.page_title')}
  description={t('broker_ib.page_description')}
  keywords={t('broker_ib.page_keywords')}
  structuredData={[schema1, schema2, schema3, schema4]}
>
<!-- BREADCRUMB NAVIGATION -->
  <nav aria-label="Breadcrumb" class="bg-[#001429] pt-20 pb-3 sm:pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-5">
      <ol class="flex items-center flex-wrap gap-2 text-xs sm:text-sm text-gray-400" itemscope
        itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={localizedPath(locale)} class="hover:text-[#2B77EE] transition" itemprop="item">
            <span itemprop="name">{t('broker_ib.breadcrumb_home')}</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="text-gray-600">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="text-white font-semibold" itemprop="name">{t('broker_ib.breadcrumb_current')}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- HERO SECTION - REDESIGNED -->
  <header class="relative overflow-hidden bg-gradient-to-b from-[#001429] via-[#001f3f] to-[#002040]">
    <!-- Animated Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <canvas id="tradingCanvas" class="w-full h-full" aria-hidden="true"></canvas>
    </div>

    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#001429]/30 to-[#002040]"></div>

    <!-- Content Container -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-32 pb-20 sm:pb-28">
      <div class="text-center" data-aos="fade-up" data-aos-duration="800">

        <!-- Top Badge -->
        <div
          class="inline-flex items-center gap-2 mb-6 sm:mb-8 bg-gradient-to-r from-[#0F3EC3]/20 to-[#2B77EE]/20 backdrop-blur-sm border border-[#2B77EE]/30 rounded-full px-4 sm:px-6 py-2 sm:py-3"
          data-aos="fade-down" data-aos-delay="100">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#2B77EE] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#2B77EE]"></span>
          </span>
          <span class="text-xs sm:text-sm font-semibold text-[#7FB8F9] uppercase tracking-wider electrolize-regular">
            {t('broker_ib.hero_badge')}
          </span>
          <i class="fa-solid fa-check-circle text-[#2B77EE]" aria-hidden="true"></i>
        </div>

        <!-- Main Heading -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold mb-6 sm:mb-8 leading-tight"
          data-aos="fade-up" data-aos-delay="200">
          <span class="block text-white mb-2">{t('broker_ib.hero_title_line1')}</span>
          <span class="block bg-gradient-to-r from-[#2B77EE] via-[#4B94FF] to-[#7FB8F9] bg-clip-text text-transparent">
            {t('broker_ib.hero_title_line2')}
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="max-w-3xl mx-auto text-base sm:text-lg md:text-xl lg:text-2xl text-gray-300 mb-8 sm:mb-10 leading-relaxed px-4"
          data-aos="fade-up" data-aos-delay="300">
          {t('broker_ib.hero_subtitle_1')} <strong class="text-white">{t('broker_ib.hero_subtitle_strong1')}</strong> {t('broker_ib.hero_subtitle_2')} <strong
            class="text-white">{t('broker_ib.hero_subtitle_strong2')}</strong> {t('broker_ib.hero_subtitle_3')}
          <span class="block mt-2 text-[#7FB8F9]">{t('broker_ib.hero_subtitle_span')}</span>
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-10 sm:mb-12 px-4" data-aos="fade-up"
          data-aos-delay="400">
          <a href="https://app.pickmytrade.io/?register=true" rel="noopener" aria-label={t('broker_ib.cta_start_trial_aria')}
            class="group relative inline-flex items-center justify-center px-8 py-4 text-base sm:text-lg font-semibold text-white bg-gradient-to-r from-[#0F3EC3] to-[#2B77EE] rounded-xl overflow-hidden shadow-lg hover:shadow-[0_0_30px_5px_rgba(43,119,238,0.5)] transition-all duration-300 w-full sm:w-auto electrolize-regular">
            <span
              class="absolute inset-0 w-full h-full bg-gradient-to-r from-[#2B77EE] to-[#0F3EC3] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
            <span class="relative flex items-center gap-2">
              <i class="fa-solid fa-rocket" aria-hidden="true"></i>
              {t('broker_ib.cta_start_trial')}
            </span>
          </a>

          <a href="https://app.pickmytrade.io" rel="noopener" aria-label={t('broker_ib.cta_login_aria')}
            class="group inline-flex items-center justify-center px-8 py-4 text-base sm:text-lg font-semibold text-[#2B77EE] bg-white/10 backdrop-blur-sm border-2 border-[#2B77EE]/50 rounded-xl hover:bg-white/20 hover:border-[#2B77EE] transition-all duration-300 w-full sm:w-auto electrolize-regular">
            <span class="flex items-center gap-2">
              <i class="fa-solid fa-sign-in-alt" aria-hidden="true"></i>
              {t('broker_ib.cta_login')}
            </span>
          </a>
        </div>

        <!-- Feature Pills -->
        <div class="flex flex-wrap justify-center gap-3 sm:gap-4 md:gap-6 text-sm sm:text-base" data-aos="fade-up"
          data-aos-delay="500">
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-check-circle text-green-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_ib.pill_free_trial')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-credit-card text-blue-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_ib.pill_no_card')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-infinity text-purple-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_ib.pill_unlimited')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-bolt text-yellow-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_ib.pill_instant')}</span>
          </div>
        </div>

        <!-- Trust Indicators -->
        <div class="mt-12 sm:mt-16 pt-8 border-t border-white/10" data-aos="fade-up" data-aos-delay="600">
          <p class="text-xs sm:text-sm text-gray-400 mb-4 uppercase tracking-wider">{t('broker_ib.trust_heading')}</p>
          <div class="flex flex-wrap justify-center items-center gap-8 sm:gap-12">

            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">50,000+</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('broker_ib.trust_rating_label')}</div>
            </div>
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">28M+</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('broker_ib.trust_uptime_label')}</div>
            </div>
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">&lt;5min</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('broker_ib.trust_setup_label')}</div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Smooth Wave Transition -->
    <div class="absolute bottom-0 left-0 right-0 z-20">
      <svg class="w-full h-16 sm:h-20 md:h-24" viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="none">
        <path
          d="M0,64L48,69.3C96,75,192,85,288,80C384,75,480,53,576,48C672,43,768,53,864,64C960,75,1056,85,1152,80C1248,75,1344,53,1392,42.7L1440,32L1440,120L1392,120C1344,120,1248,120,1152,120C1056,120,960,120,864,120C768,120,672,120,576,120C480,120,384,120,288,120C192,120,96,120,48,120L0,120Z"
          fill="url(#wave-gradient)" />
        <defs>
          <linearGradient id="wave-gradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#002040" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#002040" stop-opacity="1" />
          </linearGradient>
        </defs>
      </svg>
    </div>
  </header>

  <AnswerBlock
    locale={locale}
    answer={t('broker_ib.answer_block')}
    factsHeading={t('broker_ib.facts_heading')}
    asOfLabel={t('broker_ib.facts_as_of')}
    asOfDate="2026-10-01"
    facts={[
      { label: t('broker_ib.facts_connection_label'), value: t('broker_ib.facts_connection_value') },
      { label: t('broker_ib.facts_tws_label'), value: t('broker_ib.facts_tws_value') },
      { label: t('broker_ib.facts_api_label'), value: t('broker_ib.facts_api_value') },
      { label: t('broker_ib.facts_ports_label'), value: t('broker_ib.facts_ports_value') },
      { label: t('broker_ib.facts_assets_label'), value: t('broker_ib.facts_assets_value') },
      { label: t('broker_ib.facts_tv_plan_label'), value: t('broker_ib.facts_tv_plan_value') },
      { label: t('broker_ib.facts_speed_label'), value: t('broker_ib.facts_speed_value') },
      { label: t('broker_ib.facts_price_label'), value: t('broker_ib.facts_price_value') },
    ]}
    notSupportedHeading={t('broker_ib.not_supported_heading')}
    notSupported={[t('broker_ib.not_supported_1'), t('broker_ib.not_supported_2'), t('broker_ib.not_supported_3')]}
    reviewedBy={t('broker_ib.reviewed_by')}
    updatedLabel={t('broker_ib.updated_label')}
  />

  <!-- SEO CONTENT SECTION - REDESIGNED -->
  <article
    class="relative py-16 sm:py-24 px-4 sm:px-5 bg-gradient-to-b from-[#002040] via-[#001429] to-[#002040] overflow-hidden">
    <!-- Background Decoration -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-20 left-10 w-72 h-72 bg-[#2B77EE] rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-[#0F3EC3] rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-12 sm:mb-16" data-aos="fade-up">
        <div
          class="inline-flex items-center gap-2 mb-4 bg-gradient-to-r from-[#0F3EC3]/20 to-[#2B77EE]/20 backdrop-blur-sm border border-[#2B77EE]/30 rounded-full px-4 py-2">
          <i class="fa-solid fa-info-circle text-[#2B77EE]"></i>
          <span
            class="text-xs sm:text-sm font-semibold text-[#7FB8F9] uppercase tracking-wider electrolize-regular">{t('broker_ib.intro_eyebrow')}</span>
        </div>
        <h2
          class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4 bg-gradient-to-r from-white via-[#7FB8F9] to-white bg-clip-text text-transparent">
          {t('broker_ib.intro_title')}
        </h2>
        <p class="text-base sm:text-lg text-gray-400 max-w-3xl mx-auto">{t('broker_ib.intro_subtitle')}</p>
      </div>

      <!-- Main Content Cards -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 mb-8 sm:mb-12">
        <!-- Card 1: What is it? -->
        <div
          class="group relative bg-gradient-to-br from-[#122B75]/30 via-[#0F3EC3]/20 to-[#122B75]/30 backdrop-blur-sm border border-[#2B77EE]/50 rounded-2xl p-6 sm:p-8 hover:border-[#2B77EE] transition-all duration-300 hover:shadow-lg hover:shadow-[#2B77EE]/20"
          data-aos="fade-right" data-aos-delay="100">
          <div
            class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-[#2B77EE]/10 to-transparent rounded-bl-full opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          </div>

          <div class="flex items-start gap-4 mb-4">
            <div
              class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-[#2B77EE] to-[#0F3EC3] rounded-xl flex items-center justify-center">
              <i class="fa-solid fa-rocket text-white text-xl"></i>
            </div>
            <h3 class="text-xl sm:text-2xl font-bold text-white pt-2">{t('broker_ib.card1_title')}</h3>
          </div>

          <p class="text-gray-300 leading-relaxed mb-4">
            {t('broker_ib.card1_p1_1')} <strong class="text-[#7FB8F9]">{t('broker_ib.card1_p1_strong1')}</strong> {t('broker_ib.card1_p1_2')} <strong class="text-[#7FB8F9]">{t('broker_ib.card1_p1_strong2')}</strong> {t('broker_ib.card1_p1_3')} <strong
              class="text-[#7FB8F9]">{t('broker_ib.card1_p1_strong3')}</strong> {t('broker_ib.card1_p1_4')}
          </p>
          <p class="text-gray-300 leading-relaxed">
            {t('broker_ib.card1_p2_1')} <strong class="text-[#7FB8F9]">{t('broker_ib.card1_p2_strong1')}</strong> {t('broker_ib.card1_p2_2')}
            <strong class="text-[#7FB8F9]">{t('broker_ib.card1_p2_strong2')}</strong>{t('broker_ib.card1_p2_3')}
          </p>
        </div>

        <!-- Card 2: Why Choose? -->
        <div
          class="group relative bg-gradient-to-br from-[#122B75]/30 via-[#0F3EC3]/20 to-[#122B75]/30 backdrop-blur-sm border border-[#2B77EE]/50 rounded-2xl p-6 sm:p-8 hover:border-[#2B77EE] transition-all duration-300 hover:shadow-lg hover:shadow-[#2B77EE]/20"
          data-aos="fade-left" data-aos-delay="200">
          <div
            class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-[#2B77EE]/10 to-transparent rounded-bl-full opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          </div>

          <div class="flex items-start gap-4 mb-4">
            <div
              class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-[#2B77EE] to-[#0F3EC3] rounded-xl flex items-center justify-center">
              <i class="fa-solid fa-chart-line text-white text-xl"></i>
            </div>
            <h3 class="text-xl sm:text-2xl font-bold text-white pt-2">{t('broker_ib.card2_title')}</h3>
          </div>

          <p class="text-gray-300 leading-relaxed mb-4">
