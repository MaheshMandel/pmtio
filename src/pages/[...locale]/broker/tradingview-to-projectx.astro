---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AnswerBlock from '../../../components/AnswerBlock.astro';
import { getLocalePaths, localizedPath, useTranslations, absoluteLocalizedPath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);


const schema1 = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "PickMyTrade - TradingView to ProjectX & TopstepX Automation",
    "description": "No-code platform that automates TradingView alerts to ProjectX and TopstepX. Webhook trade copier for futures with stop loss, take profit, position sizing, multipliers, and multi-account support for Topstep evaluations and funded accounts.",
    "url": absoluteLocalizedPath(locale, 'broker/tradingview-to-projectx'),
    "image": "https://pickmytrade.io/assets/logo.png",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web-based, Windows, Mac, Linux",
    "offers": {
      "@type": "Offer",
      "price": "50.00",
      "priceCurrency": "USD",
      "priceValidUntil": "2026-12-31",
      "availability": "https://schema.org/InStock",
      "description": "$50/month or $500/year. 7-day free trial, no credit card required."
    },
    "publisher": {
      "@type": "Organization",
      "name": "PickMyTrade",
      "url": "https://pickmytrade.io",
      "logo": { "@type": "ImageObject", "url": "https://pickmytrade.io/assets/logo.png" }
    }
  };
const schema2 = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Can I automate TradingView strategies to a Topstep or TopstepX funded account?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. You generate a TopstepX API key, add the account to PickMyTrade, paste the webhook URL into TradingView, and your buy, sell, and close alerts fire automatically. Topstep sets its own rules for automation and API use, and those rules can change, so confirm Topstep's current policy before trading a live funded account." } },
      { "@type": "Question", "name": "How do I get my TopstepX (Topstep) API key and connect it to PickMyTrade?",
        "acceptedAnswer": { "@type": "Answer", "text": "Log in to your Topstep/TopstepX account, create an API key, then add a ProjectX/TopstepX connection in PickMyTrade and paste the key in. Select your account, set your risk defaults, and paste the PickMyTrade webhook URL into a TradingView alert. Our Topstep API access guide walks through every step with screenshots." } },
      { "@type": "Question", "name": "Does PickMyTrade work with ProjectX-based funded accounts, and which firms still use it?",
        "acceptedAnswer": { "@type": "Answer", "text": "Since 28 February 2026, Topstep is the firm that runs on ProjectX technology, as TopstepX. Firms that previously used ProjectX have moved to other engines. PickMyTrade automates TopstepX accounts today, and also connects to Tradovate and Rithmic accounts that many other prop firms run on. Rules vary by firm, so always confirm your firm's current policy." } },
      { "@type": "Question", "name": "Which futures contracts can I trade through ProjectX/TopstepX?",
        "acceptedAnswer": { "@type": "Answer", "text": "Index futures and their micros like NQ, MNQ, ES, MES, YM, and RTY, plus other major CME, CBOT, NYMEX, and COMEX products such as CL, NG, and GC. Availability depends on your Topstep account and data subscription." } },
      { "@type": "Question", "name": "How fast is order execution and what is the uptime?",
        "acceptedAnswer": { "@type": "Answer", "text": "PickMyTrade processes your order in under 200ms on our side. Your total fill time also depends on your broker's execution speed, network latency, and how quickly TradingView sends the alert, so we do not promise a guaranteed end-to-end number. PickMyTrade's published platform uptime is 99.9%." } },
      { "@type": "Question", "name": "Can I test in a TopstepX evaluation or demo before risking a funded account?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes, and we recommend it. Connect an evaluation or demo/practice account, run your alerts on a one-minute chart, and confirm entries, exits, stops, and targets in the alert log before you switch a live funded account on." } },
      { "@type": "Question", "name": "How is this different from TopstepX's native TradingView chart integration?",
        "acceptedAnswer": { "@type": "Answer", "text": "TopstepX's own chart integration lets you place and manage trades manually from a TradingView chart. PickMyTrade is about automation: it takes your TradingView alerts and executes them for you, adds stop loss, take profit, sizing, and multipliers, and can copy one signal to several accounts at once. Use the native integration for manual trading and PickMyTrade for hands-off, rules-based execution." } },
      { "@type": "Question", "name": "What is a Webhook URL, and where do I find it?",
        "acceptedAnswer": { "@type": "Answer", "text": "A Webhook URL is the connection point for TradingView to send alerts to PickMyTrade. You can find it in PickMyTrade after generating an alert." } },
      { "@type": "Question", "name": "What's the difference between an Indicator and a Strategy alert type?",
        "acceptedAnswer": { "@type": "Answer", "text": "Indicator: Triggers from specific chart conditions (manual/semi-automated use). Strategy: Triggers from a full Pine Script strategy with entry and exit automation." } },
      { "@type": "Question", "name": "How do the Buy, Sell, and Close alerts work?",
        "acceptedAnswer": { "@type": "Answer", "text": "Buy Alert: Opens or adds to a long position; closes any open short position first. Sell Alert: Opens or adds to a short position; closes any open long position first. Close Alert: Closes all open positions and cancels pending orders." } },
      { "@type": "Question", "name": "Can I use both quantity and risk percentage for my trades?",
        "acceptedAnswer": { "@type": "Answer", "text": "No. You must choose either fixed quantity or risk percentage per trade. Both cannot be used simultaneously." } },
      { "@type": "Question", "name": "How do the different Stop Loss and Take Profit types work?",
        "acceptedAnswer": { "@type": "Answer", "text": "Point/Dollar (from entry): Sets SL/TP at a specific point distance (e.g., -100 points from entry). Percentage: Sets SL/TP as a percentage of entry price (e.g., -2% from entry). Ticks: Sets SL/TP in tick increments, useful for futures contracts. Total Profit/Loss (USD): Fixed dollar gain/loss per contract." } },
      { "@type": "Question", "name": "What does \"Account Not Found\" mean?",
        "acceptedAnswer": { "@type": "Answer", "text": "PickMyTrade cannot see the account you selected. Recheck that your TopstepX API key is valid and active, and that the account name in PickMyTrade matches the account name in TopstepX exactly, including spacing and case." } },
      { "@type": "Question", "name": "What does \"Order Rejected\" mean?",
        "acceptedAnswer": { "@type": "Answer", "text": "TopstepX accepted the request but declined the order. Common causes are being outside allowed trading hours, exceeding a position or daily-loss limit, insufficient buying power, or a closed market. Check your account rules and current status, then resend." } },
      { "@type": "Question", "name": "What should I do if I get a \"Contract Not Found\" error?",
        "acceptedAnswer": { "@type": "Answer", "text": "The ticker in your TradingView alert did not map to a live TopstepX contract, often because the contract rolled to a new expiry or the symbol is spelled differently. Update the symbol mapping in PickMyTrade to the current front-month contract (for example, MNQ1! for Micro Nasdaq)." } },
      { "@type": "Question", "name": "What should I do if I get an \"Unknown Error\"?",
        "acceptedAnswer": { "@type": "Answer", "text": "This is usually a temporary connection or API hiccup. Confirm your API key is still valid, check the PickMyTrade alert log for detail, and if it repeats, contact support with the alert timestamp." } }
    ]
  };
const schema3 = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://pickmytrade.io" },
      { "@type": "ListItem", "position": 2, "name": "Brokers", "item": absoluteLocalizedPath(locale, 'broker') },
      { "@type": "ListItem", "position": 3, "name": "TradingView to ProjectX & TopstepX", "item": absoluteLocalizedPath(locale, 'broker/tradingview-to-projectx') }
    ]
  };
const schema4 = {
                  "@context": "https://schema.org",
                  "@type": "TechArticle",
                  "headline": "How to connect TradingView to ProjectX / TopstepX with PickMyTrade",
                  "name": "How to connect TradingView to ProjectX / TopstepX with PickMyTrade",
                  "description": "Automate TradingView alerts to a ProjectX or TopstepX account using a TopstepX API key and a PickMyTrade webhook. No coding required.",
                  "timeRequired": "PT5M",
                  "dependencies": "TradingView account (Pro, Pro+, or Premium for webhooks); Topstep / TopstepX account (evaluation, funded, or demo); PickMyTrade account",
                  "articleSection": [
                    "Generate your TopstepX API key — Log in to your Topstep/TopstepX account and create an API key so PickMyTrade can place orders on your behalf.",
                    "Add your account in PickMyTrade — Add a ProjectX/TopstepX connection in PickMyTrade, paste in your API key, select your account, and set default risk controls.",
                    "Paste the webhook URL into a TradingView alert — Create a TradingView alert, delete the default message, paste the PickMyTrade alert message, and set the PickMyTrade webhook URL under notifications.",
                    "Send buy, sell, and close signals and go live — Test on a one-minute chart, confirm the order in the PickMyTrade alert log and your TopstepX account, then switch on your live strategy."
                  ],
                  "proficiencyLevel": "Beginner",
                  "author": {
                    "@id": "https://pickmytrade.io/#organization"
                  },
                  "publisher": {
                    "@id": "https://pickmytrade.io/#organization"
                  }
                };
const schema5 = {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "PickMyTrade",
    "url": "https://pickmytrade.io",
    "logo": { "@type": "ImageObject", "url": "https://pickmytrade.io/assets/logo.png" },
    "description": "PickMyTrade automates TradingView alerts to futures brokers and prop-firm platforms including ProjectX and TopstepX. Used by more than 50,000 traders.",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@pickmytrade.com",
      "contactType": "Customer Support",
      "availableLanguage": "English"
    },
    "sameAs": [
      "https://x.com/pickmytrade",
      "https://discord.gg/FkJ7g7498S",
      "https://www.instagram.com/pickmytrade",
      "https://www.youtube.com/@PickMyTrade",
      "https://www.linkedin.com/company/pickmytrade",
      "https://sourceforge.net/software/product/PickMyTrade/",
      "https://www.trustpilot.com/review/pickmytrade.trade"
    ]
  };
---
<BaseLayout
  locale={locale}
  title={t('broker_projectx.page_title')}
  description={t('broker_projectx.page_description')}
  keywords={t('broker_projectx.page_keywords')}
  structuredData={[schema1, schema2, schema3, schema4, schema5]}
>
<!-- Spacer for fixed navbar -->
  <!-- <div class="h-16"></div> -->

  <!-- BREADCRUMB NAVIGATION -->
  <nav aria-label="Breadcrumb" class="bg-[#001429] pt-20 pb-3 sm:pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-5">
      <ol class="flex items-center flex-wrap gap-2 text-xs sm:text-sm text-gray-400" itemscope
        itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={localizedPath(locale)} class="hover:text-[#2B77EE] transition" itemprop="item">
            <span itemprop="name">{t('broker_projectx.breadcrumb_home')}</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="text-gray-600">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="text-white font-semibold" itemprop="name">{t('broker_projectx.breadcrumb_current')}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- HERO SECTION - REDESIGNED -->
  <header class="relative overflow-hidden bg-gradient-to-b from-[#001429] via-[#001f3f] to-[#002040]">
    <!-- Animated Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <canvas id="tradingCanvas" class="w-full h-full" aria-hidden="true"></canvas>
    </div>

    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#001429]/30 to-[#002040]"></div>

    <!-- Content Container -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-32 pb-20 sm:pb-28">
      <div class="text-center" data-aos="fade-up" data-aos-duration="800">

        <!-- Top Badge -->
        <div
          class="inline-flex items-center gap-2 mb-6 sm:mb-8 bg-gradient-to-r from-[#0F3EC3]/20 to-[#2B77EE]/20 backdrop-blur-sm border border-[#2B77EE]/30 rounded-full px-4 sm:px-6 py-2 sm:py-3"
          data-aos="fade-down" data-aos-delay="100">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#2B77EE] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#2B77EE]"></span>
          </span>
          <span class="text-xs sm:text-sm font-semibold text-[#7FB8F9] uppercase tracking-wider electrolize-regular">
            {t('broker_projectx.hero_badge')}
          </span>
          <i class="fa-solid fa-check-circle text-[#2B77EE]" aria-hidden="true"></i>
        </div>

        <!-- Main Heading -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold mb-6 sm:mb-8 leading-tight"
          data-aos="fade-up" data-aos-delay="200">
          <span class="block text-white mb-2">{t('broker_projectx.hero_title_line1')}</span>
          <span class="block bg-gradient-to-r from-[#2B77EE] via-[#4B94FF] to-[#7FB8F9] bg-clip-text text-transparent">
            {t('broker_projectx.hero_title_line2')}
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="max-w-3xl mx-auto text-base sm:text-lg md:text-xl lg:text-2xl text-gray-300 mb-8 sm:mb-10 leading-relaxed px-4"
          data-aos="fade-up" data-aos-delay="300">
          {t('broker_projectx.hero_subtitle_pre')} <strong class="text-white">{t('broker_projectx.hero_subtitle_tv')}</strong> {t('broker_projectx.hero_subtitle_to')} <strong
            class="text-white">{t('broker_projectx.hero_subtitle_projectx')}</strong> {t('broker_projectx.hero_subtitle_post')}
          <span class="block mt-2 text-[#7FB8F9]">{t('broker_projectx.hero_subtitle_line2')}</span>
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-10 sm:mb-12 px-4" data-aos="fade-up"
          data-aos-delay="400">
          <a href="https://app.pickmytrade.io/?register=true" rel="noopener" aria-label={t('broker_projectx.hero_cta_trial_aria')}
            class="group relative inline-flex items-center justify-center px-8 py-4 text-base sm:text-lg font-semibold text-white bg-gradient-to-r from-[#0F3EC3] to-[#2B77EE] rounded-xl overflow-hidden shadow-lg hover:shadow-[0_0_30px_5px_rgba(43,119,238,0.5)] transition-all duration-300 w-full sm:w-auto electrolize-regular">
            <span
              class="absolute inset-0 w-full h-full bg-gradient-to-r from-[#2B77EE] to-[#0F3EC3] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
            <span class="relative flex items-center gap-2">
              <i class="fa-solid fa-rocket" aria-hidden="true"></i>
              {t('broker_projectx.hero_cta_trial')}
            </span>
          </a>

          <a href="https://app.pickmytrade.io" rel="noopener" aria-label={t('broker_projectx.hero_cta_login_aria')}
            class="group inline-flex items-center justify-center px-8 py-4 text-base sm:text-lg font-semibold text-[#2B77EE] bg-white/10 backdrop-blur-sm border-2 border-[#2B77EE]/50 rounded-xl hover:bg-white/20 hover:border-[#2B77EE] transition-all duration-300 w-full sm:w-auto electrolize-regular">
            <span class="flex items-center gap-2">
              <i class="fa-solid fa-sign-in-alt" aria-hidden="true"></i>
              {t('broker_projectx.hero_cta_login')}
            </span>
          </a>
        </div>

        <!-- Feature Pills -->
        <div class="flex flex-wrap justify-center gap-3 sm:gap-4 md:gap-6 text-sm sm:text-base" data-aos="fade-up"
          data-aos-delay="500">
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-check-circle text-green-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_projectx.hero_pill_trial')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-credit-card text-blue-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_projectx.hero_pill_no_card')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-infinity text-purple-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_projectx.hero_pill_unlimited')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-bolt text-yellow-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_projectx.hero_pill_instant')}</span>
          </div>
        </div>

        <!-- Trust Indicators -->
        <div class="mt-12 sm:mt-16 pt-8 border-t border-white/10" data-aos="fade-up" data-aos-delay="600">
          <p class="text-xs sm:text-sm text-gray-400 mb-4 uppercase tracking-wider">{t('broker_projectx.hero_trust_label')}</p>
          <div class="flex flex-wrap justify-center items-center gap-8 sm:gap-12">
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">50,000+</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('broker_projectx.hero_stat_rating')}</div>
            </div>
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">99.9%</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('broker_projectx.hero_stat_uptime')}</div>
            </div>
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">&lt;5min</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('broker_projectx.hero_stat_setup')}</div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Smooth Wave Transition -->
    <div class="absolute bottom-0 left-0 right-0 z-20">
      <svg class="w-full h-16 sm:h-20 md:h-24" viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="none">
        <path
          d="M0,64L48,69.3C96,75,192,85,288,80C384,75,480,53,576,48C672,43,768,53,864,64C960,75,1056,85,1152,80C1248,75,1344,53,1392,42.7L1440,32L1440,120L1392,120C1344,120,1248,120,1152,120C1056,120,960,120,864,120C768,120,672,120,576,120C480,120,384,120,288,120C192,120,96,120,48,120L0,120Z"
          fill="url(#wave-gradient)" />
        <defs>
          <linearGradient id="wave-gradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#002040" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#002040" stop-opacity="1" />
          </linearGradient>
        </defs>
      </svg>
    </div>
  </header>

  <AnswerBlock
    locale={locale}
    answer={t('broker_projectx.answer_block')}
    factsHeading={t('broker_projectx.facts_heading')}
    asOfLabel={t('broker_projectx.facts_as_of')}
    asOfDate="2026-10-01"
    facts={[
      { label: t('broker_projectx.facts_connection_label'), value: t('broker_projectx.facts_connection_value') },
      { label: t('broker_projectx.facts_credentials_label'), value: t('broker_projectx.facts_credentials_value') },
      { label: t('broker_projectx.facts_accounts_label'), value: t('broker_projectx.facts_accounts_value') },
      { label: t('broker_projectx.facts_status_label'), value: t('broker_projectx.facts_status_value') },
      { label: t('broker_projectx.facts_tv_plan_label'), value: t('broker_projectx.facts_tv_plan_value') },
      { label: t('broker_projectx.facts_speed_label'), value: t('broker_projectx.facts_speed_value') },
      { label: t('broker_projectx.facts_price_label'), value: t('broker_projectx.facts_price_value') },
    ]}
    notSupportedHeading={t('broker_projectx.not_supported_heading')}
    notSupported={[t('broker_projectx.not_supported_1'), t('broker_projectx.not_supported_2'), t('broker_projectx.not_supported_3')]}
    reviewedBy={t('broker_projectx.reviewed_by')}
    updatedLabel={t('broker_projectx.updated_label')}
  />

  <!-- SEO CONTENT SECTION - REDESIGNED -->
  <article
    class="relative py-16 sm:py-24 px-4 sm:px-5 bg-gradient-to-b from-[#002040] via-[#001429] to-[#002040] overflow-hidden">
    <!-- Background Decoration -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-20 left-10 w-72 h-72 bg-[#2B77EE] rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-[#0F3EC3] rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-12 sm:mb-16" data-aos="fade-up">
        <div
          class="inline-flex items-center gap-2 mb-4 bg-gradient-to-r from-[#0F3EC3]/20 to-[#2B77EE]/20 backdrop-blur-sm border border-[#2B77EE]/30 rounded-full px-4 py-2">
          <i class="fa-solid fa-info-circle text-[#2B77EE]"></i>
          <span
            class="text-xs sm:text-sm font-semibold text-[#7FB8F9] uppercase tracking-wider electrolize-regular">{t('broker_projectx.seo_badge')}</span>
        </div>
        <h2
          class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4 bg-gradient-to-r from-white via-[#7FB8F9] to-white bg-clip-text text-transparent">
          {t('broker_projectx.seo_heading')}
        </h2>
        <p class="text-base sm:text-lg text-gray-400 max-w-3xl mx-auto">{t('broker_projectx.seo_subheading')}</p>
      </div>

      <!-- Main Content Cards -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 mb-8 sm:mb-12">
        <!-- Card 1: What is it? -->
        <div
          class="group relative bg-gradient-to-br from-[#122B75]/30 via-[#0F3EC3]/20 to-[#122B75]/30 backdrop-blur-sm border border-[#2B77EE]/50 rounded-2xl p-6 sm:p-8 hover:border-[#2B77EE] transition-all duration-300 hover:shadow-lg hover:shadow-[#2B77EE]/20"
          data-aos="fade-right" data-aos-delay="100">
          <div
            class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-[#2B77EE]/10 to-transparent rounded-bl-full opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          </div>

          <div class="flex items-start gap-4 mb-4">
            <div
              class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-[#2B77EE] to-[#0F3EC3] rounded-xl flex items-center justify-center">
              <i class="fa-solid fa-rocket text-white text-xl"></i>
            </div>
