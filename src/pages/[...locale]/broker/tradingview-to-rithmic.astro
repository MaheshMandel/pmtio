---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AnswerBlock from '../../../components/AnswerBlock.astro';
import { getLocalePaths, localizedPath, useTranslations, absoluteLocalizedPath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);


const schema1 = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "PickMyTrade - TradingView to Rithmic Automation",
    "image": "https://pickmytrade.io/assets/logo.png",
    "description": "PickMyTrade is the webhook bridge that connects TradingView to Rithmic. Automate your TradingView alerts to a Rithmic account, including Apex and other Rithmic-based prop accounts, with no coding and no VPS. Symbol mapping, quantity and risk sizing, stop-loss and take-profit, and multi-account support are built in.",
    "url": absoluteLocalizedPath(locale, 'broker/tradingview-to-rithmic'),
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web-based, Windows, Mac, Linux",
    "offers": {
      "@type": "Offer",
      "price": "50.00",
      "priceCurrency": "USD",
      "priceValidUntil": "2026-12-31",
      "availability": "https://schema.org/InStock",
      "description": "$50 per month or $500 per year. 7-day free trial, no credit card required."
    },
    "publisher": {
      "@type": "Organization",
      "name": "PickMyTrade",
      "url": "https://pickmytrade.io",
      "logo": { "@type": "ImageObject", "url": "https://pickmytrade.io/assets/logo.png" }
    }
  };
const schema2 = {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "PickMyTrade",
    "url": "https://pickmytrade.io",
    "logo": "https://pickmytrade.io/assets/logo.png",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@pickmytrade.com",
      "contactType": "Customer Support",
      "availableLanguage": "English"
    },
    "sameAs": [
      "https://x.com/pickmytrade",
      "https://discord.gg/FkJ7g7498S",
      "https://www.instagram.com/pickmytrade",
      "https://www.youtube.com/@PickMyTrade",
      "https://www.linkedin.com/company/pickmytrade",
      "https://sourceforge.net/software/product/PickMyTrade/",
      "https://www.trustpilot.com/review/pickmytrade.trade"
    ]
  };
const schema3 = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://pickmytrade.io" },
      { "@type": "ListItem", "position": 2, "name": "Brokers", "item": absoluteLocalizedPath(locale, 'broker') },
      { "@type": "ListItem", "position": 3, "name": "TradingView to Rithmic", "item": absoluteLocalizedPath(locale, 'broker/tradingview-to-rithmic') }
    ]
  };
const schema4 = {
                  "@context": "https://schema.org",
                  "@type": "TechArticle",
                  "headline": "How to connect TradingView to Rithmic with PickMyTrade",
                  "name": "How to connect TradingView to Rithmic with PickMyTrade",
                  "description": "Connect TradingView to a Rithmic account in three steps by adding your Rithmic connection in PickMyTrade and pasting a webhook alert into TradingView. No coding required.",
                  "image": "https://pickmytrade.io/assets/logo.png",
                  "timeRequired": "PT5M",
                  "dependencies": "PickMyTrade account; Rithmic account (live, demo, or prop firm); TradingView Pro, Pro+, or Premium (for webhook alerts)",
                  "articleSection": [
                    "Add your Rithmic connection in PickMyTrade — Create a PickMyTrade account and add your Rithmic connection with your Rithmic username, password, and system name. Set your default risk management (stop-loss, take-profit, and position sizing).",
                    "Create the TradingView webhook alert — In PickMyTrade, generate the alert message and webhook URL. In TradingView, create an alert, delete the default text, paste the PickMyTrade message, and paste the webhook URL into the alert's Notifications tab. Webhook alerts need a paid TradingView plan.",
                    "Test in demo, then automate — Test the alert on a 1-minute chart of a demo or evaluation account, confirm the order in the PickMyTrade Alert Log and in Rithmic, then switch to your live strategy. Trades then fire automatically, 24/7."
                  ],
                  "proficiencyLevel": "Beginner",
                  "author": {
                    "@id": "https://pickmytrade.io/#organization"
                  },
                  "publisher": {
                    "@id": "https://pickmytrade.io/#organization"
                  }
                };
const schema5 = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Does Rithmic connect to TradingView natively?", "acceptedAnswer": { "@type": "Answer", "text": "No. Rithmic has no built-in integration that lets TradingView place orders in a Rithmic account on its own. TradingView charts the market and fires the alert, but it cannot route the trade to Rithmic by itself. PickMyTrade is the webhook bridge that connects the two, so your TradingView alerts become live Rithmic orders with no coding." } },
      { "@type": "Question", "name": "How do I connect Rithmic to TradingView?", "acceptedAnswer": { "@type": "Answer", "text": "Add your Rithmic connection in PickMyTrade using your Rithmic username, password, and system name. Generate the alert message and webhook URL in PickMyTrade, then create an alert in TradingView, paste the message into the alert box, and paste the webhook URL into the alert's Notifications tab. When the alert fires, PickMyTrade places the order on your Rithmic account." } },
      { "@type": "Question", "name": "Can you connect Rithmic to TradingView without coding or a VPS?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The entire flow is webhook-based, so there is nothing to code. PickMyTrade runs in the cloud 24/7, which means there is no VPS to rent and no desktop app to leave running. Once your Rithmic account is connected and your alert is live, trades fire automatically even with your computer switched off." } },
      { "@type": "Question", "name": "How do I connect an Apex Rithmic account to TradingView?", "acceptedAnswer": { "@type": "Answer", "text": "Apex Trader Funding accounts run on the Rithmic feed, so the setup is the same as any Rithmic connection: add your Apex Rithmic credentials in PickMyTrade, then paste the generated alert and webhook URL into TradingView. Before you automate a funded or evaluation account, confirm Apex's current rules on automated and copy trading, since those rules vary by firm and change over time." } },
      { "@type": "Question", "name": "What is the Rithmic webhook setup with PickMyTrade?", "acceptedAnswer": { "@type": "Answer", "text": "The webhook setup is three steps: add your Rithmic connection in PickMyTrade, generate the alert message and webhook URL, and paste both into a TradingView alert (the message in the alert box, the URL in the Notifications tab). Webhook alerts need a paid TradingView plan (Pro, Pro+, or Premium). Test on a 1-minute chart, confirm the order in the PickMyTrade Alert Log and in Rithmic, then go live." } },
      { "@type": "Question", "name": "Which prop firms use Rithmic and can I automate them?", "acceptedAnswer": { "@type": "Answer", "text": "Firms that offer a Rithmic connection include Apex Trader Funding, Topstep, and E8 Markets, among others. PickMyTrade connects to accounts on Tradovate, Rithmic, and ProjectX, which many prop firms run on. Copy trading and automation rules vary by prop firm and change over time, so always confirm your firm's current policy before you automate." } },
      { "@type": "Question", "name": "Is automated trading on a Rithmic prop account allowed (Apex/Topstep rules)?", "acceptedAnswer": { "@type": "Answer", "text": "It depends on the firm and the moment, because copy trading and automation rules vary by prop firm and change over time. PickMyTrade routes your own TradingView alerts to your own accounts, which is different from subscribing to a signal seller or letting someone manage your account. Always confirm the current rules with Apex, Topstep, or your specific firm before turning automation on." } },
      { "@type": "Question", "name": "What does it cost to connect TradingView to Rithmic?", "acceptedAnswer": { "@type": "Answer", "text": "PickMyTrade is $50 per month or $500 per year, and every account starts with a 7-day free trial that needs no credit card. There is no per-account or per-trade fee, so a single subscription covers your Rithmic automation." } },
      { "@type": "Question", "name": "Rithmic vs Tradovate vs ProjectX - which route should I automate?", "acceptedAnswer": { "@type": "Answer", "text": "Pick the route your account or prop firm actually runs on. Choose Rithmic when your firm uses the Rithmic feed (common with Apex and Topstep setups), Tradovate when your account is on Tradovate, and ProjectX when your firm uses ProjectX. The TradingView side is nearly identical for all three, so if your firm switches platforms you keep the same alerts and just change the connection inside PickMyTrade." } },
      { "@type": "Question", "name": "Can I run multiple Rithmic accounts from one TradingView alert?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. You can link multiple Rithmic accounts to one PickMyTrade profile, and a single TradingView alert can execute across all of them at once. Each account can have its own quantity multiplier or risk percentage, so you can run a small evaluation and a larger funded account from the same signal while keeping each one inside its own risk limit." } }
    ]
  };
---
<BaseLayout
  locale={locale}
  title={t('broker_rithmic.page_title')}
  description={t('broker_rithmic.page_description')}
  keywords={t('broker_rithmic.page_keywords')}
  structuredData={[schema1, schema2, schema3, schema4, schema5]}
>
<!-- Spacer for fixed navbar -->
  <!-- <div class="h-16"></div> -->

  <!-- BREADCRUMB NAVIGATION -->
  <nav aria-label={t('broker_rithmic.breadcrumb_aria')} class="bg-[#001429] pt-20 pb-3 sm:pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-5">
      <ol class="flex items-center flex-wrap gap-2 text-xs sm:text-sm text-gray-400" itemscope
        itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={localizedPath(locale)} class="hover:text-[#2B77EE] transition" itemprop="item">
            <span itemprop="name">{t('broker_rithmic.breadcrumb_home')}</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="text-gray-600">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="text-white font-semibold" itemprop="name">{t('broker_rithmic.breadcrumb_current')}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- HERO SECTION - REDESIGNED -->
  <header class="relative overflow-hidden bg-gradient-to-b from-[#001429] via-[#001f3f] to-[#002040]">
    <!-- Animated Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <canvas id="tradingCanvas" class="w-full h-full" aria-hidden="true"></canvas>
    </div>

    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#001429]/30 to-[#002040]"></div>

    <!-- Content Container -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-32 pb-20 sm:pb-28">
      <div class="text-center" data-aos="fade-up" data-aos-duration="800">

        <!-- Top Badge -->
        <div
          class="inline-flex items-center gap-2 mb-6 sm:mb-8 bg-gradient-to-r from-[#0F3EC3]/20 to-[#2B77EE]/20 backdrop-blur-sm border border-[#2B77EE]/30 rounded-full px-4 sm:px-6 py-2 sm:py-3"
          data-aos="fade-down" data-aos-delay="100">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#2B77EE] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#2B77EE]"></span>
          </span>
          <span class="text-xs sm:text-sm font-semibold text-[#7FB8F9] uppercase tracking-wider electrolize-regular">
            {t('broker_rithmic.hero_badge')}
          </span>
          <i class="fa-solid fa-check-circle text-[#2B77EE]" aria-hidden="true"></i>
        </div>

        <!-- Main Heading -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold mb-6 sm:mb-8 leading-tight"
          data-aos="fade-up" data-aos-delay="200">
          <span class="block text-white mb-2">{t('broker_rithmic.hero_title_line1')}</span>
          <span class="block bg-gradient-to-r from-[#2B77EE] via-[#4B94FF] to-[#7FB8F9] bg-clip-text text-transparent">
            {t('broker_rithmic.hero_title_line2')}
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="max-w-3xl mx-auto text-base sm:text-lg md:text-xl lg:text-2xl text-gray-300 mb-8 sm:mb-10 leading-relaxed px-4"
          data-aos="fade-up" data-aos-delay="300">
          {t('broker_rithmic.hero_subtitle_pre')} <strong class="text-white">{t('broker_rithmic.hero_subtitle_alerts')}</strong> {t('broker_rithmic.hero_subtitle_mid')} <strong
            class="text-white">{t('broker_rithmic.hero_subtitle_rithmic')}</strong> {t('broker_rithmic.hero_subtitle_post')}
          <span class="block mt-2 text-[#7FB8F9]">{t('broker_rithmic.hero_subtitle_2')}</span>
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-10 sm:mb-12 px-4" data-aos="fade-up"
          data-aos-delay="400">
          <a href="https://app.pickmytrade.io/?register=true" rel="noopener" aria-label={t('broker_rithmic.hero_cta_signup_aria')}
            class="group relative inline-flex items-center justify-center px-8 py-4 text-base sm:text-lg font-semibold text-white bg-gradient-to-r from-[#0F3EC3] to-[#2B77EE] rounded-xl overflow-hidden shadow-lg hover:shadow-[0_0_30px_5px_rgba(43,119,238,0.5)] transition-all duration-300 w-full sm:w-auto electrolize-regular">
            <span
              class="absolute inset-0 w-full h-full bg-gradient-to-r from-[#2B77EE] to-[#0F3EC3] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
            <span class="relative flex items-center gap-2">
              <i class="fa-solid fa-rocket" aria-hidden="true"></i>
              {t('broker_rithmic.hero_cta_start')}
            </span>
          </a>

          <a href="https://app.pickmytrade.io" rel="noopener" aria-label={t('broker_rithmic.hero_cta_login_aria')}
            class="group inline-flex items-center justify-center px-8 py-4 text-base sm:text-lg font-semibold text-[#2B77EE] bg-white/10 backdrop-blur-sm border-2 border-[#2B77EE]/50 rounded-xl hover:bg-white/20 hover:border-[#2B77EE] transition-all duration-300 w-full sm:w-auto electrolize-regular">
            <span class="flex items-center gap-2">
              <i class="fa-solid fa-sign-in-alt" aria-hidden="true"></i>
              {t('broker_rithmic.hero_cta_login')}
            </span>
          </a>
        </div>

        <!-- Feature Pills -->
        <div class="flex flex-wrap justify-center gap-3 sm:gap-4 md:gap-6 text-sm sm:text-base" data-aos="fade-up"
          data-aos-delay="500">
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-check-circle text-green-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_rithmic.hero_pill_trial')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-credit-card text-blue-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_rithmic.hero_pill_nocard')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-infinity text-purple-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_rithmic.hero_pill_unlimited')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-bolt text-yellow-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_rithmic.hero_pill_instant')}</span>
          </div>
        </div>

        <!-- Trust Indicators -->
        <div class="mt-12 sm:mt-16 pt-8 border-t border-white/10" data-aos="fade-up" data-aos-delay="600">
          <p class="text-xs sm:text-sm text-gray-400 mb-4 uppercase tracking-wider">{t('broker_rithmic.hero_trust_label')}</p>
          <div class="flex flex-wrap justify-center items-center gap-8 sm:gap-12">
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">50,000+</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('broker_rithmic.hero_stat_rating_label')}</div>
            </div>
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">28M+</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('broker_rithmic.hero_stat_uptime_label')}</div>
            </div>
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">&lt;5min</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('broker_rithmic.hero_stat_setup_label')}</div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Smooth Wave Transition -->
    <div class="absolute bottom-0 left-0 right-0 z-20">
      <svg class="w-full h-16 sm:h-20 md:h-24" viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="none">
        <path
          d="M0,64L48,69.3C96,75,192,85,288,80C384,75,480,53,576,48C672,43,768,53,864,64C960,75,1056,85,1152,80C1248,75,1344,53,1392,42.7L1440,32L1440,120L1392,120C1344,120,1248,120,1152,120C1056,120,960,120,864,120C768,120,672,120,576,120C480,120,384,120,288,120C192,120,96,120,48,120L0,120Z"
          fill="url(#wave-gradient)" />
        <defs>
          <linearGradient id="wave-gradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#002040" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#002040" stop-opacity="1" />
          </linearGradient>
        </defs>
      </svg>
    </div>
  </header>

  <AnswerBlock
    locale={locale}
    answer={t('broker_rithmic.answer_block')}
    factsHeading={t('broker_rithmic.facts_heading')}
    asOfLabel={t('broker_rithmic.facts_as_of')}
    asOfDate="2026-10-01"
    facts={[
      { label: t('broker_rithmic.facts_connection_label'), value: t('broker_rithmic.facts_connection_value') },
      { label: t('broker_rithmic.facts_credentials_label'), value: t('broker_rithmic.facts_credentials_value') },
      { label: t('broker_rithmic.facts_tv_plan_label'), value: t('broker_rithmic.facts_tv_plan_value') },
      { label: t('broker_rithmic.facts_infra_label'), value: t('broker_rithmic.facts_infra_value') },
      { label: t('broker_rithmic.facts_speed_label'), value: t('broker_rithmic.facts_speed_value') },
      { label: t('broker_rithmic.facts_price_label'), value: t('broker_rithmic.facts_price_value') },
    ]}
    notSupportedHeading={t('broker_rithmic.not_supported_heading')}
    notSupported={[t('broker_rithmic.not_supported_1'), t('broker_rithmic.not_supported_2'), t('broker_rithmic.not_supported_3')]}
    reviewedBy={t('broker_rithmic.reviewed_by')}
    updatedLabel={t('broker_rithmic.updated_label')}
  />

  <!-- NATIVE CONNECTION + BRIDGE EXPLAINER SECTION -->
  <section class="relative py-14 sm:py-20 px-4 sm:px-5 bg-gradient-to-b from-[#001429] to-[#001429]">
    <div class="max-w-4xl mx-auto" data-aos="fade-up">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-4 text-white">{t('broker_rithmic.native_heading')}</h2>
      <p class="text-gray-300 leading-relaxed mb-4">{t('broker_rithmic.native_p1')}</p>
      <p class="text-gray-300 leading-relaxed mb-6">{t('broker_rithmic.bridge_intro')}</p>
      <div class="space-y-4">
        <p class="text-gray-300 leading-relaxed"><strong class="text-[#7FB8F9]">{t('broker_rithmic.bridge_s1_label')}</strong> {t('broker_rithmic.bridge_s1_text')}</p>
        <p class="text-gray-300 leading-relaxed"><strong class="text-[#7FB8F9]">{t('broker_rithmic.bridge_s2_label')}</strong> {t('broker_rithmic.bridge_s2_text_a')} <a href="https://docs.pickmytrade.io/connect-tradingview-to-rithmic-with-pickmytrade/" rel="noopener" target="_blank" class="text-[#2B77EE] hover:text-[#7FB8F9] underline">{t('broker_rithmic.bridge_s2_link_text')}</a> {t('broker_rithmic.bridge_s2_text_b')}</p>
        <p class="text-gray-300 leading-relaxed"><strong class="text-[#7FB8F9]">{t('broker_rithmic.bridge_s3_label')}</strong> {t('broker_rithmic.bridge_s3_text')}</p>
      </div>
    </div>
  </section>

  <!-- SEO CONTENT SECTION -->
  <article
    class="relative py-16 sm:py-24 px-4 sm:px-5 bg-gradient-to-b from-[#002040] via-[#001429] to-[#002040] overflow-hidden">
    <!-- Background Decoration -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-20 left-10 w-72 h-72 bg-[#2B77EE] rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-[#0F3EC3] rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-12 sm:mb-16" data-aos="fade-up">
        <div
          class="inline-flex items-center gap-2 mb-4 bg-gradient-to-r from-[#0F3EC3]/20 to-[#2B77EE]/20 backdrop-blur-sm border border-[#2B77EE]/30 rounded-full px-4 py-2">
          <i class="fa-solid fa-info-circle text-[#2B77EE]"></i>
          <span
            class="text-xs sm:text-sm font-semibold text-[#7FB8F9] uppercase tracking-wider electrolize-regular">{t('broker_rithmic.seo_badge')}</span>
        </div>
        <h2
          class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4 bg-gradient-to-r from-white via-[#7FB8F9] to-white bg-clip-text text-transparent">
          {t('broker_rithmic.seo_heading')}
        </h2>
        <p class="text-base sm:text-lg text-gray-400 max-w-3xl mx-auto">{t('broker_rithmic.seo_subheading')}</p>
      </div>

      <!-- Main Content Cards -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 mb-8 sm:mb-12">
        <!-- Card 1: What is it? -->
        <div
          class="group relative bg-gradient-to-br from-[#122B75]/30 via-[#0F3EC3]/20 to-[#122B75]/30 backdrop-blur-sm border border-[#2B77EE]/50 rounded-2xl p-6 sm:p-8 hover:border-[#2B77EE] transition-all duration-300 hover:shadow-lg hover:shadow-[#2B77EE]/20"
          data-aos="fade-right" data-aos-delay="100">
          <div
            class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-[#2B77EE]/10 to-transparent rounded-bl-full opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          </div>

          <div class="flex items-start gap-4 mb-4">
            <div
              class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-[#2B77EE] to-[#0F3EC3] rounded-xl flex items-center justify-center">
              <i class="fa-solid fa-rocket text-white text-xl"></i>
