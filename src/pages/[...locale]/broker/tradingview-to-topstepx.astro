---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AnswerBlock from '../../../components/AnswerBlock.astro';
import { getLocalePaths, localizedPath, useTranslations, absoluteLocalizedPath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';
import type { TranslationKey } from '../../../i18n/utils';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);


const schema1 = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "image": "https://pickmytrade.io/assets/logo.png",
    "name": "PickMyTrade - TradingView to TopStepX Automation",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web",
    "offers": {
      "@type": "Offer",
      "price": "50.00",
      "priceCurrency": "USD",
      "priceValidUntil": "2026-12-31",
      "description": "7-day free trial"
    },
    "description": "No-code platform that automates TradingView alerts to TopStepX, Topstep's platform built on ProjectX technology, with stop loss, take profit, position sizing, and multi-account support."
  };
const schema2 = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://pickmytrade.io"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Brokers",
      "item": absoluteLocalizedPath(locale, 'broker')
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "TradingView to TopStepX Automation",
      "item": absoluteLocalizedPath(locale, 'broker/tradingview-to-topstepx')
    }
  ]
};
const schema3 = {
                  "@context": "https://schema.org",
                  "@type": "TechArticle",
                  "headline": "How to Connect TradingView to TopStepX in 5 Steps",
                  "name": "How to Connect TradingView to TopStepX in 5 Steps",
                  "description": "Connect your TradingView alerts to TopStepX through PickMyTrade to automate your futures trades in minutes. No coding required.",
                  "image": "https://pickmytrade.io/assets/logo.png",
                  "timeRequired": "PT5M",
                  "dependencies": "TradingView account (Pro, Pro+, or Premium for webhooks); TopStepX account with TopstepX API Access; PickMyTrade account",
                  "articleSection": [
                    "Get TopstepX API Access — Subscribe to TopstepX API Access in your Topstep account. It is billed by Topstep, separately from your Topstep subscription.",
                    "Generate your TopstepX API key — Create an API key in your Topstep dashboard.",
                    "Connect the account in PickMyTrade — Add a ProjectX/TopstepX connection, paste the API key, select your account and set default risk controls.",
                    "Create the TradingView alert — Paste the PickMyTrade alert message and set the PickMyTrade webhook URL under notifications.",
                    "Test, then go live — Test on a Trading Combine or demo account on a one-minute chart and confirm the order in the PickMyTrade alert log and your TopstepX account."
                  ],
                  "proficiencyLevel": "Beginner",
                  "author": {
                    "@id": "https://pickmytrade.io/#organization"
                  },
                  "publisher": {
                    "@id": "https://pickmytrade.io/#organization"
                  }
                };
const schema4 = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can I use the TopstepX API on a Live Funded Account?",
      "acceptedAnswer": { "@type": "Answer", "text": "Topstep allows TopstepX API bots on the Trading Combine and Express Funded Account, but not on a Live Funded Account. Confirm your account stage and Topstep's current policy before connecting PickMyTrade." }
    },
    {
      "@type": "Question",
      "name": "Can I run the TopstepX API from a VPS?",
      "acceptedAnswer": { "@type": "Answer", "text": "No. Topstep's Terms of Use require all trading activity to originate from your own device and prohibit running automation from a VPS, VPN, or remote server. Violating this can suspend or remove you from the program." }
    },
    {
      "@type": "Question",
      "name": "How much does TopstepX API Access cost?",
      "acceptedAnswer": { "@type": "Answer", "text": "TopstepX API Access is $29 per month, or $14.50 per month with Topstep's discount code, billed separately from your Topstep subscription. PickMyTrade is $50 per month or $500 per year, with a 7-day free trial and no card required." }
    },
    {
      "@type": "Question",
      "name": "Is TopstepX the same as ProjectX?",
      "acceptedAnswer": { "@type": "Answer", "text": "In practice, yes. ProjectX ended third-party licensing on 28 February 2026 and Topstep took the technology exclusive, rebranding it as TopstepX. PickMyTrade connects to it with a TopstepX API key." }
    }
  ]
};
---
<BaseLayout
  locale={locale}
  title={t('broker_topstepx.page_title')}
  description={t('broker_topstepx.page_description')}
  keywords={t('broker_topstepx.page_keywords')}
  structuredData={[schema1, schema2, schema3, schema4]}
>
<!-- Navigation -->
  <div id="navbar-container"></div>

  <nav aria-label="Breadcrumb" class="bg-[#001429] pt-20 pb-3 sm:pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-5">
      <ol class="flex items-center flex-wrap gap-2 text-xs sm:text-sm text-gray-400" itemscope
        itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={localizedPath(locale)} class="hover:text-[#2B77EE] transition" itemprop="item">
            <span itemprop="name">{t('broker_topstepx.breadcrumb_home')}</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="text-gray-600">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="text-white font-semibold" itemprop="name">{t('broker_topstepx.breadcrumb_current')}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="relative pt-32 pb-20 px-4 overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute w-96 h-96 bg-[#2B77EE]/20 rounded-full blur-3xl -top-20 -left-20"></div>
      <div class="absolute w-96 h-96 bg-[#7FB8F9]/10 rounded-full blur-3xl top-40 right-0"></div>
    </div>

    <div class="relative max-w-6xl mx-auto text-center" data-aos="fade-up">
      <div class="flex items-center justify-center gap-4 mb-6">
        <img
              width="64"
              height="64" src="/assets/propfirm/TopStepX.png" alt={t('broker_topstepx.logo_alt', { name: 'TopStepX' })} class="w-16 h-16 object-contain rounded-lg" loading="eager" decoding="async">
        <h1 class="text-4xl md:text-6xl font-bold electrolize-regular">
          {t('broker_topstepx.hero_title_pre')} <span class="text-[#7FB8F9]">TopStepX</span> {t('broker_topstepx.hero_title_post')}
        </h1>
      </div>

      <p class="text-xl md:text-2xl text-gray-300 mb-8 max-w-3xl mx-auto">
        {t('broker_topstepx.hero_subtitle_1')} <strong class="text-white">{t('broker_topstepx.hero_subtitle_strong')}</strong> {t('broker_topstepx.hero_subtitle_2')}
        <span class="text-[#7FB8F9]">{t('broker_topstepx.hero_subtitle_nocode')}</span> {t('broker_topstepx.hero_subtitle_3')}
      </p>

      <div class="flex flex-wrap justify-center gap-4 mb-12">
        <div class="bg-[#122B75]/40 backdrop-blur-sm border border-[#2B77EE]/50 rounded-xl px-6 py-3">
          <div class="text-yellow-400 text-sm mb-1"><i class="fa-solid fa-bolt"></i> {t('broker_topstepx.hero_stat_rating_label')}</div>
          <div class="text-2xl font-bold text-white">&lt;200ms</div>
        </div>
        <div class="bg-[#122B75]/40 backdrop-blur-sm border border-[#2B77EE]/50 rounded-xl px-6 py-3">
          <div class="text-green-400 text-sm mb-1"><i class="fa-solid fa-dollar-sign"></i> {t('broker_topstepx.hero_stat_fee_label')}</div>
          <div class="text-2xl font-bold text-white">$29/mo</div>
        </div>
        <div class="bg-[#122B75]/40 backdrop-blur-sm border border-[#2B77EE]/50 rounded-xl px-6 py-3">
          <div class="text-blue-400 text-sm mb-1"><i class="fa-solid fa-handshake"></i> {t('broker_topstepx.hero_stat_affiliate_label')}</div>
          <div class="text-2xl font-bold text-white">$50/mo</div>
        </div>
        <div class="bg-[#122B75]/40 backdrop-blur-sm border border-[#2B77EE]/50 rounded-xl px-6 py-3">
          <div class="text-purple-400 text-sm mb-1"><i class="fa-solid fa-calendar"></i> {t('broker_topstepx.hero_stat_payout_label')}</div>
          <div class="text-2xl font-bold text-white">{t('broker_topstepx.hero_stat_payout_value')}</div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://app.pickmytrade.io/signup"
          class="px-8 py-4 bg-gradient-to-r from-[#0F3EC3] to-[#2B77EE] rounded-lg text-white font-semibold text-lg hover:shadow-xl hover:shadow-[#2B77EE]/50 transition-all duration-300 transform hover:-translate-y-1">
          <i class="fa-solid fa-rocket mr-2"></i>{t('broker_topstepx.hero_cta_trial')}
        </a>
        <a href="#comparison"
          class="px-8 py-4 bg-[#122B75]/40 backdrop-blur-sm border-2 border-[#2B77EE]/50 rounded-lg text-white font-semibold text-lg hover:bg-[#122B75]/60 transition-all duration-300">
          <i class="fa-solid fa-table mr-2"></i>{t('broker_topstepx.hero_cta_compare')}
        </a>
      </div>
    </div>
  </section>

  <AnswerBlock
    locale={locale}
    answer={t('broker_topstepx.answer_block')}
    factsHeading={t('broker_topstepx.facts_heading')}
    asOfLabel={t('broker_topstepx.facts_as_of')}
    asOfDate="2026-10-01"
    facts={[
      { label: t('broker_topstepx.facts_connection_label'), value: t('broker_topstepx.facts_connection_value') },
      { label: t('broker_topstepx.facts_prereq_label'), value: t('broker_topstepx.facts_prereq_value') },
      { label: t('broker_topstepx.facts_credentials_label'), value: t('broker_topstepx.facts_credentials_value') },
      { label: t('broker_topstepx.facts_stages_label'), value: t('broker_topstepx.facts_stages_value') },
      { label: t('broker_topstepx.facts_speed_label'), value: t('broker_topstepx.facts_speed_value') },
      { label: t('broker_topstepx.facts_price_label'), value: t('broker_topstepx.facts_price_value') },
    ]}
    notSupportedHeading={t('broker_topstepx.not_supported_heading')}
    notSupported={[t('broker_topstepx.not_supported_1'), t('broker_topstepx.not_supported_2'), t('broker_topstepx.not_supported_3')]}
    reviewedBy={t('broker_topstepx.reviewed_by')}
    updatedLabel={t('broker_topstepx.updated_label')}
  />

  <!-- PickMyTrade Platform Section -->
  <section class="py-16 px-4 bg-[#001429]/30">
    <div class="max-w-6xl mx-auto">
      <div class="bg-gradient-to-br from-[#122B75]/40 via-[#0F3EC3]/20 to-[#122B75]/40 backdrop-blur-sm border border-[#2B77EE]/50 rounded-2xl p-8 md:p-12"
        data-aos="fade-up">
        <div class="text-center mb-8">
          <h2 class="text-3xl md:text-4xl font-bold mb-4 electrolize-regular">
            <i class="fa-solid fa-rocket text-[#7FB8F9] mr-3"></i>{t('broker_topstepx.platform_h2')}
          </h2>
          <p class="text-xl text-gray-300 max-w-3xl mx-auto">
            {t('broker_topstepx.platform_subtitle')}
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mb-8">
          <div>
            <h3 class="text-xl font-bold text-[#7FB8F9] mb-4">{t('broker_topstepx.platform_what_h3')}</h3>
            <p class="text-gray-300 leading-relaxed mb-4">
              {t('broker_topstepx.platform_what_p1')}
            </p>
            <p class="text-gray-300 leading-relaxed">
              {t('broker_topstepx.platform_what_p2')}
            </p>
          </div>

          <div>
            <h3 class="text-xl font-bold text-[#7FB8F9] mb-4">{t('broker_topstepx.platform_features_h3')}</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-bolt text-yellow-400 mt-1"></i>
                <span class="text-gray-300"><strong class="text-white">{t('broker_topstepx.platform_feat1_label')}</strong> {t('broker_topstepx.platform_feat1_text')}</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-shield-halved text-green-400 mt-1"></i>
                <span class="text-gray-300"><strong class="text-white">{t('broker_topstepx.platform_feat2_label')}</strong> {t('broker_topstepx.platform_feat2_text')}</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-chart-line text-blue-400 mt-1"></i>
                <span class="text-gray-300"><strong class="text-white">{t('broker_topstepx.platform_feat3_label')}</strong> {t('broker_topstepx.platform_feat3_text')}</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-clock text-purple-400 mt-1"></i>
                <span class="text-gray-300"><strong class="text-white">{t('broker_topstepx.platform_feat4_label')}</strong> {t('broker_topstepx.platform_feat4_text')}</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-headset text-cyan-400 mt-1"></i>
                <span class="text-gray-300"><strong class="text-white">{t('broker_topstepx.platform_feat5_label')}</strong> {t('broker_topstepx.platform_feat5_text')}</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-code-simple text-orange-400 mt-1"></i>
                <span class="text-gray-300"><strong class="text-white">{t('broker_topstepx.platform_feat6_label')}</strong> {t('broker_topstepx.platform_feat6_text')}</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="bg-[#001429]/50 border border-[#2B77EE]/30 rounded-xl p-6">
          <div class="grid md:grid-cols-3 gap-6 text-center">
            <div>
              <div class="text-3xl font-bold text-[#7FB8F9] mb-2">ProjectX</div>
              <div class="text-gray-400 text-sm">{t('broker_topstepx.platform_stat2_label')}</div>
            </div>
            <div>
              <div class="text-3xl font-bold text-[#7FB8F9] mb-2">99.9%</div>
              <div class="text-gray-400 text-sm">{t('broker_topstepx.platform_stat3_label')}</div>
            </div>
            <div>
              <div class="text-3xl font-bold text-[#7FB8F9] mb-2">$50</div>
              <div class="text-gray-400 text-sm">{t('broker_topstepx.platform_stat4_label')}</div>
            </div>
          </div>
        </div>

        <div class="text-center mt-8">
          <a href="https://app.pickmytrade.io/signup"
            class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-[#0F3EC3] to-[#2B77EE] rounded-lg text-white font-semibold text-lg hover:shadow-xl hover:shadow-[#2B77EE]/50 transition-all duration-300 transform hover:-translate-y-1">
            <i class="fa-solid fa-rocket"></i>
            {t('broker_topstepx.platform_cta')}
          </a>
          <p class="text-gray-400 text-sm mt-3">{t('broker_topstepx.platform_cta_note')}</p>
        </div>
      </div>
    </div>
  </section>


  <!-- About Section -->
  <section class="py-16 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="bg-gradient-to-br from-[#122B75]/40 via-[#0F3EC3]/20 to-[#122B75]/40 backdrop-blur-sm border border-[#2B77EE]/50 rounded-2xl p-8 md:p-12"
        data-aos="fade-up">
        <h2 class="text-3xl md:text-4xl font-bold mb-6 electrolize-regular">
          <i class="fa-solid fa-building text-[#7FB8F9] mr-3"></i>{t('broker_topstepx.about_h2')}
        </h2>

        <div class="grid md:grid-cols-2 gap-8 mb-8">
          <div>
            <h3 class="text-xl font-bold text-[#7FB8F9] mb-4">{t('broker_topstepx.about_overview_h3')}</h3>
            <p class="text-gray-300 leading-relaxed mb-4">
              {t('broker_topstepx.about_overview_p1')}
            </p>
            <p class="text-gray-300 leading-relaxed">
              {t('broker_topstepx.about_overview_p2')}
            </p>
          </div>

          <div>
            <h3 class="text-xl font-bold text-[#7FB8F9] mb-4">{t('broker_topstepx.about_features_h3')}</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check-circle text-green-400 mt-1"></i>
                <span class="text-gray-300"><strong class="text-white">{t('broker_topstepx.about_feat1_label')}</strong> $3000 (6%)</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check-circle text-green-400 mt-1"></i>
                <span class="text-gray-300"><strong class="text-white">{t('broker_topstepx.about_feat2_label')}</strong> $2000 (4%)</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check-circle text-green-400 mt-1"></i>
                <span class="text-gray-300"><strong class="text-white">{t('broker_topstepx.about_feat3_label')}</strong> {t('broker_topstepx.about_feat3_text')}</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check-circle text-green-400 mt-1"></i>
                <span class="text-gray-300"><strong class="text-white">{t('broker_topstepx.about_feat4_label')}</strong> {t('broker_topstepx.about_feat4_text')}</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check-circle text-green-400 mt-1"></i>
                <span class="text-gray-300"><strong class="text-white">{t('broker_topstepx.about_feat5_label')}</strong> {t('broker_topstepx.about_feat5_text')}</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check-circle text-green-400 mt-1"></i>
                <span class="text-gray-300"><strong class="text-white">{t('broker_topstepx.about_feat6_label')}</strong> {t('broker_topstepx.about_feat6_text')}</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="bg-[#001429]/50 border border-[#2B77EE]/30 rounded-xl p-6">
          <h3 class="text-xl font-bold text-[#7FB8F9] mb-4">
            <i class="fa-solid fa-robot mr-2"></i>{t('broker_topstepx.about_why_h3')}
          </h3>
          <div class="grid md:grid-cols-3 gap-6">
            <div>
              <h4 class="font-bold text-white mb-2">{t('broker_topstepx.about_why1_h4')}</h4>
              <p class="text-gray-400 text-sm">{t('broker_topstepx.about_why1_p')}</p>
            </div>
            <div>
              <h4 class="font-bold text-white mb-2">{t('broker_topstepx.about_why2_h4')}</h4>
              <p class="text-gray-400 text-sm">{t('broker_topstepx.about_why2_p')}</p>
            </div>
            <div>
              <h4 class="font-bold text-white mb-2">{t('broker_topstepx.about_why3_h4')}</h4>
              <p class="text-gray-400 text-sm">{t('broker_topstepx.about_why3_p')}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section: 5-step setup, alert example, contract mapping -->
  <section id="setup" class="py-16 px-4 bg-[#001429]/30">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-6 electrolize-regular" data-aos="fade-up">
        <i class="fa-solid fa-gears text-[#7FB8F9] mr-3"></i>{t('broker_topstepx.setup_h2')}
      </h2>
      <p class="text-gray-300 leading-relaxed mb-8 text-center">{t('broker_topstepx.setup_prereq')}</p>

      <ol class="space-y-4 mb-12">
        {[1, 2, 3, 4, 5].map((n) => (
          <li class="flex items-start gap-4 bg-gradient-to-br from-[#122B75]/40 to-[#0F3EC3]/20 backdrop-blur-sm border border-[#2B77EE]/50 rounded-xl p-5">
            <span class="flex-shrink-0 w-10 h-10 bg-gradient-to-br from-[#2B77EE] to-[#0F3EC3] rounded-full flex items-center justify-center text-lg font-bold">{n}</span>
            <div>
              <h3 class="text-lg font-bold text-white mb-1">{t(`broker_topstepx.setup_step${n}_h3` as TranslationKey)}</h3>
              <p class="text-gray-300 text-sm leading-relaxed">{t(`broker_topstepx.setup_step${n}_p` as TranslationKey)}</p>
            </div>
          </li>
        ))}
      </ol>

      <h2 id="alert-example" class="text-2xl md:text-3xl font-bold mb-4 text-white electrolize-regular">{t('broker_topstepx.alert_h2')}</h2>
      <p class="text-gray-300 leading-relaxed mb-4">{t('broker_topstepx.alert_intro')}</p>
      <div class="bg-[#000d1f] border border-[#2B77EE]/30 rounded-xl p-5 overflow-x-auto mb-4">
        <pre class="text-sm text-gray-200 whitespace-pre-wrap">{`{
  "symbol": "MNQ1!",
  "data": "buy",
  "quantity": 1,
  "price": "{{close}}",
  "tp": 0,
  "dollar_tp": 10,
  "sl": 0,
  "dollar_sl": 5,
  "token": "your_token_here"
}`}</pre>
      </div>
      <p class="text-gray-400 text-sm leading-relaxed mb-12">{t('broker_topstepx.alert_note')}</p>

      <h2 id="contract-ids" class="text-2xl md:text-3xl font-bold mb-4 text-white electrolize-regular">{t('broker_topstepx.contract_h2')}</h2>
      <p class="text-gray-300 leading-relaxed mb-4">{t('broker_topstepx.contract_intro')}</p>
      <div class="overflow-x-auto rounded-xl border border-[#2B77EE]/40 mb-4">
        <table class="w-full text-left text-sm sm:text-base">
          <thead>
            <tr class="bg-[#122B75]/40 text-[#7FB8F9]">
              <th class="px-4 py-3">{t('broker_topstepx.contract_th_tv')}</th>
              <th class="px-4 py-3">{t('broker_topstepx.contract_th_market')}</th>
              <th class="px-4 py-3">{t('broker_topstepx.contract_th_id')}</th>
            </tr>
          </thead>
          <tbody>
