---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AnswerBlock from '../../../components/AnswerBlock.astro';
import { getLocalePaths, localizedPath, useTranslations, absoluteLocalizedPath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);


const schema1 = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "PickMyTrade - TradingView to TradeLocker Automation & Copier",
    "image": "https://pickmytrade.io/assets/logo.png",
    "description": "Connect TradingView to TradeLocker with PickMyTrade. Automate TradingView alerts to TradeLocker and copy one signal to multiple TradeLocker accounts, no coding. PickMyTrade processes your order in under 200ms on our side; total fill time also depends on your broker, network, and TradingView alert speed.",
    "url": absoluteLocalizedPath(locale, 'broker/tradingview-to-tradelocker'),
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web-based, Windows, Mac, Linux",
    "offers": {
      "@type": "Offer",
      "price": "50.00",
      "priceCurrency": "USD",
      "priceValidUntil": "2026-12-31",
      "availability": "https://schema.org/InStock",
      "description": "$50 per month or $500 per year. 7-day free trial, no credit card required."
    },
    "publisher": {
      "@type": "Organization",
      "name": "PickMyTrade",
      "url": "https://pickmytrade.io",
      "logo": {
        "@type": "ImageObject",
        "url": "https://pickmytrade.io/assets/logo.png"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "support@pickmytrade.com",
        "contactType": "Customer Support",
        "availableLanguage": "English"
      },
      "sameAs": [
        "https://x.com/pickmytrade",
        "https://discord.gg/FkJ7g7498S",
        "https://www.instagram.com/pickmytrade",
        "https://www.youtube.com/@PickMyTrade",
        "https://www.linkedin.com/company/pickmytrade",
        "https://sourceforge.net/software/product/PickMyTrade/",
        "https://www.trustpilot.com/review/pickmytrade.trade"
      ]
    },
    "featureList": [
      "TradingView Alert Integration",
      "TradeLocker API Connectivity",
      "TradeLocker Trade Copier",
      "Forex Trading Automation",
      "CFD Trading Automation",
      "Automated Order Execution",
      "Multi-Account Management",
      "Risk Management Tools",
      "Stop Loss & Take Profit Automation",
      "No Coding Required"
    ]
  };
// NOTE: a Product+Brand+Offer block used to sit here restating the same $50/mo
// subscription that schema1 already models as SoftwareApplication. One URL, one
// primary entity type — Product also drags SaaS into Google's Merchant Listing
// checks for return/shipping data that cannot apply.
const schema3 = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://pickmytrade.io"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "TradingView to TradeLocker",
        "item": absoluteLocalizedPath(locale, 'broker/tradingview-to-tradelocker')
      }
    ]
  };
const schema4 = {
                  "@context": "https://schema.org",
                  "@type": "TechArticle",
                  "headline": "How to Connect TradingView to TradeLocker with PickMyTrade",
                  "name": "How to Connect TradingView to TradeLocker with PickMyTrade",
                  "description": "Connect TradingView to TradeLocker using PickMyTrade webhook alerts, with no coding. Set up automation and trade copying in about five minutes.",
                  "image": "https://pickmytrade.io/assets/logo.png",
                  "timeRequired": "PT5M",
                  "dependencies": "PickMyTrade account; TradeLocker account (demo or live); TradingView Pro, Pro+ or Premium (for webhook alerts)",
                  "articleSection": [
                    "Create your PickMyTrade account and get your webhook URL — Sign up for PickMyTrade and start the 7-day free trial. Generate your alert to get a unique webhook URL that TradingView will send signals to.",
                    "Add your TradeLocker credentials — Open the TradeLocker connection screen in PickMyTrade and enter your email, password, and server or broker environment. Choose demo or live.",
                    "Build the TradingView alert with the PMT JSON message — Generate the alert message in PickMyTrade, paste it into a TradingView alert, and set your PickMyTrade webhook URL in the alert's Notifications tab. Webhook alerts need a paid TradingView plan.",
                    "Fire a test alert and confirm the order in TradeLocker — Send one test alert, check the PickMyTrade alert log, and confirm the order landed in TradeLocker before enabling your live strategy."
                  ],
                  "proficiencyLevel": "Beginner",
                  "author": {
                    "@id": "https://pickmytrade.io/#organization"
                  },
                  "publisher": {
                    "@id": "https://pickmytrade.io/#organization"
                  }
                };
const schema5 = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Can you connect TradingView to TradeLocker?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. TradingView cannot place orders in TradeLocker on its own, but PickMyTrade connects the two using webhook alerts. When your TradingView alert fires, PickMyTrade receives it and places the matching order in your TradeLocker account automatically, with no coding and no computer left running. Most traders are live in about five minutes." } },
      { "@type": "Question", "name": "How do I connect TradeLocker to PickMyTrade / TradingView?", "acceptedAnswer": { "@type": "Answer", "text": "Create a PickMyTrade account, open the TradeLocker connection screen and enter your TradeLocker email, password, and server or broker environment, choosing demo or live. Then generate your alert message and webhook URL in PickMyTrade, create an alert in TradingView, paste the message into the alert box and the webhook URL into the alert's Notifications tab. Fire a test alert to confirm it works." } },
      { "@type": "Question", "name": "What credentials and information does TradeLocker require to connect?", "acceptedAnswer": { "@type": "Answer", "text": "PickMyTrade needs the same details you use to log in to TradeLocker: your email, your password, and your server or broker environment name. You also tell PickMyTrade whether the account is a demo or a live account. Because TradeLocker is offered through many brokers, the server value is what points PickMyTrade at the correct broker environment." } },
      { "@type": "Question", "name": "Where do I find my TradeLocker server name / broker environment?", "acceptedAnswer": { "@type": "Answer", "text": "Your server or environment name appears on the TradeLocker login screen, next to the email and password fields, on both the web and mobile apps. It is set by the broker that gave you the TradeLocker account. If you are not sure which one to use, open your broker's TradeLocker login page and copy the server value exactly as shown, or ask your broker's support which environment your account uses." } },
      { "@type": "Question", "name": "Do I need to know how to code to automate TradingView to TradeLocker?", "acceptedAnswer": { "@type": "Answer", "text": "No. PickMyTrade is a no-code tool. It generates the alert message and webhook URL for you, and all you do is paste them into a TradingView alert. There is nothing to program, no API keys to write, and no plugin to install." } },
      { "@type": "Question", "name": "Can I copy one TradingView signal to multiple TradeLocker accounts?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. PickMyTrade works as a TradeLocker trade copier, so a single TradingView alert can place the same trade across several TradeLocker accounts at once. Each account can have its own quantity multiplier (for example 0.5x, 1x and 2x from the same alert) or use risk-percentage sizing, so you can scale size up or down per account while keeping the same entry, stop-loss, and take-profit." } },
      { "@type": "Question", "name": "Can I test on a TradeLocker demo account before going live?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. When you add your TradeLocker credentials you choose demo or live, so you can connect a demo account and run your whole setup on paper first. Testing on demo is the safest way to confirm your alerts, symbol mapping, and sizing behave the way you expect before you risk real money." } },
      { "@type": "Question", "name": "What order types, stop loss and take profit options are supported?", "acceptedAnswer": { "@type": "Answer", "text": "On the webhook path PickMyTrade supports market and limit orders and lets you attach a stop-loss and a take-profit to the entry. You can also reverse or flip a position and send a close-all command. If your TradingView strategy manages its own exits, including multiple take-profits such as TP1 and TP2, let the strategy handle them and do not add extra stop-loss or take-profit settings in PickMyTrade; if it does not, set them once in PickMyTrade and every alert follows them." } },
      { "@type": "Question", "name": "Can I trade a different symbol than the one in my alert (symbol mapping)?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. PickMyTrade includes symbol mapping, so the symbol in your TradingView alert can be different from the symbol executed in TradeLocker. This is useful when your chart symbol and your broker's instrument name do not match exactly, and it lets you point one alert at the correct TradeLocker instrument. You can enter the symbol to trade directly in PickMyTrade; it is mandatory for stop-loss types such as Ticks or Total Profit/Loss, and if you leave it blank PickMyTrade uses the symbol from your TradingView chart." } },
      { "@type": "Question", "name": "Why did my trade fail to place / get rejected, and how do I fix it?", "acceptedAnswer": { "@type": "Answer", "text": "The most common causes are a symbol that does not match a symbol your broker lists, a position size larger than your account or broker allows, a closed market, or not enough margin. Connection issues are usually a wrong password or a server or environment value that does not match your TradeLocker login. Open the PickMyTrade alert log to see exactly what arrived and what the broker returned; that tells you whether the fix is in the TradingView alert, the PickMyTrade settings, or your broker account. If a trade never appears at all, confirm your TradingView plan is Pro or higher (free plans cannot send webhooks), that the webhook URL and the alert message are pasted into the right fields, that your TradeLocker connection is active, and that your strategy is actually generating signals. If you push trades to a different PickMyTrade account, also check its token." } },
      { "@type": "Question", "name": "Which assets and brokers on TradeLocker are supported?", "acceptedAnswer": { "@type": "Answer", "text": "PickMyTrade works with whatever instruments your TradeLocker broker offers, which usually means forex pairs (for example EUR/USD, GBP/USD, USD/JPY), CFDs, indices, commodities, and metals. Because TradeLocker is white-labelled by many brokers, your exact symbols, spreads, and hours come from your specific broker, and PickMyTrade routes the orders your alerts create to that account." } },
      { "@type": "Question", "name": "Does this work with prop firms that use TradeLocker, and what are the rules?", "acceptedAnswer": { "@type": "Answer", "text": "PickMyTrade can connect to a TradeLocker account whether it is personal, demo, or funded, and some prop firms do run on TradeLocker. Copy trading and automation rules vary by prop firm and change over time, so always confirm your firm's current policy before you automate. Firms differ on whether they allow webhook automation, how many accounts you may copy across, and how identical fills can be. PickMyTrade copies your own alerts across your own accounts, but staying inside each firm's rules is your responsibility." } },
      { "@type": "Question", "name": "How much does it cost and is there a free trial?", "acceptedAnswer": { "@type": "Answer", "text": "PickMyTrade is $50 per month or $500 per year, and every plan starts with a 7-day free trial with no credit card required. One subscription covers both single-account automation and the multi-account trade copier, plus 24/7 live support." } }
    ]
  };
---
<BaseLayout
  locale={locale}
  title={t('broker_tradelocker.page_title')}
  description={t('broker_tradelocker.page_description')}
  keywords={t('broker_tradelocker.page_keywords')}
  structuredData={[schema1, schema3, schema4, schema5]}
>
<!-- BREADCRUMB NAVIGATION -->
  <nav aria-label="Breadcrumb" class="bg-[#001429] pt-20 pb-3 sm:pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-5">
      <ol class="flex items-center flex-wrap gap-2 text-xs sm:text-sm text-gray-400" itemscope
        itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={localizedPath(locale)} class="hover:text-[#2B77EE] transition" itemprop="item">
            <span itemprop="name">{t('broker_tradelocker.breadcrumb_home')}</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="text-gray-600">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="text-white font-semibold" itemprop="name">{t('broker_tradelocker.breadcrumb_current')}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- HERO SECTION - REDESIGNED -->
  <header class="relative overflow-hidden bg-gradient-to-b from-[#001429] via-[#001f3f] to-[#002040]">
    <!-- Animated Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <canvas id="tradingCanvas" class="w-full h-full" aria-hidden="true"></canvas>
    </div>

    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#001429]/30 to-[#002040]"></div>

    <!-- Content Container -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-32 pb-20 sm:pb-28">
      <div class="text-center" data-aos="fade-up" data-aos-duration="800">

        <!-- Top Badge -->
        <div
          class="inline-flex items-center gap-2 mb-6 sm:mb-8 bg-gradient-to-r from-[#0F3EC3]/20 to-[#2B77EE]/20 backdrop-blur-sm border border-[#2B77EE]/30 rounded-full px-4 sm:px-6 py-2 sm:py-3"
          data-aos="fade-down" data-aos-delay="100">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#2B77EE] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#2B77EE]"></span>
          </span>
          <span class="text-xs sm:text-sm font-semibold text-[#7FB8F9] uppercase tracking-wider electrolize-regular">
            {t('broker_tradelocker.hero_badge')}
          </span>
          <i class="fa-solid fa-check-circle text-[#2B77EE]" aria-hidden="true"></i>
        </div>

        <!-- Main Heading -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold mb-6 sm:mb-8 leading-tight"
          data-aos="fade-up" data-aos-delay="200">
          <span class="block text-white mb-2">{t('broker_tradelocker.hero_title_line1')}</span>
          <span class="block bg-gradient-to-r from-[#2B77EE] via-[#4B94FF] to-[#7FB8F9] bg-clip-text text-transparent">
            {t('broker_tradelocker.hero_title_line2')}
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="max-w-3xl mx-auto text-base sm:text-lg md:text-xl lg:text-2xl text-gray-300 mb-8 sm:mb-10 leading-relaxed px-4"
          data-aos="fade-up" data-aos-delay="300">
          {t('broker_tradelocker.hero_subtitle_1')} <strong class="text-white">{t('broker_tradelocker.hero_subtitle_strong1')}</strong> {t('broker_tradelocker.hero_subtitle_2')} <strong
            class="text-white">{t('broker_tradelocker.hero_subtitle_strong2')}</strong> {t('broker_tradelocker.hero_subtitle_3')}
          <span class="block mt-2 text-[#7FB8F9]">{t('broker_tradelocker.hero_subtitle_span')}</span>
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-10 sm:mb-12 px-4" data-aos="fade-up"
          data-aos-delay="400">
          <a href="https://app.pickmytrade.io/?register=true" rel="noopener" aria-label={t('broker_tradelocker.hero_cta_start_aria')}
            class="group relative inline-flex items-center justify-center px-8 py-4 text-base sm:text-lg font-semibold text-white bg-gradient-to-r from-[#0F3EC3] to-[#2B77EE] rounded-xl overflow-hidden shadow-lg hover:shadow-[0_0_30px_5px_rgba(43,119,238,0.5)] transition-all duration-300 w-full sm:w-auto electrolize-regular">
            <span
              class="absolute inset-0 w-full h-full bg-gradient-to-r from-[#2B77EE] to-[#0F3EC3] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
            <span class="relative flex items-center gap-2">
              <i class="fa-solid fa-rocket" aria-hidden="true"></i>
              {t('broker_tradelocker.hero_cta_start')}
            </span>
          </a>

          <a href="https://app.pickmytrade.io" rel="noopener" aria-label={t('broker_tradelocker.hero_cta_login_aria')}
            class="group inline-flex items-center justify-center px-8 py-4 text-base sm:text-lg font-semibold text-[#2B77EE] bg-white/10 backdrop-blur-sm border-2 border-[#2B77EE]/50 rounded-xl hover:bg-white/20 hover:border-[#2B77EE] transition-all duration-300 w-full sm:w-auto electrolize-regular">
            <span class="flex items-center gap-2">
              <i class="fa-solid fa-sign-in-alt" aria-hidden="true"></i>
              {t('broker_tradelocker.hero_cta_login')}
            </span>
          </a>
        </div>

        <!-- Feature Pills -->
        <div class="flex flex-wrap justify-center gap-3 sm:gap-4 md:gap-6 text-sm sm:text-base" data-aos="fade-up"
          data-aos-delay="500">
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-check-circle text-green-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_tradelocker.hero_pill_trial')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-credit-card text-blue-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_tradelocker.hero_pill_card')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-infinity text-purple-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_tradelocker.hero_pill_unlimited')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-bolt text-yellow-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_tradelocker.hero_pill_instant')}</span>
          </div>
        </div>

        <!-- Trust Indicators -->
        <div class="mt-12 sm:mt-16 pt-8 border-t border-white/10" data-aos="fade-up" data-aos-delay="600">
          <p class="text-xs sm:text-sm text-gray-400 mb-4 uppercase tracking-wider">{t('broker_tradelocker.hero_trust_label')}</p>
          <div class="flex flex-wrap justify-center items-center gap-8 sm:gap-12">
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">{t('broker_tradelocker.hero_trust_rating_value')}</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('broker_tradelocker.hero_trust_rating_label')}</div>
            </div>
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">{t('broker_tradelocker.hero_trust_uptime_value')}</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('broker_tradelocker.hero_trust_uptime_label')}</div>
            </div>
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">{t('broker_tradelocker.hero_trust_setup_value')}</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('broker_tradelocker.hero_trust_setup_label')}</div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Smooth Wave Transition -->
    <div class="absolute bottom-0 left-0 right-0 z-20">
      <svg class="w-full h-16 sm:h-20 md:h-24" viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="none">
        <path
          d="M0,64L48,69.3C96,75,192,85,288,80C384,75,480,53,576,48C672,43,768,53,864,64C960,75,1056,85,1152,80C1248,75,1344,53,1392,42.7L1440,32L1440,120L1392,120C1344,120,1248,120,1152,120C1056,120,960,120,864,120C768,120,672,120,576,120C480,120,384,120,288,120C192,120,96,120,48,120L0,120Z"
          fill="url(#wave-gradient)" />
        <defs>
          <linearGradient id="wave-gradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#002040" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#002040" stop-opacity="1" />
          </linearGradient>
        </defs>
      </svg>
    </div>
  </header>

  <AnswerBlock
    locale={locale}
    answer={t('broker_tradelocker.answer_block')}
    factsHeading={t('broker_tradelocker.facts_heading')}
    asOfLabel={t('broker_tradelocker.facts_as_of')}
    asOfDate="2026-10-01"
    facts={[
      { label: t('broker_tradelocker.facts_connection_label'), value: t('broker_tradelocker.facts_connection_value') },
      { label: t('broker_tradelocker.facts_brokers_label'), value: t('broker_tradelocker.facts_brokers_value') },
      { label: t('broker_tradelocker.facts_accounts_label'), value: t('broker_tradelocker.facts_accounts_value') },
      { label: t('broker_tradelocker.facts_instruments_label'), value: t('broker_tradelocker.facts_instruments_value') },
      { label: t('broker_tradelocker.facts_orders_label'), value: t('broker_tradelocker.facts_orders_value') },
      { label: t('broker_tradelocker.facts_copier_label'), value: t('broker_tradelocker.facts_copier_value') },
      { label: t('broker_tradelocker.facts_tv_plan_label'), value: t('broker_tradelocker.facts_tv_plan_value') },
      { label: t('broker_tradelocker.facts_speed_label'), value: t('broker_tradelocker.facts_speed_value') },
      { label: t('broker_tradelocker.facts_price_label'), value: t('broker_tradelocker.facts_price_value') },
    ]}
    notSupportedHeading={t('broker_tradelocker.not_supported_heading')}
    notSupported={[t('broker_tradelocker.not_supported_1'), t('broker_tradelocker.not_supported_2'), t('broker_tradelocker.not_supported_3')]}
    reviewedBy={t('broker_tradelocker.reviewed_by')}
    updatedLabel={t('broker_tradelocker.updated_label')}
  />

  <!-- SEO CONTENT SECTION - MODERN -->
  <article
    class="relative py-16 sm:py-24 px-4 sm:px-5 bg-gradient-to-b from-[#002040] via-[#001429] to-[#002040] overflow-hidden">
    <!-- Background Decoration -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-20 left-10 w-72 h-72 bg-[#2B77EE] rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-[#0F3EC3] rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-12 sm:mb-16" data-aos="fade-up">
        <div
          class="inline-flex items-center gap-2 mb-4 bg-gradient-to-r from-[#0F3EC3]/20 to-[#2B77EE]/20 backdrop-blur-sm border border-[#2B77EE]/30 rounded-full px-4 py-2">
          <i class="fa-solid fa-info-circle text-[#2B77EE]"></i>
          <span
            class="text-xs sm:text-sm font-semibold text-[#7FB8F9] uppercase tracking-wider electrolize-regular">{t('broker_tradelocker.seo_badge')}</span>
        </div>
        <h2
          class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4 bg-gradient-to-r from-white via-[#7FB8F9] to-white bg-clip-text text-transparent">
          {t('broker_tradelocker.seo_title')}
        </h2>
        <p class="text-base sm:text-lg text-gray-400 max-w-3xl mx-auto">{t('broker_tradelocker.seo_subtitle')}</p>
      </div>

      <!-- Main Content Cards -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 mb-8 sm:mb-12">
        <!-- Card 1: What is it? -->
        <div
