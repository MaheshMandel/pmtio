---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AnswerBlock from '../../../components/AnswerBlock.astro';
import { getLocalePaths, localizedPath, useTranslations, absoluteLocalizedPath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);


const schema1 = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "image": "https://pickmytrade.io/assets/logo.png",
    "name": "PickMyTrade - TradingView to TradeStation Automation",
    "alternateName": "TradeStation Algorithmic Trading Platform",
    "description": "Automated trading platform connecting TradingView alerts to the TradeStation trading platform. Features TradeStation algorithmic trading, quick trade TradeStation options, TradeStation futures trading, and automated trading strategies for micro futures contracts. Comprehensive trading station platform integration for retail algorithmic trading.",
    "url": absoluteLocalizedPath(locale, 'broker/tradingview-to-tradestation'),
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web-based, Windows, Mac, Linux",
    "keywords": "tradestation algorithmic trading, tradestation trading platform, trading station platform, tradestation futures trading, quick trade tradestation options, tradestation retail algorithmic trading features, automated trading strategies micro futures contracts",
    "offers": {
      "@type": "Offer",
      "price": "50.00",
      "priceCurrency": "USD",
      "priceValidUntil": "2026-12-31",
      "availability": "https://schema.org/InStock",
      "description": "7-day free trial, no credit card required"
    },
    "publisher": {
      "@type": "Organization",
      "name": "PickMyTrade",
      "url": "https://pickmytrade.io",
      "logo": {
        "@type": "ImageObject",
        "url": "https://pickmytrade.io/assets/logo.png"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "support@pickmytrade.com",
        "contactType": "Customer Support",
        "availableLanguage": "English"
      },
    "sameAs": [
      "https://x.com/pickmytrade",
      "https://discord.gg/FkJ7g7498S",
      "https://www.instagram.com/pickmytrade",
      "https://www.youtube.com/@PickMyTrade",
      "https://www.linkedin.com/company/pickmytrade",
      "https://sourceforge.net/software/product/PickMyTrade/",
      "https://www.trustpilot.com/review/pickmytrade.trade",
      "https://blog.pickmytrade.io",
      "https://docs.pickmytrade.io"
    ]
  },
    "featureList": [
      "TradingView Alert Integration",
      "TradeStation Trading Platform Integration",
      "TradeStation Algorithmic Trading Support",
      "Quick Trade TradeStation Options",
      "TradeStation Futures Trading Automation",
      "Automated Trading Strategies for Micro Futures Contracts",
      "TradeStation Retail Algorithmic Trading Features",
      "Trading Station Platform Connectivity",
      "Stocks Trading Automation",
      "Forex Trading Automation",
      "Multi-Account Management",
      "Risk Management Tools",
      "Stop Loss & Take Profit Automation",
      "No Coding Required"
    ]
  };
const schema2 = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Does TradeStation support webhook automation?",
        "acceptedAnswer": { "@type": "Answer", "text": "TradeStation does not turn a raw TradingView webhook into a trade on its own. PickMyTrade sits between them: it receives the TradingView webhook and connects to your TradeStation account to place the order for you. So the practical answer is yes, you can run webhook-driven automation on TradeStation through PickMyTrade." }
      },
      {
        "@type": "Question",
        "name": "Do you need to code to automate TradeStation?",
        "acceptedAnswer": { "@type": "Answer", "text": "No. PickMyTrade generates the webhook URL and the alert message for you, so there is nothing to program. You copy, paste, and trade. If you can create an alert in TradingView, you can automate TradeStation." }
      },
      {
        "@type": "Question",
        "name": "What is a Webhook URL, and where do I find it?",
        "acceptedAnswer": { "@type": "Answer", "text": "A Webhook URL is the connection point for TradingView to send alerts to PickMyTrade. You can find it in PickMyTrade after generating an alert." }
      },
      {
        "@type": "Question",
        "name": "What's the difference between an Indicator and a Strategy alert type?",
        "acceptedAnswer": { "@type": "Answer", "text": "Indicator: Triggers from specific chart conditions (manual/semi-automated use). Strategy: Triggers from a full Pine Script strategy with entry and exit automation." }
      },
      {
        "@type": "Question",
        "name": "How do the Buy, Sell, and Close alerts work?",
        "acceptedAnswer": { "@type": "Answer", "text": "Buy Alert: Opens or adds to a long position; closes any open short position first. Sell Alert: Opens or adds to a short position; closes any open long position first. Close Alert: Closes all open positions and cancels pending orders." }
      },
      {
        "@type": "Question",
        "name": "What are the different ways I can configure Stop Loss and Take Profit?",
        "acceptedAnswer": { "@type": "Answer", "text": "You can configure Stop Loss and Take Profit using Point/Dollar, Percentage, Price (using TradingView plot variables), Ticks, or Total Profit/Loss per contract." }
      },
      {
        "@type": "Question",
        "name": "How do I set the trade size (quantity) for my alerts?",
        "acceptedAnswer": { "@type": "Answer", "text": "Quantity: Fixed contracts/shares per trade. Risk Percentage: Auto-sized based on account balance and stop-loss distance." }
      },
      {
        "@type": "Question",
        "name": "What settings do I need to configure for options alerts?",
        "acceptedAnswer": { "@type": "Answer", "text": "Option type (Call/Put), strike price logic (ATM, ITM, OTM, Strike Away), and expiry date." }
      },
      {
        "@type": "Question",
        "name": "Can I practice with paper trading before going live?",
        "acceptedAnswer": { "@type": "Answer", "text": "Absolutely! PickMyTrade supports both paper trading practice accounts and live trading accounts on TradeStation. This gives you the confidence to test your automated trading strategies thoroughly before risking real capital. Simply connect your TradeStation account and choose between Sim (paper trading) or Live mode during setup." }
      },
      {
        "@type": "Question",
        "name": "TradingView vs TradeStation - which should I choose?",
        "acceptedAnswer": { "@type": "Answer", "text": "When comparing TradingView vs TradeStation, consider that TradingView excels at charting and technical analysis with a social trading community, while TradeStation provides a comprehensive all-in-one platform with direct broker integration, advanced order execution, and powerful algorithmic trading capabilities. With PickMyTrade, you can leverage the best of both worlds — use TradingView's superior charting for signal generation while executing trades through TradeStation's robust trading infrastructure." }
      }
    ]
  };
const schema3 = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://pickmytrade.io/" },
      { "@type": "ListItem", "position": 2, "name": "Brokers", "item": absoluteLocalizedPath(locale, 'tradingview-automation') },
      { "@type": "ListItem", "position": 3, "name": "TradingView to TradeStation Automation", "item": absoluteLocalizedPath(locale, 'broker/tradingview-to-tradestation') }
    ]
  };
const schema4 = {
                  "@context": "https://schema.org",
                  "@type": "TechArticle",
                  "headline": "How to automate TradeStation with a TradingView webhook",
                  "name": "How to automate TradeStation with a TradingView webhook",
                  "description": "Connect TradingView alerts to TradeStation through PickMyTrade to auto-execute stock, options, futures, and forex orders. No coding required.",
                  "timeRequired": "PT10M",
                  "dependencies": "PickMyTrade account; TradeStation account (live or paper); TradingView Pro, Pro+, or Premium (for webhook alerts)",
                  "articleSection": [
                    "Connect your TradeStation account — Create a PickMyTrade account and connect your TradeStation account, live or paper. Set your default risk controls such as stop-loss, take-profit, and position size.",
                    "Generate your webhook URL and alert message — In PickMyTrade, generate the webhook URL and the alert message for your buy, sell, and close signals. There is no code to write.",
                    "Format the alert in TradingView — In TradingView, create an alert, delete the default text, paste the PickMyTrade message, and set the webhook URL in the alert's Notifications tab. Webhook alerts require a paid TradingView plan.",
                    "Go live — Fire a test alert, confirm the order in your PickMyTrade alert log and in TradeStation, then enable the alert. Every TradingView alert now routes to TradeStation automatically."
                  ],
                  "proficiencyLevel": "Beginner",
                  "author": {
                    "@id": "https://pickmytrade.io/#organization"
                  },
                  "publisher": {
                    "@id": "https://pickmytrade.io/#organization"
                  }
                };
---
<BaseLayout
  locale={locale}
  title={t('broker_tradestation.page_title')}
  description={t('broker_tradestation.page_description')}
  keywords={t('broker_tradestation.page_keywords')}
  structuredData={[schema1, schema2, schema3, schema4]}
>
<!-- Spacer for fixed navbar -->
  <!-- <div class="h-16"></div> -->

  <!-- BREADCRUMB NAVIGATION -->
  <nav aria-label="Breadcrumb" class="bg-[#001429] pt-20 pb-3 sm:pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-5">
      <ol class="flex items-center flex-wrap gap-2 text-xs sm:text-sm text-gray-400" itemscope
        itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={localizedPath(locale)} class="hover:text-[#2B77EE] transition" itemprop="item">
            <span itemprop="name">{t('broker_tradestation.breadcrumb_home')}</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="text-gray-600">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="text-white font-semibold" itemprop="name">{t('broker_tradestation.breadcrumb_current')}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- HERO SECTION - REDESIGNED -->
  <header class="relative overflow-hidden bg-gradient-to-b from-[#001429] via-[#001f3f] to-[#002040]">
    <!-- Animated Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <canvas id="tradingCanvas" class="w-full h-full" aria-hidden="true"></canvas>
    </div>

    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#001429]/30 to-[#002040]"></div>

    <!-- Content Container -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-32 pb-20 sm:pb-28">
      <div class="text-center" data-aos="fade-up" data-aos-duration="800">

        <!-- Top Badge -->
        <div
          class="inline-flex items-center gap-2 mb-6 sm:mb-8 bg-gradient-to-r from-[#0F3EC3]/20 to-[#2B77EE]/20 backdrop-blur-sm border border-[#2B77EE]/30 rounded-full px-4 sm:px-6 py-2 sm:py-3"
          data-aos="fade-down" data-aos-delay="100">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#2B77EE] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#2B77EE]"></span>
          </span>
          <span class="text-xs sm:text-sm font-semibold text-[#7FB8F9] uppercase tracking-wider electrolize-regular">
            {t('broker_tradestation.hero_badge')}
          </span>
          <i class="fa-solid fa-check-circle text-[#2B77EE]" aria-hidden="true"></i>
        </div>

        <!-- Main Heading -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold mb-6 sm:mb-8 leading-tight"
          data-aos="fade-up" data-aos-delay="200">
          <span class="block text-white mb-2">{t('broker_tradestation.hero_title_line1')}</span>
          <span class="block bg-gradient-to-r from-[#2B77EE] via-[#4B94FF] to-[#7FB8F9] bg-clip-text text-transparent">
            {t('broker_tradestation.hero_title_line2')}
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="max-w-3xl mx-auto text-base sm:text-lg md:text-xl lg:text-2xl text-gray-300 mb-8 sm:mb-10 leading-relaxed px-4"
          data-aos="fade-up" data-aos-delay="300">
          {t('broker_tradestation.hero_subtitle_1')}<strong class="text-white">{t('broker_tradestation.hero_subtitle_alerts')}</strong>{t('broker_tradestation.hero_subtitle_2')}<strong
            class="text-white">{t('broker_tradestation.hero_subtitle_platform')}</strong>{t('broker_tradestation.hero_subtitle_3')}
          <span class="block mt-2 text-[#7FB8F9]">{t('broker_tradestation.hero_subtitle_span')}</span>
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-10 sm:mb-12 px-4" data-aos="fade-up"
          data-aos-delay="400">
          <a href="https://app.pickmytrade.io/?register=true" rel="noopener" aria-label={t('broker_tradestation.hero_aria_signup')}
            class="group relative inline-flex items-center justify-center px-8 py-4 text-base sm:text-lg font-semibold text-white bg-gradient-to-r from-[#0F3EC3] to-[#2B77EE] rounded-xl overflow-hidden shadow-lg hover:shadow-[0_0_30px_5px_rgba(43,119,238,0.5)] transition-all duration-300 w-full sm:w-auto electrolize-regular">
            <span
              class="absolute inset-0 w-full h-full bg-gradient-to-r from-[#2B77EE] to-[#0F3EC3] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
            <span class="relative flex items-center gap-2">
              <i class="fa-solid fa-rocket" aria-hidden="true"></i>
              {t('broker_tradestation.hero_cta_start')}
            </span>
          </a>

          <a href="https://app.pickmytrade.io" rel="noopener" aria-label={t('broker_tradestation.hero_aria_login')}
            class="group inline-flex items-center justify-center px-8 py-4 text-base sm:text-lg font-semibold text-[#2B77EE] bg-white/10 backdrop-blur-sm border-2 border-[#2B77EE]/50 rounded-xl hover:bg-white/20 hover:border-[#2B77EE] transition-all duration-300 w-full sm:w-auto electrolize-regular">
            <span class="flex items-center gap-2">
              <i class="fa-solid fa-sign-in-alt" aria-hidden="true"></i>
              {t('broker_tradestation.hero_cta_login')}
            </span>
          </a>
        </div>

        <!-- Feature Pills -->
        <div class="flex flex-wrap justify-center gap-3 sm:gap-4 md:gap-6 text-sm sm:text-base" data-aos="fade-up"
          data-aos-delay="500">
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-check-circle text-green-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_tradestation.hero_pill_trial')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-credit-card text-blue-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_tradestation.hero_pill_nocard')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-infinity text-purple-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_tradestation.hero_pill_unlimited')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-bolt text-yellow-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_tradestation.hero_pill_instant')}</span>
          </div>
        </div>

        <!-- Trust Indicators -->
        <div class="mt-12 sm:mt-16 pt-8 border-t border-white/10" data-aos="fade-up" data-aos-delay="600">
          <p class="text-xs sm:text-sm text-gray-400 mb-4 uppercase tracking-wider">{t('broker_tradestation.hero_trust_label')}</p>
          <div class="flex flex-wrap justify-center items-center gap-8 sm:gap-12">
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">{t('broker_tradestation.hero_trust_rating_value')}</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('broker_tradestation.hero_trust_rating_label')}</div>
            </div>
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">{t('broker_tradestation.hero_trust_uptime_value')}</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('broker_tradestation.hero_trust_uptime_label')}</div>
            </div>
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">{t('broker_tradestation.hero_trust_setup_value')}</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('broker_tradestation.hero_trust_setup_label')}</div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Smooth Wave Transition -->
    <div class="absolute bottom-0 left-0 right-0 z-20">
      <svg class="w-full h-16 sm:h-20 md:h-24" viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="none">
        <path
          d="M0,64L48,69.3C96,75,192,85,288,80C384,75,480,53,576,48C672,43,768,53,864,64C960,75,1056,85,1152,80C1248,75,1344,53,1392,42.7L1440,32L1440,120L1392,120C1344,120,1248,120,1152,120C1056,120,960,120,864,120C768,120,672,120,576,120C480,120,384,120,288,120C192,120,96,120,48,120L0,120Z"
          fill="url(#wave-gradient)" />
        <defs>
          <linearGradient id="wave-gradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#002040" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#002040" stop-opacity="1" />
          </linearGradient>
        </defs>
      </svg>
    </div>
  </header>

  <AnswerBlock
    locale={locale}
    answer={t('broker_tradestation.answer_block')}
    factsHeading={t('broker_tradestation.facts_heading')}
    asOfLabel={t('broker_tradestation.facts_as_of')}
    asOfDate="2026-10-01"
    facts={[
      { label: t('broker_tradestation.facts_connection_label'), value: t('broker_tradestation.facts_connection_value') },
      { label: t('broker_tradestation.facts_accounts_label'), value: t('broker_tradestation.facts_accounts_value') },
      { label: t('broker_tradestation.facts_assets_label'), value: t('broker_tradestation.facts_assets_value') },
      { label: t('broker_tradestation.facts_tv_plan_label'), value: t('broker_tradestation.facts_tv_plan_value') },
      { label: t('broker_tradestation.facts_speed_label'), value: t('broker_tradestation.facts_speed_value') },
      { label: t('broker_tradestation.facts_price_label'), value: t('broker_tradestation.facts_price_value') },
    ]}
    notSupportedHeading={t('broker_tradestation.not_supported_heading')}
    notSupported={[t('broker_tradestation.not_supported_1'), t('broker_tradestation.not_supported_2'), t('broker_tradestation.not_supported_3')]}
    reviewedBy={t('broker_tradestation.reviewed_by')}
    updatedLabel={t('broker_tradestation.updated_label')}
  />

  <!-- SETUP + WEBHOOK EXAMPLE + AUTOMATE + FAQ + PRICING + RELATED -->
  <section class="relative py-16 sm:py-20 px-4 sm:px-5 bg-[#001429] overflow-hidden">
    <div class="relative z-10 max-w-5xl mx-auto space-y-16 sm:space-y-20">

      <!-- 3.2 Step-by-step setup -->
      <div id="setup" data-aos="fade-up">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-6 text-white">{t('broker_tradestation.setup4_h2')}</h2>
        <ol class="space-y-5">
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[#2B77EE] text-white font-bold flex items-center justify-center">1</span>
            <div>
              <h3 class="font-semibold text-white mb-1">{t('broker_tradestation.setup4_step1_title')}</h3>
              <p class="text-gray-300 leading-relaxed">{t('broker_tradestation.setup4_step1_body')}</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[#2B77EE] text-white font-bold flex items-center justify-center">2</span>
            <div>
              <h3 class="font-semibold text-white mb-1">{t('broker_tradestation.setup4_step2_title')}</h3>
              <p class="text-gray-300 leading-relaxed">{t('broker_tradestation.setup4_step2_body')}</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[#2B77EE] text-white font-bold flex items-center justify-center">3</span>
            <div>
              <h3 class="font-semibold text-white mb-1">{t('broker_tradestation.setup4_step3_title')}</h3>
              <p class="text-gray-300 leading-relaxed">{t('broker_tradestation.setup4_step3_body')}</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[#2B77EE] text-white font-bold flex items-center justify-center">4</span>
            <div>
              <h3 class="font-semibold text-white mb-1">{t('broker_tradestation.setup4_step4_title')}</h3>
              <p class="text-gray-300 leading-relaxed">{t('broker_tradestation.setup4_step4_body')}</p>
            </div>
          </li>
        </ol>
      </div>

      <!-- 3.3 Webhook / alert example -->
      <div data-aos="fade-up">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-5 text-white">{t('broker_tradestation.webhook_h2')}</h2>
        <p class="text-gray-300 leading-relaxed mb-5">{t('broker_tradestation.webhook_intro')}</p>
        <div class="bg-[#000d1f] border border-[#2B77EE]/30 rounded-xl p-5 overflow-x-auto">
          <p class="text-xs uppercase tracking-wider text-gray-400 mb-1">{t('broker_tradestation.webhook_url_label')}</p>
          <code class="block text-sm text-[#7FB8F9] mb-4 break-all">https://pickmytrade.io/webhook/... (use the exact URL PickMyTrade shows for your account)</code>
          <p class="text-xs uppercase tracking-wider text-gray-400 mb-1">{t('broker_tradestation.webhook_msg_label')}</p>
          <pre class="text-sm text-gray-200 whitespace-pre-wrap">{`{
  "symbol": "AAPL",
  "action": "buy",
  "quantity": 10,
  "order_type": "market",
  "token": "your-pickmytrade-token"
}`}</pre>
        </div>
        <p class="text-gray-300 leading-relaxed mt-5">{t('broker_tradestation.webhook_outro')}</p>
      </div>

      <!-- 3.4 What you can automate -->
      <div data-aos="fade-up">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-5 text-white">{t('broker_tradestation.automate_h2')}</h2>
        <p class="text-gray-300 leading-relaxed mb-4">{t('broker_tradestation.automate_intro')}</p>
