---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AnswerBlock from '../../../components/AnswerBlock.astro';
import { getLocalePaths, localizedPath, useTranslations, absoluteLocalizedPath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);


const schema1 = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "image": "https://pickmytrade.io/assets/logo.png",
    "name": "PickMyTrade - TradingView to Tradier Automation",
    "alternateName": "Tradier Stock Trading Bot",
    "description": "Automated trading system for Tradier Brokerage connecting TradingView alerts to Tradier accounts. Full support for Tradier API automation, algorithmic trading, and real-time execution. Works with Tradier trading platform for stocks, options, and ETFs.",
    "url": absoluteLocalizedPath(locale, 'broker/tradingview-to-tradier'),
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web-based, Windows, Mac, Linux",
    "keywords": "tradier automated trading, tradier trading bot, tradier api trading, tradier algorithmic trading, tradier brokerage automation, automated stock trading tradier, tradier options bot, tradier trade copier, automate tradier trades",
    "offers": {
      "@type": "Offer",
      "price": "50.00",
      "priceCurrency": "USD",
      "priceValidUntil": "2026-12-31",
      "availability": "https://schema.org/InStock",
      "description": "$50 per month or $500 per year. 7-day free trial, no credit card required."
    },
    "publisher": {
      "@type": "Organization",
      "name": "PickMyTrade",
      "url": "https://pickmytrade.io",
      "logo": {
        "@type": "ImageObject",
        "url": "https://pickmytrade.io/assets/logo.png"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "support@pickmytrade.com",
        "contactType": "Customer Support",
        "availableLanguage": "English"
      },
    "sameAs": [
      "https://x.com/pickmytrade",
      "https://discord.gg/FkJ7g7498S",
      "https://www.instagram.com/pickmytrade",
      "https://www.youtube.com/@PickMyTrade",
      "https://www.linkedin.com/company/pickmytrade",
      "https://sourceforge.net/software/product/PickMyTrade/",
      "https://www.trustpilot.com/review/pickmytrade.trade",
      "https://blog.pickmytrade.io",
      "https://docs.pickmytrade.io"
    ]
  },
    "featureList": [
      "TradingView Alert Integration",
      "Tradier API Connectivity",
      "Automated Order Execution for Tradier",
      "Stock & Options Trading Automation",
      "Tradier Brokerage Integration",
      "Real-time Trade Execution",
      "Multi Account Management",
      "Tradier Auto Trading System",
      "Risk Management Tools",
      "Stop Loss & Take Profit Automation",
      "No Coding Required"
    ]
  };
const schema2 = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1","h2",".faq-question",".faq-answer","summary","details > div","details > p"] },
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can you connect TradingView to Tradier?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. PickMyTrade connects TradingView to your Tradier brokerage account using webhook alerts. When a TradingView alert fires, PickMyTrade reads it and places the matching stock or options order on Tradier automatically. No coding is required, and you can start with a 7-day free trial." }
      },
      {
        "@type": "Question",
        "name": "How do you automate Tradier with a TradingView webhook?",
        "acceptedAnswer": { "@type": "Answer", "text": "Connect your Tradier account inside PickMyTrade with your API access, generate the alert message and webhook URL in PickMyTrade, then paste them into a TradingView alert. When the alert triggers, TradingView sends the webhook to PickMyTrade, which processes the order in under 200ms on our side and routes it to Tradier. Webhook alerts require a paid TradingView plan (Pro, Pro+, or Premium)." }
      },
      {
        "@type": "Question",
        "name": "Can you trade options and stocks on Tradier through automation?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. PickMyTrade can automate both equities (stocks and ETFs) and options orders on Tradier from your TradingView alerts. You can send market, limit, and stop orders and size each one by a fixed quantity or by risk. For advanced multi-leg option strategies, check the current supported order types in the Tradier broker FAQ before going live." }
      },
      {
        "@type": "Question",
        "name": "Do you need to code to automate Tradier?",
        "acceptedAnswer": { "@type": "Answer", "text": "No. PickMyTrade is a no-code tool. You connect Tradier, generate a webhook, and paste it into a TradingView alert. There is no need to learn the Tradier API or write any scripts." }
      },
      {
        "@type": "Question",
        "name": "How much does it cost and is there a trial?",
        "acceptedAnswer": { "@type": "Answer", "text": "PickMyTrade is $50 per month or $500 per year, and every account starts with a 7-day free trial with no credit card required. One subscription covers your Tradier automation, with 24/7 live support." }
      },
      {
        "@type": "Question",
        "name": "Is my Tradier API key secure?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, your Tradier API keys are encrypted using bank-level security and stored in secure servers. We never have withdrawal permissions and use read-only access where possible."
        }
      },
      {
        "@type": "Question",
        "name": "Can I use Tradier sandbox for testing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, PickMyTrade supports Tradier's sandbox environment, allowing you to test your automated strategies before trading with real capital."
        }
      },
      {
        "@type": "Question",
        "name": "Does Tradier charge commissions?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tradier offers commission-free stock trading. Options trades are charged per contract. Check with Tradier for current pricing."
        }
      }
    ]
  };
const schema3 = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://pickmytrade.io"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "TradingView to Tradier",
        "item": absoluteLocalizedPath(locale, 'broker/tradingview-to-tradier')
      }
    ]
  };
const schema4 = {
                  "@context": "https://schema.org",
                  "@type": "TechArticle",
                  "headline": "How to automate Tradier from TradingView with PickMyTrade",
                  "name": "How to automate Tradier from TradingView with PickMyTrade",
                  "description": "Connect Tradier to PickMyTrade, generate a webhook, paste it into a TradingView alert, and place live stock and options orders on Tradier automatically. No coding required.",
                  "image": "https://pickmytrade.io/assets/logo.png",
                  "timeRequired": "PT5M",
                  "dependencies": "PickMyTrade account; Tradier brokerage account (with API access); TradingView Pro, Pro+ or Premium (for webhook alerts)",
                  "articleSection": [
                    "Connect Tradier — Create a PickMyTrade account and link your Tradier account with API access. Enable trading permissions. Optionally point it at Tradier's sandbox to test first.",
                    "Generate your webhook — In PickMyTrade, generate the alert message and webhook URL for your Tradier order. There is nothing to code.",
                    "Format the alert in TradingView — Create a TradingView alert, delete the default text, paste the PickMyTrade message, and set the PickMyTrade webhook URL in the alert's Notifications tab. Webhook alerts need a paid TradingView plan.",
                    "Go live — Fire a test alert, confirm the order in your PickMyTrade alert log and in Tradier, then enable the alert. Signals now execute on Tradier automatically, 24/7."
                  ],
                  "proficiencyLevel": "Beginner",
                  "author": {
                    "@id": "https://pickmytrade.io/#organization"
                  },
                  "publisher": {
                    "@id": "https://pickmytrade.io/#organization"
                  }
                };
---
<BaseLayout
  locale={locale}
  title={t('broker_tradier.page_title')}
  description={t('broker_tradier.page_description')}
  keywords={t('broker_tradier.page_keywords')}
  structuredData={[schema1, schema2, schema3, schema4]}
>
<nav aria-label="Breadcrumb" class="bg-[#001429] pt-20 pb-3 sm:pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-5">
      <ol class="flex items-center flex-wrap gap-2 text-xs sm:text-sm text-gray-400" itemscope
        itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={localizedPath(locale)} class="hover:text-[#2B77EE] transition" itemprop="item">
            <span itemprop="name">{t('broker_tradier.breadcrumb_home')}</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="text-gray-600">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="text-white font-semibold" itemprop="name">{t('broker_tradier.breadcrumb_current')}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- HERO SECTION - REDESIGNED -->
  <header class="relative overflow-hidden bg-gradient-to-b from-[#001429] via-[#001f3f] to-[#002040]">
    <!-- Animated Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <canvas id="tradingCanvas" class="w-full h-full" aria-hidden="true"></canvas>
    </div>

    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#001429]/30 to-[#002040]"></div>

    <!-- Content Container -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-32 pb-20 sm:pb-28">
      <div class="text-center" data-aos="fade-up" data-aos-duration="800">

        <!-- Top Badge -->
        <div
          class="inline-flex items-center gap-2 mb-6 sm:mb-8 bg-gradient-to-r from-[#0F3EC3]/20 to-[#2B77EE]/20 backdrop-blur-sm border border-[#2B77EE]/30 rounded-full px-4 sm:px-6 py-2 sm:py-3"
          data-aos="fade-down" data-aos-delay="100">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#2B77EE] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#2B77EE]"></span>
          </span>
          <span class="text-xs sm:text-sm font-semibold text-[#7FB8F9] uppercase tracking-wider electrolize-regular">
            {t('broker_tradier.hero_badge')}
          </span>
          <i class="fa-solid fa-check-circle text-[#2B77EE]" aria-hidden="true"></i>
        </div>

        <!-- Main Heading -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold mb-6 sm:mb-8 leading-tight"
          data-aos="fade-up" data-aos-delay="200">
          <span class="block text-white mb-2">{t('broker_tradier.hero_title_line1')}</span>
          <span class="block bg-gradient-to-r from-[#2B77EE] via-[#4B94FF] to-[#7FB8F9] bg-clip-text text-transparent">
            {t('broker_tradier.hero_title_line2')}
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="max-w-3xl mx-auto text-base sm:text-lg md:text-xl lg:text-2xl text-gray-300 mb-8 sm:mb-10 leading-relaxed px-4"
          data-aos="fade-up" data-aos-delay="300">
          {t('broker_tradier.hero_subtitle_pre')} <strong class="text-white">{t('broker_tradier.hero_subtitle_strong1')}</strong> {t('broker_tradier.hero_subtitle_mid')} <strong
            class="text-white">{t('broker_tradier.hero_subtitle_strong2')}</strong> {t('broker_tradier.hero_subtitle_post')}
          <span class="block mt-2 text-[#7FB8F9]">{t('broker_tradier.hero_subtitle_line2')}</span>
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-10 sm:mb-12 px-4" data-aos="fade-up"
          data-aos-delay="400">
          <a href="https://app.pickmytrade.io/?register=true" rel="noopener" aria-label={t('broker_tradier.hero_cta_primary_aria')}
            class="group relative inline-flex items-center justify-center px-8 py-4 text-base sm:text-lg font-semibold text-white bg-gradient-to-r from-[#0F3EC3] to-[#2B77EE] rounded-xl overflow-hidden shadow-lg hover:shadow-[0_0_30px_5px_rgba(43,119,238,0.5)] transition-all duration-300 w-full sm:w-auto electrolize-regular">
            <span
              class="absolute inset-0 w-full h-full bg-gradient-to-r from-[#2B77EE] to-[#0F3EC3] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
            <span class="relative flex items-center gap-2">
              <i class="fa-solid fa-rocket" aria-hidden="true"></i>
              {t('broker_tradier.hero_cta_primary')}
            </span>
          </a>

          <a href="https://app.pickmytrade.io" rel="noopener" aria-label={t('broker_tradier.hero_cta_secondary_aria')}
            class="group inline-flex items-center justify-center px-8 py-4 text-base sm:text-lg font-semibold text-[#2B77EE] bg-white/10 backdrop-blur-sm border-2 border-[#2B77EE]/50 rounded-xl hover:bg-white/20 hover:border-[#2B77EE] transition-all duration-300 w-full sm:w-auto electrolize-regular">
            <span class="flex items-center gap-2">
              <i class="fa-solid fa-sign-in-alt" aria-hidden="true"></i>
              {t('broker_tradier.hero_cta_secondary')}
            </span>
          </a>
        </div>

        <!-- Feature Pills -->
        <div class="flex flex-wrap justify-center gap-3 sm:gap-4 md:gap-6 text-sm sm:text-base" data-aos="fade-up"
          data-aos-delay="500">
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-check-circle text-green-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_tradier.pill_trial')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-credit-card text-blue-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_tradier.pill_no_card')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-chart-line text-yellow-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_tradier.pill_stocks_options')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-bolt text-yellow-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('broker_tradier.pill_instant')}</span>
          </div>
        </div>

        <!-- Trust Indicators -->
        <div class="mt-12 sm:mt-16 pt-8 border-t border-white/10" data-aos="fade-up" data-aos-delay="600">
          <p class="text-xs sm:text-sm text-gray-400 mb-4 uppercase tracking-wider">{t('broker_tradier.trust_heading')}</p>
          <div class="flex flex-wrap justify-center items-center gap-8 sm:gap-12">
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">{t('broker_tradier.trust_rating_value')}</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('broker_tradier.trust_rating_label')}</div>
            </div>
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">{t('broker_tradier.trust_uptime_value')}</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('broker_tradier.trust_uptime_label')}</div>
            </div>
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">{t('broker_tradier.trust_setup_value')}</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('broker_tradier.trust_setup_label')}</div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Smooth Wave Transition -->
    <div class="absolute bottom-0 left-0 right-0 z-20">
      <svg class="w-full h-16 sm:h-20 md:h-24" viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="none">
        <path
          d="M0,64L48,69.3C96,75,192,85,288,80C384,75,480,53,576,48C672,43,768,53,864,64C960,75,1056,85,1152,80C1248,75,1344,53,1392,42.7L1440,32L1440,120L1392,120C1344,120,1248,120,1152,120C1056,120,960,120,864,120C768,120,672,120,576,120C480,120,384,120,288,120C192,120,96,120,48,120L0,120Z"
          fill="url(#wave-gradient)" />
        <defs>
          <linearGradient id="wave-gradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#002040" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#002040" stop-opacity="1" />
          </linearGradient>
        </defs>
      </svg>
    </div>
  </header>

  <AnswerBlock
    locale={locale}
    answer={t('broker_tradier.answer_block')}
    factsHeading={t('broker_tradier.facts_heading')}
    asOfLabel={t('broker_tradier.facts_as_of')}
    asOfDate="2026-10-01"
    facts={[
      { label: t('broker_tradier.facts_connection_label'), value: t('broker_tradier.facts_connection_value') },
      { label: t('broker_tradier.facts_instruments_label'), value: t('broker_tradier.facts_instruments_value') },
      { label: t('broker_tradier.facts_options_label'), value: t('broker_tradier.facts_options_value') },
      { label: t('broker_tradier.facts_order_types_label'), value: t('broker_tradier.facts_order_types_value') },
      { label: t('broker_tradier.facts_tv_plan_label'), value: t('broker_tradier.facts_tv_plan_value') },
      { label: t('broker_tradier.facts_status_label'), value: t('broker_tradier.facts_status_value') },
      { label: t('broker_tradier.facts_price_label'), value: t('broker_tradier.facts_price_value') },
    ]}
    notSupportedHeading={t('broker_tradier.not_supported_heading')}
    notSupported={[t('broker_tradier.not_supported_1'), t('broker_tradier.not_supported_2'), t('broker_tradier.not_supported_3')]}
    reviewedBy={t('broker_tradier.reviewed_by')}
    updatedLabel={t('broker_tradier.updated_label')}
  />

  <!-- Benefits Section -->
  <section id="benefits" class="relative py-16 sm:py-24 px-4 sm:px-5 bg-gradient-to-b from-[#002040] via-[#001429] to-[#002040] overflow-hidden">
    <!-- Background Decoration -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-20 left-10 w-72 h-72 bg-[#2B77EE] rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-[#0F3EC3] rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-12 sm:mb-16" data-aos="fade-up">
        <div
          class="inline-flex items-center gap-2 mb-4 bg-gradient-to-r from-[#0F3EC3]/20 to-[#2B77EE]/20 backdrop-blur-sm border border-[#2B77EE]/30 rounded-full px-4 py-2">
          <i class="fa-solid fa-star text-[#2B77EE]"></i>
          <span class="text-sm font-semibold text-[#7FB8F9] uppercase tracking-wider">{t('broker_tradier.benefits_badge')}</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 electrolize-regular">
          <span class="bg-gradient-to-r from-white via-gray-200 to-white bg-clip-text text-transparent">
            {t('broker_tradier.benefits_title')}
          </span>
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        <div class="group bg-[#001429]/50 rounded-xl p-6 border border-[#2B77EE]/30 hover:border-[#2B77EE] transition-all duration-300 hover:bg-[#001429]/80" data-aos="fade-up">
          <div class="text-4xl mb-4 text-[#2B77EE] group-hover:scale-110 transition-transform duration-300">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 text-white">{t('broker_tradier.benefit1_title')}</h3>
          <p class="text-gray-400">{t('broker_tradier.benefit1_desc')}</p>
        </div>

        <div class="group bg-[#001429]/50 rounded-xl p-6 border border-[#2B77EE]/30 hover:border-[#2B77EE] transition-all duration-300 hover:bg-[#001429]/80" data-aos="fade-up" data-aos-delay="100">
          <div class="text-4xl mb-4 text-[#2B77EE] group-hover:scale-110 transition-transform duration-300">
            <i class="fa-solid fa-chart-candlestick"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 text-white">{t('broker_tradier.benefit2_title')}</h3>
          <p class="text-gray-400">{t('broker_tradier.benefit2_desc')}</p>
        </div>

        <div class="group bg-[#001429]/50 rounded-xl p-6 border border-[#2B77EE]/30 hover:border-[#2B77EE] transition-all duration-300 hover:bg-[#001429]/80" data-aos="fade-up" data-aos-delay="200">
          <div class="text-4xl mb-4 text-[#2B77EE] group-hover:scale-110 transition-transform duration-300">
            <i class="fa-solid fa-shield-halved"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 text-white">{t('broker_tradier.benefit3_title')}</h3>
          <p class="text-gray-400">{t('broker_tradier.benefit3_desc')}</p>
        </div>

        <div class="group bg-[#001429]/50 rounded-xl p-6 border border-[#2B77EE]/30 hover:border-[#2B77EE] transition-all duration-300 hover:bg-[#001429]/80" data-aos="fade-up">
          <div class="text-4xl mb-4 text-[#2B77EE] group-hover:scale-110 transition-transform duration-300">
            <i class="fa-solid fa-code-slash"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 text-white">{t('broker_tradier.benefit4_title')}</h3>
          <p class="text-gray-400">{t('broker_tradier.benefit4_desc')}</p>
        </div>

        <div class="group bg-[#001429]/50 rounded-xl p-6 border border-[#2B77EE]/30 hover:border-[#2B77EE] transition-all duration-300 hover:bg-[#001429]/80" data-aos="fade-up" data-aos-delay="100">
          <div class="text-4xl mb-4 text-[#2B77EE] group-hover:scale-110 transition-transform duration-300">
            <i class="fa-solid fa-vial"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 text-white">{t('broker_tradier.benefit5_title')}</h3>
