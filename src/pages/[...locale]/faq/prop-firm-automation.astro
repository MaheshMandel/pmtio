---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FaqList from "../../../components/FaqList.astro";
import {
  getLocalePaths,
  localizedPath,
  absoluteLocalizedPath,
  useTranslations,
} from "../../../i18n/utils";
import { LOCALE_BCP47, type Locale } from "../../../i18n/config";
import { SPOKES, answerParams, stripHtml } from "../../../data/faqItems";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const SLUG = "prop-firm-automation";
const spoke = SPOKES.find((s) => s.slug === SLUG)!;
// Spoke chrome (meta/hero/card) lives under this spoke's i18n namespace.
const ts = (k: string, params?: Record<string, string>) => t(`${spoke.ns}.${k}` as any, params);
const pageUrl = absoluteLocalizedPath(locale, `faq/${SLUG}`);

// Internal link targets used inside the new guide sections below (Part 5 outbound links).
const linkApex = localizedPath(locale, "propfirms/apex-trader-funding");
const linkTopstep = localizedPath(locale, "propfirms/topstep");
const linkTPT = localizedPath(locale, "propfirms/take-profit-trader");
const linkFundedNext = localizedPath(locale, "propfirms/fundednext");
const linkTradeify = localizedPath(locale, "propfirms/tradeify");
const linkPricing = localizedPath(locale, "pricing");
const linkAutomatedFutures = localizedPath(locale, "faq/automated-futures-trading");
const linkTradeCopierHub = localizedPath(locale, "prop-firm-trade-copier");
const SIGNUP_URL = "https://app.pickmytrade.io/?register=true";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: t("general_faq.breadcrumb_home"), item: absoluteLocalizedPath(locale) },
      { "@type": "ListItem", position: 2, name: t("faq_hub.breadcrumb"), item: absoluteLocalizedPath(locale, "general-faq") },
      { "@type": "ListItem", position: 3, name: ts("breadcrumb"), item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    inLanguage: LOCALE_BCP47[locale],
    speakable: {
      "@type": "SpeakableSpecification",
      cssSelector: [".faq-question", ".faq-answer"],
    },
    mainEntity: spoke.ids.map((id) => ({
      "@type": "Question",
      name: t(`general_faq.faq_q${id}` as any),
      acceptedAnswer: {
        "@type": "Answer",
        text: stripHtml(t(`general_faq.faq_a${id}` as any, answerParams(locale, id))),
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: ts("meta_title"),
    description: ts("meta_description"),
    image: "https://pickmytrade.io/logo.png",
    author: { "@type": "Organization", name: "PickMyTrade", url: "https://pickmytrade.io" },
    publisher: {
      "@type": "Organization",
      name: "PickMyTrade",
      logo: { "@type": "ImageObject", url: "https://pickmytrade.io/logo.png" },
    },
    datePublished: "2026-07-16",
    dateModified: "2026-07-16",
    mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "PickMyTrade",
    url: "https://pickmytrade.io",
    logo: "https://pickmytrade.io/logo.png",
    description:
      "PickMyTrade automates TradingView strategies to futures brokers and prop firm accounts on Tradovate, Rithmic, and ProjectX, with multi-account copy trading. Used by 50,000+ traders across 28M+ trades.",
    contactPoint: {
      "@type": "ContactPoint",
      email: "support@pickmytrade.com",
      contactType: "Customer Support",
      availableLanguage: "English",
    },
    // Plain profile links only. No AggregateRating / ratingValue / reviewCount / Review anywhere on this page.
    sameAs: [
      "https://x.com/pickmytrade",
      "https://discord.gg/FkJ7g7498S",
      "https://www.instagram.com/pickmytrade",
      "https://www.youtube.com/@PickMyTrade",
      "https://www.linkedin.com/company/pickmytrade",
      "https://sourceforge.net/software/product/PickMyTrade/",
      "https://www.trustpilot.com/review/pickmytrade.trade",
    ],
  },
];
---

<BaseLayout
  locale={locale}
  title={ts("meta_title")}
  description={ts("meta_description")}
  keywords={ts("meta_keywords")}
  canonical={pageUrl}
  structuredData={structuredData}
>
  <main id="main-content" role="main">
    <!-- Hero -->
    <section class="bg-gradient-to-b from-[#001429] via-[#001f3f] to-[#002040] pt-28 pb-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <nav aria-label="Breadcrumb" class="flex justify-center mb-6" data-aos="fade-down">
          <ol class="flex items-center space-x-2 text-sm text-gray-400">
            <li><a href={localizedPath(locale, "")} class="hover:text-[#2B77EE] transition-colors">{t("general_faq.breadcrumb_home")}</a></li>
            <li><i class="fa-solid fa-chevron-right text-xs text-gray-600"></i></li>
            <li><a href={localizedPath(locale, "general-faq")} class="hover:text-[#2B77EE] transition-colors">{t("faq_hub.breadcrumb")}</a></li>
            <li><i class="fa-solid fa-chevron-right text-xs text-gray-600"></i></li>
            <li class="text-[#2B77EE]">{ts("breadcrumb")}</li>
          </ol>
        </nav>
        <span class="inline-block px-4 py-1.5 rounded-full bg-[#2B77EE]/10 border border-[#2B77EE]/30 text-[#2B77EE] text-xs font-semibold uppercase tracking-wider mb-5" data-aos="fade-up">
          <i class={`${spoke.icon} mr-1.5`} aria-hidden="true"></i>{t("faq_hub.badge")}
        </span>
        <h1 class="text-3xl md:text-5xl font-bold mb-6 leading-tight text-white" data-aos="fade-up">
          {ts("hero_title")}
        </h1>
        <p class="text-gray-300 text-lg md:text-xl max-w-3xl mx-auto mb-8" data-aos="fade-up" data-aos-delay="100">
          {ts("hero_subtitle")}
        </p>
        <div class="flex flex-wrap gap-4 justify-center" data-aos="fade-up" data-aos-delay="200">
          <a href="https://app.pickmytrade.io/?register=true" class="px-8 py-3 bg-[#2B77EE] hover:bg-blue-600 text-white font-semibold rounded-xl transition-all duration-300 shadow-lg shadow-blue-500/25">
            {t("general_faq.cta_start_trial")}<i class="fa-solid fa-arrow-right ml-2"></i>
          </a>
          <a href="#faq" class="px-8 py-3 border border-white/20 hover:border-[#2B77EE]/50 text-white font-semibold rounded-xl transition-all duration-300 hover:bg-white/5">
            {t("general_faq.hero_browse")}<i class="fa-solid fa-chevron-down ml-2"></i>
          </a>
        </div>
      </div>
    </section>

    <!-- Guide: prop firm automation policies, per-firm rules, consistency rule, compliant setup -->
    <section class="bg-[#001429] py-16 border-t border-white/5">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 pf-body">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-3" data-aos="fade-up">{ts("s1_heading")}</h2>
        <p class="pf-lede" data-aos="fade-up">{ts("s1_intro")}</p>
        <div
          class="pf-table-wrap"
          data-aos="fade-up"
          set:html={ts("s1_table", {
            link1: linkApex,
            link2: linkTopstep,
            link4: linkTPT,
            link5: linkFundedNext,
            link6: linkTradeify,
          })}
        />
        <p class="pf-caption mb-10" data-aos="fade-up">{ts("s1_caption")}</p>

        <h2 class="text-2xl md:text-3xl font-bold text-white mb-3" data-aos="fade-up">{ts("s2_heading")}</h2>
        <div data-aos="fade-up" set:html={ts("s2_body")} />

        <h3 class="text-xl md:text-2xl font-bold text-white mb-3 mt-10" data-aos="fade-up">{ts("s3_heading")}</h3>
        <div data-aos="fade-up" set:html={ts("s3_body", { link1: linkApex })} />

        <h3 class="text-xl md:text-2xl font-bold text-white mb-3 mt-8" data-aos="fade-up">{ts("s4_heading")}</h3>
        <div data-aos="fade-up" set:html={ts("s4_body", { link1: linkTopstep })} />

        <h3 class="text-xl md:text-2xl font-bold text-white mb-3 mt-8" data-aos="fade-up">{ts("s5_heading")}</h3>
        <div
          data-aos="fade-up"
          set:html={ts("s5_body", { link1: linkTradeify, link2: linkFundedNext })}
        />

        <h2 class="text-2xl md:text-3xl font-bold text-white mb-3 mt-10" data-aos="fade-up">{ts("s6_heading")}</h2>
        <div data-aos="fade-up" set:html={ts("s6_body")} />

        <h2 class="text-2xl md:text-3xl font-bold text-white mb-3 mt-10" data-aos="fade-up">{ts("s7_heading")}</h2>
        <div data-aos="fade-up" set:html={ts("s7_body")} />

        <h2 class="text-2xl md:text-3xl font-bold text-white mb-3 mt-10" data-aos="fade-up">{ts("s8_heading")}</h2>
        <div
          data-aos="fade-up"
          set:html={ts("s8_body", { link1: linkPricing, link2: SIGNUP_URL, link3: linkAutomatedFutures })}
        />

        <h2 class="text-2xl md:text-3xl font-bold text-white mb-3 mt-10" data-aos="fade-up">{ts("s9_heading")}</h2>
        <div data-aos="fade-up" set:html={ts("s9_body", { link1: linkTradeCopierHub })} />
      </div>
    </section>

    <!-- Mid-page CTA band -->
    <section class="bg-gradient-to-r from-[#0F3EC3] to-[#2B77EE] py-14">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center" data-aos="fade-up">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">{ts("s10_heading")}</h2>
        <p class="text-blue-100 mb-6 max-w-2xl mx-auto">{ts("s10_body")}</p>
        <a href={SIGNUP_URL} class="px-8 py-3 bg-white text-[#2B77EE] font-bold rounded-xl hover:bg-gray-100 transition-all shadow-lg inline-block">
          {t("general_faq.cta_start_trial")}<i class="fa-solid fa-arrow-right ml-2"></i>
        </a>
      </div>
    </section>

    <!-- FAQ Content -->
    <section id="faq" class="bg-[#001429] py-16" itemscope itemtype="https://schema.org/FAQPage">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-2xl md:text-3xl font-bold mb-8 pb-4 border-b-2 border-[#2B77EE] flex items-center gap-3 text-white" data-aos="fade-up">
          <i class={`${spoke.icon} text-[#2B77EE]`} aria-hidden="true"></i>{ts("section_heading")}
        </h2>
        <FaqList locale={locale} ids={spoke.ids} />
      </div>
    </section>

    <!-- Explore other topics -->
    <section class="bg-[#002040] py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <h2 class="text-xl md:text-2xl font-bold text-white mb-8 text-center" data-aos="fade-up">{t("faq_hub.related_title")}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {SPOKES.filter((s) => s.slug !== SLUG).map((s) => (
            <a href={localizedPath(locale, `faq/${s.slug}`)} class="bg-[#001429] border border-white/10 rounded-xl p-4 hover:border-[#2B77EE]/50 transition-all group flex items-center gap-3">
              <div class="w-9 h-9 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-sm flex-shrink-0"><i class={s.icon} aria-hidden="true"></i></div>
              <span class="text-white font-semibold text-sm group-hover:text-[#2B77EE] transition-colors">{t(`${s.ns}.card_title` as any)}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-[#2B77EE] to-blue-600 py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center" data-aos="fade-up">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">{t("general_faq.cta_title")}</h2>
        <p class="text-blue-100 text-lg mb-8 max-w-2xl mx-auto">{t("general_faq.cta_subtitle")}</p>
        <a href="https://app.pickmytrade.io/?register=true" class="px-8 py-3 bg-white text-[#2B77EE] font-bold rounded-xl hover:bg-gray-100 transition-all shadow-lg inline-block">
          {t("general_faq.cta_start_trial")}<i class="fa-solid fa-arrow-right ml-2"></i>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .pf-lede { color: #c6d2e2; font-size: 1.05rem; line-height: 1.7; margin-bottom: 1rem; }
  .pf-caption { color: #889bb4; font-size: 0.85rem; font-style: italic; }
  .pf-body :global(p) { color: #c6d2e2; line-height: 1.75; margin-bottom: 1rem; }
  .pf-body :global(ul),
  .pf-body :global(ol) { color: #c6d2e2; margin: 0 0 1.2rem 1.4rem; }
  .pf-body :global(ul) { list-style: disc; }
  .pf-body :global(ol) { list-style: decimal; }
  .pf-body :global(li) { margin-bottom: 0.5rem; line-height: 1.7; }
  .pf-body :global(strong) { color: #fff; }
  .pf-body :global(a) { color: #60a5fa; text-decoration: underline; }
  .pf-body :global(a:hover) { color: #93c5fd; }
  .pf-table-wrap {
    overflow-x: auto;
    border: 1px solid rgba(59, 130, 246, 0.14);
    border-radius: 12px;
    margin: 1rem 0;
    scrollbar-width: thin;
  }
  .pf-table-wrap :global(table) {
    border-collapse: collapse;
    width: 100%;
    min-width: 760px;
    font-size: 0.85rem;
    color: #c6d2e2;
  }
  .pf-table-wrap :global(th) {
    text-align: left;
    background: rgba(255, 255, 255, 0.03);
    color: #889bb4;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid rgba(59, 130, 246, 0.14);
    font-weight: 700;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .pf-table-wrap :global(td) {
    padding: 0.7rem 1rem;
    border-bottom: 1px solid rgba(59, 130, 246, 0.08);
    vertical-align: top;
  }
  .pf-table-wrap :global(tr:last-child td) { border-bottom: none; }
  .pf-table-wrap :global(tr:hover) { background: rgba(59, 130, 246, 0.06); }
  .pf-table-wrap :global(a) { color: #60a5fa; text-decoration: underline; }
</style>
