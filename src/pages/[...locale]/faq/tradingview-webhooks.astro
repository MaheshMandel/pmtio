---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FaqList from "../../../components/FaqList.astro";
import {
  getLocalePaths,
  localizedPath,
  absoluteLocalizedPath,
  useTranslations,
} from "../../../i18n/utils";
import { LOCALE_BCP47, type Locale } from "../../../i18n/config";
import { SPOKES, answerParams, stripHtml } from "../../../data/faqItems";
import { WEBHOOK_FAQS } from "../../../data/traderFaqExtras";
import FaqExtraList from "../../../components/FaqExtraList.astro";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const SLUG = "tradingview-webhooks";
const spoke = SPOKES.find((s) => s.slug === SLUG)!;
// Spoke chrome (meta/hero/card) lives under this spoke's i18n namespace.
const ts = (k: string) => t(`${spoke.ns}.${k}` as any);
const pageUrl = absoluteLocalizedPath(locale, `faq/${SLUG}`);

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: t("general_faq.breadcrumb_home"), item: absoluteLocalizedPath(locale) },
      { "@type": "ListItem", position: 2, name: t("faq_hub.breadcrumb"), item: absoluteLocalizedPath(locale, "general-faq") },
      { "@type": "ListItem", position: 3, name: ts("breadcrumb"), item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    inLanguage: LOCALE_BCP47[locale],
    speakable: {
      "@type": "SpeakableSpecification",
      cssSelector: [".faq-question", ".faq-answer"],
    },
    mainEntity: [
      ...spoke.ids.map((id) => ({
        "@type": "Question",
        name: t(`general_faq.faq_q${id}` as any),
        acceptedAnswer: {
          "@type": "Answer",
          text: stripHtml(t(`general_faq.faq_a${id}` as any, answerParams(locale, id))),
        },
      })),
      ...WEBHOOK_FAQS.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.text },
      })),
    ],
  },
  {
    "@context": "https://schema.org",
    // TechArticle, not HowTo — Google retired HowTo rich results in Sept 2023,
    // so the markup carried no SERP value. Mirrors the homepage pattern.
    "@type": "TechArticle",
    headline: "How to create a TradingView webhook and send orders to your broker with PickMyTrade",
    name: "How to create a TradingView webhook and send orders to your broker with PickMyTrade",
    description: "Turn a TradingView alert into a live broker order using a webhook and PickMyTrade. No coding and no VPS required.",
    timeRequired: "PT5M",
    proficiencyLevel: "Beginner",
    dependencies: "PickMyTrade account; A supported broker account (live, demo or prop firm); TradingView paid plan (Essential or higher) with 2FA enabled",
    articleSection: [
      "Connect your broker in PickMyTrade — Create a PickMyTrade account and connect your broker account, then generate your webhook URL and alert message.",
      "Create a TradingView alert — Open your chart, click the alert icon and set your condition on a strategy, indicator or price level.",
      "Add the webhook URL — In the alert's Notifications tab, tick Webhook URL and paste your PickMyTrade webhook URL.",
      "Paste the JSON payload — Delete the default alert text and paste the PickMyTrade-generated JSON message into the alert, then create the alert.",
      "Test and go live — Fire a test alert on a 1-minute chart, confirm the fill in your PickMyTrade alert log and your broker, then enable it.",
    ],
    mainEntityOfPage: pageUrl,
    author: { "@id": "https://pickmytrade.io/#organization" },
    publisher: { "@id": "https://pickmytrade.io/#organization" },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "PickMyTrade - TradingView Webhook Automation",
    description: "Turn TradingView webhook alerts into live broker orders. No-code webhook automation that receives the alert JSON payload and executes it on Tradovate, Rithmic, Interactive Brokers, TradeStation, TradeLocker, ProjectX, Match-Trader, Tradier, cTrader and Ironbeam, in the cloud with no VPS. PickMyTrade processes your order in under 200ms on our side; total fill time also depends on your broker, network latency and how quickly TradingView sends the alert.",
    url: pageUrl,
    image: "https://pickmytrade.io/assets/logo.png",
    applicationCategory: "FinanceApplication",
    operatingSystem: "Web-based, Windows, Mac, Linux",
    offers: {
      "@type": "Offer",
      price: "50.00",
      priceCurrency: "USD",
      priceValidUntil: "2026-12-31",
      availability: "https://schema.org/InStock",
      description: "$50 per month or $500 per year. 7-day free trial, no credit card required.",
    },
    publisher: { "@type": "Organization", name: "PickMyTrade", url: "https://pickmytrade.io" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "PickMyTrade",
    url: "https://pickmytrade.io",
    logo: { "@type": "ImageObject", url: "https://pickmytrade.io/assets/logo.png" },
    contactPoint: {
      "@type": "ContactPoint",
      email: "support@pickmytrade.com",
      contactType: "Customer Support",
      availableLanguage: "English",
    },
    sameAs: [
      "https://x.com/pickmytrade",
      "https://discord.gg/FkJ7g7498S",
      "https://www.instagram.com/pickmytrade",
      "https://www.youtube.com/@PickMyTrade",
      "https://www.linkedin.com/company/pickmytrade",
      "https://sourceforge.net/software/product/PickMyTrade/",
      "https://www.trustpilot.com/review/pickmytrade.trade",
    ],
  },
];
---

<BaseLayout
  locale={locale}
  title={ts("meta_title")}
  description={ts("meta_description")}
  canonical={pageUrl}
  structuredData={structuredData}
>
  <main id="main-content" role="main">
    <!-- Hero -->
    <section class="bg-gradient-to-b from-[#001429] via-[#001f3f] to-[#002040] pt-28 pb-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <nav aria-label="Breadcrumb" class="flex justify-center mb-6" data-aos="fade-down">
          <ol class="flex items-center space-x-2 text-sm text-gray-400">
            <li><a href={localizedPath(locale, "")} class="hover:text-[#2B77EE] transition-colors">{t("general_faq.breadcrumb_home")}</a></li>
            <li><i class="fa-solid fa-chevron-right text-xs text-gray-600"></i></li>
            <li><a href={localizedPath(locale, "general-faq")} class="hover:text-[#2B77EE] transition-colors">{t("faq_hub.breadcrumb")}</a></li>
            <li><i class="fa-solid fa-chevron-right text-xs text-gray-600"></i></li>
            <li class="text-[#2B77EE]">{ts("breadcrumb")}</li>
          </ol>
        </nav>
        <span class="inline-block px-4 py-1.5 rounded-full bg-[#2B77EE]/10 border border-[#2B77EE]/30 text-[#2B77EE] text-xs font-semibold uppercase tracking-wider mb-5" data-aos="fade-up">
          <i class={`${spoke.icon} mr-1.5`} aria-hidden="true"></i>{t("faq_hub.badge")}
        </span>
        <h1 class="text-3xl md:text-5xl font-bold mb-6 leading-tight text-white" data-aos="fade-up">
          {ts("hero_title")}
        </h1>
        <p class="text-gray-300 text-lg md:text-xl max-w-3xl mx-auto mb-8" data-aos="fade-up" data-aos-delay="100">
          {ts("hero_subtitle")}
        </p>
        <div class="flex flex-wrap gap-4 justify-center" data-aos="fade-up" data-aos-delay="200">
          <a href="https://app.pickmytrade.io/?register=true" class="px-8 py-3 bg-[#2B77EE] hover:bg-blue-600 text-white font-semibold rounded-xl transition-all duration-300 shadow-lg shadow-blue-500/25">
            {t("general_faq.cta_start_trial")}<i class="fa-solid fa-arrow-right ml-2"></i>
          </a>
          <a href="#faq" class="px-8 py-3 border border-white/20 hover:border-[#2B77EE]/50 text-white font-semibold rounded-xl transition-all duration-300 hover:bg-white/5">
            {t("general_faq.hero_browse")}<i class="fa-solid fa-chevron-down ml-2"></i>
          </a>
        </div>
      </div>
    </section>

    <!-- Intro (answer-first lead) -->
    <section class="relative py-14 sm:py-16 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-4xl mx-auto px-4 sm:px-5" data-aos="fade-up">
        <p class="text-gray-200 text-lg leading-relaxed mb-4"><strong class="text-white">{ts("intro_p1_strong")}</strong> {ts("intro_p1_rest")}</p>
        <p class="text-gray-300 leading-relaxed mb-4">{ts("intro_p2")}</p>
        <p class="text-gray-300 leading-relaxed">{ts("intro_p3")}</p>
        <div class="mt-6">
          <a href="https://app.pickmytrade.io/?register=true" class="inline-flex items-center px-7 py-3.5 rounded-lg text-sm font-semibold text-white bg-[#0F3EC3] border border-[#2B77EE] hover:bg-[#0d35a8] transition-all duration-200">{ts("intro_cta")}</a>
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm">
          <span class="flex items-center gap-2 text-gray-200"><i class="fa-solid fa-users text-[#2B77EE]" aria-hidden="true"></i> {ts("intro_stat1")}</span>
          <span class="flex items-center gap-2 text-gray-200"><i class="fa-solid fa-chart-line text-[#2B77EE]" aria-hidden="true"></i> {ts("intro_stat2")}</span>
          <span class="flex items-center gap-2 text-gray-200"><i class="fa-solid fa-cloud text-[#2B77EE]" aria-hidden="true"></i> {ts("intro_stat3")}</span>
        </div>
      </div>
    </section>

    <!-- What is a TradingView webhook? -->
    <section class="relative py-14 sm:py-16 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-4xl mx-auto px-4 sm:px-5" data-aos="fade-up">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-5">{ts("w1_title")}</h2>
        <p class="text-gray-300 leading-relaxed mb-4">{ts("w1_p1")}</p>
        <p class="text-gray-300 leading-relaxed">{ts("w1_p2")}</p>
      </div>
    </section>

    <!-- Requirements before you start -->
    <section class="relative py-14 sm:py-16 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-4xl mx-auto px-4 sm:px-5" data-aos="fade-up">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-5">{ts("req_title")}</h2>
        <p class="text-gray-300 leading-relaxed mb-5">{ts("req_intro")}</p>
        <ul class="space-y-3 text-gray-300 leading-relaxed">
          <li><strong class="text-white">{ts("req_item1_strong")}</strong> {ts("req_item1_rest")}</li>
          <li><strong class="text-white">{ts("req_item2_strong")}</strong> {ts("req_item2_rest")}</li>
          <li><strong class="text-white">{ts("req_item3_strong")}</strong> {ts("req_item3_rest")}</li>
          <li><strong class="text-white">{ts("req_item4_strong")}</strong> {ts("req_item4_rest")}</li>
        </ul>
      </div>
    </section>

    <!-- How to create a webhook step by step -->
    <section class="relative py-14 sm:py-16 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-4xl mx-auto px-4 sm:px-5" data-aos="fade-up">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-5">{ts("steps_title")}</h2>
        <p class="text-gray-300 leading-relaxed mb-5">{ts("steps_intro")}</p>
        <ol class="space-y-3 text-gray-300 leading-relaxed list-decimal pl-5">
          <li><strong class="text-white">{ts("step1_strong")}</strong> {ts("step1_rest")}</li>
          <li><strong class="text-white">{ts("step2_strong")}</strong> {ts("step2_rest")} <strong class="text-white">{ts("step2_bold")}</strong>.</li>
          <li><strong class="text-white">{ts("step3_strong")}</strong> {ts("step3_rest")}</li>
          <li><strong class="text-white">{ts("step4_strong")}</strong> {ts("step4_rest")}</li>
          <li><strong class="text-white">{ts("step5_strong")}</strong> {ts("step5_rest")}</li>
        </ol>
        <p class="text-gray-300 leading-relaxed mt-4">{ts("steps_outro")}</p>
      </div>
    </section>

    <!-- JSON payload format -->
    <section class="relative py-14 sm:py-16 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-4xl mx-auto px-4 sm:px-5" data-aos="fade-up">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-5">{ts("payload_title")}</h2>
        <p class="text-gray-300 leading-relaxed mb-5">{ts("payload_intro")}</p>
        <pre class="bg-[#0a1120] border border-[#2B77EE]/40 rounded-xl p-5 text-sm text-[#c7d6f5] overflow-x-auto"><code>{`{
  "token": "YOUR_PICKMYTRADE_TOKEN",
  "symbol": "MNQ",
  "side": "buy",
  "quantity": 1,
  "order_type": "market",
  "stop_loss": 20,
  "take_profit": 40
}`}</code></pre>
        <p class="text-gray-300 leading-relaxed mt-5">{ts("payload_outro")}</p>
      </div>
    </section>

    <!-- From webhook to filled order -->
    <section class="relative py-14 sm:py-16 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-4xl mx-auto px-4 sm:px-5" data-aos="fade-up">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-5">{ts("exec_title")}</h2>
        <p class="text-gray-300 leading-relaxed mb-4">{ts("exec_p1")}</p>
        <p class="text-gray-300 leading-relaxed">{ts("exec_p2_pre")} <strong class="text-white">{ts("exec_p2_strong")}</strong> {ts("exec_p2_rest")}</p>
      </div>
    </section>

    <!-- Webhook execution latency (honest expectation) -->
    <section class="relative py-14 sm:py-16 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-4xl mx-auto px-4 sm:px-5" data-aos="fade-up">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-5">{ts("latency2_title")}</h2>
        <p class="text-gray-300 leading-relaxed mb-4">{ts("latency2_p1_pre")} <strong class="text-white">{ts("latency2_p1_strong")}</strong> {ts("latency2_p1_post")}</p>
        <p class="text-gray-300 leading-relaxed">{ts("latency2_p2")}</p>
      </div>
    </section>

    <!-- Supported brokers and prop firms -->
    <section class="relative py-14 sm:py-16 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-5xl mx-auto px-4 sm:px-5" data-aos="fade-up">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-5">{ts("brokers2_title")}</h2>
        <p class="text-gray-300 leading-relaxed mb-4">{ts("brokers2_p1")}</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 my-6">
          <a href={localizedPath(locale, "broker/tradingview-to-rithmic")} class="text-center bg-[#122B75]/30 border border-[#2B77EE]/40 rounded-lg px-3 py-3 text-sm text-gray-200 hover:text-white hover:border-[#2B77EE] transition">Rithmic</a>
          <a href={localizedPath(locale, "broker/tradingview-to-ib")} class="text-center bg-[#122B75]/30 border border-[#2B77EE]/40 rounded-lg px-3 py-3 text-sm text-gray-200 hover:text-white hover:border-[#2B77EE] transition">Interactive Brokers</a>
          <a href={localizedPath(locale, "broker/tradingview-to-tradestation")} class="text-center bg-[#122B75]/30 border border-[#2B77EE]/40 rounded-lg px-3 py-3 text-sm text-gray-200 hover:text-white hover:border-[#2B77EE] transition">TradeStation</a>
          <a href={localizedPath(locale, "broker/tradingview-to-tradelocker")} class="text-center bg-[#122B75]/30 border border-[#2B77EE]/40 rounded-lg px-3 py-3 text-sm text-gray-200 hover:text-white hover:border-[#2B77EE] transition">TradeLocker</a>
          <a href={localizedPath(locale, "broker/tradingview-to-projectx")} class="text-center bg-[#122B75]/30 border border-[#2B77EE]/40 rounded-lg px-3 py-3 text-sm text-gray-200 hover:text-white hover:border-[#2B77EE] transition">ProjectX</a>
          <a href={localizedPath(locale, "broker/tradingview-to-matchtrader")} class="text-center bg-[#122B75]/30 border border-[#2B77EE]/40 rounded-lg px-3 py-3 text-sm text-gray-200 hover:text-white hover:border-[#2B77EE] transition">Match-Trader</a>
          <a href={localizedPath(locale, "broker/tradingview-to-tradier")} class="text-center bg-[#122B75]/30 border border-[#2B77EE]/40 rounded-lg px-3 py-3 text-sm text-gray-200 hover:text-white hover:border-[#2B77EE] transition">Tradier</a>
          <a href="https://pickmytrade.trade/" class="text-center bg-[#0F3EC3]/25 border border-[#2B77EE]/60 rounded-lg px-3 py-3 text-sm text-white hover:border-[#2B77EE] transition font-semibold">Tradovate</a>
        </div>
        <p class="text-gray-300 leading-relaxed">{ts("brokers2_p2")}</p>
      </div>
    </section>

    <!-- Webhook security best practices -->
    <section class="relative py-14 sm:py-16 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-4xl mx-auto px-4 sm:px-5" data-aos="fade-up">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-5">{ts("sec2_title")}</h2>
        <p class="text-gray-300 leading-relaxed mb-5">{ts("sec2_intro")}</p>
        <ul class="space-y-3 text-gray-300 leading-relaxed">
          <li><strong class="text-white">{ts("sec2_item1_strong")}</strong> {ts("sec2_item1_rest")}</li>
          <li><strong class="text-white">{ts("sec2_item2_strong")}</strong> {ts("sec2_item2_rest")}</li>
          <li><strong class="text-white">{ts("sec2_item3_strong")}</strong> {ts("sec2_item3_rest")}</li>
          <li><strong class="text-white">{ts("sec2_item4_strong")}</strong> {ts("sec2_item4_rest")}</li>
          <li><strong class="text-white">{ts("sec2_item5_strong")}</strong> {ts("sec2_item5_rest")}</li>
        </ul>
      </div>
    </section>

    <!-- Webhook vs email/SMS vs manual trading -->
    <section class="relative py-14 sm:py-16 bg-gradient-to-b from-[#001429] to-[#002040]">
      <div class="max-w-4xl mx-auto px-4 sm:px-5" data-aos="fade-up">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-5">{ts("vs_title")}</h2>
        <p class="text-gray-300 leading-relaxed mb-5">{ts("vs_intro")}</p>
        <ul class="space-y-3 text-gray-300 leading-relaxed">
          <li><strong class="text-white">{ts("vs_item1_strong")}</strong> {ts("vs_item1_rest")}</li>
          <li><strong class="text-white">{ts("vs_item2_strong")}</strong> {ts("vs_item2_rest")}</li>
          <li><strong class="text-white">{ts("vs_item3_strong")}</strong> {ts("vs_item3_rest")}</li>
        </ul>
        <p class="text-gray-300 leading-relaxed mt-4">{ts("vs_outro")}</p>
      </div>
    </section>

    <!-- Common webhook errors and troubleshooting -->
    <section class="relative py-14 sm:py-16 bg-gradient-to-b from-[#002040] to-[#001429]">
      <div class="max-w-4xl mx-auto px-4 sm:px-5" data-aos="fade-up">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-5">{ts("err_title")}</h2>
        <p class="text-gray-300 leading-relaxed mb-5">{ts("err_intro")}</p>
        <ul class="space-y-3 text-gray-300 leading-relaxed">
          <li><strong class="text-white">{ts("err_item1_strong")}</strong> {ts("err_item1_rest")}</li>
          <li><strong class="text-white">{ts("err_item2_strong")}</strong> {ts("err_item2_rest")}</li>
          <li><strong class="text-white">{ts("err_item3_strong")}</strong> {ts("err_item3_rest")}</li>
          <li><strong class="text-white">{ts("err_item4_strong")}</strong> {ts("err_item4_rest")}</li>
          <li><strong class="text-white">{ts("err_item5_strong")}</strong> {ts("err_item5_rest")}</li>
        </ul>
        <p class="text-gray-300 leading-relaxed mt-4">{ts("err_outro")}</p>
      </div>
    </section>

    <!-- FAQ Content -->
    <section id="faq" class="bg-[#001429] py-16" itemscope itemtype="https://schema.org/FAQPage">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-2xl md:text-3xl font-bold mb-8 pb-4 border-b-2 border-[#2B77EE] flex items-center gap-3 text-white" data-aos="fade-up">
          <i class={`${spoke.icon} text-[#2B77EE]`} aria-hidden="true"></i>{ts("section_heading")}
        </h2>
        <FaqList locale={locale} ids={spoke.ids} />
        <FaqExtraList items={WEBHOOK_FAQS} />
      </div>
    </section>

    <!-- Related links strip -->
    <section class="relative py-10 bg-gradient-to-b from-[#002040] to-[#001429] border-t border-white/5">
      <div class="max-w-4xl mx-auto px-4 sm:px-5 text-center" data-aos="fade-up">
        <p class="text-xs uppercase tracking-widest text-gray-400 mb-4">{ts("related_title")}</p>
        <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm">
          <a href={localizedPath(locale, "tradingview-automation")} class="text-[#7FB8F9] hover:text-white transition">{ts("related_automation")}</a>
          <span class="text-gray-700">|</span>
          <a href={localizedPath(locale, "trade-copier")} class="text-[#7FB8F9] hover:text-white transition">{ts("related_tradecopier")}</a>
          <span class="text-gray-700">|</span>
          <a href={localizedPath(locale, "supported-propfirms")} class="text-[#7FB8F9] hover:text-white transition">{ts("related_propfirms")}</a>
          <span class="text-gray-700">|</span>
          <a href={localizedPath(locale, "pricing")} class="text-[#7FB8F9] hover:text-white transition">{ts("related_pricing")}</a>
          <span class="text-gray-700">|</span>
          <a href="https://docs.pickmytrade.io/" class="text-[#7FB8F9] hover:text-white transition">{ts("related_docs")}</a>
        </div>
      </div>
    </section>

    <!-- Explore other topics -->
    <section class="bg-[#002040] py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <h2 class="text-xl md:text-2xl font-bold text-white mb-8 text-center" data-aos="fade-up">{t("faq_hub.related_title")}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {SPOKES.filter((s) => s.slug !== SLUG).map((s) => (
            <a href={localizedPath(locale, `faq/${s.slug}`)} class="bg-[#001429] border border-white/10 rounded-xl p-4 hover:border-[#2B77EE]/50 transition-all group flex items-center gap-3">
              <div class="w-9 h-9 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-sm flex-shrink-0"><i class={s.icon} aria-hidden="true"></i></div>
              <span class="text-white font-semibold text-sm group-hover:text-[#2B77EE] transition-colors">{t(`${s.ns}.card_title` as any)}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-[#2B77EE] to-blue-600 py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center" data-aos="fade-up">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">{ts("cta2_title")}</h2>
        <p class="text-blue-100 text-lg mb-8 max-w-2xl mx-auto">{ts("cta2_p1")}</p>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href="https://app.pickmytrade.io/?register=true" class="px-8 py-3 bg-white text-[#2B77EE] font-bold rounded-xl hover:bg-gray-100 transition-all shadow-lg inline-block">
            {t("general_faq.cta_start_trial")}<i class="fa-solid fa-arrow-right ml-2"></i>
          </a>
          <a href="https://docs.pickmytrade.io/" class="px-8 py-3 border border-white/40 text-white font-semibold rounded-xl hover:bg-white/10 transition-all inline-block">
            {ts("cta2_docs")}
          </a>
        </div>
        <p class="mt-4 text-xs text-blue-100/80">{ts("cta2_footnote")}</p>
      </div>
    </section>
  </main>
</BaseLayout>
