---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import TwsDisclaimers from "../../../../components/TwsDisclaimers.astro";
import { twsArticles, localizeTwsHtml, TWS_SITE, TWS_INDEXABLE, type TwsArticle } from "../../../../data/twsHelp";
import { twsUi } from "../../../../data/twsHelpUi";
import { localizedPath, absoluteLocalizedPath } from "../../../../i18n/utils";
import { LOCALES, LOCALE_BCP47, type Locale } from "../../../../i18n/config";

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    twsArticles(locale).map((a) => ({
      params: { locale: locale === "en" ? undefined : locale, slug: a.slug },
      props: { locale, article: a },
    })),
  );
}

const { article: a, locale } = Astro.props as { article: TwsArticle; locale: Locale };
const ui = twsUi(locale);
const L = (html: string) => localizeTwsHtml(html, locale);
const hubPath = localizedPath(locale, "help/tws");
const pageUrl = absoluteLocalizedPath(locale, `help/tws/${a.slug}`);
const groupLabel = ui.groups[a.group] ?? a.group;
const titleTag = `${a.title} | PickMyTrade`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "@id": `${pageUrl}#article`,
    url: pageUrl,
    headline: a.title,
    description: a.description,
    inLanguage: LOCALE_BCP47[locale],
    dateModified: a.modified,
    author: { "@type": "Organization", name: "PickMyTrade" },
    publisher: { "@type": "Organization", name: "PickMyTrade", url: `${TWS_SITE}/` },
    mainEntityOfPage: pageUrl,
    citation: a.citation,
    ...(a.image ? { image: a.image } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: ui.twsHelp, item: absoluteLocalizedPath(locale, "help/tws") },
      { "@type": "ListItem", position: 2, name: a.title, item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: a.faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
    })),
  },
];

const toc = Object.entries(ui.toc).filter(([id]) => id !== "sources");
const h2 = "text-2xl font-bold text-white mt-12 mb-4 pb-3 border-b border-white/10";
---

<BaseLayout
  locale={locale}
  title={titleTag}
  description={a.description}
  canonical={pageUrl}
  structuredData={structuredData}
  robots={TWS_INDEXABLE ? undefined : "noindex, follow"}
>
  <section class="bg-gradient-to-b from-[#001429] via-[#001f3f] to-[#002040] pt-28 pb-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-gray-400">
          <li><a href={localizedPath(locale, "")} class="hover:text-[#2B77EE] transition-colors">{ui.home}</a></li>
          <li><i class="fa-solid fa-chevron-right text-xs text-gray-600" aria-hidden="true"></i></li>
          <li><a href={hubPath} class="hover:text-[#2B77EE] transition-colors">{ui.twsHelp}</a></li>
          <li><i class="fa-solid fa-chevron-right text-xs text-gray-600" aria-hidden="true"></i></li>
          <li class="text-[#2B77EE]">{groupLabel}</li>
        </ol>
      </nav>
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#2B77EE]/10 border border-[#2B77EE]/30 text-[#2B77EE] text-xs font-semibold uppercase tracking-wider mb-5">
        {groupLabel}
      </span>
      <h1 class="text-3xl md:text-5xl font-bold mb-4 leading-tight text-white">{a.title}</h1>
    </div>
  </section>

  <section class="bg-[#001429] py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:grid lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-8">
      <aside class="hidden lg:block">
        <nav aria-label={ui.onThisPage} class="sticky top-28 max-h-[calc(100vh-8rem)] overflow-y-auto text-sm">
          <strong class="block text-white mb-3">{ui.onThisPage}</strong>
          <ul class="space-y-2 border-l border-white/10">
            {toc.map(([id, label]) => (
              <li><a href={`#${id}`} class="block pl-4 text-gray-400 hover:text-[#2B77EE] transition-colors">{label}</a></li>
            ))}
          </ul>
        </nav>
      </aside>
      <article class="tws-prose min-w-0">
        <section id="answer" class="rounded-xl border border-[#2B77EE]/40 bg-[#002040] p-5 sm:p-6">
          <strong class="text-[#7FB8F9] text-xs uppercase tracking-wider">{ui.quickAnswer}</strong>
          <p class="text-lg text-white leading-relaxed mt-2" data-answer-block set:html={L(a.answer)} />
        </section>

        <p class="text-sm text-gray-400 mt-4">
          {ui.educationalNote}
          <a href="#disclaimers" class="text-[#2B77EE] hover:underline">{ui.readDisclaimers}</a>.
        </p>

        <h2 id="steps" class={h2}>{ui.stepByStep}</h2>
        <ol class="space-y-4 list-none p-0 m-0">
          {a.steps.map((s, i) => (
            <li id={s.id} class="flex gap-4 items-start">
              <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-[#2B77EE]/20 text-[#2B77EE] text-sm font-bold flex items-center justify-center">{i + 1}</span>
              <span class="text-gray-300 leading-relaxed pt-1" set:html={L(s.html)} />
            </li>
          ))}
        </ol>

        <h2 id="example" class={h2}>{ui.example}</h2>
        <div set:html={L(a.example)} />

        <h2 id="screen" class={h2}>{ui.screenReference}</h2>
        <div set:html={L(a.screen)} />

        <div id="verify" class="mt-10 rounded-xl border border-emerald-400/30 bg-emerald-400/5 p-5">
          <strong class="text-emerald-300 block mb-1">{ui.verify}</strong>
          <span class="text-gray-200" set:html={L(a.verify)} />
        </div>

        <h2 id="avoid" class={h2}>{ui.avoid}</h2>
        <div class="rounded-xl border border-amber-400/30 bg-amber-400/5 p-5 text-gray-200" set:html={L(a.avoid)} />

        <h2 id="faq" class={h2}>{ui.faq}</h2>
        <div class="space-y-4">
          {a.faq.map((f) => (
            <div class="bg-[#001a33] border border-white/10 rounded-xl p-5">
              <h3 class="text-white font-semibold mb-2">{f.q}</h3>
              <p class="text-gray-300 leading-relaxed" set:html={L(f.a)} />
            </div>
          ))}
        </div>

        <h2 id="related" class={h2}>{ui.related}</h2>
        <div class="grid sm:grid-cols-2 gap-3">
          {a.related.map((r) => (
            <a href={localizedPath(locale, `help/tws/${r.slug}`)} class="group bg-[#001a33] border border-white/10 rounded-xl p-4 hover:border-[#2B77EE]/60 transition-colors text-white font-medium text-sm">
              <span class="group-hover:text-[#2B77EE] transition-colors">{r.title}</span>
            </a>
          ))}
        </div>
      </article>

    </div>
  </section>

  <section class="bg-[#002040] py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <TwsDisclaimers ui={ui} />
      <p class="text-xs text-gray-500 mt-6">{ui.footerNote}</p>
    </div>
  </section>

  <section class="bg-gradient-to-r from-[#2B77EE] to-blue-600 py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-4">{ui.ctaTitle}</h2>
      <a href={localizedPath(locale, "broker/tradingview-to-ib")} class="px-8 py-3 bg-white text-[#2B77EE] font-bold rounded-xl hover:bg-gray-100 transition-all shadow-lg inline-block">
        {ui.ctaButton}<i class="fa-solid fa-arrow-right ml-2" aria-hidden="true"></i>
      </a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .tws-prose p { color: #d1d5db; line-height: 1.75; margin: 0 0 1rem; }
  .tws-prose a { color: #2b77ee; }
  .tws-prose a:hover { text-decoration: underline; }
  .tws-prose p.meta { font-size: 0.875rem; color: #9ca3af; }
  .tws-prose figure { margin: 1.5rem 0; background: #001a33; border: 1px solid rgba(255,255,255,.1); border-radius: .75rem; padding: 1rem; }
  .tws-prose figure img { display: block; max-width: 100%; height: auto; border-radius: .5rem; margin: 0 auto; }
  .tws-prose figcaption { margin-top: .75rem; font-size: .875rem; color: #9ca3af; line-height: 1.6; }
  .tws-prose code { background: rgba(43,119,238,.12); padding: .1rem .35rem; border-radius: .25rem; }
</style>
