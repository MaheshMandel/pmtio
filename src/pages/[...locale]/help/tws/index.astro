---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import TwsDisclaimers from "../../../../components/TwsDisclaimers.astro";
import { twsArticles, TWS_GROUPS, TWS_INDEXABLE } from "../../../../data/twsHelp";
import { twsUi } from "../../../../data/twsHelpUi";
import { getLocalePaths, localizedPath, absoluteLocalizedPath } from "../../../../i18n/utils";
import type { Locale } from "../../../../i18n/config";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const ui = twsUi(locale);
const articles = twsArticles(locale);
const pageUrl = absoluteLocalizedPath(locale, "help/tws");

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: ui.home, item: absoluteLocalizedPath(locale) },
      { "@type": "ListItem", position: 2, name: ui.twsHelp, item: pageUrl },
    ],
  },
];

const counts = Object.fromEntries(
  TWS_GROUPS.map((g) => [g, articles.filter((a) => a.group === g).length]),
);
---

<BaseLayout
  locale={locale}
  title={ui.hubTitle}
  description={ui.hubDescription}
  canonical={pageUrl}
  structuredData={structuredData}
  robots={TWS_INDEXABLE ? undefined : "noindex, follow"}
>
  <section class="bg-gradient-to-b from-[#001429] via-[#001f3f] to-[#002040] pt-28 pb-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#2B77EE]/10 border border-[#2B77EE]/30 text-[#2B77EE] text-xs font-semibold uppercase tracking-wider mb-5">
        <i class="fa-solid fa-life-ring mr-1.5" aria-hidden="true"></i>{ui.badge}
      </span>
      <h1 class="text-3xl md:text-5xl font-bold mb-6 leading-tight text-white">
        {ui.heroTitleA}<br />{ui.heroTitleB}
      </h1>
      <p class="text-gray-300 text-lg md:text-xl max-w-3xl mx-auto mb-4">{ui.heroSubtitle}</p>
      <p class="text-gray-400 text-sm mb-8">
        {ui.educationNote}
        <a href="#disclaimers" class="text-[#2B77EE] hover:underline">{ui.disclaimersLink}</a>.
      </p>

      <div class="grid sm:grid-cols-[2fr_1fr] gap-3 text-left max-w-3xl mx-auto">
        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400">
          {ui.searchLabel}
          <input
            type="search"
            id="tws-q"
            placeholder={ui.searchPlaceholder}
            autocomplete="off"
            class="mt-1.5 w-full bg-[#001429] border border-white/15 focus:border-[#2B77EE] focus:outline-none rounded-xl px-4 py-3 text-base font-normal normal-case tracking-normal text-white placeholder-gray-500"
          />
        </label>
        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400">
          {ui.topicLabel}
          <select
            id="tws-category"
            class="mt-1.5 w-full bg-[#001429] border border-white/15 focus:border-[#2B77EE] focus:outline-none rounded-xl px-4 py-3 text-base font-normal normal-case tracking-normal text-white"
          >
            <option value="">{ui.allTopics}</option>
            {TWS_GROUPS.map((g) => <option value={g}>{ui.groups[g] ?? g} ({counts[g]})</option>)}
          </select>
        </label>
      </div>
    </div>
  </section>

  <section class="bg-[#001429] py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <p id="tws-count" class="text-sm text-gray-400 mb-6" role="status" aria-live="polite">{articles.length} {ui.guides}</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4" id="tws-grid">
        {articles.map((a) => (
          <a
            href={localizedPath(locale, `help/tws/${a.slug}`)}
            class="tws-card group block bg-[#001a33] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/60 transition-colors"
            data-group={a.group}
            data-search={`${a.title} ${a.description} ${a.slug}`.toLowerCase()}
          >
            <span class="text-[#2B77EE] text-xs font-semibold uppercase tracking-wider">{ui.groups[a.group] ?? a.group}</span>
            <h2 class="text-white font-semibold text-base mt-2 group-hover:text-[#2B77EE] transition-colors">{a.title}</h2>
            <p class="text-gray-400 text-sm mt-2 line-clamp-3">{a.description}</p>
            <span class="inline-flex items-center gap-2 text-[#2B77EE] text-sm font-medium mt-3">
              {ui.readGuide} <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
            </span>
          </a>
        ))}
      </div>
      <p id="tws-empty" class="hidden text-gray-300 text-center py-12">
        {ui.noMatch}
        <button type="button" id="tws-reset" class="text-[#2B77EE] hover:underline ml-1">{ui.reset}</button>
      </p>
    </div>
  </section>

  <section class="bg-[#002040] py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <TwsDisclaimers ui={ui} />
    </div>
  </section>

  <section class="bg-gradient-to-r from-[#2B77EE] to-blue-600 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">{ui.ctaTitle}</h2>
      <p class="text-blue-100 text-lg mb-8 max-w-2xl mx-auto">{ui.ctaSubtitle}</p>
      <a href={localizedPath(locale, "broker/tradingview-to-ib")} class="px-8 py-3 bg-white text-[#2B77EE] font-bold rounded-xl hover:bg-gray-100 transition-all shadow-lg inline-block">
        {ui.ctaButton}<i class="fa-solid fa-arrow-right ml-2" aria-hidden="true"></i>
      </a>
    </div>
  </section>

  <script is:inline define:vars={{ one: ui.guide, many: ui.guides }}>
    (function () {
      var q = document.getElementById("tws-q");
      var cat = document.getElementById("tws-category");
      var cards = Array.prototype.slice.call(document.querySelectorAll(".tws-card"));
      var count = document.getElementById("tws-count");
      var empty = document.getElementById("tws-empty");
      function apply() {
        var terms = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
        var g = cat.value;
        var shown = 0;
        cards.forEach(function (c) {
          var ok = (!g || c.dataset.group === g) &&
            terms.every(function (t) { return c.dataset.search.indexOf(t) !== -1; });
          c.classList.toggle("hidden", !ok);
          if (ok) shown++;
        });
        count.textContent = shown + " " + (shown === 1 ? one : many);
        empty.classList.toggle("hidden", shown !== 0);
      }
      q.addEventListener("input", apply);
      cat.addEventListener("change", apply);
      document.getElementById("tws-reset").addEventListener("click", function () {
        q.value = ""; cat.value = ""; apply(); q.focus();
      });
    })();
  </script>
</BaseLayout>
