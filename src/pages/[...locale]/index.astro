---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getLocalePaths,
  localizedPath,
  useTranslations,
  type TranslationKey,
} from '../../i18n/utils';
import { LOCALES, LOCALE_BCP47, type Locale } from '../../i18n/config';
import { SALE_END } from '../../data/sale';
import pricingConfig from '../../../pricing-config.json';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

// Single source of truth for pricing shown anywhere on this page — the sale
// banner, the pricing cards and the JSON-LD Offer all derive from the same
// pricing-config.json + SALE_END, so the page can't disagree with itself on
// price the way it did before (banner showing the sale price while the
// comparison table and structured data still quoted the pre-sale figure).
const saleActive =
  pricingConfig.sale?.active !== false && Date.now() < new Date(SALE_END).getTime();
const monthlyPlan = Object.values(pricingConfig.plans).find(
  (p: any) => p.enabled && p.period === 'month',
) as { price: number; originalPrice: number | null } | undefined;
const quarterlyPlan = Object.values(pricingConfig.plans).find(
  (p: any) => p.enabled && p.period === '3 Months',
) as { price: number; originalPrice: number | null } | undefined;
const annualPlan = Object.values(pricingConfig.plans).find(
  (p: any) => p.enabled && p.period === 'year',
) as { price: number; originalPrice: number | null } | undefined;
const currentPrice = (plan: { price: number; originalPrice: number | null } | undefined, fallback: number) =>
  plan == null ? fallback : saleActive && plan.originalPrice != null ? plan.price : (plan.originalPrice ?? plan.price);
const monthlyDisplayPrice = currentPrice(monthlyPlan, 50);
const quarterlyDisplayPrice = currentPrice(quarterlyPlan, 135);
const annualDisplayPrice = currentPrice(annualPlan, 500);

// Computed, not hardcoded, so this can never overstate (or go stale on) the
// live discount — reads the same pricing-config.json the banner/cards use.
const annualPercentOff =
  saleActive && annualPlan?.originalPrice
    ? Math.round((1 - annualPlan.price / annualPlan.originalPrice) * 100)
    : 0;
const saleDescriptionSuffix =
  annualPercentOff > 0 ? ` Save ${annualPercentOff}% on the annual plan for a limited time.` : '';

