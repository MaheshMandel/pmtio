---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalePaths, localizedPath, useTranslations, absoluteLocalizedPath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const schema1 = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Terms and Conditions",
    "description": "PickMyTrade Terms of Service - Understand your rights and obligations when using our automated trading platform. Includes user agreements and arbitration terms.",
    "url": absoluteLocalizedPath(locale, 'legal/terms'),
    "dateModified": "2026-07-27",
    "isPartOf": {
      "@type": "WebSite",
      "name": "PickMyTrade",
      "url": "https://pickmytrade.io/"
    },
    "publisher": {
      "@type": "Organization",
      "name": "PickMyTrade",
      "logo": {
        "@type": "ImageObject",
        "url": "https://pickmytrade.io/assets/logo.png"
      }
    }
  };

const schema2 = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://pickmytrade.io/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Terms and Conditions",
        "item": absoluteLocalizedPath(locale, 'legal/terms')
      }
    ]
  };
---
<BaseLayout
  locale={locale}
  title={t('terms.meta_title')}
  description={t('terms.meta_description')}
  keywords=""
  structuredData={[schema1, schema2]}
>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-12 md:pt-40 md:pb-16">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4"
        style="background: linear-gradient(to right, #0055FE, #4A90E2); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
        {t('terms.page_title')}
      </h1>
      <p class="text-gray-400 text-base md:text-lg">{t('terms.last_updated_label')} July 2026</p>
    </div>

    <!-- Content Container -->
    <div class="space-y-8 text-gray-300 leading-relaxed">

      <div class="text-center italic text-gray-400 mb-6">
        <p>{t('terms.welcome')}</p>
      </div>

      <div class="bg-yellow-900/20 border border-yellow-600/30 rounded-lg p-4 my-6">
        <p class="font-semibold text-yellow-400 mb-3">{t('terms.notice_title')}</p>
        <p class="mb-3">
          <strong>{t('terms.notice_agree')}</strong>
        </p>
        <p class="text-sm">
          {t('terms.notice_arbitration_pre')} <a href="mailto:support@pickmytrade.com" class="text-blue-400 hover:text-blue-300 underline">support@pickmytrade.com</a> {t('terms.notice_arbitration_post')}
        </p>
      </div>

      <!-- Definitions -->
      <section>
        <h2 class="text-xl md:text-2xl font-bold text-white mb-3 md:mb-4">{t('terms.definitions_title')}</h2>
        <ul class="space-y-3 pl-4">
          <li><strong class="text-white">{t('terms.def_affiliate_label')}</strong> {t('terms.def_affiliate_body')}</li>
          <li><strong class="text-white">{t('terms.def_documentation_label')}</strong> {t('terms.def_documentation_body')}</li>
          <li><strong class="text-white">{t('terms.def_loss_label')}</strong> {t('terms.def_loss_body')}</li>
          <li><strong class="text-white">{t('terms.def_platform_label')}</strong> {t('terms.def_platform_body')}</li>
          <li><strong class="text-white">{t('terms.def_userdata_label')}</strong> {t('terms.def_userdata_body')}</li>
        </ul>
      </section>

      <!-- General Disclaimers -->
      <section>
        <h2 class="text-xl md:text-2xl font-bold text-white mb-3 md:mb-4">{t('terms.disclaimers_title')}</h2>
        <p class="font-semibold text-yellow-400">
          {t('terms.disclaimers_body')}
        </p>
      </section>

      <!-- General Terms -->
      <section>
        <h2 class="text-xl md:text-2xl font-bold text-white mb-3 md:mb-4">{t('terms.general_title')}</h2>
        <p>{t('terms.general_body')}</p>
      </section>

      <!-- Description of Services -->
      <section>
        <h2 class="text-xl md:text-2xl font-bold text-white mb-3 md:mb-4">{t('terms.services_title')}</h2>
        <p>{t('terms.services_body')}</p>
      </section>

      <!-- User Responsibilities -->
      <section>
        <h2 class="text-xl md:text-2xl font-bold text-white mb-3 md:mb-4">{t('terms.responsibilities_title')}</h2>
        <p class="mb-3"><strong class="text-white">{t('terms.responsibilities_resale_label')}</strong> {t('terms.responsibilities_resale_body')}</p>
      </section>

      <!-- License to Use -->
      <section>
        <h2 class="text-xl md:text-2xl font-bold text-white mb-3 md:mb-4">{t('terms.license_title')}</h2>
        <p class="mb-3">{t('terms.license_body')}</p>
        <p class="mb-2"><strong class="text-white">{t('terms.license_prohibited_label')}</strong></p>
        <ul class="list-disc list-inside space-y-2 pl-4">
          <li>{t('terms.license_prohibited_item1')}</li>
          <li>{t('terms.license_prohibited_item2')}</li>
          <li>{t('terms.license_prohibited_item3')}</li>
          <li>{t('terms.license_prohibited_item4')}</li>
        </ul>
      </section>

      <!-- Content and Proprietary Rights -->
      <section>
        <h2 class="text-xl md:text-2xl font-bold text-white mb-3 md:mb-4">{t('terms.content_title')}</h2>
        <p class="mb-3">{t('terms.content_p1')}</p>
        <p>{t('terms.content_p2')}</p>
      </section>

      <!-- Payment and Cancellation -->
      <section>
        <h2 class="text-xl md:text-2xl font-bold text-white mb-3 md:mb-4">{t('terms.payment_title')}</h2>

        <h3 class="text-lg font-semibold text-white mb-2 mt-4">{t('terms.payment_pricing_title')}</h3>
        <p class="mb-3">{t('terms.payment_pricing_body')}</p>

        <h3 class="text-lg font-semibold text-white mb-2 mt-4">{t('terms.payment_taxes_title')}</h3>
        <p class="mb-3">{t('terms.payment_taxes_body')}</p>

        <h3 class="text-lg font-semibold text-white mb-2 mt-4">{t('terms.payment_billing_title')}</h3>
        <p class="mb-3">{t('terms.payment_billing_body')}</p>

        <h3 class="text-lg font-semibold text-white mb-2 mt-4">{t('terms.payment_cancel_title')}</h3>
        <p class="mb-3">{t('terms.payment_cancel_body')}</p>

        <h3 class="text-lg font-semibold text-white mb-2 mt-4">{t('terms.payment_reseller_title')}</h3>
        <p>{t('terms.payment_reseller_body')}</p>
      </section>

      <!-- User Obligations -->
      <section>
        <h2 class="text-xl md:text-2xl font-bold text-white mb-3 md:mb-4">{t('terms.obligations_title')}</h2>

        <h3 class="text-lg font-semibold text-white mb-2">{t('terms.obligations_security_title')}</h3>
        <p class="mb-3">{t('terms.obligations_security_body')}</p>

        <h3 class="text-lg font-semibold text-white mb-2">{t('terms.obligations_compliance_title')}</h3>
        <p>{t('terms.obligations_compliance_body')}</p>
      </section>

      <!-- Privacy Policy -->
      <section>
        <h2 class="text-xl md:text-2xl font-bold text-white mb-3 md:mb-4">{t('terms.privacy_title')}</h2>
        <p>{t('terms.privacy_pre')} <a href={localizedPath(locale, 'legal/privacy')} class="text-blue-400 hover:text-blue-300 underline transition-colors">{t('terms.privacy_link')}</a>{t('terms.privacy_post')}</p>
      </section>

      <!-- Warranty Disclaimers -->
      <section>
        <h2 class="text-xl md:text-2xl font-bold text-white mb-3 md:mb-4">{t('terms.warranty_title')}</h2>
        <p class="mb-3 font-semibold text-yellow-400">{t('terms.warranty_p1')}</p>
        <p class="mb-3">{t('terms.warranty_p2')}</p>
        <p class="mb-3">{t('terms.warranty_p3')}</p>
        <p class="text-sm">{t('terms.warranty_p4')}</p>
      </section>

      <!-- Indemnification -->
      <section>
        <h2 class="text-xl md:text-2xl font-bold text-white mb-3 md:mb-4">{t('terms.indemnification_title')}</h2>
        <p>{t('terms.indemnification_body')}</p>
      </section>

      <!-- Limitation of Liability -->
      <section>
        <h2 class="text-xl md:text-2xl font-bold text-white mb-3 md:mb-4">{t('terms.liability_title')}</h2>
        <p class="mb-3 font-semibold">{t('terms.liability_p1')}</p>
        <p class="mb-3">{t('terms.liability_p2')}</p>
        <p class="font-semibold">{t('terms.liability_p3')}</p>
      </section>

      <!-- Confidentiality -->
      <section>
        <h2 class="text-xl md:text-2xl font-bold text-white mb-3 md:mb-4">{t('terms.confidentiality_title')}</h2>
        <p class="mb-3"><strong class="text-white">{t('terms.confidentiality_term')}</strong> {t('terms.confidentiality_p1')}</p>
        <p class="mb-3">{t('terms.confidentiality_p2')}</p>
        <p>{t('terms.confidentiality_p3')}</p>
      </section>

      <!-- Arbitration -->
      <section>
        <h2 class="text-xl md:text-2xl font-bold text-white mb-3 md:mb-4">{t('terms.arbitration_title')}</h2>
        <p class="mb-3">{t('terms.arbitration_p1')}</p>
        <p class="mb-3">{t('terms.arbitration_p2')}</p>
        <p class="mb-3">{t('terms.arbitration_p3')}</p>
        <p class="mb-3">{t('terms.arbitration_p4')}</p>
        <p>{t('terms.arbitration_p5')}</p>
      </section>

      <!-- Other Provisions -->
      <section>
        <h2 class="text-xl md:text-2xl font-bold text-white mb-3 md:mb-4">{t('terms.other_title')}</h2>

        <h3 class="text-lg font-semibold text-white mb-2 mt-4">{t('terms.other_amendments_title')}</h3>
        <p class="mb-3">{t('terms.other_amendments_body')}</p>

        <h3 class="text-lg font-semibold text-white mb-2 mt-4">{t('terms.other_entire_title')}</h3>
        <p class="mb-3">{t('terms.other_entire_body')}</p>

        <h3 class="text-lg font-semibold text-white mb-2 mt-4">{t('terms.other_assignment_title')}</h3>
        <p class="mb-3">{t('terms.other_assignment_body')}</p>

        <h3 class="text-lg font-semibold text-white mb-2 mt-4">{t('terms.other_severability_title')}</h3>
        <p class="mb-3">{t('terms.other_severability_body')}</p>

        <h3 class="text-lg font-semibold text-white mb-2 mt-4">{t('terms.other_governing_title')}</h3>
        <p class="mb-3">{t('terms.other_governing_body')}</p>

        <h3 class="text-lg font-semibold text-white mb-2 mt-4">{t('terms.other_notice_title')}</h3>
        <p class="mb-3">{t('terms.other_notice_pre')} <a href="mailto:support@pickmytrade.com" class="text-blue-400 hover:text-blue-300 underline transition-colors">support@pickmytrade.com</a>{t('terms.other_notice_post')}</p>

        <h3 class="text-lg font-semibold text-white mb-2 mt-4">{t('terms.other_survival_title')}</h3>
        <p>{t('terms.other_survival_body')}</p>
      </section>

      <!-- Contact -->
      <section class="text-center pt-8">
        <p class="text-gray-400 mb-3">
          {t('terms.contact_text')}
        </p>
        <p>
          <a href="mailto:support@pickmytrade.com" class="text-blue-400 hover:text-blue-300 transition-colors font-medium">support@pickmytrade.com</a>
        </p>
      </section>

    </div>

    <!-- Back Link -->
    <div class="text-center mt-12 pt-8 border-t border-gray-800">
      <a href={localizedPath(locale, '')} class="inline-flex items-center gap-2 text-blue-400 hover:text-blue-300 transition-colors font-medium">
        <span>{t('terms.back_home')}</span>
      </a>
    </div>
  </div>
</BaseLayout>
