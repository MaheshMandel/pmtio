      <p class="mb-5 text-gray-400 text-sm leading-relaxed">{t('affiliate.contact_modal_desc')}</p>
      <div class="mb-6">
        <a href="mailto:support@pickmytrade.com"
          class="inline-block bg-white/5 border border-white/10 hover:border-blue-500/40 text-blue-400 px-5 py-2.5 rounded-xl font-mono text-sm transition-colors">
          support@pickmytrade.com
        </a>
      </div>
      <button id="connectBtn"
        class="w-full bg-blue-600 hover:bg-blue-500 text-white px-6 py-3 rounded-xl font-bold shadow transition-all duration-200">
        {t('affiliate.contact_modal_button')}
      </button>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const partnershipEmail = "support@pickmytrade.com";

      const openModalBtn = document.getElementById('openModalBtn');
      const contactModal = document.getElementById('contactModal');
      const connectBtn = document.getElementById('connectBtn');
      const closeContactModalBtn = document.getElementById('closeContactModalBtn');
      const closeModalBtn = document.getElementById('closeModalBtn');
      const openAffiliateBtn = document.getElementById('openAffiliateBtn');
      const affiliateModal = document.getElementById('affiliateModal');
      const viewDocsBtn = document.getElementById('viewDocsBtn');
      const signUpBtn = document.getElementById('signUpBtn');

      openModalBtn?.addEventListener('click', () => contactModal?.classList.remove('hidden'));
      openAffiliateBtn?.addEventListener('click', () => affiliateModal?.classList.remove('hidden'));
      closeModalBtn?.addEventListener('click', () => affiliateModal?.classList.add('hidden'));
      closeContactModalBtn?.addEventListener('click', () => contactModal?.classList.add('hidden'));

      affiliateModal?.addEventListener('click', (e) => {
        if (e.target === affiliateModal) affiliateModal.classList.add('hidden');
      });
      contactModal?.addEventListener('click', (e) => {
        if (e.target === contactModal) contactModal.classList.add('hidden');
      });

      connectBtn?.addEventListener('click', () => {
        window.location.href = `mailto:${partnershipEmail}?subject=Partner%20Program%20Inquiry`;
      });
      viewDocsBtn?.addEventListener('click', () => {
        window.open('https://docs.pickmytrade.trade/docs/referral-system/', '_blank');
      });
      signUpBtn?.addEventListener('click', () => {
        window.open('https://app.pickmytrade.trade/?register=true');
      });
    });
  </script>

