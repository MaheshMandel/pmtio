---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalePaths, localizedPath, useTranslations, absoluteLocalizedPath } from '../../i18n/utils';
import { LOCALE_BCP47, type Locale } from '../../i18n/config';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const schema1 = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": "https://pickmytrade.io/#software",
  "image": "https://pickmytrade.io/assets/logo.png",
  "name": "PickMyTrade",
  "applicationCategory": "FinanceApplication",
  "applicationSubCategory": "Trading Automation",
  "operatingSystem": "Web",
  "softwareVersion": "2026.4",
  "description": "Automate TradingView alerts to Rithmic, IB, TradeStation & more in under 2 minutes. Join 50,000+ traders automating with sub-second execution.",
  "url": absoluteLocalizedPath(locale, 'pricing'),
  "downloadUrl": "https://app.pickmytrade.io/?register=true",
  "inLanguage": LOCALE_BCP47[locale],
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "50.00",
    "highPrice": "500.00",
    "offerCount": "4",
    "availability": "https://schema.org/InStock",
    "url": "https://app.pickmytrade.io/?register=true",
    "offers": [
      {
        "@type": "Offer",
        "name": "Monthly",
        "price": "50.00",
        "priceCurrency": "USD",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "50.00",
          "priceCurrency": "USD",
          "billingDuration": "P1M",
          "billingIncrement": 1
        },
        "availability": "https://schema.org/InStock",
        "url": "https://app.pickmytrade.io/?register=true"
      },
      {
        "@type": "Offer",
        "name": "Quarterly",
        "price": "135.00",
        "priceCurrency": "USD",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "135.00",
          "priceCurrency": "USD",
          "billingDuration": "P3M",
          "billingIncrement": 1
        },
        "availability": "https://schema.org/InStock",
        "url": "https://app.pickmytrade.io/?register=true"
      },
      {
        "@type": "Offer",
        "name": "Annual",
        "price": "500.00",
        "priceCurrency": "USD",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "500.00",
          "priceCurrency": "USD",
          "billingDuration": "P1Y",
          "billingIncrement": 1
        },
        "availability": "https://schema.org/InStock",
        "url": "https://app.pickmytrade.io/?register=true"
      }
    ]
  }
};

const schema2 = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://pickmytrade.io/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Pricing",
      "item": absoluteLocalizedPath(locale, 'pricing')
    }
  ]
};

const schema3 = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Pricing Plans | PickMyTrade",
  "description": "Choose the perfect plan for your TradingView automation journey. Start with our 7-day free trial. Unlimited trades, strategies, and 24/7 priority support.",
  "url": absoluteLocalizedPath(locale, 'pricing'),
  "inLanguage": LOCALE_BCP47[locale],
  "datePublished": "2023-06-01",
  "dateModified": "2026-06-05",
  "publisher": {
    "@type": "Organization",
    "name": "PickMyTrade",
    "logo": {
      "@type": "ImageObject",
      "url": "https://pickmytrade.io/assets/logo.png"
    }
  }
};
---

<BaseLayout
  locale={locale}
  title={t('pricing.page_title')}
  description={t('pricing.page_description')}
  keywords={t('pricing.page_keywords')}
  structuredData={[schema1, schema2, schema3]}
>

  <div class="bg-[#001429] pt-32 pb-20">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">

      <section id="pricing" class="w-full py-12 px-5 sm:px-0 mx-auto" data-aos="fade-up">

        <!-- Section header -->
        <div class="space-y-4 text-center mb-16">
          <div class="inline-block px-4 py-2 bg-[#0084d1]/20 rounded-full mb-4">
            <span class="text-[#0084d1] font-semibold text-sm">{t('pricing.badge')}</span>
          </div>
          <h1 class="text-4xl text-white mb-4 font-bold tracking-tighter md:text-6xl/tight">
            {t('pricing.hero_title')}
          </h1>
          <p class="text-white/80 text-lg max-w-2xl mx-auto">
            {t('pricing.hero_subtitle')}
          </p>
          <div class="flex justify-center items-center gap-2 pt-4 flex-wrap">
            <i class="fas fa-check-circle text-green-400"></i>
            <span class="text-white/70 text-sm">{t('pricing.trial_note')}</span>
          </div>
        </div>

        <!-- Pricing cards are rendered client-side from pricing-config.json (shared with the home page) -->
        <div
          id="pricing-cards-container"
          class="flex gap-8 justify-center mx-auto flex-wrap max-w-8xl my-12 xl:flex-nowrap xl:gap-6 xl:[&>div]:min-w-0 xl:[&>div]:max-w-none xl:[&>div]:flex-1"
        ></div>

        <!-- Trust Indicators Section -->
        <div class="mt-20 max-w-5xl mx-auto" data-aos="fade-up" data-aos-delay="200">
          <div class="grid md:grid-cols-2 gap-8 px-4">

            <!-- Secure Payment -->
            <div class="flex flex-col items-center text-center p-8 bg-white/5 backdrop-blur-sm rounded-2xl border border-white/10 hover:border-[#0084d1]/50 transition-all duration-300">
              <div class="w-16 h-16 rounded-full bg-blue-500/20 flex items-center justify-center mb-6">
                <i class="fas fa-lock text-blue-400 text-2xl"></i>
              </div>
              <h3 class="text-white font-bold text-xl mb-3">{t('pricing.trust_secure_title')}</h3>
              <p class="text-white/70 text-sm leading-relaxed">
                {t('pricing.trust_secure_desc')}
              </p>
            </div>

            <!-- 24/7 Support -->
            <div class="flex flex-col items-center text-center p-8 bg-white/5 backdrop-blur-sm rounded-2xl border border-white/10 hover:border-[#0084d1]/50 transition-all duration-300">
              <div class="w-16 h-16 rounded-full bg-purple-500/20 flex items-center justify-center mb-6">
                <i class="fas fa-headset text-purple-400 text-2xl"></i>
              </div>
              <h3 class="text-white font-bold text-xl mb-3">{t('pricing.trust_support_title')}</h3>
              <p class="text-white/70 text-sm leading-relaxed">
                {t('pricing.trust_support_desc')}
              </p>
            </div>
          </div>

          <!-- FAQ Link -->
          <div class="text-center mt-16">
            <p class="text-white/70 text-sm mb-4">{t('pricing.faq_prompt')}</p>
            <a
              href={localizedPath(locale, 'general-faq')}
              class="inline-flex items-center gap-2 text-[#0084d1] hover:text-blue-400 font-semibold transition-colors duration-200"
            >
              <i class="fas fa-question-circle"></i>
              {t('pricing.faq_link')}
              <i class="fas fa-arrow-right text-sm"></i>
            </a>
          </div>
        </div>

      </section>
    </div>
  </div>

  <Fragment slot="scripts">
    <script>
      import { renderPricingSection } from '../../scripts/pricing-cards';

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderPricingSection);
      } else {
        renderPricingSection();
      }
    </script>
  </Fragment>

</BaseLayout>
