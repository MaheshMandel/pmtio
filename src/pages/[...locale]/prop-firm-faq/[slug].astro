---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FirmFacts from '../../../components/FirmFacts.astro';
import { getLocalePaths, localizedPath, absoluteLocalizedPath, useTranslations } from '../../../i18n/utils';
import propfirmsData from '../../../../config/propfirms.json';
import { FIRM_FAQ_EXTRAS } from '../../../data/firmFaqExtras';
import { firmHasSupportedPlatform, toOrList, hasAutomationCaveat } from '../../../lib/firmSupport';

// ──────────────────────────────────────────────────────────────
// Extended firm catalogue (firms not in propfirms.json)
// slug here is the ROUTE slug — no "-faq" suffix
// ──────────────────────────────────────────────────────────────
const extendedFirms = [
  { slug: 'topstep',                name: 'Topstep',                description: 'The Trading Combine, TopstepX platform migration, Maximum Loss Limit, Consistency Rule, ProjectX Gateway API, and funded futures accounts.' },
  { slug: 'fundednext',             name: 'FundedNext',             description: 'Stellar 2-Step / 1-Step / Lite / Express models, on-evaluation profit share, Bolt / Rapid / Legacy futures, drawdown and consistency rules.' },
  { slug: 'myfundedfx',             name: 'MyFundedFX',             description: 'Lightning / Standard / Express evaluations, drawdown rules, payouts, the Seacrest Markets restructuring, and how MFX differs from MyFundedFutures.' },
  { slug: 'ftmo',                   name: 'FTMO',                   description: 'The two-step Challenge and Verification, daily and maximum loss limits, scaling plan, OANDA US access for American traders, automation rules.' },
  { slug: 'fundingpips',            name: 'FundingPips',            description: '1-Step, 2-Step Standard, 2-Step Pro, and Zero evaluations, the instant-funding pathway, hybrid drawdown, and Rise withdrawal cycles.' },
  { slug: 'the5ers',                name: 'The5%ers',               description: "Bootcamp, High-Stakes Challenge, Hyper Growth, and ProGrowth programs — the firm's signature low-leverage funded forex approach." },
  { slug: 'e8-markets',             name: 'E8 Markets',             description: 'E8 One / Signature / Classic / Track evaluations, the ELEV8R scaling program, profit splits, payouts — for forex and futures.' },
  { slug: 'alpha-capital-group',    name: 'Alpha Capital Group',    description: 'Six UK forex challenges (Alpha One / Pro 6-8-10% / Swing / Three), 80% split, $2M scaling cap, MT5/cTrader/DXTrade/TradeLocker platforms.' },
  { slug: 'aqua-funded',            name: 'AquaFunded',             description: 'Multi-asset prop firm: evaluation tracks, drawdown structure, payout cadence, and how to automate AquaFunded with PickMyTrade.' },
  { slug: 'audacity-capital',       name: 'Audacity Capital',       description: 'UK-based prop firm: account tiers, profit targets, drawdown rules, payout schedule, KYC, and supported trading platforms.' },
  { slug: 'blueguardian',           name: 'BlueGuardian',           description: 'BlueGuardian challenges, drawdown rules, profit splits, payouts, restricted strategies, and automation guidance via PickMyTrade.' },
  { slug: 'blufx',                  name: 'BluFX',                  description: 'Subscription-based forex prop model: live and demo plans, monthly fees, profit splits, withdrawal cycles, and supported platforms.' },
  { slug: 'brightfunded',           name: 'BrightFunded',           description: 'BrightFunded 2-step evaluations, drawdown rules, profit splits, payouts, copy-trade / EA policy, and PickMyTrade automation.' },
  { slug: 'city-traders-imperium',  name: 'City Traders Imperium',  description: 'CTI direct-funded and 2-step programs, scaling plan, monthly payout schedule, swing rules, and platform options.' },
  { slug: 'for-traders',            name: 'For Traders',            description: 'For Traders evaluation tracks, drawdown rules, profit splits, payouts, restricted countries, and PickMyTrade integration.' },
  { slug: 'funded-trading-plus',    name: 'Funded Trading Plus',    description: 'FTP challenges and instant-funded accounts, scaling, profit splits, payouts, news/HFT/EA rules, and platform availability.' },
  { slug: 'funder-pro',             name: 'FunderPro',              description: "FunderPro's 1-step, 2-step, and Direct Funded plans, drawdown rules, splits, payouts, and supported platforms / automation." },
  { slug: 'fxify',                  name: 'FXIFY',                  description: 'FXIFY 1-step / 2-step / 3-step funded plans, profit targets, drawdown limits, profit splits, payout cycles, and add-ons.' },
  { slug: 'lucid-trading',          name: 'Lucid Trading',          description: 'Lucid Trading hedging, copier and bot rules, news trading, payouts, consistency, drawdown, live-account transition and account limits.', platforms: 'Tradovate, Rithmic' },
  { slug: 'rebelsfunding',          name: 'RebelsFunding',          description: 'RebelsFunding rules on EAs and bots, copiers, martingale, the 1.5% risk rule, minimum hold time, news trading, drawdown, payouts and KYC.', platforms: 'RF-Trader' },
  { slug: 'goat-funded-trader',     name: 'Goat Funded Trader',     description: 'GFT evaluation plans, profit targets, drawdown structure, payout cadence, EA rules, and platform support.' },
  { slug: 'lark-funding',           name: 'Lark Funding',           description: "Lark Funding's futures evaluations, trailing drawdown, profit targets, payout structure, and supported futures platforms." },
  { slug: 'leeloo-trading',         name: 'Leeloo Trading',         description: 'Leeloo (now part of Take Profit Trader) futures evaluations, trailing drawdown, contract scaling, and platform options.' },
  { slug: 'lux-trading-firm',       name: 'Lux Trading Firm',       description: 'UK firm: 1-Stage Evaluation ($100K / $400K / $1M) + $400K Instant Funding, 80% split, 100% fee refund, 2x scaling to $10M, MatchTrader automation.' },
  { slug: 'maven-trading',          name: 'Maven Trading',          description: 'Maven Trading evaluations, profit targets, drawdown rules, profit splits, payout schedule, and supported platforms.' },
  { slug: 'oneup-trader',           name: 'OneUp Trader',           description: 'OneUp Trader monthly futures evaluations, trailing drawdown, profit targets, performance payouts, and platform support.' },
  { slug: 'smart-prop-trader',      name: 'Smart Prop Trader',      description: 'Smart Prop Trader evaluations, drawdown rules, profit splits, payout cycles, restricted strategies, and PickMyTrade automation.' },
  { slug: 'the-funded-trader',      name: 'The Funded Trader',      description: 'TFT Standard / Rapid / Royal / Knight evaluations, drawdown rules, scaling, payouts, and supported trading platforms.' },
  { slug: 'the-trading-pit',        name: 'The Trading Pit',        description: 'Liechtenstein-based prop firm (Pinorena Capital): CFD Standard/Pro/Aggressive + Futures Prime $50K/$100K/$150K plans, 80% splits.' },
];

// Build a normalised lookup: slug → { name, description, seo? }
// Prefer propfirms.json when the slug matches
type JsonFirm = typeof propfirmsData.propfirms[0];
type ExtFirm  = typeof extendedFirms[0];
type FirmEntry = {
  slug: string;
  name: string;
  description: string;
  seo?: JsonFirm['seo'];
  account_sizes?: string;
  profit_split?: string;
  profit_target?: string;
  platforms?: string;
  active_traders?: string;
};

const jsonFirmMap = new Map<string, JsonFirm>(
  propfirmsData.propfirms.map((f: JsonFirm) => [f.slug, f])
);

// Full catalogue: json firms first, then extended (deduplicated by slug)
const allFirms: FirmEntry[] = [
  ...propfirmsData.propfirms.map((f: JsonFirm): FirmEntry => ({
    slug: f.slug,
    name: f.name,
    description: f.seo.description,
    seo: f.seo,
    account_sizes: f.account_sizes,
    profit_split: f.profit_split,
    profit_target: f.profit_target,
    platforms: f.platforms,
    active_traders: f.active_traders,
  })),
  ...extendedFirms
    .filter((e: ExtFirm) => !jsonFirmMap.has(e.slug))
    .map((e: ExtFirm): FirmEntry => ({
      slug: e.slug,
      name: e.name,
      description: e.description,
      platforms: (e as { platforms?: string }).platforms,
    })),
];

export function getStaticPaths() {
  // Rebuild inside getStaticPaths (Astro requirement — no module-scope refs)
  type JsonFirmInner = { slug: string; name: string; seo: { title: string; description: string; keywords: string }; account_sizes: string; profit_split: string; profit_target: string; platforms: string; active_traders?: string };
  const extFirmsInner = [
    { slug: 'topstep',                name: 'Topstep' },
    { slug: 'fundednext',             name: 'FundedNext' },
    { slug: 'myfundedfx',             name: 'MyFundedFX' },
    { slug: 'ftmo',                   name: 'FTMO' },
    { slug: 'fundingpips',            name: 'FundingPips' },
    { slug: 'the5ers',                name: 'The5%ers' },
    { slug: 'e8-markets',             name: 'E8 Markets' },
    { slug: 'alpha-capital-group',    name: 'Alpha Capital Group' },
    { slug: 'aqua-funded',            name: 'AquaFunded' },
    { slug: 'audacity-capital',       name: 'Audacity Capital' },
    { slug: 'blueguardian',           name: 'BlueGuardian' },
    { slug: 'blufx',                  name: 'BluFX' },
    { slug: 'brightfunded',           name: 'BrightFunded' },
    { slug: 'city-traders-imperium',  name: 'City Traders Imperium' },
    { slug: 'for-traders',            name: 'For Traders' },
    { slug: 'funded-trading-plus',    name: 'Funded Trading Plus' },
    { slug: 'funder-pro',             name: 'FunderPro' },
    { slug: 'fxify',                  name: 'FXIFY' },
    { slug: 'lucid-trading',          name: 'Lucid Trading' },
    { slug: 'rebelsfunding',          name: 'RebelsFunding' },
    { slug: 'goat-funded-trader',     name: 'Goat Funded Trader' },
    { slug: 'lark-funding',           name: 'Lark Funding' },
    { slug: 'leeloo-trading',         name: 'Leeloo Trading' },
    { slug: 'lux-trading-firm',       name: 'Lux Trading Firm' },
    { slug: 'maven-trading',          name: 'Maven Trading' },
    { slug: 'oneup-trader',           name: 'OneUp Trader' },
    { slug: 'smart-prop-trader',      name: 'Smart Prop Trader' },
    { slug: 'the-funded-trader',      name: 'The Funded Trader' },
    { slug: 'the-trading-pit',        name: 'The Trading Pit' },
  ];

  const jsonSlugs = new Set<string>(propfirmsData.propfirms.map((f: JsonFirmInner) => f.slug));
  const allSlugs = [
    ...propfirmsData.propfirms.map((f: JsonFirmInner) => f.slug),
    ...extFirmsInner.filter(e => !jsonSlugs.has(e.slug)).map(e => e.slug),
  ];

  return getLocalePaths().flatMap(({ params, props }) =>
    allSlugs.map((slug) => ({
      params: { locale: params.locale, slug },
      props: { locale: props.locale, slug },
    }))
  );
}

const { locale, slug } = Astro.props;
const firm = allFirms.find((f) => f.slug === slug) as FirmEntry;
const t = useTranslations(locale);
const isSupported = firm.platforms ? firmHasSupportedPlatform(firm.platforms) : true;
const unsupportedPlatforms = firm.platforms ? toOrList(firm.platforms, locale) : '';

// Always use the FAQ-specific, localized metadata. firm.seo.* belongs to the
// propfirms/[slug] landing page — reusing it here shipped this page a byte-
// identical <title>/description to its /propfirms/ sibling (and an English one
// on every locale), so the two pages cannibalised each other in search.
// The default templates below promise "how to automate {name}", which is
// false for firms whose platforms are all MT4/MT5/DXTrade — see firmSupport.ts.
const pageTitle = isSupported
  ? t('propfirm_faq_detail.meta_title_fallback', { name: firm.name })
  : t('propfirm_faq_detail.meta_title_fallback_unsupported', { name: firm.name });
const pageDescription = isSupported
  ? t('propfirm_faq_detail.meta_description_fallback', { name: firm.name })
  : t('propfirm_faq_detail.meta_description_fallback_unsupported', { name: firm.name, platforms: unsupportedPlatforms });
const pageKeywords = t('propfirm_faq_detail.meta_keywords_fallback', { name: firm.name });

const pageUrl = absoluteLocalizedPath(locale, `prop-firm-faq/${firm.slug}`);

// ──────────────────────────────────────────────────────────────
// FAQPage schema, generated from the same translation keys the
// page renders.
//
// This page shows 43 Q&A pairs in <details> blocks, but the schema below used
// to declare only 3 hand-written ones — and one of those ("What is {name}?")
// answered with "See the firm's official website for current rules", which
// hands the citation to the firm instead of keeping it. Across the 30 prop-firm
// pages that was ~1,200 answered questions invisible to machine readers, on the
// deepest content the site has.
//
// Driving both from one list is what keeps them honest: SECTIONS mirrors the
// rendered accordion exactly (section order and question counts), so schema and
// visible copy cannot drift apart. faqPairCount is asserted against the number
// of <details> blocks by scripts/check-faq-schema.mjs.
// ──────────────────────────────────────────────────────────────

/** Section id → number of Q&A pairs rendered, in on-page order. */
const FAQ_SECTIONS: Array<[string, number]> = [
  ['basics', 4],
  ['accounttypes', 4],
  ['pricing', 3],
  ['targets', 3],
  ['drawdown', 4],
  ['consistency', 3],
  ['days', 3],
  ['instruments', 2],
  ['automation', 4],
  ['platforms', 3],
  ['pmt', 5],
  ['payouts', 5],
];

/**
 * Three answers are rendered as a `_pre` string followed by an inline link, so
 * the plain `_aN` key does not exist for them. The schema text has to match what
 * a reader sees, so the link's visible label is appended back on.
 */
const ANSWER_LINK_SUFFIX: Record<string, string> = {
  automation_a2: 'app.pickmytrade.io.',
  automation_a4: 'docs.pickmytrade.trade.',
  pmt_a2: 'pickmytrade.io.',
};

// automation_q2/a2 and automation_q4/a4 claim PickMyTrade connects to {name} —
// false when firm.platforms are all brokers PickMyTrade doesn't support, so
// this pair gets swapped for both the visible accordion below and this schema
// (same override, one source, so DOM and JSON-LD can't drift apart).
const unsupportedFaqOverrides: Record<string, { q: string; a: string }> = isSupported ? {} : {
  automation_2: {
    q: t('propfirm_faq_detail.automation_q2_unsupported', { name: firm.name }),
    a: t('propfirm_faq_detail.automation_a2_unsupported', { name: firm.name, platforms: unsupportedPlatforms }),
  },
  automation_4: {
    q: t('propfirm_faq_detail.automation_q4_unsupported', { name: firm.name }),
    a: t('propfirm_faq_detail.automation_a4_unsupported', { name: firm.name }),
  },
  pmt_1: {
    q: t('propfirm_faq_detail.pmt_q1_unsupported', { name: firm.name }),
    a: t('propfirm_faq_detail.pmt_a1_unsupported', { name: firm.name, platforms: unsupportedPlatforms }),
  },
  pmt_5: {
    q: t('propfirm_faq_detail.pmt_q5_unsupported', { name: firm.name }),
    a: t('propfirm_faq_detail.pmt_a5_unsupported', { name: firm.name, platforms: unsupportedPlatforms }),
  },
};

// ──────────────────────────────────────────────────────────────
// Per-firm trader FAQ extras (src/data/firmFaqExtras.ts). A REPLACE entry hides
// the shared-template question it names (visible accordion AND schema) and takes
// its place in the extras section below; every other entry is appended. The
// match is on the rendered template question, so a drifted template wording
// fails the build instead of silently leaving two answers on the page.
// ──────────────────────────────────────────────────────────────
const firmExtras = FIRM_FAQ_EXTRAS[firm.slug] ?? [];
const tEn = useTranslations('en'); // extras are English; match on the English template question in every locale
const templateQuestionKeys = new Map<string, string>();
for (const [section, count] of FAQ_SECTIONS) {
  for (let n = 1; n <= count; n++) {
    templateQuestionKeys.set(
      tEn(`propfirm_faq_detail.${section}_q${n}` as Parameters<typeof t>[0], { name: firm.name }),
      `${section}_${n}`,
    );
  }
}
const replacedKeys = new Set<string>();
for (const e of firmExtras) {
  if (e.action !== 'REPLACE') continue;
  const key = templateQuestionKeys.get(e.existing ?? '');
  if (!key) throw new Error(`[prop-firm-faq/${firm.slug}] ${e.id}: no template question matches "${e.existing}"`);
  replacedKeys.add(key);
}
const EXTRA_GROUPS: Array<{ id: 'main' | 'futures' | 'cfd'; heading: string }> =
  firm.slug === 'fundednext'
    ? [
        { id: 'futures', heading: 'FundedNext Futures: trader questions answered' },
        { id: 'cfd', heading: 'FundedNext CFD: trader questions answered' },
      ]
    : [{ id: 'main', heading: `${firm.name}: trader questions answered` }];
const extrasByGroup = EXTRA_GROUPS
  .map((g) => ({ ...g, items: firmExtras.filter((e) => e.group === g.id) }))
  .filter((g) => g.items.length > 0);
const extraEntities = extrasByGroup.flatMap((g) => g.items).map((e) => ({
  '@type': 'Question',
  name: e.q,
  acceptedAnswer: { '@type': 'Answer', text: e.text },
}));

const faqEntities = FAQ_SECTIONS.flatMap(([section, count]) =>
  Array.from({ length: count }, (_, i) => {
    const n = i + 1;
    if (replacedKeys.has(`${section}_${n}`)) return null;
    const override = unsupportedFaqOverrides[`${section}_${n}`];
    if (override) {
      return {
        '@type': 'Question',
        name: override.q,
        acceptedAnswer: { '@type': 'Answer', text: override.a },
      };
    }

    const answerId = `${section}_a${n}`;
    const suffix = ANSWER_LINK_SUFFIX[answerId];
    const answerKey = suffix ? `${answerId}_pre` : answerId;
    const params = { name: firm.name };

    const answer =
      t(`propfirm_faq_detail.${answerKey}` as Parameters<typeof t>[0], params) +
      (suffix ? suffix : '');

    return {
      '@type': 'Question',
      name: t(`propfirm_faq_detail.${section}_q${n}` as Parameters<typeof t>[0], params),
      acceptedAnswer: { '@type': 'Answer', text: answer },
    };
  }),
).filter(Boolean).concat(extraEntities);

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home",          "item": "https://pickmytrade.io/" },
      { "@type": "ListItem", "position": 2, "name": "Prop Firm FAQ", "item": absoluteLocalizedPath(locale, 'prop-firm-faq') },
      { "@type": "ListItem", "position": 3, "name": `${firm.name} FAQ`, "item": pageUrl }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1","h2","summary","details > div"] },
    "name": `${firm.name} FAQ`,
    "description": pageDescription,
    "url": pageUrl,
    // All 43 rendered Q&A pairs, in page order — not a hand-picked 3.
    // Localised automatically: these come from the same t() calls the accordion
    // uses, so the German page ships German schema.
    "mainEntity": faqEntities
  }
];
---
<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonical={pageUrl}
  structuredData={structuredData}
>
  <main id="main-content" role="main">

    <!-- Hero -->
    <section class="bg-gradient-to-b from-[#001429] via-[#001f3f] to-[#002040] pt-28 pb-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <nav aria-label="Breadcrumb" class="flex justify-center mb-6" data-aos="fade-down">
          <ol class="flex items-center space-x-2 text-sm text-gray-400">
            <li><a href={localizedPath(locale, '')} class="hover:text-[#2B77EE] transition-colors">{t('propfirm_faq_detail.breadcrumb_home')}</a></li>
            <li><i class="fa-solid fa-chevron-right text-xs text-gray-600"></i></li>
            <li><a href={localizedPath(locale, 'prop-firm-faq')} class="hover:text-[#2B77EE] transition-colors">{t('propfirm_faq_detail.breadcrumb_hub')}</a></li>
            <li><i class="fa-solid fa-chevron-right text-xs text-gray-600"></i></li>
            <li class="text-[#2B77EE]">{firm.name}</li>
          </ol>
        </nav>
        <span class="inline-block px-4 py-1.5 rounded-full bg-[#2B77EE]/10 border border-[#2B77EE]/30 text-[#2B77EE] text-xs font-semibold uppercase tracking-wider mb-5" data-aos="fade-up">
          <i class="fa-solid fa-shield-halved mr-1.5" aria-hidden="true"></i>{t('propfirm_faq_detail.hero_badge')}
        </span>
        <h1 class="text-3xl md:text-5xl font-bold mb-6 leading-tight" data-aos="fade-up">
          <span class="bg-gradient-to-r from-[#2B77EE] to-blue-400 bg-clip-text text-transparent">{firm.name}</span> {t('propfirm_faq_detail.hero_title_suffix')}
        </h1>
        <p class="text-gray-400 text-lg md:text-xl max-w-3xl mx-auto mb-8" data-aos="fade-up" data-aos-delay="100">
          {firm.description}
        </p>
        {isSupported && hasAutomationCaveat(firm.slug) && (
          <div class="max-w-2xl mx-auto mb-8 text-left bg-amber-500/10 border border-amber-500/30 rounded-xl p-5" data-aos="fade-up" data-aos-delay="150">
            <h2 class="text-white font-bold mb-2 flex items-center gap-2">
              <i class="fa-solid fa-triangle-exclamation text-amber-400" aria-hidden="true"></i>
              {t('firm_automation_rules_box.heading')}
            </h2>
            <p class="text-gray-300 text-sm leading-relaxed mb-3">{t('firm_automation_rules_box.body')}</p>
            <a href={localizedPath(locale, 'faq/prop-firm-automation')} class="text-amber-400 hover:text-amber-300 text-sm font-semibold">
              {t('firm_automation_rules_box.link_text')} <i class="fa-solid fa-arrow-right ml-1"></i>
            </a>
          </div>
        )}
        <div class="flex flex-wrap gap-4 justify-center" data-aos="fade-up" data-aos-delay="200">
          {isSupported ? (
            <a href="https://app.pickmytrade.io/?register=true" class="px-8 py-3 bg-[#2B77EE] hover:bg-blue-600 text-white font-semibold rounded-xl transition-all duration-300 shadow-lg shadow-blue-500/25">
              {t('propfirm_faq_detail.hero_cta_trial')} <i class="fa-solid fa-arrow-right ml-2"></i>
            </a>
          ) : (
            <a href={localizedPath(locale, 'supported-propfirms')} class="px-8 py-3 bg-[#2B77EE] hover:bg-blue-600 text-white font-semibold rounded-xl transition-all duration-300 shadow-lg shadow-blue-500/25">
              {t('firm_unsupported.cta_button')}
            </a>
          )}
          <a href="#faq-content" class="px-8 py-3 border border-white/20 hover:border-[#2B77EE]/50 text-white font-semibold rounded-xl transition-all duration-300 hover:bg-white/5">
            {t('propfirm_faq_detail.hero_cta_browse')} <i class="fa-solid fa-chevron-down ml-2"></i>
          </a>
        </div>
      </div>
    </section>

    <!-- FE-34: firm-specific, dated facts (config/propfirm-facts.json) -->
    <FirmFacts slug={firm.slug} name={firm.name} locale={locale} />

    <!-- Search Bar -->
    <section id="search-section" class="bg-[#001a33] py-10 px-4 border-y border-white/5">
      <div class="max-w-3xl mx-auto">
        <label for="faq-search" class="block text-white/80 text-sm font-semibold mb-3 text-center">
          <i class="fa-solid fa-magnifying-glass text-[#2B77EE] mr-2"></i>{t('propfirm_faq_detail.search_label')}
        </label>
        <div class="relative">
          <input
            id="faq-search"
            type="search"
            placeholder={t('propfirm_faq_detail.search_placeholder')}
            class="w-full bg-[#001429] border border-[#2B77EE]/30 focus:border-[#2B77EE] focus:outline-none text-white placeholder-gray-500 rounded-xl px-12 py-4 text-base transition-colors"
            autocomplete="off"
            role="combobox"
            aria-controls="faq-search-results"
            aria-expanded="false"
            aria-autocomplete="list"
          />
          <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-[#2B77EE] pointer-events-none"></i>
          <button
            id="faq-search-clear"
            type="button"
            class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-white hidden"
            aria-label="Clear search"
          >
            <i class="fa-solid fa-circle-xmark text-lg"></i>
          </button>
          <div
            id="faq-search-results"
            style="display:none"
            role="listbox"
            aria-label="Search results"
          ></div>
        </div>
      </div>
    </section>

    <!-- Section Nav -->
    <section class="bg-[#002040] py-16">
