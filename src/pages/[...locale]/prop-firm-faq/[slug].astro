  <section class="bg-[#001429] py-10 px-4 border-t border-white/10">
    <div class="max-w-4xl mx-auto text-center">
      <a href={localizedPath(locale, 'prop-firm-faq')} class="inline-flex items-center gap-2 text-[#2B77EE] hover:text-blue-400 font-semibold transition-colors">
        <i class="fa-solid fa-arrow-left"></i> {t('propfirm_faq_detail.back_to_hub')}
      </a>
    </div>
  </section>

  <!-- Secondary CTA -->
  <section class="bg-gradient-to-br from-[#0F3EC3] to-[#2B77EE] py-16 px-4">
    <div class="max-w-3xl mx-auto text-center" data-aos="fade-up">
      <h2 class="text-3xl md:text-4xl font-bold text-white electrolize mb-4">{isSupported ? t('propfirm_faq_detail.cta_title', { name: firm.name }) : t('firm_unsupported.cta_title', { name: firm.name })}</h2>
      <p class="text-white/90 mb-8">{isSupported ? t('propfirm_faq_detail.cta_subtitle', { name: firm.name }) : t('firm_unsupported.cta_subtitle', { platforms: unsupportedPlatforms })}</p>
      <a href={isSupported ? 'https://app.pickmytrade.io/?register=true' : localizedPath(locale, 'supported-propfirms')} class="bg-white text-[#0F3EC3] px-10 py-4 rounded-xl font-bold electrolize hover:shadow-[0_0_30px_5px_rgba(255,255,255,0.4)] transition-all inline-block">{isSupported ? t('propfirm_faq_detail.cta_button') : t('firm_unsupported.cta_button')}</a>
    </div>
  </section>

  <!-- Disclaimer -->
  <section class="bg-[#000a15] py-10 px-4 border-t border-white/10">
    <div class="max-w-4xl mx-auto text-sm text-white/60 leading-relaxed space-y-3">
      <h2 class="text-lg font-bold text-white/80 electrolize mb-2">{t('propfirm_faq_detail.disclaimer_title')}</h2>
      <p>{t('propfirm_faq_detail.disclaimer_text', { name: firm.name })}</p>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline define:vars={{ i18nSearch: {
      noResults: t('propfirm_faq_detail.search_no_results'),
      resultsOne: t('propfirm_faq_detail.search_results_one'),
      resultsMany: t('propfirm_faq_detail.search_results_many'),
      viewQuestion: t('propfirm_faq_detail.search_view_question'),
    } }}>
      document.addEventListener('DOMContentLoaded', function () {
        var searchInput = document.getElementById('faq-search');
        var searchClear = document.getElementById('faq-search-clear');
        var searchResults = document.getElementById('faq-search-results');
        if (!searchInput || !searchClear || !searchResults) return;

        var allDetails = Array.from(document.querySelectorAll('#faq-content details'));

        function closeResults() {
          searchResults.style.display = 'none';
          searchResults.innerHTML = '';
        }

        function runSearch() {
          var query = searchInput.value.trim().toLowerCase();
          searchClear.classList.toggle('hidden', query.length === 0);

          if (query.length < 2) { closeResults(); return; }

          var matches = allDetails.filter(function (d) {
            return (d.textContent || '').toLowerCase().includes(query);
          });

          searchResults.style.display = 'block';

          if (matches.length === 0) {
            searchResults.innerHTML = '<div class="bg-[#001429] border border-white/10 rounded-xl p-4 mt-2 text-gray-400 text-sm">' + i18nSearch.noResults + '</div>';
            return;
          }

          var countLabel = (matches.length === 1 ? i18nSearch.resultsOne : i18nSearch.resultsMany).replace('{count}', matches.length);
          var html = '<div class="mt-2 rounded-xl overflow-hidden border border-[#2B77EE]/20 bg-[#001a33]">'
            + '<div class="px-4 py-2 text-xs text-[#2B77EE] border-b border-white/10">' + countLabel + '</div>';

          matches.slice(0, 8).forEach(function (d, i) {
            var span = d.querySelector('summary span');
            var q = span ? (span.textContent || '').trim() : i18nSearch.viewQuestion;
            html += '<button data-ridx="' + i + '" class="w-full text-left px-4 py-3 text-sm text-white/90 hover:bg-[#2B77EE]/20 border-b border-white/5 last:border-0 transition-colors">' + q + '</button>';
          });
          html += '</div>';
          searchResults.innerHTML = html;

          searchResults.querySelectorAll('button[data-ridx]').forEach(function (btn) {
            btn.addEventListener('click', function () {
              var idx = parseInt(btn.getAttribute('data-ridx') || '0', 10);
              var target = matches[idx];
              if (target) {
                target.open = true;
                target.scrollIntoView({ behavior: 'smooth', block: 'center' });
              }
              closeResults();
              searchInput.value = '';
              searchClear.classList.add('hidden');
            });
          });
        }

        searchInput.addEventListener('input', runSearch);

        searchClear.addEventListener('click', function () {
          searchInput.value = '';
          searchClear.classList.add('hidden');
          closeResults();
          searchInput.focus();
        });

        document.addEventListener('click', function (e) {
          if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
            closeResults();
          }
        });
      });
    </script>
  </Fragment>
</BaseLayout>
