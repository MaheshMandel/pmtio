---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalePaths, localizedPath, absoluteLocalizedPath, useTranslations } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';
import propfirmsData from '../../../../config/propfirms.json';
import { PROPFIRM_HUB_FAQS } from '../../../data/traderFaqExtras';
import FaqExtraList from '../../../components/FaqExtraList.astro';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

// ── Firm catalogue ────────────────────────────────────────────────────────────
// Each entry: slug (matches FAQ route slug), name, description, icon (FA class)
// Firms present in propfirms.json use their seo.description; others are inlined.

type JsonFirm = typeof propfirmsData.propfirms[0];

interface FirmMeta {
  slug: string;
  name: string;
  description: string;
  icon: string;
}

// Lookup description from propfirms.json when available
const jsonDescMap = new Map<string, string>(
  propfirmsData.propfirms.map((f: JsonFirm) => [f.slug, f.seo.description])
);

function firmMeta(slug: string, name: string, fallbackDesc: string, icon: string): FirmMeta {
  return { slug, name, description: jsonDescMap.get(slug) ?? fallbackDesc, icon };
}

// ── Category definitions (matching source HTML) ───────────────────────────────

const futuresFirms: FirmMeta[] = [
  firmMeta('apex-trader-funding', 'Apex Trader Funding',
    'Largest US futures prop firm — Apex 4.0 vs Legacy 3.0, trailing drawdown, consistency rule, multi-account stacking, and frequent discount cycles.',
    'fa-solid fa-trophy'),
  firmMeta('topstep', 'Topstep / TopstepX',
    'The Trading Combine, TopstepX platform migration, Maximum Loss Limit, Consistency Rule, ProjectX Gateway API, and funded futures accounts.',
    'fa-solid fa-flag-checkered'),
];

const multiAssetFirms: FirmMeta[] = [
  firmMeta('e8-markets', 'E8 Markets',
    'E8 One / Signature / Classic / Track evaluations, the ELEV8R scaling program, profit splits, payouts — for forex and futures.',
    'fa-solid fa-rocket'),
  firmMeta('fundednext', 'FundedNext',
    'Stellar 2-Step / 1-Step / Lite / Express models, on-evaluation profit share, Bolt / Rapid / Legacy futures, drawdown and consistency rules.',
    'fa-solid fa-star'),
  firmMeta('myfundedfx', 'MyFundedFX',
    'Lightning / Standard / Express evaluations, drawdown rules, payouts, the Seacrest Markets restructuring, and how MFX differs from MyFundedFutures.',
    'fa-solid fa-circle-info'),
];

const forexFirms: FirmMeta[] = [
  firmMeta('ftmo', 'FTMO',
    'The two-step Challenge and Verification, daily and maximum loss limits, scaling plan, OANDA US access for American traders, automation rules.',
    'fa-solid fa-shield-halved'),
  firmMeta('fundingpips', 'FundingPips',
    '1-Step, 2-Step Standard, 2-Step Pro, and Zero evaluations, the instant-funding pathway, hybrid drawdown, and Rise withdrawal cycles.',
    'fa-solid fa-bolt'),
  firmMeta('the5ers', 'The5%ers',
    "Bootcamp, High-Stakes Challenge, Hyper Growth, and ProGrowth programs — the firm's signature low-leverage funded forex approach.",
    'fa-solid fa-percent'),
];

const moreFirms: FirmMeta[] = [
  firmMeta('alpha-capital-group', 'Alpha Capital Group',
    'Six UK forex challenges (Alpha One / Pro 6-8-10% / Swing / Three), 80% split, $2M scaling cap, MT5/cTrader/DXTrade/TradeLocker platforms.',
    'fa-solid fa-shield-halved'),
  firmMeta('aqua-funded', 'AquaFunded',
    'Multi-asset prop firm: evaluation tracks, drawdown structure, payout cadence, and how to automate AquaFunded with PickMyTrade.',
    'fa-solid fa-water'),
  firmMeta('audacity-capital', 'Audacity Capital',
    'UK-based prop firm: account tiers, profit targets, drawdown rules, payout schedule, KYC, and supported trading platforms.',
    'fa-solid fa-coins'),
  firmMeta('blueguardian', 'BlueGuardian',
    'BlueGuardian challenges, drawdown rules, profit splits, payouts, restricted strategies, and automation guidance via PickMyTrade.',
    'fa-solid fa-shield'),
  firmMeta('blufx', 'BluFX',
    'Subscription-based forex prop model: live and demo plans, monthly fees, profit splits, withdrawal cycles, and supported platforms.',
    'fa-solid fa-droplet'),
  firmMeta('brightfunded', 'BrightFunded',
    'BrightFunded 2-step evaluations, drawdown rules, profit splits, payouts, copy-trade / EA policy, and PickMyTrade automation.',
    'fa-solid fa-sun'),
  firmMeta('city-traders-imperium', 'City Traders Imperium',
    'CTI direct-funded and 2-step programs, scaling plan, monthly payout schedule, swing rules, and platform options.',
    'fa-solid fa-city'),
  firmMeta('for-traders', 'For Traders',
    'For Traders evaluation tracks, drawdown rules, profit splits, payouts, restricted countries, and PickMyTrade integration.',
    'fa-solid fa-user-tie'),
  firmMeta('funded-trading-plus', 'Funded Trading Plus',
    'FTP challenges and instant-funded accounts, scaling, profit splits, payouts, news/HFT/EA rules, and platform availability.',
    'fa-solid fa-plus'),
  firmMeta('funder-pro', 'FunderPro',
    "FunderPro's 1-step, 2-step, and Direct Funded plans, drawdown rules, splits, payouts, and supported platforms / automation.",
    'fa-solid fa-handshake'),
  firmMeta('fxify', 'FXIFY',
    'FXIFY 1-step / 2-step / 3-step funded plans, profit targets, drawdown limits, profit splits, payout cycles, and add-ons.',
    'fa-solid fa-bolt-lightning'),
  firmMeta('goat-funded-trader', 'Goat Funded Trader',
    'GFT evaluation plans, profit targets, drawdown structure, payout cadence, EA rules, and platform support.',
    'fa-solid fa-mountain'),
  firmMeta('lark-funding', 'Lark Funding',
    "Lark Funding's futures evaluations, trailing drawdown, profit targets, payout structure, and supported futures platforms.",
    'fa-solid fa-feather'),
  firmMeta('leeloo-trading', 'Leeloo Trading',
    'Leeloo (now part of Take Profit Trader) futures evaluations, trailing drawdown, contract scaling, and platform options.',
    'fa-solid fa-flag'),
  firmMeta('lux-trading-firm', 'Lux Trading Firm',
    'UK firm: 1-Stage Evaluation ($100K / $400K / $1M) + $400K Instant Funding, 80% split, 100% fee refund, 2x scaling to $10M, MatchTrader automation.',
    'fa-solid fa-gem'),
  firmMeta('maven-trading', 'Maven Trading',
    'Maven Trading evaluations, profit targets, drawdown rules, profit splits, payout schedule, and supported platforms.',
    'fa-solid fa-graduation-cap'),
  firmMeta('oneup-trader', 'OneUp Trader',
    'OneUp Trader monthly futures evaluations, trailing drawdown, profit targets, performance payouts, and platform support.',
    'fa-solid fa-chart-simple'),
  firmMeta('smart-prop-trader', 'Smart Prop Trader',
    'Smart Prop Trader evaluations, drawdown rules, profit splits, payout cycles, restricted strategies, and PickMyTrade automation.',
    'fa-solid fa-brain'),
  firmMeta('the-funded-trader', 'The Funded Trader',
    'TFT Standard / Rapid / Royal / Knight evaluations, drawdown rules, scaling, payouts, and supported trading platforms.',
    'fa-solid fa-trophy'),
  firmMeta('the-trading-pit', 'The Trading Pit',
    'Liechtenstein-based prop firm (Pinorena Capital): CFD Standard/Pro/Aggressive + Futures Prime $50K/$100K/$150K plans, 80% splits.',
    'fa-solid fa-warehouse'),
];

// ── Structured data ───────────────────────────────────────────────────────────

const allFirmsForSchema = [
  ...futuresFirms,
  ...multiAssetFirms,
  ...forexFirms,
  ...moreFirms,
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://pickmytrade.io/" },
      { "@type": "ListItem", "position": 2, "name": "Prop Firm FAQ Hub", "item": absoluteLocalizedPath(locale, 'prop-firm-faq') }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Prop Firm FAQ Pages",
    "description": "Per-firm FAQ pages covering evaluation rules, drawdown mechanics, profit splits, payouts, supported platforms, and TradingView automation.",
    "numberOfItems": allFirmsForSchema.length,
    "itemListOrder": "https://schema.org/ItemListUnordered",
    "itemListElement": allFirmsForSchema.map((f, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": `${f.name} FAQ`,
      "url": absoluteLocalizedPath(locale, `prop-firm-faq/${f.slug}`)
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": PROPFIRM_HUB_FAQS.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.text }
    }))
  }
];
---
<BaseLayout
  locale={locale}
  title={t('propfirm_faq_hub.meta_title')}
  description={t('propfirm_faq_hub.meta_description')}
  canonical={absoluteLocalizedPath(locale, "prop-firm-faq")}
  structuredData={structuredData}
>
  <main id="main-content" role="main">

    <!-- Hero -->
    <section class="bg-gradient-to-b from-[#001429] via-[#001f3f] to-[#002040] pt-28 pb-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <nav aria-label="Breadcrumb" class="flex justify-center mb-6" data-aos="fade-down">
          <ol class="flex items-center space-x-2 text-sm text-gray-400">
            <li><a href={localizedPath(locale, '')} class="hover:text-[#2B77EE] transition-colors">{t('propfirm_faq_hub.breadcrumb_home')}</a></li>
            <li><i class="fa-solid fa-chevron-right text-xs text-gray-600"></i></li>
            <li class="text-[#2B77EE]">{t('propfirm_faq_hub.breadcrumb_current')}</li>
          </ol>
        </nav>
        <span class="inline-block px-4 py-1.5 rounded-full bg-[#2B77EE]/10 border border-[#2B77EE]/30 text-[#2B77EE] text-xs font-semibold uppercase tracking-wider mb-5" data-aos="fade-up">
          <i class="fa-solid fa-shield-halved mr-1.5" aria-hidden="true"></i>{t('propfirm_faq_hub.hero_badge')}
        </span>
        <h1 class="text-3xl md:text-5xl font-bold mb-6 leading-tight" data-aos="fade-up">
          {t('propfirm_faq_hub.hero_title_pre')} <span class="bg-gradient-to-r from-[#2B77EE] to-blue-400 bg-clip-text text-transparent">{t('propfirm_faq_hub.hero_title_highlight')}</span>{t('propfirm_faq_hub.hero_title_post')}
        </h1>
        <p class="text-[#2B77EE] text-lg md:text-xl font-semibold mb-4" data-aos="fade-up" data-aos-delay="50">
          {t('propfirm_faq_hub.hero_count_line', { count: allFirmsForSchema.length })}
        </p>
        <p class="text-gray-400 text-base md:text-lg max-w-3xl mx-auto mb-8 leading-relaxed" data-aos="fade-up" data-aos-delay="100">
          {t('propfirm_faq_hub.hero_description')}
        </p>
        <div class="flex flex-wrap gap-4 justify-center" data-aos="fade-up" data-aos-delay="200">
          <a href="https://app.pickmytrade.io/?register=true" class="px-8 py-3 bg-[#2B77EE] hover:bg-blue-600 text-white font-semibold rounded-xl transition-all duration-300 shadow-lg shadow-blue-500/25">
            {t('propfirm_faq_hub.cta_start_trial')} <i class="fa-solid fa-arrow-right ml-2"></i>
          </a>
          <a href="#browse" class="px-8 py-3 border border-white/20 hover:border-[#2B77EE]/50 text-white font-semibold rounded-xl transition-all duration-300 hover:bg-white/5">
            {t('propfirm_faq_hub.hero_browse')} <i class="fa-solid fa-chevron-down ml-2"></i>
          </a>
        </div>
      </div>
    </section>

    <!-- Browse Prop Firms -->
    <section id="browse" class="bg-[#001429] py-16 px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12" data-aos="fade-up">
          <span class="inline-block px-4 py-1.5 rounded-full bg-[#2B77EE]/10 border border-[#2B77EE]/30 text-[#2B77EE] text-xs font-semibold uppercase tracking-wider mb-4">
            <i class="fa-solid fa-arrow-down mr-1.5" aria-hidden="true"></i> {t('propfirm_faq_hub.browse_badge')}
          </span>
          <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">{t('propfirm_faq_hub.browse_title')}</h2>
          <p class="text-gray-400 max-w-2xl mx-auto">{t('propfirm_faq_hub.browse_subtitle')}</p>
        </div>

        <!-- Futures-Focused Prop Firms -->
        <div class="mb-12" data-aos="fade-up">
          <h2 class="text-2xl md:text-3xl font-bold mb-6 pb-3 border-b-2 border-[#2B77EE] flex items-center gap-3">
            <i class="fa-solid fa-chart-line text-[#2B77EE]" aria-hidden="true"></i>{t('propfirm_faq_hub.cat_futures_title')}
            <span class="ml-auto text-xs text-gray-500 font-normal">{t('propfirm_faq_hub.cat_firms_count', { count: futuresFirms.length })}</span>
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {futuresFirms.map((firm) => (
              <a href={localizedPath(locale, `prop-firm-faq/${firm.slug}`)} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
                    <i class={firm.icon} aria-hidden="true"></i>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-2 mb-1">
                      <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate">{firm.name}</h3>
                    </div>
                    <p class="text-gray-400 text-sm mb-3">{firm.description}</p>
                    <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t('propfirm_faq_hub.card_read_faq')} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Multi-Asset Prop Firms -->
        <div class="mb-12" data-aos="fade-up">
          <h2 class="text-2xl md:text-3xl font-bold mb-6 pb-3 border-b-2 border-[#2B77EE] flex items-center gap-3">
            <i class="fa-solid fa-layer-group text-[#2B77EE]" aria-hidden="true"></i>{t('propfirm_faq_hub.cat_multiasset_title')}
            <span class="ml-auto text-xs text-gray-500 font-normal">{t('propfirm_faq_hub.cat_firms_count', { count: multiAssetFirms.length })}</span>
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {multiAssetFirms.map((firm) => (
              <a href={localizedPath(locale, `prop-firm-faq/${firm.slug}`)} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
                    <i class={firm.icon} aria-hidden="true"></i>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-2 mb-1">
                      <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate">{firm.name}</h3>
                    </div>
                    <p class="text-gray-400 text-sm mb-3">{firm.description}</p>
                    <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t('propfirm_faq_hub.card_read_faq')} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Forex-Focused Prop Firms -->
        <div class="mb-12" data-aos="fade-up">
          <h2 class="text-2xl md:text-3xl font-bold mb-6 pb-3 border-b-2 border-[#2B77EE] flex items-center gap-3">
            <i class="fa-solid fa-arrow-trend-up text-[#2B77EE]" aria-hidden="true"></i>{t('propfirm_faq_hub.cat_forex_title')}
            <span class="ml-auto text-xs text-gray-500 font-normal">{t('propfirm_faq_hub.cat_firms_count', { count: forexFirms.length })}</span>
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {forexFirms.map((firm) => (
              <a href={localizedPath(locale, `prop-firm-faq/${firm.slug}`)} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
                    <i class={firm.icon} aria-hidden="true"></i>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-2 mb-1">
                      <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate">{firm.name}</h3>
                    </div>
                    <p class="text-gray-400 text-sm mb-3">{firm.description}</p>
                    <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t('propfirm_faq_hub.card_read_faq')} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- More Prop Firms -->
        <div class="mb-4" data-aos="fade-up">
          <h2 class="text-2xl md:text-3xl font-bold mb-6 pb-3 border-b-2 border-[#2B77EE] flex items-center gap-3">
            <i class="fa-solid fa-grip text-[#2B77EE]" aria-hidden="true"></i>{t('propfirm_faq_hub.cat_more_title')}
            <span class="ml-auto text-xs text-gray-500 font-normal">{t('propfirm_faq_hub.cat_firms_count', { count: moreFirms.length })}</span>
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {moreFirms.map((firm) => (
              <a href={localizedPath(locale, `prop-firm-faq/${firm.slug}`)} class="bg-[#001429] border border-white/10 rounded-xl p-5 hover:border-[#2B77EE]/50 hover:bg-[#001f3f] transition-all group">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-[#2B77EE]/20 rounded-lg flex items-center justify-center text-[#2B77EE] text-xl flex-shrink-0">
                    <i class={firm.icon} aria-hidden="true"></i>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-2 mb-1">
                      <h3 class="text-white font-bold text-lg electrolize group-hover:text-[#2B77EE] transition-colors truncate">{firm.name}</h3>
                    </div>
                    <p class="text-gray-400 text-sm mb-3">{firm.description}</p>
                    <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">{t('propfirm_faq_hub.card_read_faq')} <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- Cross-firm rule explainers -->
    <section id="rules-explained" class="bg-[#001429] pb-16 px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold mb-8 pb-3 border-b-2 border-[#2B77EE] flex items-center gap-3 text-white">
          <i class="fa-solid fa-scale-balanced text-[#2B77EE]" aria-hidden="true"></i>Prop firm rules explained
        </h2>
        <FaqExtraList items={PROPFIRM_HUB_FAQS} microdata={false} />
      </div>
    </section>
  </main>

  <!-- Secondary CTA -->
  <section class="bg-gradient-to-br from-[#0F3EC3] to-[#2B77EE] py-16 px-4">
    <div class="max-w-3xl mx-auto text-center" data-aos="fade-up">
      <h2 class="text-3xl md:text-4xl font-bold text-white electrolize mb-4">{t('propfirm_faq_hub.cta_title')}</h2>
      <p class="text-white/90 mb-8">{t('propfirm_faq_hub.cta_subtitle')}</p>
      <a href="https://app.pickmytrade.io/?register=true" class="bg-white text-[#0F3EC3] px-10 py-4 rounded-xl font-bold electrolize hover:shadow-[0_0_30px_5px_rgba(255,255,255,0.4)] transition-all inline-block">{t('propfirm_faq_hub.cta_start_trial')}</a>
    </div>
  </section>

  <!-- Disclaimer -->
  <section class="bg-[#000a15] py-10 px-4 border-t border-white/10">
    <div class="max-w-4xl mx-auto text-sm text-white/60 leading-relaxed space-y-3">
      <h2 class="text-lg font-bold text-white/80 electrolize mb-2">{t('propfirm_faq_hub.disclaimer_title')}</h2>
      <p>{t('propfirm_faq_hub.disclaimer_text')}</p>
    </div>
  </section>
</BaseLayout>
