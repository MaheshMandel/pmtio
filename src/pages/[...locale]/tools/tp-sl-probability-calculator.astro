    }
  };

  return {
    INSTRUMENTS: INSTRUMENTS, GENERIC: GENERIC, RANGE_TO_SIGMA: RANGE_TO_SIGMA, BGK_BETA: BGK_BETA, GARCH: GARCH,
    getInstrument: getInstrument, hasTicks: hasTicks, hasMoney: hasMoney,
    dollarsPerPoint: dollarsPerPoint, pointsToTicks: pointsToTicks, ticksToPoints: ticksToPoints,
    pointsToDollars: pointsToDollars, ticksToDollars: ticksToDollars, onTickGrid: onTickGrid,
    parseNum: parseNum, validateDistance: validateDistance, validateNumber: validateNumber,
