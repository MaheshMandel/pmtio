      '<div class="r"><span>' + esc(TR('j_tip_median')) + '</span><span>' + fmtVal0(eq.p50[i]) + '</span></div>' +
      '<div class="r"><span>' + esc(TR('j_tip_p5')) + '</span><span>' + fmtVal0(eq.p5[i]) + '</span></div>' +
      '<div class="r"><span>' + esc(TR('j_tip_example')) + '</span><span>' + fmtVal0(eq.sample[i]) + '</span></div>';
