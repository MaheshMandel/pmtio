  var geo = null;
  function drawEquity() {
    var svg = $('eqSvg');
    if (!eq) return;
    var W = svg.clientWidth || 700, H = svg.clientHeight || 320;
    var m = { l: 58, r: 14, t: 12, b: 34 };
    var n = eq.n;
    var lo = Math.min(0, Math.min.apply(null, eq.p5), Math.min.apply(null, eq.sample));
    var hi = Math.max(0, Math.max.apply(null, eq.p95), Math.max.apply(null, eq.sample));
    var ticks = niceTicks(lo, hi, 5);
    lo = Math.min(lo, ticks[0]); hi = Math.max(hi, ticks[ticks.length - 1]);
    var x = function (i) { return m.l + (W - m.l - m.r) * i / n; };
    var y = function (v) { return m.t + (H - m.t - m.b) * (hi - v) / (hi - lo || 1); };
    geo = { x: x, y: y, m: m, W: W, H: H, n: n };
    var parts = [];
    ticks.forEach(function (v) {
      var yy = Math.round(y(v)) + 0.5;
      parts.push('<line x1="' + m.l + '" x2="' + (W - m.r) + '" y1="' + yy + '" y2="' + yy + '" stroke="' + (v === 0 ? 'var(--mut)' : 'var(--grid)') + '" stroke-width="1"/>');
      parts.push('<text x="' + (m.l - 8) + '" y="' + (yy + 4) + '" text-anchor="end">' + shortVal(v) + '</text>');
    });
    var xt = niceTicks(0, n, Math.min(6, Math.max(3, Math.floor(W / 120))));
    xt.forEach(function (v) {
      if (v < 0 || v > n) return;
      parts.push('<text x="' + x(v) + '" y="' + (H - m.b + 18) + '" text-anchor="middle">' + v + '</text>');
    });
    parts.push('<text x="' + (W - m.r) + '" y="' + (H - 2) + '" text-anchor="end">' + esc(TR(eq.money ? 'j_axis_trade' : 'j_axis_trade_pts')) + '</text>');
    var band = 'M' + x(0) + ',' + y(eq.p95[0]);
