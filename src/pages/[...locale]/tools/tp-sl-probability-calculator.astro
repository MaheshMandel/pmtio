  <script is:inline set:html={jsMsgScript}></script>

  <script is:inline>
/* TPSL-CALC-START */
/* Calculation and "show your work" functions. Pure and DOM-free, so they can be unit-tested outside the page.
   Every distance is in POINTS (price units). Ticks and dollars are conversions only. */
var TPSL = (function () {
  'use strict';

  /* Translated message templates ({0}, {1}, ... placeholders), supplied by the page as window.TPSL_MSG. */
  var MSG = window.TPSL_MSG || {};
  function TR(key) {
    var s = MSG[key];
    if (s == null) return key;
    for (var i = 1; i < arguments.length; i++) s = s.split('{' + (i - 1) + '}').join(String(arguments[i]));
    return s;
  }

  /* Contract specs: tick = minimum outright price increment in points; tv = US$ value of one tick per contract.
     Checked against CME Group contract specifications (see the table on the page). */
  var INSTRUMENTS = {
    ES:   { name: 'E-mini S&P 500',            tick: 0.25,     tv: 12.5   },
    MES:  { name: 'Micro E-mini S&P 500',      tick: 0.25,     tv: 1.25   },
    NQ:   { name: 'E-mini Nasdaq-100',         tick: 0.25,     tv: 5      },
    MNQ:  { name: 'Micro E-mini Nasdaq-100',   tick: 0.25,     tv: 0.5    },
    YM:   { name: 'E-mini Dow ($5)',           tick: 1,        tv: 5      },
    MYM:  { name: 'Micro E-mini Dow',          tick: 1,        tv: 0.5    },
    RTY:  { name: 'E-mini Russell 2000',       tick: 0.1,      tv: 5      },
    M2K:  { name: 'Micro E-mini Russell 2000', tick: 0.1,      tv: 0.5    },
    CL:   { name: 'Crude oil (WTI)',           tick: 0.01,     tv: 10     },
    MCL:  { name: 'Micro WTI crude oil',       tick: 0.01,     tv: 1      },
    GC:   { name: 'Gold',                      tick: 0.1,      tv: 10     },
    MGC:  { name: 'Micro gold',                tick: 0.1,      tv: 1      },
    SI:   { name: 'Silver',                    tick: 0.005,    tv: 25     },
    '6E': { name: 'Euro FX',                   tick: 0.00005,  tv: 6.25   },
    ZN:   { name: '10-Year T-Note',            tick: 0.015625, tv: 15.625 }
  };
  var GENERIC = { key: 'GEN', name: 'Generic market', tick: NaN, tv: NaN };

  /* E[high - low] of a Brownian bar = sqrt(8/pi) * sigma * sqrt(T). Used to turn ATR into sigma. */
  var RANGE_TO_SIGMA = Math.sqrt(8 / Math.PI);
  /* Broadie-Glasserman-Kou constant: beta = -zeta(1/2) / sqrt(2 pi), about 0.5826. */
  var BGK_BETA = 1.4603545088095868 / Math.sqrt(2 * Math.PI);

  function getInstrument(key, customTick, customTv) {
    if (key === 'CUSTOM') return { key: 'CUSTOM', name: 'Custom contract', tick: +customTick, tv: +customTv };
    if (INSTRUMENTS[key]) { var i = INSTRUMENTS[key]; return { key: key, name: i.name, tick: i.tick, tv: i.tv }; }
    return { key: GENERIC.key, name: GENERIC.name, tick: NaN, tv: NaN };
  }
  function hasTicks(inst) { return !!inst && inst.tick > 0 && isFinite(inst.tick); }
  function hasMoney(inst) { return hasTicks(inst) && inst.tv > 0 && isFinite(inst.tv); }
  function dollarsPerPoint(inst) { return inst.tv / inst.tick; }
  function pointsToTicks(points, inst) { return points / inst.tick; }
  function ticksToPoints(ticks, inst) { return ticks * inst.tick; }
  function pointsToDollars(points, inst) { return points / inst.tick * inst.tv; }
  function ticksToDollars(ticks, inst) { return ticks * inst.tv; }
  function onTickGrid(points, inst) {
    var n = points / inst.tick;
    return Math.abs(n - Math.round(n)) < 1e-7 * Math.max(1, Math.abs(n));
  }

  /* ---------- input validation ---------- */
  function parseNum(raw) {
    if (typeof raw === 'number') return raw;
    var s = String(raw == null ? '' : raw).trim();
    if (s === '') return NaN;
    if (!/^[-+]?(\d+\.?\d*|\.\d+)([eE][-+]?\d+)?$/.test(s)) return NaN;
    return Number(s);
  }
  function isEmpty(raw) { return raw == null || String(raw).trim() === ''; }

  /* A TP or SL distance. unit = 'points' | 'ticks'. Returns { ok, points, code, message, note }. */
  function validateDistance(raw, inst, unit, label) {
    label = label || TR('j_this_distance');
    var useTicks = unit === 'ticks' && hasTicks(inst);
    var unitWord = TR(useTicks ? 'j_unit_ticks' : 'j_unit_points');
    if (isEmpty(raw)) return { ok: false, points: NaN, code: 'empty', message: TR('j_dist_empty', label, unitWord) };
    var v = parseNum(raw);
    if (!isFinite(v)) return { ok: false, points: NaN, code: 'nan', message: TR('j_dist_nan', label, unitWord) };
    if (v === 0) return { ok: false, points: NaN, code: 'zero', message: TR('j_dist_zero', label) };
    if (v < 0) return { ok: false, points: NaN, code: 'negative', message: TR('j_dist_negative', label, unitWord) };
    var pts = useTicks ? ticksToPoints(v, inst) : v, note = null;
    if (hasTicks(inst)) {
      if (useTicks && Math.abs(v - Math.round(v)) > 1e-9) {
        note = TR('j_dist_note_ticks', label, fmtNum(v), fmtNum(Math.floor(v)), fmtNum(Math.ceil(v)));
      } else if (!useTicks && !onTickGrid(pts, inst)) {
        var lo = Math.floor(pts / inst.tick + 1e-9) * inst.tick, hi = lo + inst.tick;
        note = TR('j_dist_note_grid', label, fmtNum(pts), inst.key, fmtNum(inst.tick), fmtNum(lo), fmtNum(hi));
      }
    }
    return { ok: true, points: pts, code: note ? 'off-grid' : 'ok', message: '', note: note };
  }
  /* Any other number. opts: { min, minExclusive, max, integer, allowEmpty } */
  function validateNumber(raw, label, opts) {
    opts = opts || {};
    if (isEmpty(raw)) {
      if (opts.allowEmpty) return { ok: true, value: NaN, code: 'blank', message: '' };
      return { ok: false, value: NaN, code: 'empty', message: TR('j_num_empty', label) };
    }
    var v = parseNum(raw);
    if (!isFinite(v)) return { ok: false, value: NaN, code: 'nan', message: TR('j_num_nan', label) };
    if (opts.min != null && (opts.minExclusive ? v <= opts.min : v < opts.min)) {
      return { ok: false, value: NaN, code: 'range', message: TR(opts.minExclusive ? 'j_num_above' : 'j_num_atleast', label, fmtNum(opts.min)) };
    }
    if (opts.max != null && v > opts.max) return { ok: false, value: NaN, code: 'range', message: TR('j_num_atmost', label, fmtNum(opts.max)) };
    if (opts.integer && Math.abs(v - Math.round(v)) > 1e-9) return { ok: false, value: NaN, code: 'integer', message: TR('j_num_integer', label) };
    return { ok: true, value: v, code: 'ok', message: '' };
  }

  /* ---------- F1: no edge ---------- */
  function pNoEdge(tp, sl) { return sl / (tp + sl); }

  /* ---------- F2: with drift ----------
     Sign convention: mu is the MARKET's drift (points per unit time, + = price rising).
     The drift in your favour is muFav = +mu for a long and -mu for a short, so a falling market helps a short.
     sigma is the volatility in points per sqrt(unit time), in the same time unit as mu.
     P = (1 - e^{k B}) / (e^{-k A} - e^{k B}), k = 2 muFav / sigma^2, A = TP distance, B = SL distance. */
  function favourableDrift(side, mu) { return side === 'short' ? -mu : mu; }
  function pDriftFav(tp, sl, muFav, sigma) {
    var k = 2 * muFav / (sigma * sigma), A = tp, B = sl;
    if (!isFinite(k) || Math.abs(k * (A + B)) < 1e-12) return B / (A + B);
    /* Overflow-safe form, algebraically identical to the textbook one. */
    if (k > 0) return Math.expm1(-k * B) / Math.expm1(-k * (A + B));
    var j = -k;
    return Math.exp(-j * A) * (-Math.expm1(-j * B)) / (-Math.expm1(-j * (A + B)));
  }
  function pDrift(side, tp, sl, mu, sigma) { return pDriftFav(tp, sl, favourableDrift(side, mu), sigma); }
  /* The textbook form, kept for testing the safe form and for showing the working. */
  function pDriftTextbook(side, tp, sl, mu, sigma) {
    var k = 2 * favourableDrift(side, mu) / (sigma * sigma);
    return (1 - Math.exp(k * sl)) / (Math.exp(-k * tp) - Math.exp(k * sl));
  }

  /* ---------- F3: break-even win rate and expected value (all in points) ---------- */
  function breakEven(tp, sl, c) { return (sl + c) / (tp + sl); }
  function expectedValue(p, tp, sl, c) { return p * tp - (1 - p) * sl - c; }

  /* ---------- F4: driftless walk with a time limit ----------
     sigmaH = standard deviation of the price change over the whole holding time (points).
     P(TP by T) = B/L + sum_{n>=1} 2(-1)^n/(n pi) sin(n pi B / L) e^{-n^2 x},  x = pi^2 sigmaH^2 / (2 L^2), L = A + B.
     P(SL by T) is the same with A in place of B inside the sine and the leading fraction A/L. */
  function sigmaFromAtr(atr, bars) { return atr / RANGE_TO_SIGMA * Math.sqrt(bars); }
  function timeSeriesX(tp, sl, sigmaH) { var L = tp + sl; return Math.PI * Math.PI * sigmaH * sigmaH / (2 * L * L); }
