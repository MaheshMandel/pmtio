    for (var t = stepN; t <= n; t += stepN) rows += '<tr><td>' + t + '</td><td class="n">' + fmtVal0(eq.p5[t]) + '</td><td class="n">' + fmtVal0(eq.p50[t]) + '</td><td class="n">' + fmtVal0(eq.p95[t]) + '</td></tr>';
