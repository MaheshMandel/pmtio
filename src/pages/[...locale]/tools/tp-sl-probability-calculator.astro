.tpsl input[type=number],.tpsl input[type=text],.tpsl select{width:100%;height:44px;border:1px solid var(--rule);background:var(--surface);color:var(--ink);border-radius:8px;padding:0 12px;font:inherit;font-size:1rem;font-variant-numeric:tabular-nums}
.tpsl input[type=number]:hover,.tpsl input[type=text]:hover,.tpsl select:hover{border-color:var(--brand)}
.tpsl input[type=number]:focus,.tpsl input[type=text]:focus,.tpsl select:focus{outline:2px solid var(--focus);outline-offset:1px;border-color:transparent}
.tpsl input:disabled{opacity:.55}
.tpsl input[aria-invalid=true]{border-color:var(--bad);background:var(--bad-bg)}
.tpsl .fmsg{font-size:.82rem;line-height:1.45;border-radius:6px;padding:6px 8px}
.tpsl .fmsg.err{color:var(--bad);background:var(--bad-bg)}
.tpsl .fmsg.note{color:var(--warn);background:var(--warn-bg)}
