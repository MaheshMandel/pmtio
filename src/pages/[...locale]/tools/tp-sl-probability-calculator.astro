      var steps = unitSteps(u.inst, u.unit, u.tpIn, u.slIn);
      steps.push(step(TR('j_s_vol_bar'), R(SUB(sg, I('bar')), EQ, F(I('ATR'), SQRT(R(N('8'), O('/'), I('π'))))),
        R(EQ, F(N(fmtNum(atr), 'atr'), N('1.59577')), EQ, N(fmtNum(sb, 4), 'sb'))));
      steps.push(step(TR('j_s_vol_total'), R(SUB(sg, I('T')), EQ, SUB(sg, I('bar')), TIMES, SQRT(I('N'))),
        R(EQ, N(fmtNum(sb, 4)), TIMES, SQRT(N(fmtNum(bars), 'bars')), EQ, N(fmtNum(sH, 4), 'sH'))));
      var terms = [], show = 0;
      if (r.unreachable) {
        steps.push(step(TR('j_s_unreachable'),
          R(I('P'), O('('), I(TR('j_timeout_word')), O(')'), EQ, N('100.0%', 'toPct'))));
        return { steps: steps, values: { sb: sb, sH: sH, L: L, x: x, tp: r.tp, sl: r.sl, timeout: r.timeout, terms: 0, shown: [], unreachable: true } };
      }
      steps.push(step(TR('j_s_decay_x'), R(I('x'), EQ, F(R(SUP(I('π'), N('2')), SUP(SUB(sg, I('T')), N('2'))), R(N('2'), SUP(I('L'), N('2'))))),
        R(EQ, F(R(N('9.8696'), TIMES, SUP(N(fmtNum(sH, 4)), N('2'))), R(N('2'), TIMES, SUP(N(fmtNum(L), 'L'), N('2'))))), R(EQ, NS(x, 'x', 5))));
      /* Show up to 3 terms that are big enough to print at 5 decimals; the rest are added but not printed. */
      for (var n = 1; n <= r.terms && terms.length < 3; n++) {
        var tt = timeTerm(n, tp, sl, x);
        if (Math.max(Math.abs(tt.tp), Math.abs(tt.sl)) >= 5e-6) terms.push(tt);
        else if (tt.e < 5e-6) break;
