      show = terms.length;
      var sumTp = sl / L, sumSl = tp / L;
      terms.forEach(function (t) { sumTp += t.tp; sumSl += t.sl; });
      var restTp = r.tp - sumTp, restSl = r.sl - sumSl; /* everything not printed, so shown + rest = total */
      var rowTp = [N(fmtFixed(sl / L, 5), 'tp0')], rowSl = [N(fmtFixed(tp / L, 5), 'sl0')];
      terms.forEach(function (t, i) {
        rowTp.push(t.tp < 0 ? MIN : PLUS, N(fmtFixed(Math.abs(t.tp), 5), 'tpT' + (i + 1)));
        rowSl.push(t.sl < 0 ? MIN : PLUS, N(fmtFixed(Math.abs(t.sl), 5), 'slT' + (i + 1)));
