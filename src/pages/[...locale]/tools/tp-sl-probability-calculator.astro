---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import ReadingMotion from '../../../components/ReadingMotion.astro';
import { getLocalePaths, localizedPath, useTranslations } from '../../../i18n/utils';
import { LOCALE_BCP47, type Locale } from '../../../i18n/config';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
// All copy lives in the `tp_sl_calculator` namespace of src/i18n/locales/*.json.
const tt = (key: string) => t(`tp_sl_calculator.${key}` as any);

// TODO(pre-launch): swap the generic /logo.png for a page-specific 1200x630 social card.
const OG_IMAGE = '/logo.png';

const pageUrl = new URL(Astro.url.pathname, 'https://pickmytrade.io').href.replace(/[/]$/, '');

const faqItems = Array.from({ length: 15 }, (_, i) => ({ question: tt(`faq_q${i + 1}`), answer: tt(`faq_a${i + 1}`) }));

// Strings used by the calculator script (window.TPSL_MSG).
const jsMsgKeys = ["j_this_distance","j_unit_ticks","j_unit_points","j_dist_empty","j_dist_nan","j_dist_zero","j_dist_negative","j_dist_note_ticks","j_dist_note_grid","j_num_empty","j_num_nan","j_num_above","j_num_atleast","j_num_atmost","j_num_integer","j_closes_empty","j_closes_nan","j_closes_few_one","j_closes_few_other","j_closes_many","j_closes_note","j_s_convert_ticks","j_s_convert_cost","j_s_write_formula","j_s_put_distances","j_s_add_bottom","j_s_divide","j_s_short_flip","j_s_long_keep","j_s_work_k","j_s_k_zero","j_s_huge","j_s_top_power","j_s_bottom_power","j_s_put_formula","j_s_compare_f1_trend","j_s_breakeven_put","j_s_never_breakeven","j_s_ev_at","j_s_multiply_subtract","j_s_check_ev_zero","j_s_vol_bar","j_s_vol_total","j_timeout_word","j_s_unreachable","j_s_decay_x","j_more_term_one","j_more_term_other","j_s_f4_tp_terms","j_s_f4_tp_terms_more","j_s_f4_tp_none","j_s_f4_sl","j_s_f4_timeout","j_s_shift","j_s_move_orders","j_s_compare_f1_cont","j_s_est_changes","j_s_est_trend_prices","j_today","j_n_days_ago","j_s_est_trend_closes","j_s_est_trend_zero","j_s_est_vol_atr","j_s_est_vol_iv","j_s_est_avg_change","j_s_est_vol_closes","j_custom_contract_err","j_echo_fix_custom","j_hint_generic","j_echo_generic","j_hint_inst","j_echo_inst","j_your_custom_contract","j_change_units","j_conv_pts","j_conv_ticks","j_conv_money","j_pts","j_money_for_qty","j_money_per_contract","j_one_in","j_n_in_100","j_lbl_tp","j_lbl_sl","j_lbl_trend","j_lbl_vol","j_lbl_cost","j_lbl_wr","j_lbl_qty","j_lbl_atr","j_lbl_time","j_lbl_maxhold","j_lbl_past","j_lbl_now","j_lbl_days","j_lbl_datr","j_lbl_price","j_lbl_iv","j_f1_sub","j_f2_sub_long","j_f2_sub_short","j_pts_short","j_v_never","j_v_need","j_v_even","j_v_above","j_v_below","j_fix_input","j_never","j_f3_ev_user","j_hyp_tpsl","j_f3_ev_nouser","j_add_wr","j_leg_tp","j_leg_to","j_leg_sl","j_f4_cmp","j_ev_noedge","j_ev_f2","j_check_inputs","j_hero_waiting","j_one_note","j_inputs_ok","j_inputs_ok_grid","j_inputs_ok_plain","j_bigcap_f4","j_bigcap_f2","j_bigcap_f1","j_with_no_time","j_with_no_trend","j_leg_tp_first","j_leg_sl_first","j_hyp_f4","j_hyp","j_ev_user_main","j_hyp_assumes","j_ev_nouser_main","j_for_qty","j_side_long","j_side_short","j_hero_cap","j_with_your_trend","j_no_edge","j_bar_limit","j_tp_first","j_hero_ev_f2","j_hero_ev_noedge","j_eqp_mine","j_eqp_mine_unset","j_eqp_f2","j_eqp_f1","j_iv_note","j_flat_closes","j_est_hour","j_est_done","j_of_100","j_waiting","j_fix_sim","j_formula_says","j_running","j_running_note","j_gap_noise","j_pill_agree","j_pill_gap_real","j_pill_gap_noise","j_big_note","j_big_note_to","j_dist_ticks","j_canvas_tp","j_canvas_sl","j_canvas_entry_short","j_canvas_entry_long","j_canvas_time_bars","j_canvas_time","j_canvas_aria","j_eq_never","j_streak_small","j_eq_note","j_eq_src_user","j_eq_src_f2","j_eq_src_f1","j_eq_pick_inst","j_eq_timeouts","j_axis_trade","j_axis_trade_pts","j_tip_after","j_tip_p95","j_tip_median","j_tip_p5","j_tip_example"];
const jsMsg = Object.fromEntries(jsMsgKeys.map((k) => [k, tt(k)]));
const jsMsgScript = 'window.TPSL_MSG=' + JSON.stringify(jsMsg).replace(/</g, String.fromCharCode(92) + 'u003c') + ';';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": pageUrl + '#webpage',
      "url": pageUrl,
      "name": tt('schema_page_name'),
      "description": tt('meta_description'),
      "inLanguage": LOCALE_BCP47[locale],
      "datePublished": "2026-09-23",
      "dateModified": "2026-09-23",
      "publisher": {
        "@id": "https://pickmytrade.io/#organization"
      },
      "breadcrumb": {
        "@id": pageUrl + '#breadcrumb'
      },
      "mainEntity": {
        "@id": pageUrl + '#app'
      },
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [
          "#answer",
          "#takeaways"
        ]
      }
    },
    {
      "@type": "WebApplication",
      "@id": pageUrl + '#app',
      "name": tt('schema_app_name'),
      "url": pageUrl,
      "description": tt('schema_app_description'),
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Any (web browser)",
      "browserRequirements": tt('schema_app_browser'),
      "featureList": Array.from({ length: 9 }, (_, i) => tt(`schema_feature_${i + 1}`)),
      "isAccessibleForFree": true,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "dateModified": "2026-09-23",
      "inLanguage": LOCALE_BCP47[locale],
      "publisher": {
        "@id": "https://pickmytrade.io/#organization"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": pageUrl + '#breadcrumb',
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": tt('breadcrumb_home'),
          "item": "https://pickmytrade.io/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": tt('breadcrumb_current'),
          "item": pageUrl
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": pageUrl + '#faq',
      "mainEntity": faqItems.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } }))
    }
  ]
};
---
<BaseLayout
  locale={locale}
  title={tt('meta_title')}
  description={tt('meta_description')}
  keywords={tt('meta_keywords')}
  ogImage={OG_IMAGE}
  structuredData={structuredData}
>
  <script is:inline slot="head">document.documentElement.className += ' js';</script>
  <ReadingMotion />

  <div class="tpsl">
  <!-- Top disclaimer banner -->
  <div class="bg-[#001429] pt-20 text-center px-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-b border-blue-500/20 pb-3">
      <p class="text-xs sm:text-sm text-gray-400">
        <Fragment set:html={tt('s001')} /></p>
    </div>
  </div>


  <!-- Hero -->
  <section class="hero relative pt-8 pb-12 overflow-hidden bg-[#001429]">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-gradient-to-br from-blue-600/10 via-transparent to-orange-600/10"></div>
      <div class="absolute top-0 left-[12%] w-96 h-96 bg-orange-500/10 rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute bottom-0 right-[8%] w-96 h-96 bg-blue-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
      <div class="absolute inset-0 opacity-[0.02]" style="background-image: linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px); background-size: 50px 50px;"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] gap-10 lg:gap-14 items-start">
        <div data-aos="fade-up">
          <Fragment set:html={tt('s002')} />
          <h1 class="text-3xl sm:text-5xl font-bold leading-tight tracking-tight mb-6">
            <Fragment set:html={tt('s003')} />
          </h1>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <Fragment set:html={tt('s004')} />
          </div>

          <div class="flex flex-wrap gap-3 sm:gap-4 text-sm">
            <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2">
              <Fragment set:html={tt('s005')} />
            </div>
            <div class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2">
              <Fragment set:html={tt('s006')} />
            </div>
          </div>
        </div>

        <div class="space-y-5" data-aos="fade-up" data-aos-delay="100">
        <aside class="odds-card" aria-label={tt('s007')}>
        <p class="cap" id="heroCap">{tt('s008')}</p>
        <p class="big num" id="heroBig"><Fragment set:html={tt('s009')} /></p>
        <div class="bar" aria-hidden="true"><i class="tp" id="heroBarTp" style="flex:0 0 33.3%"></i><i class="to" id="heroBarTo" style="flex:0 0 0%" hidden></i><i class="sl" id="heroBarSl" style="flex:1 1 auto"></i></div>
        <div class="legend"><Fragment set:html={tt('s010')} /></div>
        <div class="sub">
          <Fragment set:html={tt('s011')} />
        </div>
        <p class="jump"><Fragment set:html={tt('s012')} /></p>
      </aside>
          <aside class="bg-gradient-to-br from-gray-800/60 to-gray-900/60 backdrop-blur-sm border border-gray-700/50 border-l-4 border-l-orange-500 rounded-2xl p-6" aria-label={tt('s013')}>
            <h2 class="text-sm font-bold uppercase tracking-wider text-blue-400 mb-3 flex items-center gap-2"><Fragment set:html={tt('s014')} /></h2>
            <p class="answer" id="answer"><Fragment set:html={tt('s015')} /></p>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <div class="bg-[#001429]"><div class="max-w-[1500px] mx-auto px-2 sm:px-4 xl:grid xl:grid-cols-[250px_minmax(0,1fr)] xl:gap-6">
    <aside class="hidden xl:block pt-6">
      <nav aria-label={tt('s016')} class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto rounded-2xl border border-gray-700/50 bg-gradient-to-br from-gray-800/50 to-gray-900/50 p-3">
        <p class="px-2.5 pt-1 pb-2 text-xs font-bold uppercase tracking-wider text-blue-400 electrolize-regular">{tt('s017')}</p>
        <ul class="space-y-0.5">
          <li><Fragment set:html={tt('s018')} /></li>
          <li><Fragment set:html={tt('s019')} /></li>
          <li><Fragment set:html={tt('s020')} /></li>
          <li><Fragment set:html={tt('s021')} /></li>
          <li><Fragment set:html={tt('s022')} /></li>
          <li><Fragment set:html={tt('s023')} /></li>
          <li><Fragment set:html={tt('s024')} /></li>
          <li><Fragment set:html={tt('s025')} /></li>
          <li><Fragment set:html={tt('s026')} /></li>
          <li><Fragment set:html={tt('s027')} /></li>
          <li><Fragment set:html={tt('s028')} /></li>
          <li><Fragment set:html={tt('s029')} /></li>
          <li><Fragment set:html={tt('s030')} /></li>
          <li><Fragment set:html={tt('s031')} /></li>
          <li><Fragment set:html={tt('s032')} /></li>
          <li><Fragment set:html={tt('s033')} /></li>
        </ul>
      </nav>
    </aside>
    <div class="min-w-0">
<section class="relative py-10 scroll-mt-28 " aria-labelledby="takeaways-h">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="takeaways" id="takeaways">
      <h2 id="takeaways-h">{tt('s034')}</h2>
      <ul>
        <li>{tt('s035')}</li>
        <li>{tt('s036')}</li>
        <li>{tt('s037')}</li>
        <li>{tt('s038')}</li>
        <li>{tt('s039')}</li>
        <li>{tt('s040')}</li>
      </ul>
    </div>
  </div>
</section>

<section id="contents" class="py-8 scroll-mt-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-6 xl:hidden" data-aos="fade-up">
        <Fragment set:html={tt('s041')} />
      </div>
      <nav aria-label={tt('s042')} class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-10 xl:hidden" data-aos="fade-up">
          <Fragment set:html={tt('s043')} />
      </nav>
      <div class="settings needs-js" id="settings" role="group" aria-labelledby="settings-h">
      <div class="field">
        <h2 id="settings-h" style="font-size:1.2rem">{tt('s044')}</h2>
        <p class="hint">{tt('s045')}</p>
        <p class="hint" id="settingsHint">{tt('s046')}</p>
      </div>
      <div class="group">
        <div class="row">
          <div class="field">
            <label for="inst">{tt('s047')}</label>
            <select id="inst" name="inst">
              <option value="GEN" selected>{tt('s048')}</option>
              <option value="ES">{tt('s049')}</option>
              <option value="MES">{tt('s050')}</option>
              <option value="NQ">{tt('s051')}</option>
              <option value="MNQ">{tt('s052')}</option>
              <option value="YM">{tt('s053')}</option>
              <option value="MYM">{tt('s054')}</option>
              <option value="RTY">{tt('s055')}</option>
              <option value="M2K">{tt('s056')}</option>
              <option value="CL">{tt('s057')}</option>
              <option value="MCL">{tt('s058')}</option>
              <option value="GC">{tt('s059')}</option>
              <option value="MGC">{tt('s060')}</option>
              <option value="SI">{tt('s061')}</option>
              <option value="6E">{tt('s062')}</option>
              <option value="ZN">{tt('s063')}</option>
              <option value="CUSTOM">{tt('s064')}</option>
            </select>
          </div>
          <div class="field">
            <Fragment set:html={tt('s065')} />
            <div class="seg" role="radiogroup" aria-labelledby="unit-l">
              <label><input type="radio" name="unit" id="unitPoints" value="points" checked><Fragment set:html={tt('s066')} /></label>
              <label><input type="radio" name="unit" id="unitTicks" value="ticks" disabled><Fragment set:html={tt('s067')} /></label>
            </div>
          </div>
        </div>
        <div class="row" id="customRow" hidden>
          <div class="field"><label for="cTick">{tt('s068')}</label><input type="number" id="cTick" inputmode="decimal" step="any" min="0" value="0.25"></div>
          <div class="field"><label for="cTv">{tt('s069')}</label><input type="number" id="cTv" inputmode="decimal" step="any" min="0" value="12.5"></div>
        </div>
        <p class="fmsg err" id="settingsMsg" hidden></p>
        <p class="hint" id="znHint" hidden>{tt('s070')}</p>
      </div>
    </div>
  
    </div>
  </section>

<section id="f1" class="relative py-10 scroll-mt-28  fsec" aria-labelledby="f1-h">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto mb-8" data-aos="fade-up">
        <span class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold border border-blue-500/30 electrolize-regular mb-4">F1</span>
        <h2 id="f1-h" class="text-3xl md:text-4xl lg:text-5xl font-bold text-white tracking-tight mb-5">{tt('s071')}</h2>
        <p class="text-lg text-gray-300 leading-relaxed">{tt('s072')}</p>
      </div>

    <div class="plate" role="group" aria-label={tt('s073')}>
      <p class="cap">{tt('s074')}</p>
      <div class="mx"><math display="block"><mrow><mi>P</mi><mo>=</mo><mfrac><mi>SL</mi><mrow><mi>TP</mi><mo>+</mo><mi>SL</mi></mrow></mfrac></mrow></math></div>
    </div>

    <div class="block">
      <h3>{tt('s075')}</h3>
      <div class="tw letters"><table>
        <thead><tr><th>{tt('s076')}</th><th>{tt('s077')}</th><th>{tt('s078')}</th><th class="n">{tt('s079')}</th></tr></thead>
        <tbody>
          <tr><td>P</td><td>{tt('s080')}</td><td>0 to 1 (or 0% to 100%)</td><td class="n">0.333</td></tr>
          <tr><td>TP</td><td>{tt('s081')}</td><td>{tt('s082')}</td><td class="n">20</td></tr>
          <tr><td>SL</td><td>{tt('s083')}</td><td>{tt('s082')}</td><td class="n">10</td></tr>
        </tbody>
      </table></div>
    </div>

    <div class="block">
      <h3>{tt('s084')}</h3>
      <p>{tt('s085')}</p>
      <div class="analogy"><Fragment set:html={tt('s086')} /></div>
      <div class="fit">
        <div><h4>{tt('s087')}</h4><ul><li>{tt('s088')}</li><li>{tt('s089')}</li><li>{tt('s090')}</li><li>{tt('s091')}</li></ul></div>
        <div><h4>{tt('s092')}</h4><ul><li>{tt('s093')}</li><li>{tt('s094')}</li><li>{tt('s095')}</li><li>{tt('s096')}</li><li>{tt('s097')}</li></ul></div>
      </div>
      <div class="tw">
        <table>
          <caption>{tt('s098')}</caption>
          <thead><tr><th>{tt('s099')}</th><th class="n">{tt('s100')}</th><th class="n">{tt('s101')}</th></tr></thead>
          <tbody>
            <tr><td>1 : 1</td><td class="n">50.0%</td><td class="n">50</td></tr>
            <tr><td>1.5 : 1</td><td class="n">40.0%</td><td class="n">40</td></tr>
            <tr><td>2 : 1</td><td class="n">33.3%</td><td class="n">33</td></tr>
            <tr><td>3 : 1</td><td class="n">25.0%</td><td class="n">25</td></tr>
            <tr><td>4 : 1</td><td class="n">20.0%</td><td class="n">20</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="block">
      <h3>{tt('s102')}</h3>
      <div class="example">
        <p class="given">{tt('s103')}</p>
        <ol class="steps"><li><p class="st-l">{tt('s104')}</p><div class="mx"><math display="block"><mrow><mrow><mi>P</mi><mo>=</mo><mfrac><mi>SL</mi><mrow><mi>TP</mi><mo>+</mo><mi>SL</mi></mrow></mfrac></mrow></mrow></math></div></li><li><p class="st-l">{tt('s105')}</p><div class="mx"><math display="block"><mrow><mrow><mi>P</mi><mo>=</mo><mfrac><mn data-k="sl">10</mn><mrow><mn data-k="tp">20</mn><mo>+</mo><mn>10</mn></mrow></mfrac></mrow></mrow></math></div></li><li><p class="st-l">{tt('s106')}</p><div class="mx"><math display="block"><mrow><mrow><mi>P</mi><mo>=</mo><mfrac><mn>10</mn><mn data-k="L">30</mn></mfrac></mrow></mrow></math></div></li><li><p class="st-l">{tt('s107')}</p><div class="mx"><math display="block"><mrow><mrow><mi>P</mi><mo>=</mo><mn data-k="p">0.3333</mn><mo>=</mo><mn data-k="pct">33.3%</mn></mrow></mrow></math></div></li></ol>
      </div>
    </div>

    <div class="block">
      <h3>{tt('s108')}</h3>
      <p class="nojs">{tt('s109')}</p>
      <div class="mini needs-js">
        <form class="panel" id="f1form" novalidate aria-label={tt('s110')}>
          <p class="echo" data-echo></p>
          <div class="row">
            <div class="field"><label for="f1tp"><Fragment set:html={tt('s111')} /></label><input type="text" id="f1tp" inputmode="decimal" value="30" autocomplete="off"><p class="fmsg" id="f1tpMsg" hidden></p></div>
            <div class="field"><label for="f1sl"><Fragment set:html={tt('s112')} /></label><input type="text" id="f1sl" inputmode="decimal" value="10" autocomplete="off"><p class="fmsg" id="f1slMsg" hidden></p></div>
          </div>
          <p class="conv" id="f1conv" aria-live="polite"></p>
          <p class="hint">{tt('s113')}</p>
        </form>
        <div class="work" aria-live="polite">
          <p class="work-h">{tt('s114')}</p>
          <ol class="steps" id="f1work"></ol>
          <div class="result-line"><Fragment set:html={tt('s115')} />
            <div class="bar" aria-hidden="true"><i class="tp" id="f1barTp"></i><i class="to" id="f1barTo" hidden></i><i class="sl" id="f1barSl"></i></div></div>
          <div class="disclosure compact" role="note"><Fragment set:html={tt('s116')} /></div>
        </div>
      </div>
    </div>

    <div class="source">
      <Fragment set:html={tt('s117')} />
      <ul>
        <li><Fragment set:html={tt('s118')} /></li>
        <li><Fragment set:html={tt('s119')} /></li>
      </ul>
    </div>
  </div>
</section>

<section id="f2" class="relative py-10 scroll-mt-28  fsec" aria-labelledby="f2-h">
