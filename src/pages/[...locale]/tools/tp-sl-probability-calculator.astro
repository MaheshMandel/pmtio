    var m = money(), scale = m ? T.dollarsPerPoint(inst()) * r.qty : 1;
    var winNet = (r.A - r.c) * scale, lossNet = (r.B + r.c) * scale;
    eq = T.simulateEquity(p, winNet, lossNet, n, 400, seedValue() + 104729);
    eq.n = n; eq.p = p; eq.useUser = useUser; eq.money = m;
    $('eLoss').textContent = fmtPct(eq.lossShare, 0);
    $('eDD').textContent = fmtVal0(-eq.ddMedian);
    $('eDD95').textContent = fmtVal0(-eq.dd95);
    $('eStreak').innerHTML = Math.round(eq.streakMedian) + '<small>' + esc(TR('j_streak_small', eq.streakMax)) + '</small>';
    var winTxt = m ? fmtMoney(winNet) : TR('j_pts', fmtNum(winNet, 2)), lossTxt = m ? fmtMoney(lossNet) : TR('j_pts', fmtNum(lossNet, 2));
    $('eqNote').textContent = TR('j_eq_note', 400, n, fmtPct(p),
      TR(useUser ? 'j_eq_src_user' : r.formula === 'F2' ? 'j_eq_src_f2' : 'j_eq_src_f1'), winTxt, lossTxt,
      m ? '' : TR('j_eq_pick_inst'), fmtVal0(eq.finalMedian),
