    s.c = readCost('cost', TR('j_lbl_cost'));
    s.useTime = $('useTime').checked;
    s.useTrend = $('useTrend').checked && !s.useTime;
    var list = [s.a, s.b, s.c];
    if (s.useTrend) { s.mu = readNum('mu', TR('j_lbl_trend'), {}); s.sigma = readNum('sigma', TR('j_lbl_vol'), { min: 0, minExclusive: true }); list.push(s.mu, s.sigma); }
    if (s.useTime) { s.atr = readNum('atr', TR('j_lbl_atr'), { min: 0, minExclusive: true }); s.bars = readNum('bars', TR('j_lbl_maxhold'), { min: 1, integer: true }); list.push(s.atr, s.bars); }
    s.wr = readNum('wr', TR('j_lbl_wr'), { min: 0, max: 100, allowEmpty: true }); list.push(s.wr);
    s.q = money() ? readNum('qty', TR('j_lbl_qty'), { min: 1, integer: true }) : { ok: true, value: 1 }; list.push(s.q);
    s.problem = firstProblem(list);
