    $('f2sub').textContent = TR(side === 'long' ? 'j_f2_sub_long' : 'j_f2_sub_short');
    $('f2cmpP').textContent = fmtPct(v.p);
    $('f2cmpP1').textContent = fmtPct(v.p1);
    $('f2cmpD').textContent = TR('j_pts_short', T.fmtSignedPts(v.diff, 2));
  }

  /* ---------- F3 ---------- */
  function verdictHtml(wr, be, ev, qty) {
    var evText = isFinite(ev) ? ptsMoney(ev, qty, true) : '', lossText = isFinite(ev) ? ptsMoney(Math.abs(ev), qty, false) : '';
    if (!(be < 1)) return { cls: 'verdict bad', html: ICON_DOWN + '<span>' + esc(TR('j_v_never')) + '</span>' };
    if (!isFinite(wr)) return { cls: 'verdict', html: ICON_INFO + '<span>' + esc(TR('j_v_need', fmtPct(be))) + '</span>' };
    if (Math.abs(wr - be) < 0.0005) return { cls: 'verdict', html: ICON_INFO + '<span>' + esc(TR('j_v_even', fmtPct(be))) + '</span>' };
    if (wr > be) return { cls: 'verdict good', html: ICON_UP + '<span>' + esc(TR('j_v_above', fmtNum(wr * 100, 1), fmtPct(be), evText)) + '</span>' };
    return { cls: 'verdict bad', html: ICON_DOWN + '<span>' + esc(TR('j_v_below', fmtNum(wr * 100, 1), fmtPct(be), lossText)) + '</span>' };
  }
  function renderF3() {
    var a = readDist('f3tp', TR('j_lbl_tp')), b = readDist('f3sl', TR('j_lbl_sl'));
    var c = readCost('f3c', TR('j_lbl_cost'));
    var wr = readNum('f3wr', TR('j_lbl_wr'), { min: 0, max: 100, allowEmpty: true });
