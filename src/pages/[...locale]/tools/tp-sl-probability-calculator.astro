  /* ---------- F2 input helper: estimate the trend and volatility ---------- */
  var estLast = null;
  function clearMsg(id) { var el = $(id), m = $(id + 'Msg'); if (el) el.removeAttribute('aria-invalid'); if (m) { m.textContent = ''; m.hidden = true; } }
  function renderEst() {
    var muM = radio('estMu') || 'prices', sgM = radio('estSig') || 'atr', useCloses = muM === 'closes' || sgM === 'closes';
    $('estPricesRow').hidden = muM !== 'prices';
    $('estAtrRow').hidden = sgM !== 'atr';
    $('estIvRow').hidden = sgM !== 'iv';
    $('estClosesGroup').hidden = !useCloses;
    $('estDone').textContent = '';
    var list = [], o = { muMethod: muM, sigmaMethod: sgM };
    if (muM === 'prices') {
      var past = readNum('estPast', TR('j_lbl_past'), {}), now = readNum('estNow', TR('j_lbl_now'), {});
      var days = readNum('estDays', TR('j_lbl_days'), { min: 1, integer: true });
      list.push(past, now, days); o.past = past.value; o.now = now.value; o.days = days.value;
    } else { ['estPast', 'estNow', 'estDays'].forEach(clearMsg); }
    if (sgM === 'atr') {
      var atr = readNum('estAtr', TR('j_lbl_datr'), { min: 0, minExclusive: true }); list.push(atr); o.atr = atr.value;
    } else clearMsg('estAtr');
    if (sgM === 'iv') {
      var pr = readNum('estPrice', TR('j_lbl_price'), { min: 0, minExclusive: true }), iv = readNum('estIv', TR('j_lbl_iv'), { min: 0, minExclusive: true });
      if (iv.ok && iv.value < 1) { iv.note = TR('j_iv_note', fmtNum(iv.value)); showMsg('estIv', iv); }
      list.push(pr, iv); o.price = pr.value; o.iv = iv.value;
    } else { ['estPrice', 'estIv'].forEach(clearMsg); }
    if (useCloses) {
      var pc = T.parseCloses($('estCloses').value);
      if (pc.ok && sgM === 'closes' && !(T.closeStats(pc.values).sd > 0)) {
        pc = { ok: false, values: [], code: 'flat', message: TR('j_flat_closes') };
      }
      showMsg('estCloses', pc); list.push(pc); o.closes = pc.values;
    } else clearMsg('estCloses');
    var bad = '';
    for (var i = 0; i < list.length; i++) if (!list[i].ok) { bad = list[i].message; break; }
    if (bad) {
      workFail($('estWork'), bad);
      $('estMuOut').textContent = '–'; $('estSigOut').textContent = '–'; $('estHour').textContent = '';
      $('estUse').disabled = true; estLast = null;
      return;
    }
    var w = T.work.est(o), v = w.values;
    renderWork($('estWork'), w);
    $('estMuOut').textContent = T.fmtSignedPts(v.mu, 2);
    $('estSigOut').textContent = fmtNum(v.sigma, 2);
    var hr = T.rescaleToShorterUnit(v.mu, v.sigma, 23);
    $('estHour').textContent = TR('j_est_hour', T.fmtSignedPts(hr.mu, 3), fmtNum(hr.sigma, 2));
    $('estUse').disabled = false;
    estLast = { mu: v.mu, sigma: v.sigma };
  }
  function useEstimates() {
    if (!estLast) return;
    $('f2mu').value = String(+estLast.mu.toFixed(4));
    $('f2sigma').value = String(+estLast.sigma.toFixed(4));
    renderF2();
    $('estDone').textContent = TR('j_est_done', T.fmtSignedPts(+estLast.mu.toFixed(4), 4), fmtNum(+estLast.sigma.toFixed(4), 4));
    $('f2form').scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    try { $('f2mu').focus({ preventScroll: true }); } catch (e) { /* older browsers */ }
  }

  function renderAll() { renderF1(); renderF2(); renderF3(); renderF4(); renderF5(); renderEst(); renderMain(); }

  /* ---------- theme-aware colours for canvas/SVG ---------- */
  function cssVar(name) { return getComputedStyle(document.documentElement).getPropertyValue(name).trim(); }

  /* ---------- path simulation ---------- */
  var anim = null, simTimer = null, bigTimer = null, lastPaths = null;
  function simPending() {
    clearTimeout(simTimer); clearTimeout(bigTimer); lastPaths = null;
    if (anim) { cancelAnimationFrame(anim); anim = null; }
    var of100 = '<small>' + esc(TR('j_of_100')) + '</small>';
    $('cTp').innerHTML = '–' + of100; $('cSl').innerHTML = '–' + of100; $('cTo').innerHTML = '–' + of100;
    ['chkFormula', 'chkSim', 'chkGap'].forEach(function (id) { $(id).textContent = '–'; });
    $('chkPill').innerHTML = '<span class="pill">' + esc(TR('j_waiting')) + '</span>';
    $('bigRunNote').textContent = TR('j_fix_sim');
    var cv = $('pathCanvas'), ctx = cv.getContext('2d'); ctx.clearRect(0, 0, cv.width, cv.height);
  }
  function scheduleSims() {
    clearTimeout(simTimer);
    simTimer = setTimeout(function () { runPaths(); runEquity(); }, 180);
  }
  function simOptions() {
    var s = last.s, r = last.r;
    return T.simSettings({ tp: r.A, sl: r.B, side: s.side, mu: s.useTrend ? s.mu.value : 0, sigma: s.useTrend ? s.sigma.value : 0,
      timed: s.useTime, sigmaH: r.sigmaH, mode: radio('model') || 'ideal' });
  }
  function seedValue() { var v = Math.round(T.parseNum($('seed').value)); return isFinite(v) ? v : 1; }
  function fmtDist(points) {
    if (unit() === 'ticks') return TR('j_dist_ticks', fmtNum(T.pointsToTicks(points, inst()), 2));
    return TR('j_pts_short', fmtNum(points));
  }

  function runPaths() {
    if (!last) return;
    var o = simOptions(), seed = seedValue(), r = last.r;
    var rng = T.rngFromSeed(seed), normal = T.normalFrom(rng), paths = [];
    for (var i = 0; i < 100; i++) paths.push(T.simulatePath(o, rng, normal, true));
    lastPaths = { paths: paths, o: o, s: last.s };
    var theory = r.pTp;
    $('chkFormulaL').textContent = TR('j_formula_says', r.formula);
    $('chkFormula').textContent = fmtPct(theory);
    ['chkSim', 'chkGap'].forEach(function (id) { $(id).textContent = '…'; });
    $('chkPill').innerHTML = '<span class="pill">' + esc(TR('j_running')) + '</span>';
    drawPaths(true);
    clearTimeout(bigTimer);
    $('bigRunNote').textContent = TR('j_running_note');
    bigTimer = setTimeout(function () {
      var n = 20000, c = T.simulateMany(o, n, seed + 7919), got = c.tp / n, noise = T.noise95(theory, n), gap = got - theory;
      $('chkSim').textContent = fmtPct(got);
      $('chkGap').innerHTML = T.fmtSignedPts(gap * 100, 1) + '<small>' + esc(TR('j_gap_noise', fmtNum(noise * 100, 1))) + '</small>';
      var agree = Math.abs(gap) <= noise * 1.5;
      $('chkPill').innerHTML = agree ? '<span class="pill good">' + esc(TR('j_pill_agree')) + '</span>' :
        '<span class="pill warn">' + esc(TR(o.mode === 'real' ? 'j_pill_gap_real' : 'j_pill_gap_noise')) + '</span>';
      $('bigRunNote').textContent = TR('j_big_note', fmtPct(c.tp / n), fmtPct(c.sl / n),
        o.timed ? TR('j_big_note_to', fmtPct(c.timeout / n)) : '', r.formula, fmtPct(theory), fmtNum(noise * 100, 1));
    }, 60);
  }

  function drawPaths(animate) {
    if (!lastPaths) return;
    if (anim) { cancelAnimationFrame(anim); anim = null; }
    var cv = $('pathCanvas'), dpr = Math.min(window.devicePixelRatio || 1, 2);
    var W = cv.clientWidth, H = cv.clientHeight;
    if (!W || !H) return;
    cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
    var ctx = cv.getContext('2d'); ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    var P = lastPaths, s = P.s, o = P.o;
    var hi = o.A, lo = -o.B, pad = (hi - lo) * 0.12;
    var left = 8, right = W - 8, top = 26, bottom = H - 26;
    var maxSteps = 1;
    if (o.timed) maxSteps = o.maxSteps;
    else {
      var st = P.paths.map(function (p) { return p.steps; }).sort(function (a, b) { return a - b; });
      maxSteps = Math.max(10, st[Math.floor(st.length * 0.95)]);
    }
    var xs = function (i) { return left + (right - left) * i / maxSteps; };
    var ys = function (v) { return top + (bottom - top) * (hi + pad - v) / ((hi - lo) + 2 * pad); };
    var col = { tp: cssVar('--tp'), sl: cssVar('--sl'), timeout: cssVar('--to'), ink: cssVar('--ink-2'), grid: cssVar('--grid'), muted: cssVar('--mut'), surface: cssVar('--surface') };
    function frame() {
      ctx.clearRect(0, 0, W, H);
      ctx.lineWidth = 1; ctx.strokeStyle = col.grid;
      ctx.beginPath(); ctx.moveTo(left, Math.round(ys(0)) + 0.5); ctx.lineTo(right, Math.round(ys(0)) + 0.5); ctx.stroke();
      ctx.lineWidth = 2;
      ctx.strokeStyle = col.tp; ctx.beginPath(); ctx.moveTo(left, ys(hi)); ctx.lineTo(right, ys(hi)); ctx.stroke();
      ctx.strokeStyle = col.sl; ctx.beginPath(); ctx.moveTo(left, ys(lo)); ctx.lineTo(right, ys(lo)); ctx.stroke();
      ctx.font = '600 12px Inter, system-ui, sans-serif'; ctx.fillStyle = col.ink;
      ctx.textBaseline = 'bottom'; ctx.fillText(TR('j_canvas_tp', fmtDist(o.A)), left + 2, ys(hi) - 5);
      ctx.textBaseline = 'top'; ctx.fillText(TR('j_canvas_sl', MINUS + fmtDist(o.B)), left + 2, ys(lo) + 5);
      ctx.textBaseline = 'bottom'; ctx.fillStyle = col.muted; ctx.textAlign = 'right';
      ctx.lineWidth = 3; ctx.strokeStyle = col.surface; ctx.lineJoin = 'round';
      var entryTxt = TR(s.side === 'short' ? 'j_canvas_entry_short' : 'j_canvas_entry_long');
      ctx.strokeText(entryTxt, right - 2, ys(0) - 4); ctx.fillText(entryTxt, right - 2, ys(0) - 4);
      ctx.fillText(o.timed ? TR('j_canvas_time_bars', s.bars.value) : TR('j_canvas_time'), right - 2, H - 4);
      ctx.textAlign = 'left';
    }
    function drawOne(p) {
      var pts = p.points, n = Math.min(p.points.length, Math.ceil(maxSteps * 1.02) + 2), stride = Math.max(1, Math.floor(n / 500));
      ctx.save(); ctx.beginPath(); ctx.rect(left, 0, right - left, H); ctx.clip();
      ctx.strokeStyle = col[p.outcome]; ctx.globalAlpha = 0.42; ctx.lineWidth = 1.2;
      ctx.beginPath(); ctx.moveTo(xs(0), ys(0));
      for (var i = stride; i < n; i += stride) ctx.lineTo(xs(i), ys(pts[i]));
      ctx.lineTo(xs(n - 1), ys(pts[n - 1]));
      ctx.stroke();
      ctx.restore();
      ctx.globalAlpha = 1;
      n = pts.length;
      if (p.outcome !== 'timeout' && n - 1 <= maxSteps) {
        ctx.fillStyle = col[p.outcome];
