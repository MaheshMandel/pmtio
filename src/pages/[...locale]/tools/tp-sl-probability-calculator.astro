    return s;
  }
  function computeMain(s) {
    var A = s.a.points, B = s.b.points, c = s.c.points, r = { A: A, B: B, c: c };
    r.p1 = T.pNoEdge(A, B);
    r.wr = isFinite(s.wr.value) ? s.wr.value / 100 : NaN;
    r.qty = s.q.value;
    if (s.useTime) {
      r.sigmaH = T.sigmaFromAtr(s.atr.value, s.bars.value);
      var t = T.pWithTimeLimit(A, B, r.sigmaH);
      r.pTp = t.tp; r.pSl = t.sl; r.pTo = t.timeout; r.formula = 'F4'; r.pBase = r.p1;
      r.evModel = -c; r.evModelLabel = TR('j_ev_noedge');
    } else if (s.useTrend) {
      r.pTp = T.pDrift(s.side, A, B, s.mu.value, s.sigma.value); r.pSl = 1 - r.pTp; r.pTo = 0; r.formula = 'F2'; r.pBase = r.pTp;
      r.evModel = T.expectedValue(r.pTp, A, B, c); r.evModelLabel = TR('j_ev_f2');
    } else {
      r.pTp = r.p1; r.pSl = 1 - r.p1; r.pTo = 0; r.formula = 'F1'; r.pBase = r.p1;
      r.evModel = -c; r.evModelLabel = TR('j_ev_noedge');
    }
    r.be = T.breakEven(A, B, c);
    r.evU = isFinite(r.wr) ? T.expectedValue(r.wr, A, B, c) : NaN;
    return r;
  }
  function kvMoney(id, x, qty, signed) {
