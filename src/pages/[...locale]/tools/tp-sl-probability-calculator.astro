    r.points = t ? T.ticksToPoints(r.value, i) : r.value;
    showMsg(id, r); return r;
  }
  function readNum(id, label, opts) { var r = T.validateNumber($(id).value, label, opts); showMsg(id, r); return r; }
  function uopts(a, b, c) { return { inst: inst(), unit: unit(), tpIn: a && a.input, slIn: b && b.input, cIn: c && c.input }; }

  function money() { return T.hasMoney(inst()) && !settingsError(); }
  function dollars(points, qty) { return T.pointsToDollars(points, inst()) * (qty || 1); }
  function convLine(label, points) {
    var i = inst(), s = TR('j_conv_pts', label, fmtNum(points));
    if (T.hasTicks(i) && !settingsError()) s += TR('j_conv_ticks', fmtNum(T.pointsToTicks(points, i), 2));
    if (money()) s += TR('j_conv_money', fmtMoney(dollars(points)));
    return s;
  }
  function ptsText(x, signed, dp) {
    return TR('j_pts', signed ? T.fmtSignedPts(x, dp == null ? 2 : dp) : fmtNum(x, dp == null ? 2 : dp));
  }
  function ptsMoney(x, qty, signed) {
    var s = ptsText(x, signed);
    if (money()) s += ' (' + (qty > 1 ? TR('j_money_for_qty', fmtMoney(dollars(x, qty), signed), qty) : TR('j_money_per_contract', fmtMoney(dollars(x, qty), signed))) + ')';
    return s;
  }
  function renderWork(el, w) {
    el.innerHTML = w.steps.map(function (s) { return '<li><p class="st-l">' + esc(s.label) + '</p>' + s.html + '</li>'; }).join('');
  }
  function workFail(el, msg) { el.innerHTML = '<li><p class="st-l">' + esc(msg) + '</p></li>'; }
  function setBar(prefix, tp, to, sl) {
    $(prefix + 'Tp').style.flex = '0 0 ' + (tp * 100).toFixed(2) + '%';
    $(prefix + 'To').style.flex = '0 0 ' + (to * 100).toFixed(2) + '%';
    $(prefix + 'To').hidden = !(to > 0);
    $(prefix + 'Sl').style.flex = '1 1 auto';
  }
  function oneIn(p) {
    if (!(p > 0)) return '';
    var n = 1 / p;
    if (Math.abs(n - Math.round(n)) < 0.08 && Math.round(n) >= 2) return TR('j_one_in', Math.round(n));
    return TR('j_n_in_100', Math.round(p * 100));
  }
  function firstProblem(list) { for (var i = 0; i < list.length; i++) if (!list[i].ok) return list[i].message; return settingsError(); }

  /* ---------- F1 ---------- */
  function renderF1() {
    var a = readDist('f1tp', TR('j_lbl_tp')), b = readDist('f1sl', TR('j_lbl_sl'));
    var bad = firstProblem([a, b]);
    if (bad) { workFail($('f1work'), bad); $('f1res').textContent = '–'; $('f1conv').textContent = ''; setBar('f1bar', 0, 0, 1); return; }
    var w = T.work.f1(a.points, b.points, uopts(a, b));
    renderWork($('f1work'), w);
    $('f1res').textContent = fmtPct(w.values.p);
    $('f1sub').textContent = TR('j_f1_sub', oneIn(w.values.p));
    setBar('f1bar', w.values.p, 0, 1 - w.values.p);
    $('f1conv').textContent = convLine('TP', a.points) + '. ' + convLine('SL', b.points) + '.';
  }

  /* ---------- F2 ---------- */
  function renderF2() {
    var a = readDist('f2tp', TR('j_lbl_tp')), b = readDist('f2sl', TR('j_lbl_sl'));
    var mu = readNum('f2mu', TR('j_lbl_trend'), {}), sg = readNum('f2sigma', TR('j_lbl_vol'), { min: 0, minExclusive: true });
    var bad = firstProblem([a, b, mu, sg]);
    ['f2res', 'f2cmpP', 'f2cmpP1', 'f2cmpD'].forEach(function (id) { $(id).textContent = '–'; });
    if (bad) { workFail($('f2work'), bad); return; }
    var side = radio('f2side') || 'long';
