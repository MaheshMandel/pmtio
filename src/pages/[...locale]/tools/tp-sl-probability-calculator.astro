        steps.push(step(TR('j_s_est_trend_closes', st.n),
          R(mi, EQ, dbar, EQ, F(R(N(fmtNum(st.last), 'now'), MIN, N(fmtNum(st.first), 'past')), N(fmtNum(st.n), 'days'))),
          R(EQ, N(fmtSignedPts(mu, 4), 'mu'))));
      } else {
        mu = 0;
        steps.push(step(TR('j_s_est_trend_zero'), R(mi, EQ, N('0', 'mu'))));
      }
      if (o.sigmaMethod === 'atr') {
        sigma = sigmaFromDailyAtr(o.atr);
        steps.push(step(TR('j_s_est_vol_atr'),
          R(sg, O('≈'), F(I('ATR'), SQRT(R(N('8'), O('/'), I('π'))))),
          R(EQ, F(N(fmtNum(o.atr), 'atr'), N('1.59577')), EQ, N(fmtNum(sigma, 4), 'sigma'))));
      } else if (o.sigmaMethod === 'iv') {
        sigma = sigmaFromIv(o.price, o.iv);
        steps.push(step(TR('j_s_est_vol_iv'),
          R(sg, O('≈'), F(R(I('Price'), TIMES, I('IV')), SQRT(N('252')))),
          R(EQ, F(R(N(fmtNum(o.price), 'price'), TIMES, N(fmtNum(o.iv / 100, 6), 'ivDec')), N('15.8745')), EQ, N(fmtNum(sigma, 4), 'sigma'))));
      } else {
        sigma = st.sd;
