    else { st.className = 'status ok'; st.innerHTML = ICON_OK + '<span><b>' + esc(TR('j_inputs_ok')) + '</b> ' + esc(TR(T.hasTicks(inst()) ? 'j_inputs_ok_grid' : 'j_inputs_ok_plain')) + '</span>'; }
