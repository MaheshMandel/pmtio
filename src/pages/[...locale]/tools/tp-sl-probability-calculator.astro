      var more = r.terms - show;
      var tail = more > 0 ? R(PLUS, '<mtext> ' + esc(TR(more === 1 ? 'j_more_term_one' : 'j_more_term_other', more.toLocaleString('en-US'))) + '</mtext>') : '';
      /* Lay a series out as short lines: "P(TP) = B/L +/- term1", then up to two more terms per line. */
      function rowLines(head, row, total) {
        var lines = [R(head, row[0], row[1] || '', row[2] || '')];
        for (var j = 3; j < row.length; j += 4) lines.push(R('<mspace width="1.5em"/>', row[j], row[j + 1], row[j + 2] || '', row[j + 3] || ''));
        if (tail) lines.push(R('<mspace width="1.5em"/>', tail));
        lines.push(R(EQ, total));
        return lines;
      }
      steps.push(step.apply(null, [terms.length ? TR('j_s_f4_tp_terms', terms.map(function (t) { return t.n; }).join(', '), more > 0 ? TR('j_s_f4_tp_terms_more', r.terms.toLocaleString('en-US')) : '') :
        TR('j_s_f4_tp_none')]
        .concat(rowLines(R(I('P'), O('('), I('TP'), O(')'), EQ), rowTp, N(fmtPct(r.tp), 'tpPct')))));
      steps.push(step.apply(null, [TR('j_s_f4_sl')]
        .concat(rowLines(R(I('P'), O('('), I('SL'), O(')'), EQ), rowSl, N(fmtPct(r.sl), 'slPct')))));
      steps.push(step(TR('j_s_f4_timeout'), R(N('1'), MIN, N(fmtFixed(r.tp, 4), 'tpP'), MIN, N(fmtFixed(r.sl, 4), 'slP')), R(EQ, N(fmtPct(r.timeout), 'toPct'))));
