  <script is:inline>
(function () {
  'use strict';
  var T = TPSL;
  var $ = function (id) { return document.getElementById(id); };
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var MINUS = '−';
  var fmtNum = T.fmtNum, fmtPct = T.fmtPct, fmtMoney = T.fmtMoney, TR = T.TR;

  var ICON_OK = '<svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="m6 10.4 2.6 2.6L14.2 7.4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  var ICON_WARN = '<svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2 19 18H1L10 2Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M10 8v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="10" cy="14.8" r="1.1" fill="currentColor"/></svg>';
  var ICON_UP = '<svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 14 8 9l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  var ICON_DOWN = '<svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6l5 5 3-3 6 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  var ICON_INFO = '<svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M10 9v5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="10" cy="6" r="1.1" fill="currentColor"/></svg>';

  function esc(t) { return String(t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function radio(name) { var el = document.querySelector('input[name="' + name + '"]:checked'); return el ? el.value : null; }

  /* ---------- units and instrument (shared by every calculator) ---------- */
  var DIST_IDS = ['f1tp', 'f1sl', 'f2tp', 'f2sl', 'f3tp', 'f3sl', 'f3c', 'f4tp', 'f4sl', 'f5tp', 'f5sl', 'tp', 'sl', 'cost'];
  function inst() { return T.getInstrument($('inst').value, $('cTick').value, $('cTv').value); }
  function unit() { return (T.hasTicks(inst()) && radio('unit') === 'ticks') ? 'ticks' : 'points'; }
  function settingsError() {
    if ($('inst').value === 'CUSTOM' && !T.hasMoney(inst())) return TR('j_custom_contract_err');
    return '';
  }
  var cur = { inst: inst(), unit: 'points' };
  function convertFields(fromInst, fromUnit, toInst, toUnit) {
    DIST_IDS.forEach(function (id) {
      var el = $(id), v = T.parseNum(el.value);
      if (!isFinite(v)) return;
      var pts = (fromUnit === 'ticks' && T.hasTicks(fromInst)) ? T.ticksToPoints(v, fromInst) : v;
      var out = (toUnit === 'ticks' && T.hasTicks(toInst)) ? T.pointsToTicks(pts, toInst) : pts;
      el.value = String(+out.toFixed(8));
    });
  }
  function unitWord() { return unit(); }
  function applySettings(fromSelect) {
    var i = inst(), ok = T.hasTicks(i);
    $('customRow').hidden = $('inst').value !== 'CUSTOM';
    $('unitTicks').disabled = !ok;
    if (!ok && radio('unit') === 'ticks') $('unitPoints').checked = true;
    var u = unit();
    if (fromSelect && (u !== cur.unit || (u === 'ticks' && cur.inst.tick !== i.tick))) convertFields(cur.inst, cur.unit, i, u);
    if (ok || u === 'points') cur = { inst: i, unit: u };
    document.querySelectorAll('.u').forEach(function (el) { el.textContent = TR(u === 'ticks' ? 'j_unit_ticks' : 'j_unit_points'); });
    $('znHint').hidden = i.key !== 'ZN';
    var err = settingsError();
    $('settingsMsg').hidden = !err; $('settingsMsg').textContent = err;
    var echo, hint;
    if (err) { echo = TR('j_echo_fix_custom'); hint = err; }
    else if (!T.hasMoney(i)) {
      hint = TR('j_hint_generic');
      echo = TR('j_echo_generic');
    } else {
      hint = TR('j_hint_inst', i.key, fmtNum(i.tick), fmtMoney(i.tv), fmtMoney(T.dollarsPerPoint(i)));
      echo = TR('j_echo_inst', TR(u === 'ticks' ? 'j_unit_ticks' : 'j_unit_points'), i.key === 'CUSTOM' ? TR('j_your_custom_contract') : i.key, fmtNum(i.tick), fmtMoney(i.tv));
    }
    $('settingsHint').textContent = hint;
    document.querySelectorAll('[data-echo]').forEach(function (el) {
      el.innerHTML = esc(echo) + ' <a href="#settings">' + esc(TR('j_change_units')) + '</a>';
    });
    var money = T.hasMoney(i) && !err;
    $('f3qtyRow').hidden = !money;
    $('qtyField').hidden = !money;
    renderAll();
  }

  /* ---------- reading and validating inputs ---------- */
  function showMsg(id, res) {
    var el = $(id), m = $(id + 'Msg');
    if (el) el.setAttribute('aria-invalid', String(!res.ok));
    if (!m) return;
    if (!res.ok) { m.textContent = res.message; m.className = 'fmsg err'; m.hidden = false; }
    else if (res.note) { m.textContent = res.note; m.className = 'fmsg note'; m.hidden = false; }
    else { m.textContent = ''; m.hidden = true; }
  }
  function readDist(id, label) {
    var r = T.validateDistance($(id).value, inst(), unit(), label);
    r.input = T.parseNum($(id).value);
    showMsg(id, r); return r;
  }
  /* Costs may be zero; they follow the distance unit. */
  function readCost(id, label) {
