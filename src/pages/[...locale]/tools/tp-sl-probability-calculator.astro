    },
    f5: function (tp, sl, atr, u) {
      u = u || {};
      var sb = atr / RANGE_TO_SIGMA, s = bgkShift(sb), p = pDiscrete(tp, sl, sb), p1 = pNoEdge(tp, sl);
      var steps = unitSteps(u.inst, u.unit, u.tpIn, u.slIn);
      steps.push(step(TR('j_s_vol_bar'), R(SUB(I('σ'), I('bar')), EQ, F(N(fmtNum(atr), 'atr'), N('1.59577')), EQ, N(fmtNum(sb, 4), 'sb'))));
      steps.push(step(TR('j_s_shift'), R(I('s'), EQ, N('0.5826'), TIMES, N(fmtNum(sb, 4)), EQ, N(fmtNum(s, 4), 's'))));
      steps.push(step(TR('j_s_move_orders'), R(SUB(I('P'), I('bars')), O('≈'), F(R(N(fmtNum(sl)), PLUS, N(fmtNum(s, 4))), R(N(fmtNum(tp)), PLUS, N(fmtNum(sl)), PLUS, N('2'), TIMES, N(fmtNum(s, 4))))),
        R(EQ, F(N(fmtNum(sl + s, 4), 'num'), N(fmtNum(tp + sl + 2 * s, 4), 'den')), EQ, N(fmtPct(p), 'pct'))));
      steps.push(step(TR('j_s_compare_f1_cont'), R(SUB(I('P'), I('F1')), EQ, N(fmtPct(p1), 'p1'))));
      return { steps: steps, values: { sb: sb, s: s, num: sl + s, den: tp + sl + 2 * s, p: p, p1: p1 } };
    },
    /* F2's inputs. o = { muMethod: 'prices'|'closes'|'zero', sigmaMethod: 'atr'|'iv'|'closes',
       past, now, days, atr, price, iv (percent), closes: [numbers] }. Inputs are already validated. */
    est: function (o) {
      var steps = [], mu, sigma, st = null, mi = I('μ'), sg = I('σ');
      var dbar = '<mover accent="true"><mi>d</mi><mo>¯</mo></mover>';
      if (o.muMethod === 'closes' || o.sigmaMethod === 'closes') {
        st = closeStats(o.closes);
        var shown = st.diffs.slice(0, 4), row = [I('d'), EQ];
        shown.forEach(function (d, i) { if (i) row.push(O(',')); row.push(N(fmtNum(d, 4), i === 0 ? 'd1' : null)); });
        if (st.n > shown.length) row.push(O(','), '<mi>…</mi>');
        steps.push(step(TR('j_s_est_changes', st.n + 1, st.n), R.apply(null, row)));
      }
      if (o.muMethod === 'prices') {
        mu = muFromPrices(o.past, o.now, o.days);
        steps.push(step(TR('j_s_est_trend_prices'),
          R(mi, EQ, F(R(SUB(I('C'), '<mtext>' + esc(TR('j_today')) + '</mtext>'), MIN, SUB(I('C'), '<mtext>' + esc(TR('j_n_days_ago')) + '</mtext>')), I('N'))),
          R(EQ, F(R(N(fmtNum(o.now), 'now'), MIN, N(fmtNum(o.past), 'past')), N(fmtNum(o.days), 'days')), EQ, F(N(fmtNum(o.now - o.past, 4), 'chg'), N(fmtNum(o.days))), EQ, N(fmtSignedPts(mu, 4), 'mu'))));
      } else if (o.muMethod === 'closes') {
