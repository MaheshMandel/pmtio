    $('heroEv').textContent = ptsText(r.evModel, true) + (money() ? ' (' + fmtMoney(dollars(r.evModel, q), true) + ')' : '');

    $('eqpUserL').textContent = isFinite(r.wr) ? TR('j_eqp_mine', fmtNum(r.wr * 100, 1)) : TR('j_eqp_mine_unset');
    $('eqpZeroL').textContent = TR(r.formula === 'F2' ? 'j_eqp_f2' : 'j_eqp_f1', fmtPct(r.pBase));
    $('eqpUser').disabled = !isFinite(r.wr);
