</BaseLayout>

<style is:global>
@layer theme, base, components, utilities;
:root{
  --ground:#001429; --surface:#0d1b2e; --surface-2:#12233b; --surface-3:#0a1a2f; --ink:#f3f6fb; --ink-2:#cbd5e1; --mut:#94a3b8;
  --rule:#2b3a52; --grid:#22324a;
  --brand:#2b77ee; --brand-deep:#8dbbff; --link:#60a5fa; --brand-soft:#0f3566;
  --band:#001429; --band-2:#002040; --on-band:#ffffff; --on-band-2:#cbd5e1; --on-band-rule:rgba(255,255,255,.12); --on-band-card:rgba(255,255,255,.05);
  --tp:#4f92f5; --sl:#f26a2a; --to:#7b88a0; --median:#e9f0fb; --band-fill:rgba(79,146,245,.22);
  --good:#5fd39b; --good-bg:rgba(34,197,94,.12); --bad:#ff8f84; --bad-bg:rgba(239,68,68,.12); --warn:#fbbf24; --warn-bg:rgba(234,179,8,.10); --warn-rule:rgba(234,179,8,.35);
  --code-bg:rgba(0,0,0,.4); --code-ink:#e5e7eb; --focus:#8dbbff; --btn-ink:#ffffff; --btn:#0f3ec3;
  --math:#e9f0fb; --math-num:#9cc3ff;
}
@layer components{
.tpsl *,.tpsl *::before,.tpsl *::after{box-sizing:border-box}
.tpsl [hidden]{display:none !important}
.tpsl img,.tpsl svg,.tpsl canvas{max-width:100%}
.tpsl :focus-visible{outline:2px solid var(--focus);outline-offset:2px;border-radius:4px}
.tpsl h1{font-family:Electrolize,"Segoe UI",Roboto,Arial,sans-serif;font-weight:400;letter-spacing:.005em;text-wrap:balance;line-height:1.15;margin:0}
.tpsl h3{font-size:1.1rem;line-height:1.35;margin:0;font-weight:650;text-wrap:balance}
.tpsl p{margin:0}
.tpsl .num{font-variant-numeric:tabular-nums}

/* header */

/* hero */
.tpsl .answer{margin-top:18px;font-size:1.15rem;line-height:1.6;color:var(--on-band-2);max-width:60ch}
