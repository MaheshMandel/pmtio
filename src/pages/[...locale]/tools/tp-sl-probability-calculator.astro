    bgkShift: bgkShift, pDiscrete: pDiscrete,
    TRADING_DAYS_PER_YEAR: TRADING_DAYS_PER_YEAR, muFromPrices: muFromPrices, sigmaFromDailyAtr: sigmaFromDailyAtr, sigmaFromIv: sigmaFromIv,
    rescaleToShorterUnit: rescaleToShorterUnit, driftK: driftK, parseCloses: parseCloses, closeStats: closeStats,
    rngFromSeed: rngFromSeed, normalFrom: normalFrom, simulatePath: simulatePath, simulateMany: simulateMany,
    simSettings: simSettings, noise95: noise95, simulateEquity: simulateEquity, percentile: percentile,
