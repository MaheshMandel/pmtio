  <script>
    // Broker tabs functionality
    document.addEventListener('DOMContentLoaded', function() {
      const tabs = document.querySelectorAll('.broker-tab');
      const contents = document.querySelectorAll('.broker-content');

      tabs.forEach(tab => {
        tab.addEventListener('click', function(this: HTMLElement) {
          const broker = this.getAttribute('data-broker');

          // Remove active class from all tabs
          tabs.forEach(t => {
            t.classList.remove('active', 'bg-gradient-to-r', 'from-blue-600', 'to-blue-700', 'text-white');
            t.classList.add('bg-white/5', 'text-gray-300', 'border', 'border-gray-700/50');
          });

          // Add active class to clicked tab
          this.classList.remove('bg-white/5', 'text-gray-300', 'border', 'border-gray-700/50');
          this.classList.add('active', 'bg-gradient-to-r', 'from-blue-600', 'to-blue-700', 'text-white');

          // Hide all content
          contents.forEach(content => {
            content.classList.remove('active');
          });

          // Show selected content
          const selectedContent = document.getElementById(broker + '-content');
          if (selectedContent) {
            selectedContent.classList.add('active');
          }
        });
      });
    });
  </script>

