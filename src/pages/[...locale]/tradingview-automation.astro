---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalePaths, localizedPath, useTranslations, absoluteLocalizedPath } from '../../i18n/utils';
import { LOCALE_BCP47, type Locale } from '../../i18n/config';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const schema1 = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "TradingView Automation Guide - Connect Alerts to Rithmic, IB, TradeStation",
    "description": "Master TradingView automation with our complete guide. Learn position sizing, SL/TP strategies, broker connections, alert configuration, and risk management.",
    "image": {
      "@type": "ImageObject",
      "url": "https://pickmytrade.io/assets/logo.png",
      "width": 1200,
      "height": 630
    },
    "author": {
      "@type": "Organization",
      "name": "PickMyTrade",
      "url": "https://pickmytrade.io/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://pickmytrade.io/assets/logo.png"
      }
    },
    "publisher": {
      "@type": "Organization",
      "name": "PickMyTrade",
      "logo": {
        "@type": "ImageObject",
        "url": "https://pickmytrade.io/assets/logo.png"
      }
    },
    "datePublished": "2025-01-15",
    "dateModified": "2026-04-17",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": absoluteLocalizedPath(locale, 'tradingview-automation')
    }
  };

const schema2 = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://pickmytrade.io/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "TradingView Automation Guide",
        "item": absoluteLocalizedPath(locale, 'tradingview-automation')
      }
    ]
  };

const schema3 = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "TradingView Automation Guide",
    "description": "Master TradingView automation with our complete guide. Learn position sizing, SL/TP strategies, broker connections, alert configuration, and risk management.",
    "url": absoluteLocalizedPath(locale, 'tradingview-automation'),
    "inLanguage": LOCALE_BCP47[locale],
    "isPartOf": {
      "@type": "WebSite",
      "name": "PickMyTrade",
      "url": "https://pickmytrade.io/"
    },
    "about": {
      "@type": "Thing",
      "name": "Trading Automation"
    },
    "audience": {
      "@type": "Audience",
      "audienceType": "Traders"
    }
  };

const schema4 = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
    "image": "https://pickmytrade.io/assets/logo.png",
  "name": "PickMyTrade",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web-based",
  "offers": {
    "@type": "Offer",
    "price": "50.00",
    "priceCurrency": "USD",
    "description": "7-day free trial, then subscription-based pricing"
  },
  "description": "TradingView automation platform that executes trades automatically from TradingView alerts to 60+ brokers and 27+ prop firms with ultra-low latency.",
  "featureList": [
    "Ultra-low latency webhook execution",
    "60+ broker integrations",
    "27+ prop firm integrations",
    "Multi-account management",
    "Advanced risk management",
    "Portfolio tracking",
    "No coding required"
  ],
  "screenshot": "https://pickmytrade.io/assets/logo.png",
  "softwareVersion": "3.0",
  "releaseNotes": "Enhanced automation features and expanded broker support"
};
---
<BaseLayout
  locale={locale}
  title={t('tradingview_automation.page_title')}
  description={t('tradingview_automation.page_description')}
  keywords={t('tradingview_automation.page_keywords')}
  structuredData={[schema1, schema2, schema3, schema4]}
>
<nav aria-label="Breadcrumb" class="bg-[#001429] pt-20 pb-3 sm:pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-5">
      <ol class="flex items-center flex-wrap gap-2 text-xs sm:text-sm text-gray-400" itemscope
        itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={localizedPath(locale, '')} class="hover:text-[#2B77EE] transition" itemprop="item">
            <span itemprop="name">{t('tradingview_automation.breadcrumb_home')}</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="text-gray-600">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="text-white font-semibold" itemprop="name">{t('tradingview_automation.breadcrumb_current')}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="relative pt-32 mt-10 pb-40 px-4 overflow-hidden">
    <!-- Advanced Animated Background -->
    <div class="absolute inset-0">
      <!-- Base Gradient -->
      <div class="absolute inset-0 bg-gradient-to-br from-blue-600/10 via-transparent to-purple-600/10"></div>

      <!-- Animated Orbs -->
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-500/5 rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-purple-500/5 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
      <div class="absolute top-1/2 left-1/2 w-72 h-72 bg-pink-500/5 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>

      <!-- Grid Pattern -->
      <div class="absolute inset-0 opacity-[0.02]" style="background-image: linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px); background-size: 50px 50px;"></div>

      <!-- Gradient Lines -->
      <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-blue-500/20 to-transparent"></div>
    </div>

    <div class="max-w-7xl mx-auto relative z-10">
      <!-- Main Hero Content -->
      <div class="text-center mb-20" data-aos="fade-up">
        <!-- Premium Badge -->
        <div class="inline-flex items-center gap-3 bg-blue-600/20 border border-blue-500/30 rounded-full px-8 py-3 mb-10">
          <div class="relative">
            <i class="fa-solid fa-bolt text-blue-400 text-lg"></i>
            <span class="absolute -top-1 -right-1 w-2 h-2 bg-blue-400 rounded-full animate-ping"></span>
          </div>
          <span class="text-blue-400 text-base font-semibold tracking-wide">{t('tradingview_automation.hero_badge_brand')}</span>
          <div class="w-px h-4 bg-blue-500/30"></div>
          <span class="text-gray-300 text-sm">{t('tradingview_automation.hero_badge_platform')}</span>
        </div>

        <!-- Main Headline with Enhanced Styling -->
        <h1 class="text-5xl sm:text-6xl md:text-7xl font-bold mb-10 leading-tight tracking-tight">
          <span class="block text-white mb-3">
            {t('tradingview_automation.hero_title_line1')}
          </span>
          <span class="block text-[#2B77EE]">
            {t('tradingview_automation.hero_title_line2')}
          </span>
        </h1>

        <!-- Subheadline with Better Typography -->
        <div class="mb-14 space-y-3">
          <p class="text-xl md:text-2xl text-gray-300 leading-relaxed max-w-3xl mx-auto">
            {t('tradingview_automation.hero_subtitle_part1')} <span class="text-blue-400 font-semibold">{t('tradingview_automation.hero_subtitle_tradingview')}</span> {t('tradingview_automation.hero_subtitle_part2')}
            <span class="text-blue-400 font-semibold">{t('tradingview_automation.hero_subtitle_anybroker')}</span>.
          </p>
          <p class="text-xl md:text-2xl text-blue-400 font-semibold">
            {t('tradingview_automation.hero_subtitle_seamlessly')}
          </p>
        </div>

        <!-- Enhanced CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-5 justify-center items-center mb-20">
          <a href="https://app.pickmytrade.io/?register=true"
            class="group relative px-12 py-6 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 rounded-2xl font-bold text-xl transition-all duration-300 shadow-2xl shadow-blue-500/30 hover:shadow-blue-500/60 hover:scale-105 overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-r from-blue-400 to-purple-400 opacity-0 group-hover:opacity-20 transition-opacity duration-300"></div>
            <span class="relative flex items-center gap-3">
              {t('tradingview_automation.hero_cta_trial')}
              <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform duration-300"></i>
            </span>
          </a>
          <a href="https://docs.pickmytrade.io/docs/"
            class="group px-12 py-6 bg-white/5 hover:bg-white/10 border-2 border-white/10 hover:border-blue-500/50 rounded-2xl font-bold text-xl transition-all duration-300 backdrop-blur-sm">
            <span class="flex items-center gap-3">
              <i class="fa-solid fa-book text-gray-400 group-hover:text-blue-400 transition-colors duration-300"></i>
              {t('tradingview_automation.hero_cta_docs')}
            </span>
          </a>
        </div>
      </div>

      <!-- Enhanced Hero Visual - 3 Column Bridge with Flow Animation -->
      <div class="relative max-w-6xl mx-auto mb-20" data-aos="fade-up" data-aos-delay="200">
        <!-- Connection Flow Lines (Desktop Only) -->
        <div class="hidden md:block absolute top-1/2 left-0 right-0 h-0.5 -translate-y-1/2 z-0">
          <div class="absolute inset-0 bg-gradient-to-r from-blue-500/0 via-purple-500/50 to-pink-500/0"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-blue-500 via-purple-500 to-pink-500 opacity-50 animate-pulse"></div>
        </div>

        <div class="grid md:grid-cols-3 gap-10 relative z-10">
          <!-- TradingView Column -->
          <div class="group relative bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-2xl p-10 border border-gray-700/50 hover:border-blue-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-500/20" data-aos="zoom-in" data-aos-delay="300">
            <div class="text-center">
              <div class="w-20 h-20 bg-gradient-to-br from-blue-500/20 to-blue-600/20 rounded-xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
                <img src="/assets/TV-black-short-logo.svg" alt={t('tradingview_automation.bridge_tv_logo_alt')} class="rounded-md" width="180" height="180" loading="eager" decoding="async">
              </div>
              <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors duration-300">{t('tradingview_automation.bridge_tv_title')}</h3>
              <p class="text-gray-300 leading-relaxed">{t('tradingview_automation.bridge_tv_desc')}</p>
            </div>
          </div>

          <!-- Strategy Bridge Column -->
          <div class="group relative bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-2xl p-10 border border-gray-700/50 hover:border-blue-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-500/20" data-aos="zoom-in" data-aos-delay="400">
            <div class="text-center">
              <div class="w-20 h-20 bg-gradient-to-br from-blue-500/20 to-blue-600/20 rounded-xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
                <img src="assets/logo.webp" alt={t('tradingview_automation.bridge_strategy_logo_alt')} class="rounded-md" width="1563" height="1563" loading="lazy" decoding="async">
              </div>
              <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors duration-300">{t('tradingview_automation.bridge_strategy_title')}</h3>
              <div class="flex items-center justify-center gap-3 mb-4">
                <div class="w-2 h-2 bg-blue-400 rounded-full"></div>
                <i class="fa-solid fa-arrow-right text-blue-400 text-lg"></i>
                <div class="w-2 h-2 bg-blue-400 rounded-full"></div>
              </div>
              <p class="text-gray-300 leading-relaxed">{t('tradingview_automation.bridge_strategy_desc')}</p>
            </div>
          </div>

          <!-- Execution Column -->
          <div class="group relative bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-2xl p-10 border border-gray-700/50 hover:border-blue-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-500/20" data-aos="zoom-in" data-aos-delay="500">
            <div class="text-center">
              <div class="w-20 h-20 bg-gradient-to-br from-blue-500/20 to-blue-600/20 rounded-xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
                <i class="fa-solid fa-building-columns text-4xl text-blue-400"></i>
              </div>
              <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors duration-300">{t('tradingview_automation.bridge_execution_title')}</h3>
              <p class="text-gray-300 leading-relaxed">{t('tradingview_automation.bridge_execution_desc')}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Enhanced Trust Indicators -->
      <div class="text-center" data-aos="fade-up" data-aos-delay="600">
        <div class="inline-block bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl px-8 py-6">
          <p class="text-gray-400 text-xs uppercase tracking-widest mb-6 font-semibold">{t('tradingview_automation.trust_heading')}</p>
          <div class="flex flex-wrap justify-center items-center gap-12">
            <div class="flex flex-col items-center gap-2 group cursor-pointer">
              <div class="w-12 h-12 bg-blue-500/10 rounded-xl flex items-center justify-center group-hover:bg-blue-500/20 transition-all duration-300">
                <i class="fa-solid fa-bolt text-blue-400 text-xl group-hover:scale-110 transition-transform duration-300"></i>
              </div>
              <span class="text-sm font-medium text-gray-300">{t('tradingview_automation.trust_millisecond')}<br>{t('tradingview_automation.trust_execution')}</span>
            </div>
            <div class="hidden sm:block w-px h-12 bg-white/10"></div>
            <div class="flex flex-col items-center gap-2 group cursor-pointer">
              <div class="w-12 h-12 bg-green-500/10 rounded-xl flex items-center justify-center group-hover:bg-green-500/20 transition-all duration-300">
                <i class="fa-solid fa-shield-halved text-green-400 text-xl group-hover:scale-110 transition-transform duration-300"></i>
              </div>
              <span class="text-sm font-medium text-gray-300">{t('tradingview_automation.trust_banklevel')}<br>{t('tradingview_automation.trust_security')}</span>
            </div>
            <div class="hidden sm:block w-px h-12 bg-white/10"></div>
            <div class="flex flex-col items-center gap-2 group cursor-pointer">
              <div class="w-12 h-12 bg-purple-500/10 rounded-xl flex items-center justify-center group-hover:bg-purple-500/20 transition-all duration-300">
                <i class="fa-solid fa-clock text-purple-400 text-xl group-hover:scale-110 transition-transform duration-300"></i>
              </div>
              <span class="text-sm font-medium text-gray-300">{t('tradingview_automation.trust_247')}<br>{t('tradingview_automation.trust_automation')}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Your Bridge from Strategy to Execution -->
  <section class="relative py-32 px-4 overflow-hidden">
    <!-- Background Effects -->
    <div class="absolute inset-0">
      <div class="absolute top-0 left-0 w-96 h-96 bg-blue-500/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-0 w-96 h-96 bg-purple-500/5 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-6xl mx-auto relative z-10">
      <div class="text-center mb-20" data-aos="fade-up">
        <div class="inline-block mb-6">
          <div class="inline-block px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-sm font-semibold border border-blue-500/30">
            {t('tradingview_automation.bridge2_badge')}
          </div>
        </div>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight">
          {t('tradingview_automation.bridge2_title')}
        </h2>
        <p class="text-xl text-gray-300 max-w-4xl mx-auto leading-relaxed">
          {t('tradingview_automation.bridge2_desc_part1')} <span class="text-blue-400 font-semibold">{t('tradingview_automation.bridge2_desc_instantly')}</span> {t('tradingview_automation.bridge2_desc_and')} <span class="text-blue-400 font-semibold">{t('tradingview_automation.bridge2_desc_accurately')}</span>{t('tradingview_automation.bridge2_desc_part2')}
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-12 relative">
        <!-- Enhanced Connection Lines with Pulse Animation -->
        <div class="hidden md:block absolute top-32 left-1/4 right-1/4 h-0.5 -translate-y-1/2 z-0">
          <div class="absolute inset-0 bg-gradient-to-r from-blue-500/50 via-purple-500/50 to-pink-500/50"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-blue-500 via-purple-500 to-pink-500 opacity-50 animate-pulse"></div>
        </div>

        <!-- Step 1: Connect -->
        <div class="group relative bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-2xl p-8 border border-gray-700/50 hover:border-blue-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-500/20" data-aos="fade-up" data-aos-delay="100">
          <div class="absolute -top-4 left-8 w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center shadow-lg border-4 border-[#001429] group-hover:scale-110 transition-transform duration-300">
            <span class="text-white font-bold text-xl">1</span>
          </div>
          <div class="mt-6">
            <div class="w-16 h-16 mb-4 bg-gradient-to-br from-blue-500/20 to-blue-600/20 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
              <i class="fa-solid fa-plug text-3xl text-blue-400"></i>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors duration-300">{t('tradingview_automation.bridge2_step1_title')}</h3>
            <p class="text-gray-300 leading-relaxed">{t('tradingview_automation.bridge2_step1_desc')}</p>
          </div>
        </div>

        <!-- Step 2: Configure -->
        <div class="group relative bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-2xl p-8 border border-gray-700/50 hover:border-blue-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-500/20" data-aos="fade-up" data-aos-delay="200">
          <div class="absolute -top-4 left-8 w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center shadow-lg border-4 border-[#001429] group-hover:scale-110 transition-transform duration-300">
            <span class="text-white font-bold text-xl">2</span>
          </div>
          <div class="mt-6">
            <div class="w-16 h-16 mb-4 bg-gradient-to-br from-blue-500/20 to-blue-600/20 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
              <i class="fa-solid fa-sliders text-3xl text-blue-400"></i>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors duration-300">{t('tradingview_automation.bridge2_step2_title')}</h3>
            <p class="text-gray-300 leading-relaxed">{t('tradingview_automation.bridge2_step2_desc')}</p>
          </div>
        </div>

        <!-- Step 3: Automate -->
        <div class="group relative bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-2xl p-8 border border-gray-700/50 hover:border-blue-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-500/20" data-aos="fade-up" data-aos-delay="300">
          <div class="absolute -top-4 left-8 w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center shadow-lg border-4 border-[#001429] group-hover:scale-110 transition-transform duration-300">
            <span class="text-white font-bold text-xl">3</span>
          </div>
          <div class="mt-6">
            <div class="w-16 h-16 mb-4 bg-gradient-to-br from-blue-500/20 to-blue-600/20 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
              <i class="fa-solid fa-rocket text-3xl text-blue-400"></i>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors duration-300">{t('tradingview_automation.bridge2_step3_title')}</h3>
            <p class="text-gray-300 leading-relaxed">{t('tradingview_automation.bridge2_step3_desc')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Activating Your Automation in TradingView -->
  <section class="py-20 px-4 bg-gradient-to-b from-transparent to-purple-900/10">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="text-3xl md:text-5xl font-bold mb-6">{t('tradingview_automation.activate_title')}</h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          {t('tradingview_automation.activate_subtitle')}
        </p>
      </div>

      <div class="grid lg:grid-cols-4 gap-4" data-aos="fade-up">
        <!-- Step 1 -->
        <div class="bg-gradient-to-br from-blue-500/10 to-blue-600/10 border border-blue-500/30 rounded-xl p-6">
          <div class="w-12 h-12 bg-blue-500 rounded-xl flex items-center justify-center mb-4 font-bold text-xl">1</div>
          <h3 class="text-lg font-bold mb-3">{t('tradingview_automation.activate_step1_title')}</h3>
          <p class="text-sm text-gray-300">{t('tradingview_automation.activate_step1_desc')}</p>
        </div>

        <!-- Step 2 -->
        <div class="bg-gradient-to-br from-purple-500/10 to-purple-600/10 border border-purple-500/30 rounded-xl p-6">
          <div class="w-12 h-12 bg-purple-500 rounded-xl flex items-center justify-center mb-4 font-bold text-xl">2</div>
          <h3 class="text-lg font-bold mb-3">{t('tradingview_automation.activate_step2_title')}</h3>
          <p class="text-sm text-gray-300">{t('tradingview_automation.activate_step2_desc')}</p>
        </div>

        <!-- Step 3 -->
        <div class="bg-gradient-to-br from-pink-500/10 to-pink-600/10 border border-pink-500/30 rounded-xl p-6">
          <div class="w-12 h-12 bg-pink-500 rounded-xl flex items-center justify-center mb-4 font-bold text-xl">3</div>
          <h3 class="text-lg font-bold mb-3">{t('tradingview_automation.activate_step3_title')}</h3>
          <p class="text-sm text-gray-300">{t('tradingview_automation.activate_step3_desc')}</p>
        </div>

        <!-- Step 4 -->
        <div class="bg-gradient-to-br from-green-500/10 to-green-600/10 border border-green-500/30 rounded-xl p-6">
