---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalePaths, localizedPath, useTranslations, absoluteLocalizedPath } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const schema1 = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://pickmytrade.io"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Trading VPS (TradoxVPS)",
        "item": absoluteLocalizedPath(locale, 'tradoxvps')
      }
    ]
  };

// NOTE: TradoxVPS's current annual plan price could not be verified (their
// pricing page did not expose it, and no "PickMyTrade" discount code was
// found live on tradoxvps.com — only an unrelated "WELCOME" code). Per the
// content guardrail against inventing/staling pricing figures in structured
// data, this Product schema intentionally omits "offers"/price. Add it back
// once the current TradoxVPS annual price and partner-code discount are
// confirmed directly with TradoxVPS.
const schema2 = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "TradoxVPS Trading VPS",
  "description": "Chicago-based, CME-proximal low-latency Windows trading VPS built for futures and TradingView automation, running on AMD Ryzen 9950X CPUs with DDR5 RAM and NVMe SSD storage. Offered in partnership with PickMyTrade.",
  "brand": { "@type": "Brand", "name": "TradoxVPS" },
  "category": "Trading VPS Hosting",
  "url": absoluteLocalizedPath(locale, 'tradoxvps')
};

const schema3 = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is a trading VPS and do I need one?",
      "acceptedAnswer": { "@type": "Answer", "text": "A trading VPS is an always-on Windows computer in a professional data center that you log into remotely to run your trading platforms, TradingView in a browser, or custom scripts. It keeps working 24/7 even when your home PC is off or your internet drops. You need one if you rely on desktop platforms or scripts that must stay online, or you want a stable environment separate from your home setup. If you only automate TradingView alerts to your broker through PickMyTrade, that runs in the cloud already, so a VPS is optional." }
    },
    {
      "@type": "Question",
      "name": "What is the best VPS for futures trading?",
      "acceptedAnswer": { "@type": "Answer", "text": "For US futures, the best VPS is usually one in a Chicago data center close to the CME, with strong uptime, a modern CPU, DDR5 RAM, NVMe SSD storage, and enough resources to run your platforms smoothly. TradoxVPS is built to this spec on AMD Ryzen 9950X hardware in Chicago. The right plan depends on how many charts, platforms and strategies you run at once." }
    },
    {
      "@type": "Question",
      "name": "Do I need a VPS to run TradingView automation with PickMyTrade?",
      "acceptedAnswer": { "@type": "Answer", "text": "No. PickMyTrade runs in the cloud and executes your trades from its own servers 24/7, even when your computer is off, so you do not need a VPS for the automation itself. A VPS like TradoxVPS is useful if you also want to keep TradingView open in a browser around the clock, run non-cloud scripts, or host a broker desktop app, but it is optional, not required." }
    },
    {
      "@type": "Question",
      "name": "Which VPS location is best for Tradovate and Rithmic (Chicago/CME proximity)?",
      "acceptedAnswer": { "@type": "Answer", "text": "A Chicago data center is the usual choice, because it sits close to the CME futures matching engine and keeps network latency low for the platforms you host on the server. TradoxVPS is Chicago-based and CME-proximal for this reason. Remember that PickMyTrade's own automation is cloud-hosted, so for pure webhook trading the VPS location mainly matters for tools you run on the VPS yourself." }
    },
    {
      "@type": "Question",
      "name": "Can a VPS keep my strategy running 24/7 when my computer is off?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. Because a VPS lives in a data center with redundant power and internet, anything you run on it, such as a browser with TradingView, a broker platform or a custom script, keeps running 24/7 whether or not your home PC is on. If your automation runs through PickMyTrade instead, it already executes in the cloud around the clock without a VPS." }
    }
  ]
};
---
<BaseLayout
  locale={locale}
  title={t('tradoxvps.page_title')}
  description={t('tradoxvps.page_description')}
  keywords={t('tradoxvps.page_keywords')}
  structuredData={[schema1, schema2, schema3]}
>
<nav aria-label="Breadcrumb" class="bg-[#001429] pt-20 pb-3 sm:pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-5">
      <ol class="flex items-center flex-wrap gap-2 text-xs sm:text-sm text-gray-400" itemscope
        itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={localizedPath(locale, '')} class="hover:text-[#2B77EE] transition" itemprop="item">
            <span itemprop="name">{t('tradoxvps.breadcrumb_home')}</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="text-gray-600">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="text-white font-semibold" itemprop="name">{t('tradoxvps.breadcrumb_current')}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="pt-52 pb-16 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <div class="mb-6">
        <span class="bg-orange-500/20 text-orange-400 px-4 py-2 rounded-full text-sm font-semibold uppercase tracking-wide">
          {t('tradoxvps.badge_partner')}
        </span>
      </div>
      <div class="mb-8">
        <div class="inline-flex items-center gap-3 bg-gradient-to-r from-orange-500/10 to-orange-400/5 border border-orange-500/30 rounded-2xl px-8 py-4">
          <i class="fa-solid fa-server text-3xl text-orange-400"></i>
          <span class="text-3xl md:text-4xl font-bold tracking-wide text-white electrolize-regular">TradoxVPS</span>
        </div>
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
        {t('tradoxvps.hero_title_a')}<br /><span class="gradient-text">{t('tradoxvps.hero_title_highlight')}</span>
      </h1>
      <p class="text-xl text-gray-300 mb-6 max-w-3xl mx-auto">
        {t('tradoxvps.hero_subtitle')}
      </p>

      <!-- Hardware highlight strip -->
      <div class="flex flex-wrap justify-center gap-3 mb-10">
        <div class="hardware-badge px-4 py-2 rounded-full text-sm font-semibold text-orange-300">
          <i class="fa-solid fa-microchip mr-2"></i>{t('tradoxvps.hw_badge_cpu')}
        </div>
        <div class="hardware-badge px-4 py-2 rounded-full text-sm font-semibold text-orange-300">
          <i class="fa-solid fa-memory mr-2"></i>{t('tradoxvps.hw_badge_ram')}
        </div>
        <div class="hardware-badge px-4 py-2 rounded-full text-sm font-semibold text-orange-300">
          <i class="fa-solid fa-hard-drive mr-2"></i>{t('tradoxvps.hw_badge_ssd')}
        </div>
        <div class="hardware-badge px-4 py-2 rounded-full text-sm font-semibold text-orange-300">
          <i class="fa-solid fa-location-dot mr-2"></i>{t('tradoxvps.hw_badge_location')}
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-10">
        <a href="https://tradoxvps.com" target="_blank" rel="noopener noreferrer"
          class="px-8 py-4 bg-gradient-to-r from-[#2B77EE] to-[#4B94FF] rounded-xl font-bold text-white hover:shadow-lg hover:shadow-blue-500/50 transition-all text-lg">
          <i class="fa-solid fa-server mr-2"></i> {t('tradoxvps.hero_cta_primary')}
        </a>
        <a href="https://app.pickmytrade.io/?register=true"
          class="px-8 py-4 border-2 border-[#2B77EE] rounded-xl font-bold text-white hover:bg-[#2B77EE]/10 transition-all text-lg">
          {t('tradoxvps.hero_cta_secondary')}
        </a>
      </div>

      <!-- Discount code callout -->
      <div class="mt-4">
        <p class="text-sm text-gray-400 mb-3">{t('tradoxvps.discount_pre')} <span class="text-green-400 font-bold">{t('tradoxvps.discount_off')}</span>:</p>
        <div class="code-box relative inline-block pr-24">
          PickMyTrade
          <button class="copy-btn" onclick="copyCode()">
            <i class="fa-solid fa-copy"></i> {t('tradoxvps.copy_button')}
          </button>
        </div>
        <p class="text-xs text-gray-500 mt-3">{t('tradoxvps.discount_apply')}</p>
      </div>
    </div>
  </section>

  <!-- What is a trading VPS (answer-first) -->
  <section class="py-16 px-4 bg-black/30">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-6 text-center">{t('tradoxvps.s31_h2')}</h2>
      <div class="space-y-4 text-gray-300 text-lg leading-relaxed">
        <p>{t('tradoxvps.s31_p1')}</p>
        <p>{t('tradoxvps.s31_p2')}</p>
        <p>{t('tradoxvps.s31_p3')}</p>
      </div>
    </div>
  </section>

  <!-- What to look for in the best VPS for trading -->
  <section class="py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-center">{t('tradoxvps.s32_h2')}</h2>
      <p class="text-gray-300 text-lg max-w-3xl mx-auto text-center mb-10">{t('tradoxvps.s32_intro')}</p>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="feature-card rounded-xl p-6">
          <h3 class="text-lg font-bold mb-2 text-white">{t('tradoxvps.s32_item1_title')}</h3>
          <p class="text-gray-400">{t('tradoxvps.s32_item1_desc')}</p>
        </div>
        <div class="feature-card rounded-xl p-6">
          <h3 class="text-lg font-bold mb-2 text-white">{t('tradoxvps.s32_item2_title')}</h3>
          <p class="text-gray-400">{t('tradoxvps.s32_item2_desc')}</p>
        </div>
        <div class="feature-card rounded-xl p-6">
          <h3 class="text-lg font-bold mb-2 text-white">{t('tradoxvps.s32_item3_title')}</h3>
          <p class="text-gray-400">{t('tradoxvps.s32_item3_desc')}</p>
        </div>
        <div class="feature-card rounded-xl p-6">
          <h3 class="text-lg font-bold mb-2 text-white">{t('tradoxvps.s32_item4_title')}</h3>
          <p class="text-gray-400">{t('tradoxvps.s32_item4_desc')}</p>
        </div>
        <div class="feature-card rounded-xl p-6 md:col-span-2">
          <h3 class="text-lg font-bold mb-2 text-white">{t('tradoxvps.s32_item5_title')}</h3>
          <p class="text-gray-400">{t('tradoxvps.s32_item5_desc')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why TradoxVPS Section -->
  <section class="py-16 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">
          {t('tradoxvps.why_title_a')} <span class="gradient-text">Futures and TradingView Automation</span>
        </h2>
        <p class="text-gray-300 text-lg max-w-3xl mx-auto">
          {t('tradoxvps.why_subtitle')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="feature-card rounded-xl p-6">
          <div class="w-12 h-12 bg-orange-500/20 rounded-lg flex items-center justify-center mb-4">
            <i class="fa-solid fa-location-dot text-2xl text-orange-400"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{t('tradoxvps.feature_chicago_title')}</h3>
          <p class="text-gray-400">{t('tradoxvps.feature_chicago_desc')}</p>
        </div>

        <div class="feature-card rounded-xl p-6">
          <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center mb-4">
            <i class="fa-solid fa-bolt text-2xl text-blue-400"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{t('tradoxvps.feature_latency_title')}</h3>
          <p class="text-gray-400">{t('tradoxvps.feature_latency_desc')}</p>
        </div>

        <div class="feature-card rounded-xl p-6">
          <div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center mb-4">
            <i class="fa-solid fa-shield-halved text-2xl text-green-400"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{t('tradoxvps.feature_stability_title')}</h3>
          <p class="text-gray-400">{t('tradoxvps.feature_stability_desc')}</p>
        </div>

        <div class="feature-card rounded-xl p-6">
          <div class="w-12 h-12 bg-purple-500/20 rounded-lg flex items-center justify-center mb-4">
            <i class="fa-solid fa-microchip text-2xl text-purple-400"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{t('tradoxvps.feature_hardware_title')}</h3>
          <p class="text-gray-400">{t('tradoxvps.feature_hardware_desc')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Hardware Specs Section -->
  <section class="py-16 px-4 bg-black/30">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">
          {t('tradoxvps.hardware_title_a')} <span class="gradient-text-orange">{t('tradoxvps.hardware_title_highlight')}</span> {t('tradoxvps.hardware_title_b')}
        </h2>
        <p class="text-gray-300 text-lg max-w-3xl mx-auto">
          {t('tradoxvps.hardware_subtitle')}
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto mb-12">
        <div class="bg-gradient-to-br from-orange-900/20 to-orange-800/10 border border-orange-500/30 rounded-2xl p-8 text-center">
          <div class="w-16 h-16 bg-orange-500/20 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-microchip text-3xl text-orange-400"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{t('tradoxvps.spec_cpu_title')}</h3>
          <p class="text-gray-400 text-sm">{t('tradoxvps.spec_cpu_desc')}</p>
        </div>

        <div class="bg-gradient-to-br from-blue-900/20 to-blue-800/10 border border-blue-500/30 rounded-2xl p-8 text-center">
          <div class="w-16 h-16 bg-blue-500/20 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-memory text-3xl text-blue-400"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{t('tradoxvps.spec_ram_title')}</h3>
          <p class="text-gray-400 text-sm">{t('tradoxvps.spec_ram_desc')}</p>
        </div>

        <div class="bg-gradient-to-br from-green-900/20 to-green-800/10 border border-green-500/30 rounded-2xl p-8 text-center">
          <div class="w-16 h-16 bg-green-500/20 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-hard-drive text-3xl text-green-400"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{t('tradoxvps.spec_ssd_title')}</h3>
          <p class="text-gray-400 text-sm">{t('tradoxvps.spec_ssd_desc')}</p>
        </div>
      </div>

      <!-- IBKR Advantages -->
      <div class="bg-gradient-to-br from-blue-900/20 to-blue-800/10 border border-blue-500/30 rounded-2xl p-8 max-w-4xl mx-auto">
        <h3 class="text-2xl font-bold mb-6 text-center">{t('tradoxvps.advantages_title_a')} <span class="gradient-text">{t('tradoxvps.advantages_title_highlight')}</span></h3>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
              <i class="fa-solid fa-signal text-sm text-blue-400"></i>
            </div>
            <div>
              <h4 class="font-bold mb-1">{t('tradoxvps.advantage_connectivity_title')}</h4>
              <p class="text-gray-400 text-sm">{t('tradoxvps.advantage_connectivity_desc')}</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 bg-purple-500/20 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
              <i class="fa-solid fa-gears text-sm text-purple-400"></i>
            </div>
            <div>
              <h4 class="font-bold mb-1">{t('tradoxvps.advantage_optimized_title')}</h4>
              <p class="text-gray-400 text-sm">{t('tradoxvps.advantage_optimized_desc')}</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 bg-green-500/20 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
              <i class="fa-solid fa-chart-line text-sm text-green-400"></i>
            </div>
            <div>
              <h4 class="font-bold mb-1">{t('tradoxvps.advantage_peak_title')}</h4>
              <p class="text-gray-400 text-sm">{t('tradoxvps.advantage_peak_desc')}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trading VPS use cases -->
  <section class="py-16 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-10 text-center">{t('tradoxvps.s33_h2')}</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="feature-card rounded-xl p-6">
          <h3 class="text-lg font-bold mb-2 text-white">{t('tradoxvps.s33_card1_title')}</h3>
          <p class="text-gray-400 text-sm">{t('tradoxvps.s33_card1_desc')}</p>
        </div>
        <div class="feature-card rounded-xl p-6">
          <h3 class="text-lg font-bold mb-2 text-white">{t('tradoxvps.s33_card2_title')}</h3>
          <p class="text-gray-400 text-sm">
            {t('tradoxvps.s33_card2_desc')}
            <a href="https://pickmytrade.trade/tradingview-to-tradovate/" class="text-blue-400 hover:text-blue-300 font-semibold">{t('tradoxvps.outbound_tv_tradovate')}</a>.
          </p>
        </div>
        <div class="feature-card rounded-xl p-6">
          <h3 class="text-lg font-bold mb-2 text-white">{t('tradoxvps.s33_card3_title')}</h3>
          <p class="text-gray-400 text-sm">
            {t('tradoxvps.s33_card3_desc')}
            <a href="https://pickmytrade.io/broker/tradingview-to-rithmic/" class="text-blue-400 hover:text-blue-300 font-semibold">{t('tradoxvps.outbound_tv_rithmic')}</a>.
          </p>
        </div>
        <div class="feature-card rounded-xl p-6">
          <h3 class="text-lg font-bold mb-2 text-white">{t('tradoxvps.s33_card4_title')}</h3>
          <p class="text-gray-400 text-sm">
            {t('tradoxvps.s33_card4_desc')}
            <a href="https://pickmytrade.trade/tradingview-automation/" class="text-blue-400 hover:text-blue-300 font-semibold">{t('tradoxvps.outbound_tv_automation')}</a>.
          </p>
        </div>
        <div class="feature-card rounded-xl p-6">
          <h3 class="text-lg font-bold mb-2 text-white">{t('tradoxvps.s33_card5_title')}</h3>
          <p class="text-gray-400 text-sm">{t('tradoxvps.s33_card5_desc')}</p>
        </div>
        <div class="feature-card rounded-xl p-6">
          <h3 class="text-lg font-bold mb-2 text-white">{t('tradoxvps.s33_card6_title')}</h3>
          <p class="text-gray-400 text-sm">{t('tradoxvps.s33_card6_desc')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TradoxVPS: plans, specs and setup -->
  <section class="py-16 px-4 bg-black/30">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-6 text-center">{t('tradoxvps.s34_h2')}</h2>
      <p class="text-gray-300 text-lg leading-relaxed mb-6">{t('tradoxvps.s34_p1')}</p>
      <p class="text-gray-300 text-lg mb-4 font-semibold">{t('tradoxvps.s34_steps_intro')}</p>
      <ol class="space-y-3 text-gray-300 list-decimal list-inside mb-6">
        <li>{t('tradoxvps.s34_step1')}</li>
        <li>{t('tradoxvps.s34_step2')}</li>
        <li>{t('tradoxvps.s34_step3')}</li>
        <li>{t('tradoxvps.s34_step4')}</li>
        <li>{t('tradoxvps.s34_step5')}</li>
      </ol>
      <p class="text-gray-400 text-sm border-t border-white/10 pt-6">{t('tradoxvps.s34_pricing_note')}</p>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="py-20 px-4 relative overflow-hidden">
    <!-- Background decorative elements -->
    <div class="absolute top-0 left-0 w-full h-full opacity-10">
      <div class="absolute top-20 left-10 w-72 h-72 bg-blue-500 rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-orange-500 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-6xl mx-auto relative z-10">
      <div class="text-center mb-16">
        <div class="inline-block mb-4">
          <span class="bg-gradient-to-r from-blue-500/20 to-orange-500/20 border border-blue-500/30 text-blue-400 px-6 py-2 rounded-full text-sm font-semibold uppercase tracking-wide">
            {t('tradoxvps.process_badge')}
          </span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold mb-4">
