---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalePaths, localizedPath, useTranslations, absoluteLocalizedPath } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const schema1 = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "image": "https://pickmytrade.io/assets/logo.png",
    "name": "PickMyTrade - TrendSpider to Broker Automation",
    "alternateName": "TrendSpider Trading Bot",
    "description": "Automated trading system connecting TrendSpider alerts to your broker. Full support for dynamic alerts, multi-factor alerts, AI-powered analysis, and automated pattern detection.",
    "url": absoluteLocalizedPath(locale, 'trendspider'),
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web-based, Windows, Mac, Linux",
    "keywords": "trendspider automated trading, trendspider trading bot, trendspider alerts automation, ai trading, dynamic alerts",
    "offers": {
      "@type": "Offer",
      "price": "50.00",
      "priceCurrency": "USD",
      "priceValidUntil": "2026-12-31",
      "availability": "https://schema.org/InStock",
      "description": "7-day free trial, no credit card required"
    },
    "publisher": {
      "@type": "Organization",
      "name": "PickMyTrade",
      "url": "https://pickmytrade.io",
      "logo": {
        "@type": "ImageObject",
        "url": "https://pickmytrade.io/assets/logo.png"
      }
    },
    "featureList": [
      "TrendSpider Alert Integration",
      "Dynamic Alert Support",
      "Multi-Factor Alert Automation",
      "AI-Powered Technical Analysis",
      "Candlestick Pattern Detection",
      "Automated Order Execution",
      "Multi-Broker Support",
      "Real-time Trading",
      "No Coding Required"
    ]
  };

const schema2 = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1","h2",".faq-question",".faq-answer","summary","details > div","details > p"] },
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is TrendSpider and how does it work with PickMyTrade?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "TrendSpider is an AI-powered technical analysis platform with advanced charting and automated alert capabilities. PickMyTrade connects to TrendSpider via webhooks to automatically execute trades based on your alerts."
        }
      },
      {
        "@type": "Question",
        "name": "What types of TrendSpider alerts can I automate?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "You can automate dynamic alerts (moving averages, trendlines, support/resistance), multi-factor alerts (combining multiple indicators), and candlestick pattern detection alerts."
        }
      },
      {
        "@type": "Question",
        "name": "Which brokers are supported for TrendSpider automation?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "PickMyTrade supports Rithmic, Interactive Brokers, TradeStation, TradeLocker, ProjectX, and more. Connect your TrendSpider alerts to any supported broker."
        }
      },
      {
        "@type": "Question",
        "name": "Is coding required to set up TrendSpider automated trading?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No coding is required. PickMyTrade provides a no-code solution for automating your TrendSpider alerts to your broker, making it accessible for traders of all technical levels."
        }
      }
    ]
  };

const schema3 = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://pickmytrade.io"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "TrendSpider to Broker Automation",
        "item": absoluteLocalizedPath(locale, 'trendspider')
      }
    ]
  };
---
<BaseLayout
  locale={locale}
  title={t('trendspider.page_title')}
  description={t('trendspider.page_description')}
  keywords={t('trendspider.page_keywords')}
  structuredData={[schema1, schema2, schema3]}
>
<nav aria-label="Breadcrumb" class="bg-[#001429] pt-20 pb-3 sm:pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-5">
      <ol class="flex items-center flex-wrap gap-2 text-xs sm:text-sm text-gray-400" itemscope
        itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={localizedPath(locale, '')} class="hover:text-[#2B77EE] transition" itemprop="item">
            <span itemprop="name">{t('trendspider.breadcrumb_home')}</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="text-gray-600">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="text-white font-semibold" itemprop="name">{t('trendspider.breadcrumb_current')}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- HERO SECTION -->
  <header class="relative overflow-hidden bg-gradient-to-b from-[#001429] via-[#001f3f] to-[#002040]">
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#001429]/30 to-[#002040]"></div>

    <!-- Content Container -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-32 pb-20 sm:pb-28">
      <div class="text-center" data-aos="fade-up" data-aos-duration="800">

        <!-- Top Badge -->
        <div
          class="inline-flex items-center gap-2 mb-6 sm:mb-8 bg-gradient-to-r from-[#0F3EC3]/20 to-[#2B77EE]/20 backdrop-blur-sm border border-[#2B77EE]/30 rounded-full px-4 sm:px-6 py-2 sm:py-3"
          data-aos="fade-down" data-aos-delay="100">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#2B77EE] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#2B77EE]"></span>
          </span>
          <span class="text-xs sm:text-sm font-semibold text-[#7FB8F9] uppercase tracking-wider electrolize-regular">
            {t('trendspider.hero_badge')}
          </span>
          <i class="fa-solid fa-check-circle text-[#2B77EE]" aria-hidden="true"></i>
        </div>

        <!-- TrendSpider Logo -->
        <div class="flex justify-center mb-8" data-aos="fade-up" data-aos-delay="150">
          <img src="/assets/TrendSpider.webp" alt={t('trendspider.hero_logo_alt')}
            class="h-16 sm:h-20 md:h-24 w-auto object-contain brightness-0 invert" width="993" height="126" loading="lazy" decoding="async">
        </div>

        <!-- Main Heading -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold mb-6 sm:mb-8 leading-tight"
          data-aos="fade-up" data-aos-delay="200">
          <!-- <span class="block text-white mb-2">to Broker</span> -->
          <span class="block bg-gradient-to-r from-[#2B77EE] via-[#4B94FF] to-[#7FB8F9] bg-clip-text text-transparent">
            {t('trendspider.hero_title')}
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="max-w-3xl mx-auto text-base sm:text-lg md:text-xl lg:text-2xl text-gray-300 mb-8 sm:mb-10 leading-relaxed px-4"
          data-aos="fade-up" data-aos-delay="300">
          {t('trendspider.hero_subtitle_a')} <strong class="text-white">{t('trendspider.hero_subtitle_strong1')}</strong> {t('trendspider.hero_subtitle_b')} <strong
            class="text-white">{t('trendspider.hero_subtitle_strong2')}</strong> {t('trendspider.hero_subtitle_c')}
          <span class="block mt-2 text-[#7FB8F9]">{t('trendspider.hero_subtitle_line2')}</span>
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-10 sm:mb-12 px-4" data-aos="fade-up"
          data-aos-delay="400">
          <a href="https://app.pickmytrade.io/?register=true" rel="noopener" aria-label={t('trendspider.hero_cta_primary_aria')}
            class="group relative inline-flex items-center justify-center px-8 py-4 text-base sm:text-lg font-semibold text-white bg-gradient-to-r from-[#0F3EC3] to-[#2B77EE] rounded-xl overflow-hidden shadow-lg hover:shadow-[0_0_30px_5px_rgba(43,119,238,0.5)] transition-all duration-300 w-full sm:w-auto electrolize-regular">
            <span
              class="absolute inset-0 w-full h-full bg-gradient-to-r from-[#2B77EE] to-[#0F3EC3] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
            <span class="relative flex items-center gap-2">
              <i class="fa-solid fa-rocket" aria-hidden="true"></i>
              {t('trendspider.hero_cta_primary')}
            </span>
          </a>

          <a href="https://trendspider.com?_go=pmt" target="_blank" rel="noopener" aria-label={t('trendspider.hero_cta_secondary_aria')}
            class="group inline-flex items-center justify-center px-8 py-4 text-base sm:text-lg font-semibold text-[#2B77EE] bg-white/10 backdrop-blur-sm border-2 border-[#2B77EE]/50 rounded-xl hover:bg-white/20 hover:border-[#2B77EE] transition-all duration-300 w-full sm:w-auto electrolize-regular">
            <span class="flex items-center gap-2">
              <i class="fa-solid fa-external-link" aria-hidden="true"></i>
              {t('trendspider.hero_cta_secondary')}
            </span>
          </a>
        </div>

        <!-- Feature Pills -->
        <div class="flex flex-wrap justify-center gap-3 sm:gap-4 md:gap-6 text-sm sm:text-base" data-aos="fade-up"
          data-aos-delay="500">
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-check-circle text-green-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('trendspider.pill_trial')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-credit-card text-blue-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('trendspider.pill_no_card')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-robot text-purple-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('trendspider.pill_ai')}</span>
          </div>
          <div
            class="flex items-center gap-2 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-all">
            <i class="fa-solid fa-bolt text-yellow-400" aria-hidden="true"></i>
            <span class="text-gray-300">{t('trendspider.pill_instant')}</span>
          </div>
        </div>

        <!-- Trust Indicators -->
        <div class="mt-12 sm:mt-16 pt-8 border-t border-white/10" data-aos="fade-up" data-aos-delay="600">
          <p class="text-xs sm:text-sm text-gray-400 mb-4 uppercase tracking-wider">{t('trendspider.trust_label')}</p>
          <div class="flex flex-wrap justify-center items-center gap-8 sm:gap-12">
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">{t('trendspider.trust_rating_value')}</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('trendspider.trust_rating_label')}</div>
            </div>
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">{t('trendspider.trust_uptime_value')}</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('trendspider.trust_uptime_label')}</div>
            </div>
            <div class="text-center">
              <div class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#2B77EE] electrolize-regular">{t('trendspider.trust_setup_value')}</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{t('trendspider.trust_setup_label')}</div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Wave Transition -->
    <div class="absolute bottom-0 left-0 right-0 z-20">
      <svg class="w-full h-16 sm:h-20 md:h-24" viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="none">
        <path
          d="M0,64L48,69.3C96,75,192,85,288,80C384,75,480,53,576,48C672,43,768,53,864,64C960,75,1056,85,1152,80C1248,75,1344,53,1392,42.7L1440,32L1440,120L1392,120C1344,120,1248,120,1152,120C1056,120,960,120,864,120C768,120,672,120,576,120C480,120,384,120,288,120C192,120,96,120,48,120L0,120Z"
          fill="url(#wave-gradient)" />
        <defs>
          <linearGradient id="wave-gradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#002040" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#002040" stop-opacity="1" />
          </linearGradient>
        </defs>
      </svg>
    </div>
  </header>

  <!-- Features Section -->
  <section id="features" class="relative py-16 sm:py-24 px-4 sm:px-5 bg-gradient-to-b from-[#002040] via-[#001429] to-[#002040] overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-20 left-10 w-72 h-72 bg-[#2B77EE] rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-[#0F3EC3] rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="text-center mb-12 sm:mb-16" data-aos="fade-up">
        <div
          class="inline-flex items-center gap-2 mb-4 bg-gradient-to-r from-[#0F3EC3]/20 to-[#2B77EE]/20 backdrop-blur-sm border border-[#2B77EE]/30 rounded-full px-4 py-2">
          <i class="fa-solid fa-star text-[#2B77EE]"></i>
          <span class="text-sm font-semibold text-[#7FB8F9] uppercase tracking-wider">{t('trendspider.features_badge')}</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 electrolize-regular">
          <span class="bg-gradient-to-r from-white via-gray-200 to-white bg-clip-text text-transparent">
            {t('trendspider.features_title')}
          </span>
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        <div class="group bg-[#001429]/50 rounded-xl p-6 border border-[#2B77EE]/30 hover:border-[#2B77EE] transition-all duration-300 hover:bg-[#001429]/80" data-aos="fade-up">
          <div class="text-4xl mb-4 text-[#2B77EE] group-hover:scale-110 transition-transform duration-300">
            <i class="fa-solid fa-chart-line"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 text-white">{t('trendspider.feature_dynamic_title')}</h3>
          <p class="text-gray-400">{t('trendspider.feature_dynamic_desc')}</p>
        </div>

        <div class="group bg-[#001429]/50 rounded-xl p-6 border border-[#2B77EE]/30 hover:border-[#2B77EE] transition-all duration-300 hover:bg-[#001429]/80" data-aos="fade-up" data-aos-delay="100">
          <div class="text-4xl mb-4 text-[#2B77EE] group-hover:scale-110 transition-transform duration-300">
            <i class="fa-solid fa-layer-group"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 text-white">{t('trendspider.feature_multifactor_title')}</h3>
          <p class="text-gray-400">{t('trendspider.feature_multifactor_desc')}</p>
        </div>

        <div class="group bg-[#001429]/50 rounded-xl p-6 border border-[#2B77EE]/30 hover:border-[#2B77EE] transition-all duration-300 hover:bg-[#001429]/80" data-aos="fade-up" data-aos-delay="200">
          <div class="text-4xl mb-4 text-[#2B77EE] group-hover:scale-110 transition-transform duration-300">
            <i class="fa-solid fa-fire"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 text-white">{t('trendspider.feature_candlestick_title')}</h3>
          <p class="text-gray-400">{t('trendspider.feature_candlestick_desc')}</p>
        </div>

        <div class="group bg-[#001429]/50 rounded-xl p-6 border border-[#2B77EE]/30 hover:border-[#2B77EE] transition-all duration-300 hover:bg-[#001429]/80" data-aos="fade-up">
          <div class="text-4xl mb-4 text-[#2B77EE] group-hover:scale-110 transition-transform duration-300">
            <i class="fa-solid fa-brain"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 text-white">{t('trendspider.feature_ai_title')}</h3>
          <p class="text-gray-400">{t('trendspider.feature_ai_desc')}</p>
        </div>

        <div class="group bg-[#001429]/50 rounded-xl p-6 border border-[#2B77EE]/30 hover:border-[#2B77EE] transition-all duration-300 hover:bg-[#001429]/80" data-aos="fade-up" data-aos-delay="100">
          <div class="text-4xl mb-4 text-[#2B77EE] group-hover:scale-110 transition-transform duration-300">
            <i class="fa-solid fa-cloud"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 text-white">{t('trendspider.feature_cloud_title')}</h3>
          <p class="text-gray-400">{t('trendspider.feature_cloud_desc')}</p>
        </div>

        <div class="group bg-[#001429]/50 rounded-xl p-6 border border-[#2B77EE]/30 hover:border-[#2B77EE] transition-all duration-300 hover:bg-[#001429]/80" data-aos="fade-up" data-aos-delay="200">
          <div class="text-4xl mb-4 text-[#2B77EE] group-hover:scale-110 transition-transform duration-300">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <h3 class="text-xl font-bold mb-3 text-white">{t('trendspider.feature_instant_title')}</h3>
          <p class="text-gray-400">{t('trendspider.feature_instant_desc')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section id="howitworks" class="relative py-16 sm:py-24 px-4 sm:px-5 bg-[#001429] overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-10 right-20 w-64 h-64 bg-[#2B77EE] rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="text-center mb-12 sm:mb-16" data-aos="fade-up">
        <div
          class="inline-flex items-center gap-2 mb-4 bg-gradient-to-r from-[#0F3EC3]/20 to-[#2B77EE]/20 backdrop-blur-sm border border-[#2B77EE]/30 rounded-full px-4 py-2">
          <i class="fa-solid fa-cogs text-[#2B77EE]"></i>
          <span class="text-sm font-semibold text-[#7FB8F9] uppercase tracking-wider">{t('trendspider.howitworks_badge')}</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 electrolize-regular">
          <span class="bg-gradient-to-r from-white via-gray-200 to-white bg-clip-text text-transparent">
            {t('trendspider.howitworks_title')}
          </span>
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8 sm:gap-12">
        <div class="text-center group" data-aos="fade-up">
          <div class="relative w-20 h-20 sm:w-24 sm:h-24 bg-gradient-to-br from-[#0F3EC3] to-[#2B77EE] rounded-full flex items-center justify-center text-3xl sm:text-4xl font-bold text-white mx-auto mb-6 group-hover:scale-110 transition-transform duration-300 shadow-lg shadow-[#2B77EE]/50">
            <div class="absolute inset-0 rounded-full bg-gradient-to-br from-[#2B77EE] to-[#0F3EC3] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <span class="relative">1</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold mb-4 text-white">{t('trendspider.step1_title')}</h3>
          <p class="text-gray-400">{t('trendspider.step1_desc')}</p>
        </div>

        <div class="text-center group" data-aos="fade-up" data-aos-delay="100">
          <div class="relative w-20 h-20 sm:w-24 sm:h-24 bg-gradient-to-br from-[#0F3EC3] to-[#2B77EE] rounded-full flex items-center justify-center text-3xl sm:text-4xl font-bold text-white mx-auto mb-6 group-hover:scale-110 transition-transform duration-300 shadow-lg shadow-[#2B77EE]/50">
            <div class="absolute inset-0 rounded-full bg-gradient-to-br from-[#2B77EE] to-[#0F3EC3] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <span class="relative">2</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold mb-4 text-white">{t('trendspider.step2_title')}</h3>
          <p class="text-gray-400">{t('trendspider.step2_desc')}</p>
        </div>

        <div class="text-center group" data-aos="fade-up" data-aos-delay="200">
          <div class="relative w-20 h-20 sm:w-24 sm:h-24 bg-gradient-to-br from-[#0F3EC3] to-[#2B77EE] rounded-full flex items-center justify-center text-3xl sm:text-4xl font-bold text-white mx-auto mb-6 group-hover:scale-110 transition-transform duration-300 shadow-lg shadow-[#2B77EE]/50">
            <div class="absolute inset-0 rounded-full bg-gradient-to-br from-[#2B77EE] to-[#0F3EC3] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <span class="relative">3</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold mb-4 text-white">{t('trendspider.step3_title')}</h3>
          <p class="text-gray-400">{t('trendspider.step3_desc')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section id="faq" class="relative py-16 sm:py-24 px-4 sm:px-5 bg-gradient-to-b from-[#002040] via-[#001429] to-[#002040] overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-1/3 right-20 w-80 h-80 bg-[#2B77EE] rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/3 left-20 w-96 h-96 bg-[#0F3EC3] rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto">
      <div class="text-center mb-12 sm:mb-16" data-aos="fade-up">
        <div
