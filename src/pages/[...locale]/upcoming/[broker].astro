---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalePaths, localizedPath, useTranslations, absoluteLocalizedPath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';
import upcomingBrokersData from '../../../../config/upcoming-brokers.json';
import liveBrokersData from '../../../../config/brokers.json';

interface UpcomingBroker {
  slug: string;
  name: string;
  logo: string;
  category: keyof typeof upcomingBrokersData.categories;
  subtitle: string;
}

export function getStaticPaths() {
  return getLocalePaths().flatMap(({ params, props }) =>
    (upcomingBrokersData.brokers as UpcomingBroker[]).map((broker) => ({
      params: { locale: params.locale, broker: broker.slug },
      props: { locale: props.locale, broker },
    }))
  );
}

// Maps each wait-list category to broker connections that are live today —
// surfaced on the page so it isn't just a template with the name swapped out,
// and so users who don't want to wait have a real, working alternative.
const CATEGORY_TO_LIVE_SLUGS: Record<string, string[]> = {
  stocks: ['tradingview-to-ib', 'tradingview-to-tradestation', 'tradingview-to-tradier'],
  futures: ['tradingview-to-rithmic', 'tradingview-to-projectx'],
  forex: ['tradingview-to-matchtrader', 'tradingview-to-tradelocker'],
  propfirm: ['tradingview-to-topstepx'],
  ai: ['tradingview-to-rithmic', 'tradingview-to-ib'],
};

const { locale, broker } = Astro.props as { locale: Locale; broker: UpcomingBroker };
const t = useTranslations(locale);
const category = upcomingBrokersData.categories[broker.category];

const liveAlternatives = (CATEGORY_TO_LIVE_SLUGS[broker.category] ?? [])
  .map((slug) => liveBrokersData.brokers.find((b) => b.slug === slug))
  .filter((b): b is NonNullable<typeof b> => Boolean(b))
  .slice(0, 3);

const pageTitle = t('broker_upcoming.page_title', { name: broker.name });
const pageDescription = t('broker_upcoming.page_description', { name: broker.name });
const pageKeywords = t('broker_upcoming.page_keywords', { name: broker.name });
const canonicalUrl = `https://pickmytrade.io${localizedPath(locale, `upcoming/${broker.slug}`)}`;

const schema1 = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": pageTitle,
  "url": canonicalUrl,
  "description": pageDescription,
  "publisher": {
    "@type": "Organization",
    "name": "PickMyTrade",
    "url": "https://pickmytrade.io"
  }
};

const schema2 = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://pickmytrade.io/" },
    { "@type": "ListItem", "position": 2, "name": "Upcoming Brokers", "item": absoluteLocalizedPath(locale, 'upcoming/brokers') },
    { "@type": "ListItem", "position": 3, "name": broker.name, "item": canonicalUrl }
  ]
};

const faqItems = [
  { q: t('broker_upcoming.faq_q1', { name: broker.name }), a: t('broker_upcoming.faq_a1', { name: broker.name }) },
  { q: t('broker_upcoming.faq_q2', { name: broker.name }), a: t('broker_upcoming.faq_a2', { name: broker.name }) },
  { q: t('broker_upcoming.faq_q3'), a: t('broker_upcoming.faq_a3') },
];

const schema3 = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
};

// ---------------------------------------------------------------------------
// Indexation of the /upcoming/* family (43 brokers x 5 locales = 215 URLs).
//
// These pages advertise integrations that do not exist yet: every one states in
// its own FAQ that the broker "is coming soon", the bodies are ~400 words of
// heavily-templated copy differing mainly by broker name, and the only action
// is a waitlist signup. Indexing them puts near-duplicate pages that cannot
// deliver the advertised functionality into results for commercial-intent
// queries — the doorway-page pattern, and a scaled-content-abuse risk for the
// whole domain under the Sept 2025 QRG.
//
// They stay live, linked from /upcoming/brokers, and keep capturing waitlist
// demand; they are simply not offered to search until the integration ships.
// Flip this to false (or make it per-broker) when that happens.
// ---------------------------------------------------------------------------
const NOINDEX_UPCOMING = true;
const robots = NOINDEX_UPCOMING ? 'noindex, follow' : undefined;
---
<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonical={canonicalUrl}
  robots={robots}
  structuredData={[schema1, schema2, schema3]}
>
  <nav aria-label="Breadcrumb" class="bg-[#001429] pt-20 pb-3 sm:pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-5">
      <ol class="flex items-center flex-wrap gap-2 text-xs sm:text-sm text-gray-400" itemscope
        itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={localizedPath(locale, '')} class="hover:text-[#2B77EE] transition" itemprop="item">
            <span itemprop="name">{t('broker_upcoming.breadcrumb_home')}</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="text-gray-600">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={localizedPath(locale, 'upcoming/brokers')} class="hover:text-[#2B77EE] transition" itemprop="item">
            <span itemprop="name">{t('broker_upcoming.breadcrumb_upcoming')}</span>
          </a>
          <meta itemprop="position" content="2" />
        </li>
        <li class="text-gray-600">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="text-white font-semibold" itemprop="name">{broker.name}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- HERO SECTION -->
  <section class="pt-16 pb-16 px-6 text-center relative overflow-hidden bg-gradient-to-b from-[#001429] to-[#00193a]">
    <div class="absolute inset-0 opacity-10 pointer-events-none">
      <div class="absolute top-10 left-1/4 w-96 h-96 bg-blue-500 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-purple-500 rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-3xl mx-auto" data-aos="fade-up">
      <div class="w-20 h-20 mx-auto rounded-2xl bg-white flex items-center justify-center p-3 shadow-lg mb-6">
        <img
          src={broker.logo}
          alt={`${broker.name} logo`}
          class="max-w-full max-h-full object-contain"
          width="56"
          height="56"
          loading="eager"
          decoding="async"
          onerror={"this.src='/assets/logo.webp'"}
        />
      </div>

      <div class="flex items-center justify-center flex-wrap gap-2 mb-6">
        <span class="inline-flex items-center gap-2 bg-blue-500/15 border border-blue-500/30 px-4 py-1.5 rounded-full text-xs tracking-widest font-semibold text-blue-400 electrolize-regular">
          <i class="fa-solid fa-hourglass-half"></i> {t('broker_upcoming.hero_coming_soon')}
        </span>
        <span class={`inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold border border-white/10 bg-white/5 ${category.color}`}>
          <i class={`fa-solid ${category.icon}`}></i> {category.label}
        </span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-5">
        {t('broker_upcoming.hero_title')} <span class="bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">{broker.name}</span>
      </h1>
      <p class="max-w-xl mx-auto text-gray-300 text-lg leading-relaxed">
        {broker.subtitle}
      </p>
    </div>
  </section>

  <!-- CATEGORY INTRO -->
  <section class="pb-10 sm:pb-14 px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto text-center" data-aos="fade-up">
    <p class="text-gray-300 leading-relaxed">{t(`broker_upcoming.category_intro.${broker.category}`)}</p>
  </section>

  <!-- HOW TO USE -->
  <section class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <div class="text-center mb-12" data-aos="fade-up">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">{t('broker_upcoming.how_to_use_title')}</h2>
      <p class="text-gray-300 max-w-2xl mx-auto leading-relaxed">{t('broker_upcoming.how_to_use_description')}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <!-- Step 1 -->
      <div class="group flex flex-col bg-white/[0.03] border border-white/10 rounded-2xl p-6 hover:border-[#2B77EE]/50 hover:bg-white/[0.06] transition-all duration-300" data-aos="fade-up">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-xl bg-[#2B77EE]/15 border border-[#2B77EE]/30 flex items-center justify-center text-[#2B77EE] text-lg">
            <i class="fa-solid fa-user-plus"></i>
          </div>
          <span class="text-xs font-bold text-blue-400/70 electrolize-regular tracking-widest">STEP 01</span>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">{t('broker_upcoming.step_signup_title')}</h3>
        <p class="text-sm text-gray-400 leading-relaxed mb-6 flex-1">{t('broker_upcoming.step_signup_description')}</p>
        <a href="https://app.pickmytrade.io/?register=true" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-[#2B77EE] hover:bg-[#1e5fc9] rounded-xl font-semibold text-white transition-all">
          {t('broker_upcoming.step_signup_button')} <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
        </a>
      </div>

      <!-- Step 2 -->
      <div class="group flex flex-col bg-white/[0.03] border border-white/10 rounded-2xl p-6 hover:border-[#2B77EE]/50 hover:bg-white/[0.06] transition-all duration-300" data-aos="fade-up" data-aos-delay="100">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-xl bg-[#2B77EE]/15 border border-[#2B77EE]/30 flex items-center justify-center text-[#2B77EE] text-lg">
            <i class="fa-solid fa-link"></i>
          </div>
          <span class="text-xs font-bold text-blue-400/70 electrolize-regular tracking-widest">STEP 02</span>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">{t('broker_upcoming.step_connect_broker_title')}</h3>
        <p class="text-sm text-gray-400 leading-relaxed mb-6 flex-1">{t('broker_upcoming.step_connect_broker_description', { name: broker.name })}</p>
        <a href="https://app.pickmytrade.io/?register=true" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-[#2B77EE] hover:bg-[#1e5fc9] rounded-xl font-semibold text-white transition-all">
          {t('broker_upcoming.step_connect_broker_button')} <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
        </a>
      </div>

      <!-- Step 3 -->
      <div class="group flex flex-col bg-white/[0.03] border border-white/10 rounded-2xl p-6 hover:border-[#2B77EE]/50 hover:bg-white/[0.06] transition-all duration-300" data-aos="fade-up">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-xl bg-[#2B77EE]/15 border border-[#2B77EE]/30 flex items-center justify-center text-[#2B77EE] text-lg">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <span class="text-xs font-bold text-blue-400/70 electrolize-regular tracking-widest">STEP 03</span>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">{t('broker_upcoming.step_generate_alert_title')}</h3>
        <p class="text-sm text-gray-400 leading-relaxed mb-6 flex-1">
          {t('broker_upcoming.step_generate_alert_description')} <b class="text-gray-300">{t('broker_upcoming.step_generate_alert_strong')}</b>.
        </p>
        <a href="https://app.pickmytrade.io/?register=true" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-[#2B77EE] hover:bg-[#1e5fc9] rounded-xl font-semibold text-white transition-all">
          {t('broker_upcoming.step_generate_alert_button')} <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
        </a>
      </div>

      <!-- Step 4 -->
      <div class="group flex flex-col bg-white/[0.03] border border-white/10 rounded-2xl p-6 hover:border-[#2B77EE]/50 hover:bg-white/[0.06] transition-all duration-300" data-aos="fade-up" data-aos-delay="100">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-xl bg-[#2B77EE]/15 border border-[#2B77EE]/30 flex items-center justify-center text-[#2B77EE] text-lg">
            <i class="fa-solid fa-chart-line"></i>
          </div>
          <span class="text-xs font-bold text-blue-400/70 electrolize-regular tracking-widest">STEP 04</span>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">{t('broker_upcoming.step_connect_tradingview_title')}</h3>
        <p class="text-sm text-gray-400 leading-relaxed mb-6 flex-1">{t('broker_upcoming.step_connect_tradingview_description')}</p>
        <a href="https://www.tradingview.com/" target="_blank" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-[#2B77EE] hover:bg-[#1e5fc9] rounded-xl font-semibold text-white transition-all">
          {t('broker_upcoming.step_connect_tradingview_button')} <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- LIVE ALTERNATIVES -->
  {liveAlternatives.length > 0 && (
    <section class="pb-16 sm:pb-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto" data-aos="fade-up">
      <div class="text-center mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold mb-3">{t('broker_upcoming.alternatives_title')}</h2>
        <p class="text-gray-300 max-w-2xl mx-auto leading-relaxed">{t('broker_upcoming.alternatives_description')}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {liveAlternatives.map((live) => (
          <a href={localizedPath(locale, `broker/${live.slug}`)} class="group flex flex-col bg-white/[0.03] border border-white/10 rounded-2xl p-5 hover:border-green-500/50 hover:bg-white/[0.06] transition-all duration-300">
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-green-400 bg-green-500/10 px-2.5 py-1 rounded-full w-fit mb-3">
              <i class="fa-solid fa-circle-check text-[10px]"></i> {t('broker_upcoming.alternatives_badge')}
            </span>
            <h3 class="text-lg font-bold text-white mb-1 group-hover:text-[#2B77EE] transition-colors">{live.name}</h3>
            <p class="text-sm text-gray-400 leading-relaxed mb-4 flex-1">{live.subtitle}</p>
            <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              {t('broker_upcoming.alternatives_cta')} <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="pb-16 sm:pb-20 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto" data-aos="fade-up">
    <h2 class="text-2xl sm:text-3xl font-bold text-center mb-8">{t('broker_upcoming.faq_title')}</h2>
    <div class="space-y-4">
      {faqItems.map((item) => (
        <details class="group bg-white/[0.03] border border-white/10 rounded-2xl p-5">
          <summary class="cursor-pointer font-semibold text-white flex items-center justify-between gap-4 list-none">
            {item.q}
            <i class="fa-solid fa-chevron-down text-xs text-gray-400 shrink-0 group-open:rotate-180 transition-transform"></i>
          </summary>
          <p class="text-sm text-gray-400 leading-relaxed mt-3">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- NOTIFY CTA -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto text-center" data-aos="fade-up">
    <div class="bg-gradient-to-r from-blue-600/20 to-purple-600/20 rounded-3xl p-12 border border-blue-500/30">
      <h2 class="text-3xl font-bold mb-4">{t('broker_upcoming.notify_title', { name: broker.name })}</h2>
      <p class="text-gray-300 mb-8 max-w-2xl mx-auto">
        {t('broker_upcoming.notify_description', { name: broker.name })}
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href={localizedPath(locale, 'page/contact')} class="px-8 py-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-xl font-semibold transition-all">
          {t('broker_upcoming.notify_button')}
        </a>
        <a href={localizedPath(locale, 'upcoming/brokers')} class="px-8 py-3 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 rounded-xl font-semibold shadow-lg shadow-blue-600/20 transition-all">
          {t('broker_upcoming.back_to_list_button')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
