---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalePaths, localizedPath, absoluteLocalizedPath, useTranslations } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';
import upcomingBrokersData from '../../../../config/upcoming-brokers.json';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

type CategoryKey = keyof typeof upcomingBrokersData.categories;

interface UpcomingBroker {
  slug: string;
  name: string;
  logo: string;
  category: CategoryKey;
  subtitle: string;
}

// Brokers on the connection wait list — support is in progress.
// Source of truth is config/upcoming-brokers.json, shared with the
// /upcoming/[broker] detail pages so the two never drift apart.
const brokers = upcomingBrokersData.brokers as UpcomingBroker[];
const categories = upcomingBrokersData.categories as Record<CategoryKey, { label: string; icon: string; color: string }>;
const categoryEntries = Object.entries(categories) as [CategoryKey, { label: string; icon: string; color: string }][];

const pageTitle = t('upcoming_brokers.page_title');
const pageDescription = t('upcoming_brokers.page_description');
const pageKeywords = t('upcoming_brokers.page_keywords');
const categoryLabel = (key: CategoryKey) => t(`upcoming_brokers.categories.${key}`);
const brokerSubtitle = (b: UpcomingBroker) => t(`upcoming_brokers.subtitles.${b.slug}` as Parameters<typeof t>[0]);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t('upcoming_brokers.breadcrumb_home'), "item": "https://pickmytrade.io/" },
    { "@type": "ListItem", "position": 2, "name": t('upcoming_brokers.breadcrumb_current'), "item": absoluteLocalizedPath(locale, 'upcoming/brokers') }
  ]
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": t('upcoming_brokers.schema_list_name'),
  "description": t('upcoming_brokers.schema_list_description'),
  "numberOfItems": brokers.length,
  "itemListOrder": "https://schema.org/ItemListUnordered",
  "itemListElement": brokers.map((b, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": b.name,
  })),
};
---
<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  structuredData={[breadcrumbSchema, itemListSchema]}
>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="bg-[#001429] pt-20 pb-3 sm:pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-5">
      <ol class="flex items-center flex-wrap gap-2 text-xs sm:text-sm text-gray-400">
        <li>
          <a href={localizedPath(locale, '')} class="hover:text-[#2B77EE] transition">{t('upcoming_brokers.breadcrumb_home')}</a>
        </li>
        <li class="text-gray-600">/</li>
        <li><span class="text-white font-semibold">{t('upcoming_brokers.breadcrumb_current')}</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="pt-16 pb-12 px-4 sm:px-6 lg:px-8 text-center relative overflow-hidden bg-gradient-to-b from-[#001429] to-[#00193a]">
    <div class="absolute inset-0 opacity-10 pointer-events-none">
      <div class="absolute top-10 left-1/4 w-96 h-96 bg-blue-500 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-purple-500 rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto" data-aos="fade-up">
      <div class="inline-flex items-center gap-2 bg-blue-500/15 border border-blue-500/30 px-5 py-2 rounded-full text-xs tracking-widest font-semibold text-blue-400 mb-6 electrolize-regular">
        <i class="fa-solid fa-hourglass-half"></i> {t('upcoming_brokers.hero_badge')}
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6">
        {t('upcoming_brokers.hero_title_1')} <span class="bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">{t('upcoming_brokers.hero_title_2')}</span>
      </h1>
      <p class="text-lg sm:text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed mb-8">
        {t('upcoming_brokers.hero_description')}
      </p>

      <!-- Stat strip -->
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
        <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2">
          <i class="fa-solid fa-building-columns text-[#2B77EE] text-sm"></i>
          <span class="text-white font-bold text-sm">{brokers.length}</span>
          <span class="text-gray-400 text-xs electrolize-regular tracking-wide">{t('upcoming_brokers.stat_brokers')}</span>
        </div>
        <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2">
          <i class="fa-solid fa-layer-group text-purple-400 text-sm"></i>
          <span class="text-white font-bold text-sm">{categoryEntries.length}</span>
          <span class="text-gray-400 text-xs electrolize-regular tracking-wide">{t('upcoming_brokers.stat_asset_classes')}</span>
        </div>
        <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2">
          <i class="fa-solid fa-arrow-trend-up text-green-400 text-sm"></i>
          <span class="text-gray-300 text-xs electrolize-regular tracking-wide">{t('upcoming_brokers.stat_growing')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Brokers Grid -->
  <section class="pb-20 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
    <!-- Search -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5" data-aos="fade-up">
      <div class="relative w-full sm:max-w-sm">
        <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-sm"></i>
        <input
          id="broker-search"
          type="text"
          placeholder={t('upcoming_brokers.search_placeholder')}
          autocomplete="off"
          class="w-full pl-11 pr-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-[#2B77EE] focus:ring-2 focus:ring-[#2B77EE]/30 transition"
        />
      </div>
      <p class="text-sm text-gray-400">
        <span id="broker-count" class="text-white font-semibold">{brokers.length}</span> {t('upcoming_brokers.count_suffix')}
      </p>
    </div>

    <!-- Category filter pills -->
    <div id="category-filters" class="flex flex-wrap gap-2 mb-8" data-aos="fade-up">
      <button
        type="button"
        data-filter-category="all"
        class="category-pill is-active px-4 py-2 rounded-full text-xs font-semibold border border-[#2B77EE] bg-[#2B77EE] text-white transition-all"
      >
        {t('upcoming_brokers.filter_all')} <span class="opacity-70">({brokers.length})</span>
      </button>
      {categoryEntries.map(([key, cat]) => {
        const count = brokers.filter((b) => b.category === key).length;
        return (
          <button
            type="button"
            data-filter-category={key}
            class="category-pill px-4 py-2 rounded-full text-xs font-semibold border border-white/10 bg-white/5 text-gray-400 hover:text-white hover:border-white/30 inline-flex items-center gap-1.5 transition-all"
          >
            <i class={`fa-solid ${cat.icon} ${cat.color}`}></i> {categoryLabel(key)} <span class="opacity-60">({count})</span>
          </button>
        );
      })}
    </div>

    <div id="broker-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {brokers.map((broker) => {
        const cat = categories[broker.category];
        return (
          <a
            href={localizedPath(locale, `upcoming/${broker.slug}`)}
            class="broker-card group relative flex flex-col gap-4 bg-white/[0.03] border border-white/10 rounded-2xl p-5 hover:border-[#2B77EE]/50 hover:bg-white/[0.06] hover:-translate-y-1 hover:shadow-lg hover:shadow-blue-500/10 transition-all duration-300"
            data-name={broker.name.toLowerCase()}
            data-category={broker.category}
          >
            <div class="flex items-center gap-3">
              <div class="shrink-0 w-14 h-14 rounded-xl bg-white flex items-center justify-center p-2.5 shadow-sm">
                <img
                  src={broker.logo}
                  alt={t('upcoming_brokers.logo_alt', { name: broker.name })}
                  class="max-w-full max-h-full object-contain"
                  width="48"
                  height="48"
                  loading="lazy"
                  decoding="async"
                  onerror={"this.src='/assets/logo.webp'"}
                />
              </div>
              <div class="min-w-0 flex-1">
                <span class="block font-bold text-white text-lg truncate group-hover:text-[#2B77EE] transition-colors">{broker.name}</span>
                <span class={`inline-flex items-center gap-1.5 text-[11px] font-semibold ${cat.color}`}>
                  <i class={`fa-solid ${cat.icon} text-[10px]`}></i> {categoryLabel(broker.category)}
                </span>
              </div>
            </div>

            <p class="text-sm text-gray-400 leading-relaxed line-clamp-2">{brokerSubtitle(broker)}</p>

            <div class="flex items-center justify-between pt-3 border-t border-white/5 mt-auto">
              <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-blue-400/90 bg-blue-500/10 px-2.5 py-1 rounded-full">
                <i class="fa-solid fa-clock text-[10px]"></i> {t('upcoming_brokers.badge_wait_list')}
              </span>
              <span class="text-[#2B77EE] text-xs font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                {t('upcoming_brokers.view_details')} <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </span>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Empty state -->
    <div id="broker-empty" class="hidden text-center py-20">
      <i class="fa-solid fa-magnifying-glass text-4xl text-gray-600 mb-4"></i>
      <p class="text-gray-400">{t('upcoming_brokers.empty_state')}</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="pb-20 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto text-center" data-aos="fade-up">
    <div class="bg-gradient-to-r from-blue-600/20 to-purple-600/20 rounded-3xl p-12 border border-blue-500/30">
      <h2 class="text-3xl font-bold mb-4">{t('upcoming_brokers.cta_title')}</h2>
      <p class="text-gray-300 mb-8 max-w-2xl mx-auto">
        {t('upcoming_brokers.cta_description')}
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href={localizedPath(locale, 'page/contact')} class="px-8 py-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-xl font-semibold transition-all">
          {t('upcoming_brokers.cta_request')}
        </a>
        <a href="https://app.pickmytrade.io/?register=true" class="px-8 py-3 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 rounded-xl font-semibold shadow-lg shadow-blue-600/20 transition-all">
          {t('upcoming_brokers.cta_start')}
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const search = document.getElementById('broker-search');
      const grid = document.getElementById('broker-grid');
      const empty = document.getElementById('broker-empty');
      const count = document.getElementById('broker-count');
      const filterBar = document.getElementById('category-filters');
      if (!search || !grid || !filterBar) return;

      const cards = Array.from(grid.querySelectorAll('.broker-card'));
      const pills = Array.from(filterBar.querySelectorAll('.category-pill'));
      let activeCategory = 'all';

      const ACTIVE_CLASSES = ['bg-[#2B77EE]', 'border-[#2B77EE]', 'text-white', 'is-active'];
      const INACTIVE_CLASSES = ['bg-white/5', 'border-white/10', 'text-gray-400'];

      function setActivePill(pill) {
        pills.forEach(function (p) {
          const isTarget = p === pill;
          p.classList.remove(...ACTIVE_CLASSES, ...INACTIVE_CLASSES);
          p.classList.add(...(isTarget ? ACTIVE_CLASSES : INACTIVE_CLASSES));
        });
      }

      function applyFilters() {
        const q = search.value.trim().toLowerCase();
        let visible = 0;
        cards.forEach(function (card) {
          const nameMatch = card.getAttribute('data-name').includes(q);
          const categoryMatch = activeCategory === 'all' || card.getAttribute('data-category') === activeCategory;
          const match = nameMatch && categoryMatch;
          card.classList.toggle('hidden', !match);
          if (match) visible++;
        });
        if (count) count.textContent = String(visible);
        if (empty) empty.classList.toggle('hidden', visible !== 0);
      }

      search.addEventListener('input', applyFilters);

      pills.forEach(function (pill) {
        pill.addEventListener('click', function () {
          activeCategory = pill.getAttribute('data-filter-category') || 'all';
          setActivePill(pill);
          applyFilters();
        });
      });
    })();
  </script>
</BaseLayout>
