---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import { getLocalePaths, localizedPath, absoluteLocalizedPath, useTranslations } from '../../../i18n/utils';
import { localizedSeo } from '../../../i18n/seo';
import type { Locale } from '../../../i18n/config';
import usecasesData from '../../../../config/usecases.json';

export function getStaticPaths() {
  return getLocalePaths().flatMap(({ params, props }) =>
    usecasesData.usecases.map(uc => ({
      params: { locale: params.locale, slug: uc.slug },
      props: { uc, locale: props.locale },
    }))
  );
}

const { locale, uc } = Astro.props as { locale: Locale; uc: typeof usecasesData.usecases[0] };
const t = useTranslations(locale);

const faqItems = [
  { question: t('use_case_detail.faq_q1', { persona_lower: uc.persona_lower }), answer: t('use_case_detail.faq_a1', { persona_lower: uc.persona_lower, answer: uc.faq_1_answer }) },
  { question: t('use_case_detail.faq_q2'), answer: t('use_case_detail.faq_a2') },
  { question: t('use_case_detail.faq_q3', { persona_lower: uc.persona_lower }), answer: t('use_case_detail.faq_a3', { brokers: uc.recommended_brokers, persona_lower: uc.persona_lower }) },
  { question: t('use_case_detail.faq_q4'), answer: t('use_case_detail.faq_a4') },
];

const canonical = absoluteLocalizedPath(locale, `use-cases/${uc.slug}`);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `Trading Automation for ${uc.persona}`,
  "description": uc.seo.description,
  "provider": { "@type": "Organization", "name": "PickMyTrade" },
  "serviceType": "Trading Automation",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1","h2",".faq-question",".faq-answer"] },
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Is PickMyTrade suitable for ${uc.persona_lower}?`,
      "acceptedAnswer": { "@type": "Answer", "text": `Yes! PickMyTrade is specifically designed to meet the needs of ${uc.persona_lower}. ${uc.faq_1_answer}` },
    },
    {
      "@type": "Question",
      "name": "Do I need coding skills?",
      "acceptedAnswer": { "@type": "Answer", "text": "No coding required! PickMyTrade is a no-code solution. Simply connect your broker, set up TradingView webhooks, and start automating your strategies." },
    },
    {
      "@type": "Question",
      "name": `What brokers work best for ${uc.persona_lower}?`,
      "acceptedAnswer": { "@type": "Answer", "text": `${uc.recommended_brokers}. These brokers offer the features and capabilities most ${uc.persona_lower} need.` },
    },
    {
      "@type": "Question",
      "name": "Is there a free trial?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes! PickMyTrade offers a 7-day free trial with full access to all features. No credit card required to start your trial." },
    },
  ],
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "PickMyTrade",
  "url": "https://pickmytrade.io",
  "logo": "https://pickmytrade.io/assets/logo.png",
  "description": "TradingView automation platform for brokers and prop firms.",
  "sameAs": [
    "https://x.com/pickmytrade",
    "https://discord.gg/FkJ7g7498S",
    "https://www.instagram.com/pickmytrade",
    "https://www.youtube.com/@PickMyTrade",
    "https://www.linkedin.com/company/pickmytrade",
    "https://sourceforge.net/software/product/PickMyTrade/",
    "https://www.trustpilot.com/review/pickmytrade.trade",
    "https://blog.pickmytrade.io",
    "https://docs.pickmytrade.io",
  ],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://pickmytrade.io/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Use Cases",
      "item": absoluteLocalizedPath(locale, '#use-cases')
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": uc.persona,
      "item": canonical
    }
  ]
};

const colorClasses: Record<string, {
  badgeBg: string; badgeBorder: string; badgeText: string;
  gradFrom: string; gradTo: string; blob: string;
  featureBorder: string; featureIconBg: string; featureIconText: string;
  ctaGradFrom: string; ctaTextColor: string;
  solutionBorder: string; solutionIconBg: string; solutionIconText: string;
}> = {
  orange: {
    badgeBg: 'bg-orange-500/20', badgeBorder: 'border-orange-500/30', badgeText: 'text-orange-400',
    gradFrom: 'from-orange-400', gradTo: 'to-orange-500',
    blob: 'bg-orange-500',
    featureBorder: 'hover:border-orange-500/50', featureIconBg: 'bg-orange-500/20', featureIconText: 'text-orange-400',
    ctaGradFrom: 'from-orange-600', ctaTextColor: 'text-orange-600',
    solutionBorder: 'border-orange-500/30', solutionIconBg: 'bg-orange-500/20', solutionIconText: 'text-orange-400',
  },
  blue: {
    badgeBg: 'bg-blue-500/20', badgeBorder: 'border-blue-500/30', badgeText: 'text-blue-400',
    gradFrom: 'from-blue-400', gradTo: 'to-blue-500',
    blob: 'bg-blue-500',
    featureBorder: 'hover:border-blue-500/50', featureIconBg: 'bg-blue-500/20', featureIconText: 'text-blue-400',
    ctaGradFrom: 'from-blue-600', ctaTextColor: 'text-blue-600',
    solutionBorder: 'border-blue-500/30', solutionIconBg: 'bg-blue-500/20', solutionIconText: 'text-blue-400',
  },
  purple: {
    badgeBg: 'bg-purple-500/20', badgeBorder: 'border-purple-500/30', badgeText: 'text-purple-400',
    gradFrom: 'from-purple-400', gradTo: 'to-purple-500',
    blob: 'bg-purple-500',
    featureBorder: 'hover:border-purple-500/50', featureIconBg: 'bg-purple-500/20', featureIconText: 'text-purple-400',
    ctaGradFrom: 'from-purple-600', ctaTextColor: 'text-purple-600',
    solutionBorder: 'border-purple-500/30', solutionIconBg: 'bg-purple-500/20', solutionIconText: 'text-purple-400',
  },
  green: {
    badgeBg: 'bg-green-500/20', badgeBorder: 'border-green-500/30', badgeText: 'text-green-400',
    gradFrom: 'from-green-400', gradTo: 'to-green-500',
    blob: 'bg-green-500',
    featureBorder: 'hover:border-green-500/50', featureIconBg: 'bg-green-500/20', featureIconText: 'text-green-400',
    ctaGradFrom: 'from-green-600', ctaTextColor: 'text-green-600',
    solutionBorder: 'border-green-500/30', solutionIconBg: 'bg-green-500/20', solutionIconText: 'text-green-400',
  },
  indigo: {
    badgeBg: 'bg-indigo-500/20', badgeBorder: 'border-indigo-500/30', badgeText: 'text-indigo-400',
    gradFrom: 'from-indigo-400', gradTo: 'to-indigo-500',
    blob: 'bg-indigo-500',
    featureBorder: 'hover:border-indigo-500/50', featureIconBg: 'bg-indigo-500/20', featureIconText: 'text-indigo-400',
    ctaGradFrom: 'from-indigo-600', ctaTextColor: 'text-indigo-600',
    solutionBorder: 'border-indigo-500/30', solutionIconBg: 'bg-indigo-500/20', solutionIconText: 'text-indigo-400',
  },
  cyan: {
    badgeBg: 'bg-cyan-500/20', badgeBorder: 'border-cyan-500/30', badgeText: 'text-cyan-400',
    gradFrom: 'from-cyan-400', gradTo: 'to-cyan-500',
    blob: 'bg-cyan-500',
    featureBorder: 'hover:border-cyan-500/50', featureIconBg: 'bg-cyan-500/20', featureIconText: 'text-cyan-400',
    ctaGradFrom: 'from-cyan-600', ctaTextColor: 'text-cyan-600',
    solutionBorder: 'border-cyan-500/30', solutionIconBg: 'bg-cyan-500/20', solutionIconText: 'text-cyan-400',
  },
};

const c = colorClasses[uc.color] ?? colorClasses.blue;
// Localized title/description for non-English locales; English keeps the
// bespoke per-page copy in config. See src/i18n/seo.ts.
const seo = localizedSeo(locale, t, 'usecase', uc.persona, uc.seo);

---
<BaseLayout
  locale={locale}
  title={seo.title}
  description={seo.description}
  keywords={uc.seo.keywords}
  canonical={canonical}
  structuredData={[serviceSchema, faqSchema, orgSchema, breadcrumbSchema]}
>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="bg-[#001429] pt-20 pb-4">
    <div class="max-w-7xl mx-auto px-4">
      <ol class="flex items-center gap-2 text-sm text-gray-400">
        <li><a href={localizedPath(locale)} class="hover:text-blue-400">{t('use_case_detail.breadcrumb_home')}</a></li>
        <li>/</li>
        <li><a href={localizedPath(locale, '#use-cases')} class="hover:text-blue-400">{t('use_case_detail.breadcrumb_usecases')}</a></li>
        <li>/</li>
        <li class="text-white font-semibold">{uc.persona}</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <header class="relative overflow-hidden bg-gradient-to-b from-[#001429] via-[#001f3f] to-[#002040] py-16 sm:py-24">
    <div class="absolute inset-0 opacity-10">
      <div class={`absolute top-20 left-1/4 w-96 h-96 ${c.blob} rounded-full blur-3xl`}></div>
      <div class="absolute bottom-10 right-1/4 w-80 h-80 bg-blue-500 rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto px-4 text-center">
      <div class={`inline-flex items-center gap-2 mb-6 ${c.badgeBg} border ${c.badgeBorder} rounded-full px-5 py-2`} data-aos="fade-down">
        <i class={`${uc.icon} ${c.badgeText}`}></i>
        <span class={`text-sm font-semibold ${c.badgeText} uppercase tracking-wider`}>{t('use_case_detail.hero_built_for', { persona: uc.persona })}</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6" data-aos="fade-up">
        <span class="text-white">{t('use_case_detail.hero_title_line1')}</span><br>
        <span class={`bg-gradient-to-r ${c.gradFrom} to-blue-400 bg-clip-text text-transparent electrolize-regular`}>{uc.persona}</span>
      </h1>

      <p class="text-lg sm:text-xl text-gray-300 max-w-3xl mx-auto mb-8 leading-relaxed" data-aos="fade-up" data-aos-delay="100">
        {uc.tagline}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-10" data-aos="fade-up" data-aos-delay="200">
        <a href="https://app.pickmytrade.io/?register=true"
          class={`px-8 py-4 bg-gradient-to-r ${c.gradTo} to-blue-600 rounded-xl font-semibold text-white shadow-lg transition-all duration-300 electrolize-regular`}>
          {t('use_case_detail.hero_cta_trial')}
        </a>
        <a href="https://docs.pickmytrade.io/docs/"
          class="px-8 py-4 bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl font-semibold text-white hover:bg-white/20 transition-all duration-300 electrolize-regular">
          {t('use_case_detail.hero_cta_docs')}
        </a>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-6 text-sm">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-check-circle text-green-400"></i>
          <span class="text-gray-300">{t('use_case_detail.hero_badge_trial')}</span>
        </div>
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-credit-card text-green-400"></i>
          <span class="text-gray-300">{t('use_case_detail.hero_badge_card')}</span>
        </div>
        <div class="flex items-center gap-2">
          <i class={`fa-solid fa-users ${c.badgeText}`}></i>
          <span class="text-gray-300">{t('use_case_detail.hero_active_users', { count: uc.user_count })}</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Challenges -->
  <section class="bg-[#002040] py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-12" data-aos="fade-up">
        {t('use_case_detail.challenges_title_1')} <span class={`bg-gradient-to-r ${c.gradFrom} to-blue-400 bg-clip-text text-transparent`}>{t('use_case_detail.challenges_title_2')}</span>
      </h2>

      <div class="grid md:grid-cols-2 gap-8">
        {[
          { title: uc.challenge_1_title, desc: uc.challenge_1_desc },
          { title: uc.challenge_2_title, desc: uc.challenge_2_desc },
          { title: uc.challenge_3_title, desc: uc.challenge_3_desc },
          { title: uc.challenge_4_title, desc: uc.challenge_4_desc },
        ].map((ch) => (
          <div class="bg-[#001429] border border-red-500/30 rounded-xl p-8" data-aos="fade-up">
            <div class="w-12 h-12 bg-red-500/20 rounded-lg flex items-center justify-center mb-4">
              <i class="fa-solid fa-triangle-exclamation text-red-400 text-xl"></i>
            </div>
            <h3 class="text-xl font-bold mb-3 text-red-300">{ch.title}</h3>
            <p class="text-gray-400">{ch.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How PickMyTrade Helps -->
  <section class="bg-[#001429] py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-12" data-aos="fade-up">
        {t('use_case_detail.helps_title_1')} <span class={`bg-gradient-to-r ${c.gradFrom} to-blue-400 bg-clip-text text-transparent`}>{t('use_case_detail.helps_title_2')}</span>
      </h2>

      <div class="grid md:grid-cols-3 gap-8">
        <div class={`bg-gradient-to-br from-[#002040] to-[#001429] border ${c.solutionBorder} rounded-xl p-6`} data-aos="fade-up">
          <div class={`w-12 h-12 ${c.solutionIconBg} rounded-lg flex items-center justify-center mb-4`}>
            <i class={`fa-solid fa-check-circle ${c.solutionIconText} text-xl`}></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{uc.solution_1_title}</h3>
          <p class="text-gray-400">{uc.solution_1_desc}</p>
        </div>

        <div class="bg-gradient-to-br from-[#002040] to-[#001429] border border-blue-500/30 rounded-xl p-6" data-aos="fade-up" data-aos-delay="100">
          <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center mb-4">
            <i class="fa-solid fa-check-circle text-blue-400 text-xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{uc.solution_2_title}</h3>
          <p class="text-gray-400">{uc.solution_2_desc}</p>
        </div>

        <div class="bg-gradient-to-br from-[#002040] to-[#001429] border border-green-500/30 rounded-xl p-6" data-aos="fade-up" data-aos-delay="200">
          <div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center mb-4">
            <i class="fa-solid fa-check-circle text-green-400 text-xl"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{uc.solution_3_title}</h3>
          <p class="text-gray-400">{uc.solution_3_desc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="bg-[#002040] py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-12" data-aos="fade-up">
        {t('use_case_detail.features_title_1')} <span class={`bg-gradient-to-r ${c.gradFrom} to-blue-400 bg-clip-text text-transparent`}>{t('use_case_detail.features_title_2')}</span>
      </h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { icon: 'fa-solid fa-bolt', color: c.featureIconText, title: uc.feature_1_title, desc: uc.feature_1_desc },
          { icon: 'fa-solid fa-shield-halved', color: 'text-blue-400', title: uc.feature_2_title, desc: uc.feature_2_desc },
          { icon: 'fa-solid fa-chart-line', color: 'text-green-400', title: uc.feature_3_title, desc: uc.feature_3_desc },
          { icon: 'fa-solid fa-layer-group', color: 'text-purple-400', title: uc.feature_4_title, desc: uc.feature_4_desc },
          { icon: 'fa-solid fa-mobile-screen', color: 'text-cyan-400', title: uc.feature_5_title, desc: uc.feature_5_desc },
          { icon: 'fa-solid fa-headset', color: 'text-yellow-400', title: uc.feature_6_title, desc: uc.feature_6_desc },
        ].filter((feat) => feat.title).map((feat, i) => (
          <div class={`bg-[#001429] border border-white/10 rounded-xl p-6 ${c.featureBorder} transition-all`} data-aos="fade-up" data-aos-delay={`${i * 50}`}>
            <i class={`${feat.icon} ${feat.color} text-3xl mb-4`}></i>
            <h3 class="text-lg font-bold mb-2">{feat.title}</h3>
            <p class="text-gray-400 text-sm">{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Recommended Setup -->
  {!uc.hide_recommended_setup && (
    <section class="bg-[#001429] py-16">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-3xl sm:text-4xl font-bold text-center mb-12" data-aos="fade-up">
          {t('use_case_detail.setup_title_1')} <span class={`bg-gradient-to-r ${c.gradFrom} to-blue-400 bg-clip-text text-transparent`}>{t('use_case_detail.setup_title_2')}</span>
        </h2>

        <div class={`grid gap-8 ${[uc.recommended_brokers, uc.recommended_strategies, uc.recommended_risk].filter(Boolean).length >= 3 ? 'md:grid-cols-3' : 'md:grid-cols-2 max-w-3xl mx-auto'}`}>
          {uc.recommended_brokers && (
            <div class={`bg-gradient-to-br from-[#002040] to-[#001429] border ${c.solutionBorder} rounded-xl p-8 text-center`} data-aos="fade-up">
              <div class={`w-16 h-16 ${c.solutionIconBg} rounded-full flex items-center justify-center mx-auto mb-6`}>
                <i class={`fa-solid fa-building-columns ${c.solutionIconText} text-2xl`}></i>
              </div>
              <h3 class="text-xl font-bold mb-4">{t('use_case_detail.setup_brokers_title')}</h3>
              <p class="text-gray-400">{uc.recommended_brokers}</p>
            </div>
          )}

          {uc.recommended_strategies && (
            <div class="bg-gradient-to-br from-[#002040] to-[#001429] border border-blue-500/30 rounded-xl p-8 text-center" data-aos="fade-up" data-aos-delay="100">
              <div class="w-16 h-16 bg-blue-500/20 rounded-full flex items-center justify-center mx-auto mb-6">
                <i class="fa-solid fa-code text-blue-400 text-2xl"></i>
              </div>
              <h3 class="text-xl font-bold mb-4">{t('use_case_detail.setup_strategy_title')}</h3>
              <p class="text-gray-400">{uc.recommended_strategies}</p>
            </div>
          )}

          {uc.recommended_risk && (
            <div class="bg-gradient-to-br from-[#002040] to-[#001429] border border-green-500/30 rounded-xl p-8 text-center" data-aos="fade-up" data-aos-delay="200">
              <div class="w-16 h-16 bg-green-500/20 rounded-full flex items-center justify-center mx-auto mb-6">
                <i class="fa-solid fa-shield-halved text-green-400 text-2xl"></i>
              </div>
              <h3 class="text-xl font-bold mb-4">{t('use_case_detail.setup_risk_title')}</h3>
              <p class="text-gray-400">{uc.recommended_risk}</p>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="bg-[#002040] py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-12" data-aos="fade-up">
        {t('use_case_detail.faq_title_1')} <span class={`bg-gradient-to-r ${c.gradFrom} to-blue-400 bg-clip-text text-transparent`}>{t('use_case_detail.faq_title_2')}</span>
      </h2>

      <FaqAccordion items={faqItems} />
    </div>
  </section>

  <!-- Final CTA -->
  <section class={`bg-gradient-to-r ${c.ctaGradFrom} to-blue-600 py-16`}>
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold mb-6 electrolize-regular" data-aos="fade-up">
        {t('use_case_detail.cta_title')}
      </h2>
      <p class="text-xl text-blue-100 mb-8" data-aos="fade-up" data-aos-delay="100">
        {t('use_case_detail.cta_subtitle', { count: uc.user_count, persona_lower: uc.persona_lower })}
      </p>
      <a href="https://app.pickmytrade.io/?register=true"
        class={`inline-block px-8 py-4 bg-white ${c.ctaTextColor} rounded-xl font-semibold shadow-xl hover:shadow-2xl transform hover:-translate-y-1 transition-all duration-300 electrolize-regular`}
        data-aos="fade-up" data-aos-delay="200">
        {t('use_case_detail.cta_button')}
      </a>
    </div>
  </section>
</BaseLayout>
